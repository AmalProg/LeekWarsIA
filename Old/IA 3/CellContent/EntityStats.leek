class EntityStats {
	public maxLife; public getMaxLife() { return this.maxLife; }
	public life; public getLife() { return this.life; }
	public strength; public getStrength() { return this.strength; }
	public wisdom; public getWisdom() { return this.wisdom; }
	public agility; public getAgility() { return this.agility; }
	public resistance; public getResistance() { return this.resistance; }
	public science; public getScience() { return this.science; }
	public magic; public getMagic() { return this.magic; }
	public power; public getPower() { return this.power; }
	public frequency; public getFrequency() { return this.frequency; }
	public tp; public getTP() { return this.tp; }
	public mp; public getMP() { return this.mp; }
	public abso; public getAbso() { return this.abso; }
	public rel; public getRel() { return this.rel; }
	public dmgReturn; public getDmgReturn() { return this.dmgReturn; }
	
	public strengthMult; public getStrengthMult() { return this.strengthMult; }
	public wisdomMult; public getWisdomMult() { return this.wisdomMult; }
	public agilityMult; public getAgilityMult() { return this.agilityMult; }
	public resistanceMult; public getResistanceMult() { return this.resistanceMult; }
	public scienceMult; public getScienceMult() { return this.scienceMult; }
	public magicMult; public getMagicMult() { return this.magicMult; }
	public powerMult; public getPowerMult() { return this.powerMult; }
	
	public effects = []; public getEffects() { return this.effects; }	
	public passiveEffects = [];
	
	public entityName;

	constructor(entity) {
		this.initStats(entity.id);
		entityName = entity.name;
	}
	
	public copy(stats) {
		this.maxLife = stats.maxLife;
		this.life = stats.life;
		this.strength = stats.strength;
		this.wisdom = stats.wisdom;
		this.agility = stats.agility;
		this.resistance = stats.resistance;
		this.science = stats.science;
		this.magic = stats.magic;
		this.power = stats.power;
		this.frequency = stats.frequency;
		this.tp = stats.tp;
		this.mp = stats.mp;
		this.abso = stats.abso;
		this.rel = stats.rel;
		this.dmgReturn = stats.dmgReturn;
		
		this.strengthMult = stats.strengthMult;
		this.wisdomMult = stats.wisdomMult;
		this.agilityMult = stats.agilityMult;
		this.resistanceMult = stats.resistanceMult;
		this.scienceMult = stats.scienceMult;
		this.magicMult = stats.magicMult;
		this.powerMult = stats.powerMult;
		
		this.effects = clone(stats.effects);
		this.passiveEffects = clone(stats.passiveEffects);
	}
	
	public initStats(entityId) {
		this.maxLife = getTotalLife(entityId);
		this.life = getLife(entityId);
		this.strength = getStrength(entityId);
		this.wisdom = getWisdom(entityId);
		this.agility = getAgility(entityId);
		this.resistance = getResistance(entityId);
		this.science = getScience(entityId);
		this.magic = getMagic(entityId);
		this.power = getPower(entityId);
		this.frequency = getFrequency(entityId);
		this.tp = getTP(entityId);
		if (this.tp < 0)
			this.tp = 0;
		this.mp = getMP(entityId);
		if (this.mp < 0)
			this.mp = 0;
		this.abso = getAbsoluteShield(entityId);
		this.rel = getRelativeShield(entityId);
		this.dmgReturn = getDamageReturn(entityId);
		
		this.effects = [];
		for (var effect in getEffects(entityId)) {
			push(this.effects, EntityEffect(effect));
		}
		this.passiveEffects = [];
		for (var effect in getPassiveEffects(entityId)) {
			push(this.passiveEffects, new EntityEffect(effect));
		}
		
		updateMults();
	}
	
	public updateMults() {
		this.strengthMult = (1 + (this.getStrength() >= 0 ? this.getStrength() : 0) / 100);
		this.wisdomMult = (1 + (this.getWisdom() >= 0 ? this.getWisdom() : 0) / 100);
		this.agilityMult = (1 + (this.getAgility() >= 0 ? this.getAgility() : 0) / 100);
		this.resistanceMult = (1 + (this.getResistance() >= 0 ? this.getResistance() : 0) / 100);
		this.scienceMult = (1 + (this.getScience() >= 0 ? this.getScience() : 0) / 100);
		this.magicMult = (1 + (this.getMagic() >= 0 ? this.getMagic() : 0) / 100);
		this.powerMult = (1 + (this.getPower() >= 0 ? this.getPower() : 0) / 100);	
	}
	
	public addEffect(type, value, caster, turns, critical, itemId, target) {
		if (turns != 0) {
			if (caster instanceof EntityStats)
				debug("Nope");
			var effect = new EntityEffect(type, value, caster, turns, critical, itemId, target);
			//debug("adding effect " + effect + " to " + this.name)
			push(this.effects, effect);
			effect.applyTo(this);
		}
	}
	public addEffect(effect) {
		if (effect.turns != 0) {
			//debug("adding effect " + effect + " to " + this.name)
			push(this.effects, effect);
			effect.applyTo(this);
		}
	}
	public addEffects(effects) {
		for (var effect in effects) {
			if (effect.turns != 0) {
				//debug("adding effect " + effect + " to " + this.name)
				push(this.effects, effect);
				effect.applyTo(this);
			}
		}
	}
	
	public removeEffect(effect) {
		if (effect != null) {
			//debug("removing effect " + effect + " to " + this.name)
			removeElement(this.effects, effect);
			effect.removeTo(this);
		}
	}
	public removeEffects(effects) {
		if (effects != null or effects != []) {
			for (var effect in effects) {
				//debug("removing effect " + effect + " to " + this.name)
				removeElement(this.effects, effect);
				effect.removeTo(this);
			}
		}
	}
	
	/**
	 * Test si l'effet affecte l'entité, corespondant au type et à l'item de l'effet donné
	 * 
	 * @param eff : l'effet recherché
	 * 
	 * @return true si l'entité est affecté par l'effet
	 * 
	 **/
	public hasEffectOn(eff) {
		for (var effect in this.effects) {
			if (effect.type == eff.type && effect.itemId == eff.item.id)
				return true;
		}
		return false;
	}
	
	public hasEffectType(effType) {
		for (var effect in this.effects) {
			if (effect.type == effType)
				return true;
		}
		return false;
	}
	
	/**
	 * Récupère l'effet qui affecte l'entité, corespondant au type et à l'item de l'effet donné
	 * 
	 * @param eff : l'effet recherché
	 * 
	 * @return la liste des effets correspondant à 'eff'
	 **/
	public getEffectsOn(eff) {
		var effectsMatching = [];
		for (var effect in this.effects) {
			if (effect.type == eff.type && effect.itemId == eff.item.id)
				push(effectsMatching, effect);
		}
		return effectsMatching;
	}
	
		
	/**
	 * Récupère les effets qui affecteront encore l'entité dans x tour
	 * 
	 * @param turns : le nombre de tours
	 * 
	 * @return la liste des effets
	 **/
	public getEffectsInTurns(turns, entity) {
		var effectsInTurns = [];
		for (var effect in this.effects) {
			if (effect.turns == -1 || effect.turns > turns || (effect.turns == turns && effect.caster.leekTurnOrder > entity.leekTurnOrder))
				push(effectsInTurns, effect);
		}
		return effectsInTurns;
	}
	
	public removeShackles() {
		var effectsToRemove = [];
		for (var eff in this.effects) {
			if (eff.type == EFFECT_SHACKLE_AGILITY or eff.type == EFFECT_SHACKLE_WISDOM or eff.type == EFFECT_SHACKLE_MP or eff.type == EFFECT_SHACKLE_TP or eff.type == EFFECT_SHACKLE_STRENGTH or eff.type == EFFECT_SHACKLE_MAGIC) {
				eff.caster.removeLaunchedEffect(eff);
				push(effectsToRemove, eff);
			}
		}
		this.removeEffects(this.effects);
	}
	
	public removePoisons() {
		var effectsToRemove = [];
		for (var eff in this.effects) {
			if (eff.type != EFFECT_POISON) {
				eff.caster.removeLaunchedEffect(eff);
				push(effectsToRemove, eff);
			}
		}
		this.removeEffects(this.effects);
	}
	
	public debuff(value) {
		var newEffects = [];
		for (var eff in this.effects) {
			var newValue = round(eff.value * (1 - (value / 100)));
			if (newValue > 0) {
				push(newEffects, new EntityEffect(eff.type, newValue, eff.caster, eff.turns, eff.critical, eff.itemId, eff.target));
			}
		}
		this.removeEffects(this.effects);
		this.addEffects(newEffects);
	}
	
	public triggerPassive(target, value, type) {
		for (var eff in this.passiveEffects) {
			if(eff.type == EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD && type == EFFECT_DAMAGE) {
				var val = value * eff.value / 100;
				this.addEffect(EFFECT_RAW_ABSOLUTE_SHIELD, val, target, eff.turns, false, eff.itemId, target);
				
			} else if(eff.type == EFFECT_DAMAGE_TO_STRENGTH && type == EFFECT_DAMAGE) {
				var val = value * eff.value / 100;
				this.addEffect(EFFECT_RAW_BUFF_STRENGTH, val, target, eff.turns, false, eff.itemId, target);
				
			} else if(eff.type == EFFECT_POISON_TO_SCIENCE && type == EFFECT_POISON) {
				var val = value * eff.value / 100;
				this.addEffect(EFFECT_RAW_BUFF_SCIENCE, val, target, eff.turns, false, eff.itemId, target);
				
			} else if(eff.type == EFFECT_NOVA_DAMAGE_TO_MAGIC && type == EFFECT_NOVA_DAMAGE) {
				var val = value * eff.value / 100;
				this.addEffect(EFFECT_RAW_BUFF_MAGIC, val, target, eff.turns, false, eff.itemId, target);
				
			} else if(eff.type == EFFECT_MOVED_TO_MP) {
				
			}
		}
	}
	
	public addMaxLife(value) {	
		this.maxLife += value;
		Debug.info("adding max life " + value + " life to " + entityName + " who has " + this.life + " / " + this.maxLife);
	}
	
	public removeMaxLife(value) {
		this.maxLife -= value;
		this.triggerPassive(this, value, EFFECT_NOVA_DAMAGE);
		Debug.info("removing max life " + value + " life from " + entityName + " who has " + this.life + " / " + this.maxLife);
	}
	
	public addLife(value) {
		this.life += value;
		if (this.life > this.maxLife)
			this.life = this.maxLife;
		Debug.info("healing " + value + " life to " + entityName + " who has " + this.life + " / " + this.maxLife);
	}
	
	public removeLife(value, type) {
		this.life -= value;
		this.triggerPassive(this, value, type);

		var erosionMult = type == EFFECT_POISON ? 0.10 : 0.05;
		var erosionValue = round(value * erosionMult);
		this.removeMaxLife(erosionValue);
		
		Debug.info("removing " + value + " life from " + entityName + " who has " + this.life + " / " + this.maxLife);
	}
	
	public addStrength(value) {
		this.strength += value;
		Debug.info("add " + value + " strength to " + entityName);
	}
	
	public removeStrength(value) {
		this.strength -= value;
		Debug.info("remove " + value + " strength to " + entityName);
	}
	
	public addWisdom(value) {
		this.wisdom += value;
		Debug.info("add " + value + " wisdom to " + entityName);
	}
	
	public removeWisdom(value) {
		this.wisdom -= value;
		Debug.info("remove " + value + " wisdom to " + entityName);
	}
	
	public addAgility(value) {
		this.agility += value;
		Debug.info("add " + value + " agility to " + entityName);
	}
	
	public removeAgility(value) {
		this.agility -= value;
		Debug.info("remove " + value + " agility to " + entityName);
	}
	
	public addResistance(value) {
		this.resistance += value;
		Debug.info("add " + value + " resistance to " + entityName);
	}
	
	public removeResistance(value) {
		this.resistance -= value;
		Debug.info("remove " + value + " resistance to " + entityName);
	}
	
	public addScience(value) {
		this.science += value;
		Debug.info("add " + value + " science to " + entityName);
	}
	
	public removeScience(value) {
		this.science -= value;
		Debug.info("remove " + value + " science to " + entityName);
	}
	
	public addMagic(value) {
		this.magic += value;
		Debug.info("add " + value + " magic to " + entityName);
	}
	
	public removeMagic(value) {
		this.magic -= value;
		Debug.info("remove " + value + " magic to " + entityName);
	}
	
	public addPower(value) {
		this.power += value;
		Debug.info("add " + value + " power to " + entityName);
	}
	
	public removePower(value) {
		this.power -= value;
		Debug.info("remove " + value + " power to " + entityName);
	}
	
	public addAbso(value) {
		this.abso += value;
		Debug.info("add " + value + " abso to " + entityName);
	}
	
	public removeAbso(value) {
		this.abso -= value;
		Debug.info("remove " + value + " abso to " + entityName);
	}
	
	public addRel(value) {
		this.rel += value;
		Debug.info("add " + value + " rel to " + entityName);
	}
	
	public removeRel(value) {
		this.rel -= value;
		Debug.info("remove " + value + " rel to " + entityName);
	}
	
	public addDmgReturn(value) {
		this.dmgReturn += value;
		Debug.info("add " + value + " dmg return to " + entityName);
	}
	
	public removeDmgReturn(value) {
		this.dmgReturn -= value;
		Debug.info("remove " + value + " dmg return to " + entityName);
	}
	
	public addTP(value) {
		this.tp += value;
		Debug.info("add " + value + " tp to " + entityName);
	}
	
	public removeTP(value) {
		this.tp -= value;
		Debug.info("remove " + value + " tp to " + entityName);		
	}
	
	public useTP(value) {
		this.tp -= value;
		Debug.info("using " + value + " tp to " + entityName);
	}
	
	public addMP(value) {
		this.mp += value;
		Debug.info("add " + value + " mp to " + entityName);
	}
	
	public removeMP(value) {
		this.mp -= value;
		Debug.info("remove " + value + " mp to " + entityName);		
	}
	
	public useMP(value) {
		this.mp -= value;
		Debug.info("using " + value + " mp to " + entityName);
	}
	
	public string() {
		return
			"\n maxLife : " + this.maxLife +
			"\n life : " + this.life +
			"\n strength : " + this.strength +
			"\n wisdom : " + this.wisdom +
			"\n agility : " + this.agility +
			"\n resistance : " + this.resistance +
			"\n science : " + this.science +
			"\n magic : " + this.magic +
			"\n power : " + this.power +
			"\n tp : " + this.tp +
			"\n mp : " + this.mp +
			"\n abso : " + this.abso +
			"\n rel : " + this.rel +
			"\n dmgReturn : " + this.dmgReturn;
	}
}