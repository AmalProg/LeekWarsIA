			"\n shackleMp : " + this.shackleMp +
			"\n shackleTp : " + this.shackleTp +
			"\n shackleStrength : " + this.shackleStrength +
			"\n shackleMagic : " + this.shackleMagic +
			"\n removeShackles : " + this.removeShackles +
			"\n abso : " + this.abso +
			"\n rel : " + this.rel +
