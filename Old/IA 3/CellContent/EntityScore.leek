	public heal;
	public novaVitality;
	public boostMaxLife;
	public buffAgility;
	public buffResistance;
	public buffWisdom;
	public buffMp;
	public buffTp;
	public buffStrength;
	public rawBuffAgility;
	public rawBuffResistance;
	public rawBuffWisdom;
	public rawBuffMp;
	public rawBuffTp;
	public rawBuffStrength;
	public rawBuffMagic;
	public shackleAgility;
	public shackleWisdom;
	public shackleMp;
	public shackleTp;
	public shackleStrength;
	public shackleMagic;
	public removeShackles;
