	constructor() {
		this.damage = 0;
		this.poison = 0;
		this.lifeDamage = 0;
		this.novaDamage = 0;
		this.heal = 0;
		this.novaVitality = 0;
		this.boostMaxLife = 0;
		this.buffAgility = 0;
		this.buffResistance = 0;
		this.buffWisdom = 0;
		this.buffMp = 0;
		this.buffTp = 0;
		this.buffStrength = 0;
		this.rawBuffAgility = 0;
		this.rawBuffResistance = 0;
		this.rawBuffWisdom = 0;
		this.rawBuffMp = 0;
		this.rawBuffTp = 0;
		this.rawBuffStrength = 0;
		this.rawBuffMagic = 0;
		this.shackleAgility = 0;
		this.shackleWisdom = 0;
		this.shackleMp = 0;
		this.shackleTp = 0;
		this.shackleStrength = 0;
		this.shackleMagic = 0;
		this.removeShackles = 0;
		this.abso = 0;
		this.rel = 0;
		this.absoVulnerability = 0;
		this.relVulnerability = 0;
		this.stealAbso = 0;
		this.damageReturn = 0;
		this.afterEffect = 0;
		this.antidote = 0;
		this.debuff = 0;
		this.teleport = 0;
		this.invert = 0;
		this.ressurect = 0;
		this._summon = 0;
		this.summonHeal = 0;
		this.summonRes = 0;
		this.summonDamage = 0;
		this.summonPoison = 0;
		this.summonMove = 0;
		this.summonNova = 0;
		this.kill = 0;
		this.attract = 0;
		this._push = 0;
		this.damageToAbso = 0;
		this.damageToStrength = 0;
		this.poisonToScience = 0;
		this.novaDamageToMagic = 0;
		this.propagation = 0;
		this.movedToMp = 0;
		this.usefulnessScore = 0;
		this.willGetHit = 0;
		this.isolated = 0;
		this.inDanger = 0;
		this.debuffProtect = 0;
		this.debuffDanger = 0;
	}
	
	public string() {
		return " { damage : " + this.damage +
			"\n poison : " + this.poison +
			"\n lifeDamage : " + this.lifeDamage +
			"\n novaDamage : " + this.novaDamage +
			"\n heal : " + this.heal +
			"\n novaVitality : " + this.novaVitality +
			"\n boostMaxLife : " + this.boostMaxLife +
			"\n buffAgility : " + this.buffAgility +
			"\n buffResistance : " + this.buffResistance +
			"\n buffWisdom : " + this.buffWisdom +
			"\n buffMp : " + this.buffMp +
			"\n buffTp : " + this.buffTp +
			"\n buffStrength : " + this.buffStrength +
			"\n rawBuffAgility : " + this.rawBuffAgility +
			"\n rawBuffResistance : " + this.rawBuffResistance +
			"\n rawBuffWisdom : " + this.rawBuffWisdom +
