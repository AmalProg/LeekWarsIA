			"\n stealAbso : " + this.stealAbso +
			"\n damageReturn : " + this.damageReturn +
			"\n afterEffect : " + this.afterEffect +
			"\n antidote : " + this.antidote +
			"\n debuff : " + this.debuff +
			"\n teleport : " + this.teleport +
			"\n invert : " + this.invert +
			"\n ressurect : " + this.ressurect +
