			finalValue = round(baseValue * casterStats.agilityMult);
			affectedEntityStats.addEffect(this.type, finalValue, caster, this.turns, false, this.item.id, target);		
			
		} else if (this.type == EFFECT_AFTEREFFECT) {
			var dmg = round(baseValue * casterStats.scienceMult);
			if (dmg > 0)
				affectedEntityStats.removeLife(dmg, EFFECT_AFTEREFFECT);
			
		} else if (this.type == EFFECT_ANTIDOTE) {
			affectedEntityStats.removePoisons();
		
		} else if (this.type == EFFECT_DEBUFF) {
			affectedEntityStats.debuff(finalValue);
			
		}
		
		affectedEntityStats.updateMults();
	}


	/**
	 * Renvoi la valeur du l'effet appliqué à target par caster
	 **/
	public getAppliedValue(target, caster, cellTarget, aoeMult) {
		if (!this.canTarget(target, caster)) return 0;
		
		var casterStats = caster.getStats();
		var targetStats = target.getStats();
		
		if (this.notReplaceable) {
			// On ne peut pas remplacer l'effet déjà en place
			if (targetStats.hasEffectOn(this)) return 0;
		}
		
		// l'entité affecté est le caster, donc rien sur la target
		if (this.affectCaster and target.id != caster.id) {
			return 0;
		}
		
		var nbrTargetsMult = 1;
		if (this.multByTargets) {
			nbrTargetsMult = count(item.getItemTargets(cellTarget, null, caster));
		}
		
		var baseEffValue = this.minValue * nbrTargetsMult * (1 + this.turns / 9) * aoeMult;
		var totalValue = 0;
		if(this.type == EFFECT_DAMAGE) {
			var baseDmg = baseEffValue * casterStats.strengthMult * casterStats.powerMult;
			totalValue = round(baseDmg * (1 - targetStats.getRel()  / 100) - targetStats.getAbso());

		} else if(this.type == EFFECT_POISON) {
			totalValue = baseEffValue * casterStats.magicMult * casterStats.powerMult;

		} else if(this.type == EFFECT_LIFE_DAMAGE) {
			var baseDmg = baseEffValue / 100 * casterStats.life * casterStats.powerMult;
			totalValue = round(baseDmg * (1 - targetStats.getRel() / 100) - targetStats.getAbso());

		} else if(this.type == EFFECT_NOVA_DAMAGE) {
			totalValue = baseEffValue * casterStats.scienceMult * casterStats.powerMult;

		} else if(this.type == EFFECT_HEAL) {
			totalValue = baseEffValue * casterStats.wisdomMult;
 
		} else if(this.type == EFFECT_NOVA_VITALITY) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_BOOST_MAX_LIFE) {
			totalValue = baseEffValue * casterStats.wisdomMult;

		} else if(this.type == EFFECT_BUFF_AGILITY) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_BUFF_RESISTANCE) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_BUFF_WISDOM) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_BUFF_MP) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_BUFF_TP) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_BUFF_STRENGTH) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_RAW_BUFF_AGILITY) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_RAW_BUFF_RESISTANCE) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_RAW_BUFF_WISDOM) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_RAW_BUFF_MP) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_RAW_BUFF_TP) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_RAW_BUFF_STRENGTH) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_RAW_BUFF_MAGIC) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_SHACKLE_AGILITY) {
			totalValue = baseEffValue * casterStats.magicMult;

		} else if(this.type == EFFECT_SHACKLE_WISDOM) {
			totalValue = baseEffValue * casterStats.magicMult;

		} else if(this.type == EFFECT_SHACKLE_MP) {
			totalValue = baseEffValue * casterStats.magicMult;

		} else if(this.type == EFFECT_SHACKLE_TP) {
			totalValue = baseEffValue * casterStats.magicMult;

		} else if(this.type == EFFECT_SHACKLE_STRENGTH) {
			totalValue = baseEffValue * casterStats.magicMult;

		} else if(this.type == EFFECT_SHACKLE_MAGIC) {
			totalValue = baseEffValue * casterStats.magicMult;

		} else if(this.type == EFFECT_ABSOLUTE_SHIELD) {
			totalValue = baseEffValue * casterStats.resistanceMult;

		} else if(this.type == EFFECT_RELATIVE_SHIELD) {
			totalValue = baseEffValue * casterStats.resistanceMult;

		} else if(this.type == EFFECT_ABSOLUTE_VULNERABILITY) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_VULNERABILITY) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_STEAL_ABSOLUTE_SHIELD) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_DAMAGE_RETURN) {
			totalValue = baseEffValue * casterStats.agilityMult;

		} else if(this.type == EFFECT_AFTEREFFECT) {
			totalValue = baseEffValue * casterStats.scienceMult;

		} else if(this.type == EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_DAMAGE_TO_STRENGTH) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_POISON_TO_SCIENCE) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_NOVA_DAMAGE_TO_MAGIC) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_PROPAGATION) {
			totalValue = baseEffValue;

		} else if(this.type == EFFECT_MOVED_TO_MP) {
			totalValue = baseEffValue;
		}
		
		return totalValue;
	}
	
	public string() {
		return 	"{ type: " + this.type +
				" | meanValue: " + this.meanValue +
				" | turns: " + this.turns +
				" | item: " + this.item.name + " }";
	}
}