include("Cell");
include("../CellContent/Obstacle");
include("../Memoize");
include("../Effect/EffectScoreMultiplier");
include("../Game");
 
class Map {
	public static xMin = -17;
	public static yMin = -17;
	public static xMax = 17;
	public static yMax = 17;
	public static cellIdMax = 612;
	
	public static obstacles = [];
	public static initObstacles() {
		for (var id in getObstacles()) {
			Cell.get(id).setContent(new Obstacle());
			obstacles[id] = Cell.get(id);
		}
	}
	
	public static inaccessibleCells = [];
	public static initInaccessibleCells() {
		var cellsAccessible = Map.getMyPathLength(Cell.get(getCell()), 60);
		
		for (var cell in Cell.getCells()) {
			if (cellsAccessible[cell.id] == null and obstacles[cell.id] == null) {
				inaccessibleCells[cell.id] = cell;	
			}
		}
	}
	

	public dangerScores = [];
	public dangerScoresPerEnemy = [];

	public initMap() {
	}

	public setEntitiesPosition(entities) {
		for (var entity in entities.any) {
			if (entity.alive()) {				
				Cell.get(entity.cell.id).setContent(entity);
			}
		}
	}
	public resetEntitiesPosition() {
		for (var cell in Cell.getCells()) {
			if (cell.getContentType() != CELL_OBSTACLE) {
				cell.setContent(null);
			}
		}
	}

	public initDamageMap(game) {
		this.resetDangerScoresPerEnemy();
	
		for(var enemy in game.getEnemiesGroup().alive) {
			var nextTurnEffects = enemy.stats.getEffectsInTurns(1, enemy);
			var e = clone(enemy, 2);
			e.stats.copy(e.stats);
			e.stats.removeEffects(e.stats.effects);
			e.stats.addEffects(nextTurnEffects);
			
			// récupère les items faisant des dégâts pour cet ennemi
			var itemLiberation = null;
			var hasJump = false;
			var itemsToTest = Item.getPriorityDangerItem(e, game.getMe());
			for(var item in e.items) {
				if(item.id == CHIP_LIBERATION and e.cooldowns[item.id] == 0) {
					itemLiberation = item;
				}
				if(item.id == CHIP_JUMP and e.cooldowns[item.id] == 0) {
					hasJump = true;
				}
			}
			
			var nbrItemToTest = (e instanceof Bulb) ? 1 : 12 / count(game.getEnemiesGroup().alive);
			var cellsAccessible = null;
			if (!hasJump)
				cellsAccessible = Map.getCellsAccessible(e.cell, e.stats.mp);
			else {
				nbrItemToTest -= e.stats.mp - 6;
				cellsAccessible = Map.getCellsAccessibleWithTeleportation(e.cell, e.stats.mp, Item.get(CHIP_JUMP));
			}
				
			this.dangerScoresPerEnemy[e.id] = [];
			var curDangerScores = this.dangerScoresPerEnemy[e.id];
			
			// damage items
			
			var testedItemsCount = 0;
			for(var itemPrioScore in itemsToTest) {
				var item = itemPrioScore.item;
				var prioScore = itemPrioScore.priorityScore;
				if (testedItemsCount > nbrItemToTest) {
					Debug.logC("Item non testé pour la map de dégats : " + item.name  + " avec un score de " + prioScore, getColor(150, 0, 0))
					continue;
				}
				if (e.cooldowns[item.id] != 0) continue;
				
				Debug.logC("Item testé pour la map de dégats : " + item.name + " avec un score de " + prioScore, getColor(200, 0, 200));
				
				
				var cellsCanHitEdge = [];
				if (item.getAreaSize() != 0) 
					cellsCanHitEdge = Map.getCellsMissingNeighborInArray(Map.getCellsCanUseItemFromCells([], cellsAccessible, item));
				
				var baseScoreValue = 0;
				for(var effect in item.effects) {
					var mult = 1;
					if (effect.type == EFFECT_DAMAGE)
						mult = EffectScoreMultiplier.damage;
					else if (effect.type == EFFECT_LIFE_DAMAGE)
						mult = EffectScoreMultiplier.lifeDamage;
					else if (effect.type == EFFECT_NOVA_DAMAGE)
						mult = EffectScoreMultiplier.novaDamage;
					else if (effect.type == EFFECT_POISON)
						mult = EffectScoreMultiplier.poison;
					else if (effect.type == EFFECT_VULNERABILITY)
						mult = EffectScoreMultiplier.relVulnerability;
					else if (effect.type == EFFECT_ABSOLUTE_VULNERABILITY)
						mult = EffectScoreMultiplier.absoVulnerability;

					var hitValue = 0;
					if (effect.canTarget(game.getMe(), e) and (ItemEffect.damageEffects[effect.type] or ItemEffect.vulnerabilityEffects[effect.type])) {
						hitValue = effect.getAppliedValue(game.getMe(), e, game.getMe().cell, 1);
					}
					baseScoreValue += (e.getStats().getTP() / item.cost) * hitValue * mult;
				}
				
				for (var cAccessible in cellsAccessible) {
					var cellsCanHit = Map.getCellsCanUseItem([], item, cAccessible.cell);
					var directHitScore = baseScoreValue * (1 - cAccessible.mp / 16);
					for(var c in cellsCanHit) {
						if (directHitScore > curDangerScores[c.id]) {
							curDangerScores[c.id] = directHitScore;
						}

						if (cellsCanHitEdge[c.id] != null) {
							for (var cEffective in item.getEffectiveArea(c, cAccessible.cell)) {
								var areaHitScore = directHitScore * item.getAoeMult(Cell.getDistance(c, cEffective));
								if (areaHitScore > curDangerScores[cEffective.id]) {
									curDangerScores[cEffective.id] = areaHitScore;
								}
							}
						}
					}
				}
				
				// on ne compte pas les items qui ne sont utilisé qu'au cac
				if (item.minRange != 1 or item.maxRange != 1) {
					testedItemsCount++;
				}
			}
			
			// libération
			var libeHit = [];
			if (itemLiberation != null) {
				for (var cAccessible in cellsAccessible) {
					var cellsCanHit = Map.getCellsCanUseItem([], itemLiberation, cAccessible.cell);
					for (var c in cellsCanHit) {
						if (libeHit[c.id] == null) {
							curDangerScores[c.id] += game.getMe().getScores().debuff * EffectScoreMultiplier.debuff * (1 - cAccessible.mp / 16);
							libeHit[c.id] = true;
						}
					}
				}
			}
		}
		
		this.calculateDangerScores();
	}
	public removeEnemyFromDangerScores(enemy) {
		removeKey(this.dangerScoresPerEnemy, enemy.id);		
	}
	public calculateDangerScores() {
		this.resetDangerScores();

		for (var eId : var enemyDangerScores in this.dangerScoresPerEnemy) {
			var enemy = Entity.get(eId);
			for (var cId : var score in enemyDangerScores) {
				var testedScore = score / enemy.scores.isolated;
				if (testedScore > this.dangerScores[cId])
					this.dangerScores[cId] = testedScore;
			}
		}
	}
	public resetDangerScores() {
		for (var c in Cell.getCells()) {
			this.dangerScores[c.id] = 0;
		}
	}
	public getDangerScores() {
		return this.dangerScores;
	}
	public resetDangerScoresPerEnemy() {
		this.dangerScoresPerEnemy = [];
	}
	
	public static los(cell1, cell2) {
		var p1 = {x: cell1.x, y: cell1.y};
		var p2 = {x: cell2.x, y: cell2.y};
		
		   
	}
	
	/**
	 * Récupère les cellules ayant au moins une cellule voisine manquante dans le tableau
	 * 
	 * @params cells : le tableau de cellule
	 * 
	 * @return tableau des cellules
	 **/
	public static getCellsMissingNeighborInArray(cells) {
		var resultCells = [];
		for (var cell in cells) {
			if (cell.N != null and cells[cell.N.id] == null) {
				resultCells[cell.id] = cell;
			} else if (cell.E != null and cells[cell.E.id] == null) {
				resultCells[cell.id] = cell;
			} else if (cell.S != null and cells[cell.S.id] == null) {
				resultCells[cell.id] = cell;
			} else if (cell.W != null and cells[cell.W.id] == null) {
				resultCells[cell.id] = cell;
			}
		}
		
		return resultCells;
	}
	
	/**
	 * Récupère les cellules accessible avec une téléportation
	 * 
	 * @params cell : la cellule initial
	 * @params mp : le nombre de mp
	 * 
	 * @return tableau des cellules accessibles
	 **/
	public static getCellsAccessibleWithTeleportation(cell, mp, item) {
		return Map.cellsAccessibleWithTeleportationMemo.apply(cell, mp, item);
	}
	
	/**
	 * Récupère les cellules accessible
	 * 
	 * @params cell : la cellule initial
	 * @params mp : le nombre de mp
	 * 
	 * @return tableau des cellules accessibles
	 **/
	public static getCellsAccessible(cell, mp) {
		return Map.cellsAccessibleMemo.apply(cell, mp);
	}
	
	/**
	 * Récupère les cellules accessible
	 * 
	 * @params cell : la cellule initial
	 * @params mp : le nombre de mp
	 * 
	 * @return tableau des cellules accessibles
	 **/
	public static getMyPathLength(cell, mp) {
		return Map.pathLegnthMemo.apply(cell, mp);
	}

	/**
	 * Initialise chaque cell avec ces 4 cells voisines
	 **/
	public static initNeighbors() {
		for(var id = 0; id <= Map.cellIdMax; id++) {
			var cell = Cell.get(id);
			var x = cell.X();
			var y = cell.Y();
			
			var n = getCellFromXY(x, y + 1);
			if(n != null)
				cell.N = Cell.get(n);
			var e = getCellFromXY(x - 1, y);
			if(e != null)
				cell.E = Cell.get(e);
			var s = getCellFromXY(x, y - 1);
			if(s != null)
				cell.S = Cell.get(s);
			var w = getCellFromXY(x + 1, y)
			if(w != null)
				cell.W = Cell.get(w);
		}
	}
	
	/**
	 * Récupère une ligne
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "E", "S", "W"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getLine(cells, cell, distMin, distMax, direction) {		
		var currentCell = cell;
		for(var i = 0; i <= distMax and currentCell != null; i++) {
			(!cells[currentCell.id] and i >= distMin and !currentCell.hasObstacle) 
			and
			(cells[currentCell.id] = currentCell);
			
			currentCell = currentCell[direction];
		}
		
		return cells;
	}
	
	/**
	 * Récupère une ligne
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "E", "S", "W"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getInvertLine(cells, cell, distMin, distMax, direction) {		
		var currentCell = cell;
		for(var i = 0; i <= distMax and currentCell != null and currentCell.walkable; i++) {
			(!cells[currentCell.id] and i >= distMin and currentCell.hasEntity) 
			and
			(cells[currentCell.id] = currentCell);
			
			currentCell = currentCell[direction];
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone en forme de +
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getPlusArea(cells, cell, distMin, distMax) {
		Map.getLine(cells, cell, distMin, distMax, "N");
		Map.getLine(cells, cell, distMin, distMax, "E");
		Map.getLine(cells, cell, distMin, distMax, "S");
		Map.getLine(cells, cell, distMin, distMax, "W");
		
		return cells;
	}
	
	/**
	 * Récupère une zone en forme de + pour les inversion
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getInvertPlusArea(cells, cell, distMin, distMax) {
		Map.getInvertLine(cells, cell, distMin, distMax, "N");
		Map.getInvertLine(cells, cell, distMin, distMax, "E");
		Map.getInvertLine(cells, cell, distMin, distMax, "S");
		Map.getInvertLine(cells, cell, distMin, distMax, "W");
		
		return cells;
	}
	
	/**
	 * Récupère une zone circulaire
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getArea(cells, cell, distMin, distMax) {
		if(cell == null) return cells;
		
		var currentCellE = cell;
		var currentCellW = cell;

		for (var i = 0; i <= distMax; i++) {
			var minj = (distMin - i);
			var maxj = (distMax - i);
			
			if (currentCellE != null) {
				Map.getLine(cells, currentCellE, minj, maxj, "N");
				Map.getLine(cells, currentCellE, minj, maxj, "S");
				currentCellE = currentCellE.E;
			}
			
			if (currentCellW != null) {
				Map.getLine(cells, currentCellW, minj, maxj, "N");
				Map.getLine(cells, currentCellW, minj, maxj, "S");
				currentCellW = currentCellW.W;
			}
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone circulaire avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getInvertArea(cells, cell, distMin, distMax) {
		if(cell == null) return cells;
		
		var currentCellE = cell;
		var currentCellW = cell;

		for (var i = 0; i <= distMax; i++) {
			var minj = (distMin - i);
			var maxj = (distMax - i);
			
			if (currentCellE != null) {
				Map.getInvertLine(cells, currentCellE, minj, maxj, "N");
				Map.getInvertLine(cells, currentCellE, minj, maxj, "S");
				currentCellE = currentCellE.E;
			}
			
			if (currentCellW != null) {
				Map.getInvertLine(cells, currentCellW, minj, maxj, "N");
				Map.getInvertLine(cells, currentCellW, minj, maxj, "S");
				currentCellW = currentCellW.W;
			}
		}
		
		return cells;
	}
	
	/**
	 * Récupère une ligne avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "E", "S", "W"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getLineLos(cells, cell, distMin, distMax, direction, initialCell) {
		if(cell == null) return cells;		
		
		var currentCell = cell;			
		for(var i = 0; i <= distMax and currentCell != null; i++) {
			if (!cells[currentCell.id] and i >= distMin and !currentCell.hasObstacle and lineOfSight(initialCell.id, currentCell.id)) {
				cells[currentCell.id] = currentCell;
			}
			currentCell = currentCell[direction];
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone en forme de + avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getPlusAreaLos(cells, cell, distMin, distMax) {
		Map.getLineLos(cells, cell, distMin, distMax, "N", cell);
		Map.getLineLos(cells, cell, distMin, distMax, "E", cell);
		Map.getLineLos(cells, cell, distMin, distMax, "S", cell);
		Map.getLineLos(cells, cell, distMin, distMax, "W", cell);
		
		return cells;
	}

	/**
	 * Récupère une ligne avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "E", "S", "W"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getDiagonalLos(cells, cell, distMin, distMax, direction, direction2, initialCell) {
		if(cell == null) return cells;		
		
		var currentCell = cell;			
		for(var i = 0; i <= distMax and currentCell != null; i+=2) {
			(!cells[currentCell.id] and i >= distMin and !currentCell.hasObstacle and lineOfSight(initialCell.id, currentCell.id))
			and
			(cells[currentCell.id] = currentCell);
			
			if (currentCell[direction] != null)
				currentCell = currentCell[direction][direction2];
			else if (currentCell[direction2] != null)
				currentCell = currentCell[direction2][direction];
			else currentCell = null;
		}
		
		return cells;
	}

	/**
	 * Récupère une ligne
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "E", "S", "W"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getDiagonal(cells, cell, distMin, distMax, direction, direction2) {
		var currentCell = cell;
		for(var i = 0; i <= distMax and currentCell != null; i+=2) {
			(!cells[currentCell.id] and i >= distMin and !currentCell.hasObstacle) 
			and
			(cells[currentCell.id] = currentCell);
			
			if (currentCell[direction] != null)
				currentCell = currentCell[direction][direction2];
			else if (currentCell[direction2] != null)
				currentCell = currentCell[direction2][direction];
			else currentCell = null;
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone circulaire avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getAreaLos(cells, cell, distMin, distMax) {
		if(cell == null) return cells;
		var currentCellE = cell;
		var currentCellW = cell;

		for (var i = 0; i <= distMax; i++) {
			var minj = (distMin - i);
			var maxj = (distMax - i);
			
			if(currentCellE != null) {
				Map.getLineLos(cells, currentCellE, minj, maxj, "N", cell);
				Map.getLineLos(cells, currentCellE, minj, maxj, "S", cell);
				currentCellE = currentCellE.E;
			}
			
			if(currentCellW != null) {
				Map.getLineLos(cells, currentCellW, minj, maxj, "N", cell);
				Map.getLineLos(cells, currentCellW, minj, maxj, "S", cell);
				currentCellW = currentCellW.W;
			}
		}
						
		return cells;
	}
	
	/**
	 * Récupère une zone diagonale avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getDiagonalAreaLos(cells, cell, distMin, distMax) {
		if(cell == null) return cells;
		
		var currentCell = cell;
		
		Map.getDiagonalLos(cells, currentCell, distMin, distMax, "N", "E", cell);
		Map.getDiagonalLos(cells, currentCell, distMin, distMax, "E", "S", cell);
		Map.getDiagonalLos(cells, currentCell, distMin, distMax, "S", "W", cell);
		Map.getDiagonalLos(cells, currentCell, distMin, distMax, "W", "N", cell);
		
		return cells;
	}

	/**
	 * Récupère une zone diagonale avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getDiagonalArea(cells, cell, distMin, distMax) {
		if(cell == null) return cells;
		
		var currentCell = cell;
		
		Map.getDiagonal(cells, currentCell, distMin, distMax, "N", "E");
		Map.getDiagonal(cells, currentCell, distMin, distMax, "E", "S");
		Map.getDiagonal(cells, currentCell, distMin, distMax, "S", "W");
		Map.getDiagonal(cells, currentCell, distMin, distMax, "W", "N");
						
		return cells;
	}

	/**
	 * Récupère une zone star avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getStarAreaLos(cells, cell, distMin, distMax) {
		if(cell == null) return cells;
		
		Map.getDiagonalAreaLos(cells, cell, distMin, distMax);
		Map.getPlusAreaLos(cells, cell, distMin, distMax);
						
		return cells;
	}

	/**
	 * Récupère une zone star avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static getStarArea(cells, cell, distMin, distMax) {
		if(cell == null) return cells;
		
		Map.getDiagonalArea(cells, cell, distMin, distMax);
		Map.getPlusArea(cells, cell, distMin, distMax);
						
		return cells;
	}
	
	public static getLineForLaser(cells, target, distMin, distMax, direction) {
		if(target == null) return cells;		
		
		var currentCell = target;
		var distMinTmp = distMin;
		for(var i = 0; i <= distMax and currentCell != null and !currentCell.hasObstacle; i++) {
			if(!cells[currentCell.id] and i >= distMinTmp and currentCell.walkable) {
				cells[currentCell.id] = currentCell;
			} else if(currentCell.hasEntityNotPlayer) {
				distMinTmp = i + distMin;
			}
			
			currentCell = currentCell[direction];
		}
		
		return cells;
	}
	
	public static getCellsToUseLaserOnCell(cells, target, item) {
		getLineForLaser(cells, target, item.minRange, item.maxRange, "N");
		getLineForLaser(cells, target, item.minRange, item.maxRange, "E");
		getLineForLaser(cells, target, item.minRange, item.maxRange, "S");
		getLineForLaser(cells, target, item.minRange, item.maxRange, "W");
		
		return cells;
	}
	
	public static getCellToHitLaser(item, cellTarget, cellFrom) {
		var dx = cellTarget.x - cellFrom.x;
		var dy = cellTarget.y - cellFrom.y;
		var direction = (dx != 0) ? ((dx > 0) ? "W" : "E") : ((dy > 0) ? "N" : "S");
		
		return getFirstCellToHitLaser(item, cellFrom, direction);
	}
	
	
	/**
	 * Récupère les cellules sur lesquelles on peut utiliser 'item' avec des déplacements
	 * 
	 * params
	 * cellsCanGo : les cellules accessibles par la lanceur
	 * item : l'item utilisé
	 * target : la cellule cible
	 * 
	 * return
	 * cells : tableau des cellules
	 **/
	public static getCellsCanUseItemFromCells(cells, cellsFrom, item) {
		
		for(var cAcc in cellsFrom) {
			Cell.add(cells, Map.getCellsCanUseItem(cells, item, cAcc.cell));
		}
		
		return cells;
	}
	
	/**
	 * params
	 * cellsCanGo : les cellules accessibles par la lanceur
	 * item : l'item utilisé
	 * target : la cellule cible
	 * 
	 * return
	 * cells : tableau des cellules
	 **/
	public static getCellsToUseItemOnCell(cellsCanGo, item, target) {
		var cellsCanUse = Map.getCellsCanUseItem([], item, target);
		return Cell.intersection(cellsCanUse, cellsCanGo);
	}
	
	/**
	 * Récupère les cellules sur lesquelles on peut utiliser 'item'
	 * 
	 * params
	 * cell : la cellule du lanceur
	 * item : l'item utilisé
	 * 
	 * return
	 * cells : tableau des cellules
	 **/
	public static getCellsCanUseItem(cells, item, target) {
		cells = Map.cellsCanUseItemMemo.apply(item, target);
		return cells;
	}
	
	/**
	 * Récupère la première cellule permettant d'utilier l'item sur la cellule target
	 * 
	 * params
	 * target : la cellule à viser
	 * item : l'item utilisé
	 * 
	 * return
	 *  : la cellule
	 **/
	public static getFirstCellToHitLaser(item, target, direction) {
		var currentCell = target;
		for(var i = 0; i <= item.maxRange and currentCell != null and !currentCell.hasObstacle; i++) {
			if(i >= item.minRange)
				return currentCell;
			currentCell = currentCell[direction];
		}
		
		return null;
	}
	
	
	public static getAreaLaserLine(cells, dist, cellTarget, cellFrom) {
		if(cellTarget == null) return cells;
		
		var dx = cellTarget.x - cellFrom.x;
		var dy = cellTarget.y - cellFrom.y;
		var direction = (dx != 0) ? ((dx > 0) ? "W" : "E") : ((dy > 0) ? "N" : "S");
		
		var currentCell = cellTarget;
		for(var i = 0; i <= dist and currentCell != null and !currentCell.hasObstacle; i++) {
			cells[currentCell.id] = currentCell;
			currentCell = currentCell[direction];
		}
		
		return cells;
	}
	
	public static getAreaFirstInLine(cells, dist, cellTarget, cellFrom) {
		if(cellTarget == null) return cells;
		
		var dx = cellTarget.x - cellFrom.x;
		var dy = cellTarget.y - cellFrom.y;
		var direction = (dx != 0) ? ((dx > 0) ? "W" : "E") : ((dy > 0) ? "N" : "S");
		
		var currentCell = cellTarget;
		for(var i = 0; i < dist and currentCell != null and currentCell.walkable; i++) {
			currentCell = currentCell[direction];
		}
		(currentCell.hasEntityNotPlayer) and (cells[currentCell.id] = currentCell);
		
		return cells;
	}
	
	public static getAreaSquare(cells, size, cellTarget) {
		if(cellTarget == null) return cells;
		
		var currentCellE = cellTarget;
		var currentCellW = cellTarget;
		cells[cellTarget.id] = cellTarget;
		Map.getLine(cells, currentCellE, 0, size, "N");
		Map.getLine(cells, currentCellE, 0, size, "S");
		for (var i = 0; i < size; i++) {
			if(currentCellE != null) {
				currentCellE = currentCellE.E;
				Map.getLine(cells, currentCellE, 0, size, "N");
				Map.getLine(cells, currentCellE, 0, size, "S");
			}
			
			if(currentCellW != null) {
				currentCellW = currentCellW.W;
				Map.getLine(cells, currentCellW, 0, size, "N");
				Map.getLine(cells, currentCellW, 0, size, "S");
			}
		}
		
		return cells;
	}
