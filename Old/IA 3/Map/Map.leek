	public constructor() {
	}
	
	private static cellsCanUseItemMemo = new Memoize2(function(item, target) {
			var cells = [];
			
			if(item.launchType == LAUNCH_TYPE_LINE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					Map.getInvertPlusArea(cells, target, item.minRange, item.maxRange);
				} else if (item.areaType == AREA_LASER_LINE) {
					Map.getCellsToUseLaserOnCell(cells, target, item)
				} else if(item.needLos)
					Map.getPlusAreaLos(cells, target, item.minRange, item.maxRange);
				else
					Map.getPlusArea(cells, target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_CIRCLE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					Map.getInvertArea(cells, target, item.minRange, item.maxRange);
				} else if(item.needLos)
					Map.getAreaLos(cells, target, item.minRange, item.maxRange);
				else
					Map.getArea(cells, target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_DIAGONAL) {
				if(item.needLos)
					Map.getDiagonalAreaLos(cells, target, item.minRange, item.maxRange);
				else
					Map.getDiagonalArea(cells, target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_STAR) {
				if(item.needLos)
					Map.getStarAreaLos(cells, target, item.minRange, item.maxRange);
				else
					Map.getStarArea(cells, target, item.minRange, item.maxRange);
			}

			return cells;
		}, function(item, target) {
			return target.id << 10 | item.id;
		}
	);
	public static resetCellsCanUseItemMemo() {
		Map.cellsCanUseItemMemo.reset();
	}
	
	private static cellsAccessibleWithTeleportationMemo = new Memoize3(function(cell, mp, item) {	
			var cellsAccessible = Map.getCellsAccessible(cell, mp);
		
			var cellsTeleportation = [];
			cellsTeleportation[cell.id] = {cell: cell, mp: 0, cellTeleportFrom: cell};
			for (var cAcc in cellsAccessible) {
				var cellsCanUse = Map.getCellsCanUseItem([], item, cAcc.cell);

				for(var cCanUse in cellsCanUse) {
					// si pas encore visitée ou que ça coûte moins de mp
					if ((cellsTeleportation[cCanUse.id] == null or cAcc.mp < cellsTeleportation[cCanUse.id].mp) and cCanUse.walkable) {
						cellsTeleportation[cCanUse.id] = {cell: cCanUse, mp: cAcc.mp, cellTeleportFrom: cAcc.cell}
					}
				}
			}
		
			cellsTeleportation = arraySort(cellsTeleportation, function(cObj1, cObj2) {
				return 	cObj1.mp - cObj2.mp;
			})
		
			var cellsToExpand = [];
			for (var cellObj in cellsTeleportation) {
				var c = cellObj.cell;
				var currentMP = cellObj.mp+1;
				
				if (currentMP > mp) continue;
				
				var n = c.N;
				if(n != null) { 
					if (cellsTeleportation[n.id] == null and n.walkable) {
						cellsTeleportation[n.id] = {cell: n, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
						cellsToExpand[n.id] = n;
					}
					else if (cellsTeleportation[n.id] != null and currentMP < cellsTeleportation[n.id].mp) {
						cellsTeleportation[n.id].mp = currentMP;
						cellsTeleportation[n.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
					}
				}

				var e = c.E;
				if(e != null) { 
					if (cellsTeleportation[e.id] == null and e.walkable) {
						cellsTeleportation[e.id] = {cell: e, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
						cellsToExpand[e.id] = e;
					}
					else if (cellsTeleportation[e.id] != null and currentMP < cellsTeleportation[e.id].mp) {
						cellsTeleportation[e.id].mp = currentMP;
						cellsTeleportation[e.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
					}
				}

				var s = c.S;
				if(s != null) { 
					if (cellsTeleportation[s.id] == null and s.walkable) {
						cellsTeleportation[s.id] = {cell: s, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
						cellsToExpand[s.id] = s;
					}
					else if (cellsTeleportation[s.id] != null and currentMP < cellsTeleportation[s.id].mp) {
						cellsTeleportation[s.id].mp = currentMP;
						cellsTeleportation[s.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
					}
				}

				var w = c.W;
				if(w != null) { 
					if (cellsTeleportation[w.id] == null and w.walkable) {
						cellsTeleportation[w.id] = {cell: w, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
						cellsToExpand[w.id] = w;
					}
					else if (cellsTeleportation[w.id] != null and currentMP < cellsTeleportation[w.id].mp) {
						cellsTeleportation[w.id].mp = currentMP;
						cellsTeleportation[w.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
					}
				}
			}
		
			while (count(cellsToExpand) != 0) {
				var clonedCellsToExpand = clone(cellsToExpand);
				cellsToExpand = [];
				for (var c in clonedCellsToExpand) {
					var currentMP = cellsTeleportation[c.id].mp + 1;
					
					if (currentMP > mp) continue;
					
					var n = c.N;
					if(n != null) { 
						if (cellsTeleportation[n.id] == null and n.walkable) {
							cellsTeleportation[n.id] = {cell: n, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
							cellsToExpand[n.id] = n;
						}
						else if (cellsTeleportation[n.id] != null and currentMP < cellsTeleportation[n.id].mp) {
							cellsTeleportation[n.id].mp = currentMP;
							cellsTeleportation[n.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
						}
					}

					var e = c.E;
					if(e != null) { 
						if (cellsTeleportation[e.id] == null and e.walkable) {
							cellsTeleportation[e.id] = {cell: e, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
							cellsToExpand[e.id] = e;
						}
						else if (cellsTeleportation[e.id] != null and currentMP < cellsTeleportation[e.id].mp) {
							cellsTeleportation[e.id].mp = currentMP;
							cellsTeleportation[e.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
						}
					}

					var s = c.S;
					if(s != null) { 
						if (cellsTeleportation[s.id] == null and s.walkable) {
							cellsTeleportation[s.id] = {cell: s, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
							cellsToExpand[s.id] = s;
						}
						else if (cellsTeleportation[s.id] != null and currentMP < cellsTeleportation[s.id].mp) {
							cellsTeleportation[s.id].mp = currentMP;
							cellsTeleportation[s.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
						}
					}

					var w = c.W;
					if(w != null) { 
						if (cellsTeleportation[w.id] == null and w.walkable) {
							cellsTeleportation[w.id] = {cell: w, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom}
							cellsToExpand[w.id] = w;
						}
						else if (cellsTeleportation[w.id] != null and currentMP < cellsTeleportation[w.id].mp) {
							cellsTeleportation[w.id].mp = currentMP;
							cellsTeleportation[w.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
						}
					}
				}
			}
		
			return cellsTeleportation;
		}, function(cell, mp, item) {
			return cell.id << 16 | mp << 10 | item.id;
		}
	);
	
	private static cellsAccessibleMemo = new Memoize2(function(cell, mp) {
			if(cell == null) return [];
		
			var cells = [];
			cells[cell.id] = {cell: cell, mp: 0};
			// les nouvelles cells de chaque mp
			var tmpCells = [];
			tmpCells[cell.id] = cell;
			for(var i = 0; i < mp; i++) {
				var iPlus = i+1;
				var tempCellsIte = clone(tmpCells);
				tmpCells = [];
				for(var c in tempCellsIte) {
					var n = c.N;
					if(n != null && !cells[n.id] and n.walkable) {
						cells[n.id] = {cell: n, mp: iPlus};
						tmpCells[n.id] = n;
					}

					var e = c.E;
					if(e != null && !cells[e.id] and e.walkable) {
						cells[e.id] = {cell: e, mp: iPlus};
						tmpCells[e.id] = e;
					}

					var s = c.S;
					if(s != null && !cells[s.id] and s.walkable) {
						cells[s.id] = {cell: s, mp: iPlus};
						tmpCells[s.id] = s;
					}

					var w = c.W;
					if(w != null && !cells[w.id] and w.walkable) {
						cells[w.id] = {cell: w, mp: iPlus};
						tmpCells[w.id] = w;
					}
				}
			}

			return cells;
		}, function(cell, mp) {
			return cell.id << 6 | mp;
		}
	);
	
	private static pathLegnthMemo = new Memoize2(function(cell, mp) {
			if(cell == null) return [];
		
			var cells = [];
			cells[cell.id] = {cell: cell, mp: 0};
			// les nouvelles cells de chaque mp
			var tmpCells = [];
			tmpCells[cell.id] = cell;
			for(var i = 0; i < mp; i++) {
				var iPlus = i+1;
				var tempCellsIte = clone(tmpCells);
				tmpCells = [];
				for(var c in tempCellsIte) {
					var n = c.N;
					if(n != null && !cells[n.id] && !n.hasObstacle) {
						cells[n.id] = {cell: n, mp: iPlus};
						tmpCells[n.id] = n;
					}

					var e = c.E;
					if(e != null && !cells[e.id] && !e.hasObstacle) {
						cells[e.id] = {cell: e, mp: iPlus};
						tmpCells[e.id] = e;
					}

					var s = c.S;
					if(s != null && !cells[s.id] && !s.hasObstacle) {
						cells[s.id] = {cell: s, mp: iPlus};
						tmpCells[s.id] = s;
					}

					var w = c.W;
					if(w != null && !cells[w.id] && !w.hasObstacle) {
						cells[w.id] = {cell: w, mp: iPlus};
						tmpCells[w.id] = w;
					}
				}
			}

			return cells;
		}, function(cell, mp) {
			return cell.id << 12 | mp;
		}
	);
	
	
	public static resetCellsAccessibleItemMemo() {
		Map.cellsAccessibleMemo.reset();
		Map.cellsAccessibleWithTeleportationMemo.reset();
		Map.pathLegnthMemo.reset();
	}
}