	public static markCells(cells, color) {
		var cellsId = [];
		for(var c in cells) {
			push(cellsId, c.id);
		} 
		mark(cellsId, color, 1);
	}
	public static markAccessibleCells(cells, color) {
		var cellsId = [];
		for(var cAcc in cells) {
			push(cellsId, cAcc.cell.id);
		} 
		mark(cellsId, color, 1);
	}
	
