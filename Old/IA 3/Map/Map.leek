			(cell != null and cell.hasEntity) and (push(targets, cell.entity));
			cell = cell.W;
			if (cell != null) {
				(cell.hasEntity) and (push(targets, cell.entity));
				cell = cell.E.N;
				(cell != null and cell.hasEntity) and (push(targets, cell.entity))
			} else {
				cell = cellTarget.N.W;
				(cell != null and cell.hasEntity) and (push(targets, cell.entity))
