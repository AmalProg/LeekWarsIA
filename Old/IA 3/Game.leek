include("Debug");
include("CellContent/EntitiesGroup");
include("CellContent/Leek");
include("Item/Chip");
include("Item/Weapon");
include("Effect/EffectScoreMultiplier");
include("Map/Map");

class Game {
	private entities; public getEntitiesGroup() {return this.entities;}
	private enemies; public getEnemiesGroup() {return this.enemies;}
	private allies; public getAlliesGroup() {return this.allies;}
	private me; public getMe() {return this.me;}
	private map; public getMap() {return this.map;}
	public leeksOrder = [];
	public alliesLeeksOrder = []; public getAlliesLeeksOrder() {return this.alliesLeeksOrder;}
	public enemiesLeeksOrder = []; public getEnemiesLeeksOrder() {return this.enemiesLeeksOrder;}
	public turnOrder = [];


	constructor() {
		// game initialisation
		this.map = new Map();
		Cell.initCells(); 
		Map.initObstacles();
		Map.initNeighbors();
		Map.initInaccessibleCells();
		Leek.initLeeks(getAllies() + getEnemies());
		Turret.initTurrets([getAlliedTurret()] + [getEnemyTurret()]);
	}

	public startTurn() {
		// seul les bulbs peuvent apparaitre au cours d'un combat
		Bulb.initBulbs(getAllies() + getEnemies());

		this.enemies = new EntitiesGroup(getEnemies());
		this.allies = new EntitiesGroup(getAllies());
		this.entities = new EntitiesGroup(getAllies() + getEnemies());
		var entityType = getType(getEntity());
		if (entityType == ENTITY_LEEK) {
			this.me = Leek.get(getEntity());
		} else if (entityType == ENTITY_BULB) {
			this.me = Bulb.get(getEntity());
		} else if (entityType == ENTITY_TURRET) {
			this.me = Turret.get(getEntity());
		}
		
		Item.initOnTeamItems();
		
		this.updateStats();
		
		this.me.contentType = -1;
		this.map.resetEntitiesPosition();
		this.map.setEntitiesPosition(this.entities);
		
		this.updateLeeksOrder();
		
		Map.resetCellsCanUseItemMemo();
		Map.resetCellsAccessibleItemMemo();
	}

	public endTurn() {
		this.me.contentType = CELL_ENTITY;
	}

	public updateStats() {
		Leek.updateLeeksStats();
		Bulb.updateBulbsStats();
		Turret.updateTurretsStats();
	}

	public updateEntities() {		
		this.enemies.update();
		this.allies.update();
		this.entities.update();
		
		this.map.resetEntitiesPosition();
		this.map.setEntitiesPosition(this.entities);
		
		this.updateLeeksOrder();
	}
	
	public applyItem(item, cellTarget, cellFrom) {
		var targets = [];
		if (cellTarget != null)
			targets = item.getItemTargets(cellTarget, cellFrom, this.me);
		
		this.me.applyItem(item);
		
		for (var target in targets) {
			target.applyItem(item, this.me, cellTarget, Cell.getDistance(target.cell, cellTarget));
		}
	}
	
	/**
	 * Met à jour l'ordre de jeu des entités par rapport à l'entité actuelle 
	 **/
	public updateLeeksOrder() {
		this.turnOrder = [];
		for(var e in this.entities.alive) {
			this.turnOrder[e.allTurnOrder] = e;
		}
		
		this.leeksOrder = [];
		for(var e in this.entities.aliveLeeks) {
			this.leeksOrder[e.leekTurnOrder] = e;
		}
		this.leeksOrder = arraySort(leeksOrder, function(id1, e1, id2, e2) {
			if(id1 < id2) {
				if(id1 < 0 and id2 < 0)
					return -1;
				else if(id1 < 0)
					return 1;
				else
					return -1;
			} else if(id1 > id2) {
				if(id1 < 0 and id2 < 0)
					return 1;
				else if(id2 < 0)
					return -1;
				else
					return 1;
			}
		}) 
		
		var tmpLeeksOrder = clone(leeksOrder);
		this.leeksOrder = [];
		this.alliesLeeksOrder = [];
		this.enemiesLeeksOrder = [];
		var i = 0;
		var a = 0;
		var e = 0;
		for(var entity in tmpLeeksOrder) {
			if (entity.isAnAlly) {
				this.alliesLeeksOrder[entity.id] = a;
				a++;
			} else {
				this.enemiesLeeksOrder[entity.id] = e;
				e++;
			}
			this.leeksOrder[entity.id] = i;
			entity.leekTurnOrder = i;
			i++;
		}
		
		arraySort(this.leeksOrder, function(t1, t2){
			return t1 - t2;
		});
		arraySort(this.alliesLeeksOrder, function(t1, t2){
			return t1 - t2;
		});
		arraySort(this.enemiesLeeksOrder, function(t1, t2){
			return t1 - t2;
		});
	}

	string() {
		return this;
	}
}