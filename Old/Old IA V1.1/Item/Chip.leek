include("../Debug");
include("Item");
include("../Effect/ItemEffect");

class Chip extends Item {
	constructor(id, caster) {
		Debug.debugCodePosition("Creating Chip object for id : " + id, COLOR_GREEN);

		super(id, caster);
		initStats();
	}

	private initStats() {
		this.name = getChipName(this.id);
		this.areaType = getChipArea(this.id);
		this.cost = getChipCost(this.id);
		this.baseCooldown = getChipCooldown(this.id);
		this.cooldown = 0;
		this.minRange = getChipMinRange(this.id);
		this.maxRange = getChipMaxRange(this.id);
		this.isInline = isInlineChip(this.id);
		this.needLos = chipNeedLos(this.id);
		for (var effect in getChipEffects(this.id)) {
			var eff = new ItemEffect(effect, caster, this);
			push(this.effects, eff);
			if(eff.type == EFFECT_DAMAGE or eff.type == EFFECT_POISON)
				push(this.effectsDamage, eff);
		}
	}
	
	// met à jour le cd de la puce pour ce tour
	public updateCooldown() {
		this.cooldown = getCooldown(this.id, this.caster);
	}
	
	public use(cell) {
		var result = useChipOnCell(this.id, cell.id);
		if(result == USE_SUCCESS or result == USE_CRITICAL) {
			this.caster.tp -= this.cost;
			this.cooldown = this.baseCooldown;
		}
		
		return result;
	}
}