	public static getTargetsLaserLine(targets, dist, cellTarget, cellFrom) {
		if(cellTarget == null) return;
		
		var dx = cellTarget.x - cellFrom.x;
		var dy = cellTarget.y - cellFrom.y;
		var direction = (dx != 0) ? ((dx > 0) ? "W" : "E") : ((dy > 0) ? "N" : "S");
		
		var currentCell = cellTarget;
		for(var i = 0; i <= dist and currentCell != null and !currentCell.hasObstacle; i++) {
			(currentCell.hasEntity) and (push(targets, currentCell.entity));
			currentCell = currentCell[direction];
		}
		
		return targets;
	}
	
	public static getTargetsFirstInLine(targets, dist, cellTarget, cellFrom) {
		if(cellTarget == null) return;
		
		var dx = cellTarget.x - cellFrom.x;
		var dy = cellTarget.y - cellFrom.y;
		var direction = (dx != 0) ? ((dx > 0) ? "W" : "E") : ((dy > 0) ? "N" : "S");
		
		var currentCell = cellTarget;
		for(var i = 0; i < dist and currentCell != null and currentCell.walkable; i++) {
			currentCell = currentCell[direction];
		}
		(currentCell != null and currentCell.hasEntity) and (push(targets, currentCell));
		
		return targets;
	}
	
