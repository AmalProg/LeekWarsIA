include("../Debug")
include("../CellContent/Entity");

class Cell { 
	/** entities pool **/
	public static cells = [];
	public static cellsXY = [];
	public static initCells() {
		Cell.voidCell.N = Cell.voidCell;
		Cell.voidCell.E = Cell.voidCell;
		Cell.voidCell.S = Cell.voidCell;
		Cell.voidCell.W = Cell.voidCell;	
		
		for (var x = -17; x <= 17; x++) {
			Cell.cellsXY[x] = [];
			var absX = abs(x);
			for (var y = -17; y <= 17; y++) {
				if (absX + abs(y) <= 17) {
					Cell.cellsXY[x][y] = new Cell(x, y);
					Cell.cells[getCellFromXY(x, y)] = Cell.cellsXY[x][y];
				} else {
					var newCell = new Cell(x, y);
					Cell.fakeCells[newCell.id] = newCell;
				}
			}
		}
	}
	
	public static voidCell = new Cell(99999);
	public static fakeCells = [];
	public static getFakeCell(x, y) {
		if (x > 17 or x < -17 or y > 17 or y < -17)
			return Cell.voidCell;

		var id = 10000 + x * 100 + y;
		if (Cell.fakeCells[id] == null) {
			Cell.fakeCells[id] = new Cell(id);
		}
		return Cell.fakeCells[id];
	}

	public static get(id) {
		return Cell.cells[id];
	}
	public static getByXY(x, y) {
		return Cell.cellsXY[x][y];
	}
	public static getCells() {
		return Cell.cells;
	}
	/** fin entities pool **/

	public N = null;
	public E = null;
	public S = null;
	public W = null;

	public id;
	public y;
	public x;
	public content = null;
	public type = CELL_EMPTY;
	public walkable = true;
	public hasObstacle = false;
	public hasEntity = false;
	public hasEntityNotPlayer = false;
	public isFake = false;
	
	/**
	 * @param cells : tableau de cellules
	 * @param cells2 : tableau de cellules
	 * 
	 * @return tableau des cellules présentent dans les deux tableaux d'entrée
	 **/
	public static intersection(cells, cells2) {
		var newCells = [];
		for(var id : var c in cells) {
			if(cells2[id] != null) {
				newCells[id] = c;
			}
		}
		
		return newCells;
	}
	
	/**
	 * @param cells : tableau de cellules
	 * @param cells2 : tableau de cellules
	 * 
	 * @return tableau des cellules présentent dans les deux tableaux d'entrée
	 **/
	public static accessibleIntersection(cells, cells2) {
		var newCells = [];
		for(var id : var cAcc in cells) {
			if(cells2[id] != null) {
				if (cells2[id].mp < cAcc.mp) {
					newCells[id] = cells2[id];
				} else {
					newCells[id] = cAcc;
				}
			}
		}
		
		return newCells;
	}
	
	/**
	 * @params cells : tableau de cellules
	 * @params cells2 : tableau des cellules à ajouter
	 * 
	 * @return tableau des cellules après ajout
	 **/
	public static add(cells, cells2) {
		for(var id : var c in cells2) {
			cells[id] = c;
		}
		
		return cells;
	}
	
	/**
	 * @params cells : tableau de cellules accessibles
	 * @params cells2 : tableau des cellules accessibles à ajouter
	 * 
	 * @return tableau des cellules après ajout
	 **/
	public static accessibleAdd(cells, cells2) {
		for(var id : var cAcc in cells2) {
			if(cells[id] == null) {
				// on prend la cellule qui demande le moins de mp
				if (cells2[id].mp < cAcc.mp) {
					cells[id] = cells2[id];
				} else {
					cells[id] = cAcc;
				}
			}
		}
		
		return cells;
	}
	
	/**
	 * @params cells : tableau de cellules
	 * 
	 * @return id de la cellule étant les barycentre de 'cells'
	 **/
	public static getBarycenter(cells) {
		var nbrCells = count(cells);
		if (nbrCells == 0) return null;
		
		var x = 0, y = 0;
		for(var cell in cells){
			x += cell.x;
			y += cell.y;
		}

		return Cell.get(getCellFromXY(x / nbrCells, y / nbrCells));
	}
	
	/**
	 * @params c1 : cellule
	 * @params c2 : cellule
	 * 
	 * @return true si les deux cellules sont sur la même ligne
	 **/
	public static sameLine(c1, c2) {
		return c1.x === c2.x || c1.y === c2.y;
	}
	
	/**
	 * @params c1 : cellule
	 * @params c2 : cellule
	 * 
	 * @return la distance entre les deux cellules à vole d'oiseau
	 **/
	public static getDistance(c1, c2) {
		var distX = c1.x - c2.x;
		var distY = c1.y - c2.y;
		return (distX >= 0 ? distX : -distX) + (distY >= 0 ? distY : -distY);
	}
	
	constructor(id) {
		this.id = id;
		
		if (id >= 0 and id <= 612) {
			this.x = getCellX(id);
			this.y = getCellY(id);
		} else {
			this.type = CELL_OBSTACLE;
			this.hasObstacle = true;
			this.hasEntity = false;
			this.hasEntityNotPlayer = false;
			this.walkable = false;
			this.isFake = true;
			this.N = Cell.voidCell;
			this.E = Cell.voidCell;
			this.S = Cell.voidCell;
			this.W = Cell.voidCell;	
		}
	}
	constructor(x, y) {	
		this.x = x;
		this.y = y;
		
		if (abs(x) + abs(y) <= 17) {
			// if is a real cell
			this.id = getCellFromXY(x, y);
		} else {
			this.id = 10000 + x * 100 + y;
			this.type = CELL_OBSTACLE;
			this.hasObstacle = true;
			this.hasEntity = false;
			this.hasEntityNotPlayer = false;
			this.walkable = false;
			this.isFake = true;
			this.N = Cell.voidCell;
			this.E = Cell.voidCell;
			this.S = Cell.voidCell;
			this.W = Cell.voidCell;
		}
	}
	
	/**
	 * @param content : le contenu à mettre sur la cell
	 **/
	public setContent(content) {
		this.content = content;

		if (content != null) {
			this.type = content.contentType;
			this.hasObstacle = this.type == CELL_OBSTACLE;
			this.hasEntity = this.type == CELL_ENTITY || this.type == -1;
			this.hasEntityNotPlayer = this.type == CELL_ENTITY;
			this.walkable = this.type != CELL_OBSTACLE and this.type != CELL_ENTITY;
		} else {
			this.type = CELL_EMPTY;
			this.hasObstacle = false;
			this.hasEntity = false;
			this.hasEntityNotPlayer = false;
			this.walkable = true;
		}
	}
	public getContent() {
		return this.content;
	}
	public getContentType() {
		return (this.content != null) ? this.content.contentType : CELL_EMPTY;
	}
	
	
	string() {
		return "{ id :" + this.id + " }";
	}
}