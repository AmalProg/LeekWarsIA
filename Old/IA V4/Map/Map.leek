			}
		
			return cellsInvertion;
		}, function(cell, mp, item) {
			return cell.id << 16 | mp << 10 | item.id;
		}
	);
	
	private static cellsAccessibleMemo = new Memoize2(function(cell, mp) {
			if(cell == null) return [];
		
			var cells = [];
			cells[cell.id] = {cell: cell, mp: 0};
			// les nouvelles cells de chaque mp
			var tmpCells = [];
			tmpCells[0] = [];
			tmpCells[0][cell.id] = cell;
			for(var i = 0; i < mp; i++) {
				if (tmpCells[i] == []) break;
				
				var iPlus = i+1;
				tmpCells[iPlus] = [];
				for(var c in tmpCells[i]) {
					var n = c.N;
					var nId = n.id;
					if(!cells[nId] and n.walkable) {
						cells[nId] = {cell: n, mp: iPlus};
						tmpCells[iPlus][nId] = n;
					}

					var e = c.E;
					var eId = e.id;
					if(!cells[eId] and e.walkable) {
						cells[eId] = {cell: e, mp: iPlus};
						tmpCells[iPlus][eId] = e;
					}

					var s = c.S;
					var sId = s.id;
					if(!cells[sId] and s.walkable) {
						cells[sId] = {cell: s, mp: iPlus};
						tmpCells[iPlus][sId] = s;
					}

					var w = c.W;
					var wId = w.id;
					if(!cells[w.id] and w.walkable) {						
						cells[wId] = {cell: w, mp: iPlus};
						tmpCells[iPlus][wId] = w;
					}
				}
			}

			return cells;
		}, function(cell, mp) {
			return cell.id << 6 | mp;
		}
	);
	
	private static pathLegnthMemo = new Memoize2(function(cell, mp) {
			if(cell == null) return [];
		
			var cells = [];
			cells[cell.id] = {cell: cell, mp: 0};
			// les nouvelles cells de chaque mp
			var tmpCells = [];
			tmpCells[0] = [];
			tmpCells[0][cell.id] = cell;
			for(var i = 0; i < mp; i++) {
				if (tmpCells[i] == []) break;
				
				var iPlus = i+1;
				tmpCells[iPlus] = [];
				for(var c in tmpCells[i]) {
					var n = c.N;
					var nId = n.id;
					if(!cells[nId] && !n.hasObstacle) {
						cells[nId] = {cell: n, mp: iPlus};
						tmpCells[iPlus][nId] = n;
					}

					var e = c.E;
					var eId = e.id;
					if(!cells[eId] && !e.hasObstacle) {
						cells[eId] = {cell: e, mp: iPlus};
						tmpCells[iPlus][eId] = e;
					}

					var s = c.S;
					var sId = s.id;
					if(!cells[sId] && !s.hasObstacle) {
						cells[sId] = {cell: s, mp: iPlus};
						tmpCells[iPlus][sId] = s;
					}

					var w = c.W;
					var wId = w.id;
					if(!cells[wId] && !w.hasObstacle) {
						cells[wId] = {cell: w, mp: iPlus};
						tmpCells[iPlus][wId] = w;
					}
				}
			}

			return cells;
		}, function(cell, mp) {
			return cell.id << 12 | mp;
		}
	);
	
	
	public static resetCellsAccessibleMemo() {
		Map.cellsAccessibleMemo.reset();
		Map.cellsAccessibleWithTeleportationMemo.reset();
	}
}