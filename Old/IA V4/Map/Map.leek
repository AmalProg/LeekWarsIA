	private static cellsCanUseItemMemo = new Memoize2(function(item, target) {
			var cells = [];
			
			if(item.launchType == LAUNCH_TYPE_LINE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					if (item.needLos) {
						cells = Map.getInvertPlusAreaLos(target, item.minRange, item.maxRange);
					} else {
						cells = Map.getInvertPlusArea(target, item.minRange, item.maxRange);
					}
				} else if (item.areaType == AREA_LASER_LINE) {
					cells = Map.getCellsToUseLaserOnCell(cells, target, item)
				} else if(item.needLos)
					cells = Map.getPlusAreaLos(target, item.minRange, item.maxRange);
				else
					cells = Map.getPlusArea(target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_CIRCLE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					if (item.needLos) {
						cells = Map.getInvertAreaLos(target, item.minRange, item.maxRange);
					} else {
						cells = Map.getInvertArea(target, item.minRange, item.maxRange);
					}
				} else if(item.needLos)
					cells = Map.getAreaLos(target, item.minRange, item.maxRange);
				else 
					cells = Map.getArea(target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_DIAGONAL) {
				if(item.needLos)
					cells = Map.getDiagonalAreaLos(target, item.minRange, item.maxRange);
				else
					cells = Map.getDiagonalArea(target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_STAR) {
				if(item.needLos)
					cells = Map.getStarAreaLos(target, item.minRange, item.maxRange);
				else
					cells = Map.getStarArea(target, item.minRange, item.maxRange);
			}

			return cells;
		}, function(item, target) {
			return target.id << 10 | item.id;
		}
	);
	public static resetCellsCanUseItemMemo() {
		Map.cellsCanUseItemMemo.reset();
	}
	private static cellsCanUseItemIgnoreMemo = new Memoize3(function(item, target, ignoredEntities) {
			var cells = [];
			
			var ignoredEntitiesId = [];
			for (var entity in ignoredEntities) {
				entity.cell.setContent(null);
				push(ignoredEntitiesId, entity.id);
			}
			currentLoS = function(start, end) {
				return lineOfSight(start, end, ignoredEntitiesId);
			}

			if(item.launchType == LAUNCH_TYPE_LINE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					Map.getInvertPlusArea(target, item.minRange, item.maxRange);
				} else if (item.areaType == AREA_LASER_LINE) {
					Map.getCellsToUseLaserOnCell(cells, target, item)
				} else if(item.needLos)
					Map.getPlusAreaLos(target, item.minRange, item.maxRange);
				else
					Map.getPlusArea(target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_CIRCLE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					Map.getInvertArea(target, item.minRange, item.maxRange);
				} else if(item.needLos)
					Map.getAreaLos(target, item.minRange, item.maxRange);
				else
					Map.getArea(target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_DIAGONAL) {
				if(item.needLos)
					Map.getDiagonalAreaLos(target, item.minRange, item.maxRange);
				else
					Map.getDiagonalArea(target, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_STAR) {
				if(item.needLos)
					Map.getStarAreaLos(target, item.minRange, item.maxRange);
				else
					Map.getStarArea(target, item.minRange, item.maxRange);
			}

			currentLoS = lineOfSight;

			for (var entity in ignoredEntities) {
				entity.cell.setContent(entity);
			}

			return cells;
		}, function(item, target, ignoredEntities) {
			var ignoredEntitiesValue = 0;
			ignoredEntitiesValue += (count(ignoredEntities) + ignoredEntities[0].id) * 10;
			for (var entity in ignoredEntities) {
				ignoredEntitiesValue += entity.id;
			}
			return target.id << 20 | item.id << 10 | ignoredEntitiesValue;
		}
	);
	public static resetCellsCanUseItemIgnoreMemo() {
		Map.cellsCanUseItemMemo.reset();
	}
	
	private static cellsAccessibleWithTeleportationMemo = new Memoize3(function(cell, mp, item) {	
			var cellsAccessible = Map.getCellsAccessible(cell, mp);
		
			var cellsTeleportation = [];
			cellsTeleportation[cell.id] = {cell: cell, mp: 0, cellTeleportFrom: cell, cellTeleportTo: cell};
			for (var cAcc in cellsAccessible) {
				var cellsCanUse = Map.getCellsCanUseItem([], item, cAcc.cell);

				for(var cCanUseId : var cCanUse in cellsCanUse) {
					// si pas encore visitée ou que ça coûte moins de mp
					if ((cellsTeleportation[cCanUseId] == null or cAcc.mp < cellsTeleportation[cCanUseId].mp) and cCanUse.walkable) {
						cellsTeleportation[cCanUseId] = {cell: cCanUse, mp: cAcc.mp, cellTeleportFrom: cAcc.cell, cellTeleportTo: cCanUse}
					}
				}
			}
		
			cellsTeleportation = arraySort(cellsTeleportation, function(cObj1, cObj2) {
				return cObj1.mp - cObj2.mp;
			})
		
			var cellsToExpand = [];
			for (var cellObj in cellsTeleportation) {
				var c = cellObj.cell;
				var currentMP = cellObj.mp+1;
				
				if (currentMP > mp) continue;
				
				var n = c.N;
				if(n != null) { 
					if (cellsTeleportation[n.id] == null and n.walkable) {
						cellsTeleportation[n.id] = {cell: n, mp: currentMP, cellTeleportFrom: cellObj.cellTeleportFrom, cellTeleportTo: cellObj.cellTeleportTo}
						cellsToExpand[n.id] = n;
					}
					else if (cellsTeleportation[n.id] != null and currentMP < cellsTeleportation[n.id].mp) {
						cellsTeleportation[n.id].mp = currentMP;
						cellsTeleportation[n.id].cellTeleportFrom = cellObj.cellTeleportFrom;
						cellsTeleportation[n.id].cellTeleportTo = cellObj.cellTeleportTo;
					}
				}

				var e = c.E;
				if(e != null) { 
					if (cellsTeleportation[e.id] == null and e.walkable) {
						cellsTeleportation[e.id] = {cell: e, mp: currentMP, cellTeleportFrom: cellObj.cellTeleportFrom, cellTeleportTo: cellObj.cellTeleportTo}
						cellsToExpand[e.id] = e;
					}
					else if (cellsTeleportation[e.id] != null and currentMP < cellsTeleportation[e.id].mp) {
						cellsTeleportation[e.id].mp = currentMP;
						cellsTeleportation[e.id].cellTeleportFrom = cellObj.cellTeleportFrom;
						cellsTeleportation[e.id].cellTeleportTo = cellObj.cellTeleportTo;
					}
				}

				var s = c.S;
				if(s != null) { 
					if (cellsTeleportation[s.id] == null and s.walkable) {
						cellsTeleportation[s.id] = {cell: s, mp: currentMP, cellTeleportFrom: cellObj.cellTeleportFrom, cellTeleportTo: cellObj.cellTeleportTo}
						cellsToExpand[s.id] = s;
					}
					else if (cellsTeleportation[s.id] != null and currentMP < cellsTeleportation[s.id].mp) {
						cellsTeleportation[s.id].mp = currentMP;
						cellsTeleportation[s.id].cellTeleportFrom = cellObj.cellTeleportFrom;
						cellsTeleportation[s.id].cellTeleportTo = cellObj.cellTeleportTo;
					}
				}

				var w = c.W;
				if(w != null) { 
					if (cellsTeleportation[w.id] == null and w.walkable) {
						cellsTeleportation[w.id] = {cell: w, mp: currentMP, cellTeleportFrom: cellObj.cellTeleportFrom, cellTeleportTo: cellObj.cellTeleportTo}
						cellsToExpand[w.id] = w;
					}
					else if (cellsTeleportation[w.id] != null and currentMP < cellsTeleportation[w.id].mp) {
						cellsTeleportation[w.id].mp = currentMP;
						cellsTeleportation[w.id].cellTeleportFrom = cellObj.cellTeleportFrom;
						cellsTeleportation[w.id].cellTeleportTo = cellObj.cellTeleportTo;
					}
				}
			}
		
			while (count(cellsToExpand) != 0) {
				var clonedCellsToExpand = clone(cellsToExpand);
				cellsToExpand = [];
				for (var c in clonedCellsToExpand) {
					var currentMP = cellsTeleportation[c.id].mp + 1;
					
					if (currentMP > mp) continue;
					
					var n = c.N;
					if(n != null) { 
						if (cellsTeleportation[n.id] == null and n.walkable) {
							cellsTeleportation[n.id] = {cell: n, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom, cellTeleportTo: cellsTeleportation[c.id].cellTeleportTo}
							cellsToExpand[n.id] = n;
						}
						else if (cellsTeleportation[n.id] != null and currentMP < cellsTeleportation[n.id].mp) {
							cellsTeleportation[n.id].mp = currentMP;
							cellsTeleportation[n.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
							cellsTeleportation[n.id].cellTeleportTo = cellsTeleportation[c.id].cellTeleportTo;
						}
					}

					var e = c.E;
					if(e != null) { 
						if (cellsTeleportation[e.id] == null and e.walkable) {
							cellsTeleportation[e.id] = {cell: e, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom, cellTeleportTo: cellsTeleportation[c.id].cellTeleportTo}
							cellsToExpand[e.id] = e;
						}
						else if (cellsTeleportation[e.id] != null and currentMP < cellsTeleportation[e.id].mp) {
							cellsTeleportation[e.id].mp = currentMP;
							cellsTeleportation[e.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
							cellsTeleportation[e.id].cellTeleportTo = cellsTeleportation[c.id].cellTeleportTo;
						}
					}

					var s = c.S;
					if(s != null) { 
						if (cellsTeleportation[s.id] == null and s.walkable) {
							cellsTeleportation[s.id] = {cell: s, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom, cellTeleportTo: cellsTeleportation[c.id].cellTeleportTo}
							cellsToExpand[s.id] = s;
						}
						else if (cellsTeleportation[s.id] != null and currentMP < cellsTeleportation[s.id].mp) {
							cellsTeleportation[s.id].mp = currentMP;
							cellsTeleportation[s.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
							cellsTeleportation[s.id].cellTeleportTo = cellsTeleportation[c.id].cellTeleportTo;
						}
					}

					var w = c.W;
					if(w != null) { 
						if (cellsTeleportation[w.id] == null and w.walkable) {
							cellsTeleportation[w.id] = {cell: w, mp: currentMP, cellTeleportFrom: cellsTeleportation[c.id].cellTeleportFrom, cellTeleportTo: cellsTeleportation[c.id].cellTeleportTo}
							cellsToExpand[w.id] = w;
						}
						else if (cellsTeleportation[w.id] != null and currentMP < cellsTeleportation[w.id].mp) {
							cellsTeleportation[w.id].mp = currentMP;
							cellsTeleportation[w.id].cellTeleportFrom = cellsTeleportation[c.id].cellTeleportFrom;
							cellsTeleportation[w.id].cellTeleportTo = cellsTeleportation[c.id].cellTeleportTo;
						}
					}
				}
			}
		
			return cellsTeleportation;
		}, function(cell, mp, item) {
			return cell.id << 16 | mp << 10 | item.id;
		}
	);
	
	private static cellsAccessibleWithInvertionMemo = new Memoize3(function(cell, mp, item) {	
			var cellsAccessible = Map.getCellsAccessible(cell, mp);
		
			var cellsInvertion = [];
			cellsInvertion[cell.id] = {cell: cell, mp: 0, cellTeleportFrom: cell};
			for (var cAcc in cellsAccessible) {
