				cellsToExpand = [];
				for (var c in clonedCellsToExpand) {
					var currentMP = cellsInvertion[c.id].mp + 1;
					
					if (currentMP > mp) continue;
					
					var n = c.N;
					if(n != null) { 
						if (cellsInvertion[n.id] == null and n.walkable) {
							cellsInvertion[n.id] = {cell: n, mp: currentMP, cellTeleportFrom: cellsInvertion[c.id].cellTeleportFrom}
							cellsToExpand[n.id] = n;
						}
						else if (cellsInvertion[n.id] != null and currentMP < cellsInvertion[n.id].mp) {
							cellsInvertion[n.id].mp = currentMP;
							cellsInvertion[n.id].cellTeleportFrom = cellsInvertion[c.id].cellTeleportFrom;
						}
					}

					var e = c.E;
					if(e != null) { 
						if (cellsInvertion[e.id] == null and e.walkable) {
							cellsInvertion[e.id] = {cell: e, mp: currentMP, cellTeleportFrom: cellsInvertion[c.id].cellTeleportFrom}
							cellsToExpand[e.id] = e;
						}
						else if (cellsInvertion[e.id] != null and currentMP < cellsInvertion[e.id].mp) {
							cellsInvertion[e.id].mp = currentMP;
							cellsInvertion[e.id].cellTeleportFrom = cellsInvertion[c.id].cellTeleportFrom;
						}
					}

					var s = c.S;
					if(s != null) { 
						if (cellsInvertion[s.id] == null and s.walkable) {
							cellsInvertion[s.id] = {cell: s, mp: currentMP, cellTeleportFrom: cellsInvertion[c.id].cellTeleportFrom}
