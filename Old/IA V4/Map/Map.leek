					if (cellsInvertion[w.id] == null and w.walkable) {
						cellsInvertion[w.id] = {cell: w, mp: currentMP, cellTeleportFrom: cellsInvertion[c.id].cellTeleportFrom}
						cellsToExpand[w.id] = w;
					}
					else if (cellsInvertion[w.id] != null and currentMP < cellsInvertion[w.id].mp) {
						cellsInvertion[w.id].mp = currentMP;
						cellsInvertion[w.id].cellTeleportFrom = cellsInvertion[c.id].cellTeleportFrom;
