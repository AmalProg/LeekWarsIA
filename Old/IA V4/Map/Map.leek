				for(var cCanUse in cellsCanUse) {
					// si pas encore visitée ou que ça coûte moins de mp
					if ((cellsInvertion[cCanUse.id] == null or cAcc.mp < cellsInvertion[cCanUse.id].mp) and cCanUse.walkable) {
						cellsInvertion[cCanUse.id] = {cell: cCanUse, mp: cAcc.mp, cellTeleportFrom: cAcc.cell}
					}
				}
			}
		
			cellsInvertion = arraySort(cellsInvertion, function(cObj1, cObj2) {
				return 	cObj1.mp - cObj2.mp;
			})
		
			var cellsToExpand = [];
