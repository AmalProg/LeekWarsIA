		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cellTarget.E.E;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cell.S;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cellTarget.E.E.E;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		
		
		cell = cellTarget.S;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cell.W;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cell.W;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cellTarget.S.S;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cell.W;
		(!cell.hasObstacle) and (cells[cell.id] = cell)	
		cell = cellTarget.S.S.S;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		
		cell = cellTarget.W;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cell.N;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cell.N;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cellTarget.W.W;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cell.N;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		cell = cellTarget.W.W.W;
		(!cell.hasObstacle) and (cells[cell.id] = cell)
		
		return cells;
	}
	
	public static markCells(cells, color) {
		var cellsId = [];
		for(var c in cells) {
			push(cellsId, c.id);
		} 
		mark(cellsId, color, 1);
	}
	public static markAccessibleCells(cells, color) {
		var cellsId = [];
		for(var cAcc in cells) {
			push(cellsId, cAcc.cell.id);
		} 
		mark(cellsId, color, 1);
	}
	
