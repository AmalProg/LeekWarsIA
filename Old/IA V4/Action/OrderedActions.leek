include("../Item/ItemEffect");

class OrderedActions {
	private orderedActions;
	private summonActions;

	constructor() {
		this.orderedActions = [];
		this.summonActions = [];
	}

	public getOrderedActions() {
		return this.orderedActions;
	}
	public getSummonActions() {
		return this.summonActions;
	}

	public order(actions, caster, endTurnScores) {
		var selfCastActions = [];
		var otherActions = [];
		 
		for (var action in actions) {
			// cas d'un summon
			if (action.getCellToUse() == null) {
				push(this.summonActions, action);
				continue;
			} else if (action.getCellTarget() == null) {
				push(otherActions, action);
				continue;
			}
			
			var targets = action.getItem().getItemTargets(action.getCellTarget(), action.getCellToUse(), caster);
			
			// si c'est un self cast
			if (action.getCellToUse().id == action.getCellTarget().id and ((count(targets) == 1 and targets[caster.id] != null) or (count(targets) == 0))) {
				action.setCellTarget(null);
				action.setCellToUse(null);
				push(selfCastActions, action);
			} else {
				push(otherActions, action);
			}
		}
		
		selfCastActions = arraySort(selfCastActions, function(action1, action2) {
			var score1 = getSelfActionOrderScore(action1);
			var score2 = getSelfActionOrderScore(action2);
			
			return score1 - score2;
		});
		
		var othersGoodActionCombo = [];
		if (!caster.isASummon) {
			var oepjfcs = getOperations();
			var goodActionsCombo = [];
			var otherActionsCount = count(otherActions);
			var maxActionToAdd = 13 - otherActionsCount * 2;
			for (var id : var action in otherActions) {
				if (id == 0) {
					for (var otherGoodAction in action.otherGoodActions) {
						push(goodActionsCombo, [otherGoodAction]);
					}
				} else {
					var tmp = clone(goodActionsCombo);
					goodActionsCombo = [];
					for (var goodActionCombo in tmp) {
						var i = 0;
						for (var otherGoodAction in action.otherGoodActions) {
							if (i > maxActionToAdd) break;
							push(goodActionsCombo, goodActionCombo + otherGoodAction);
							i++;
						}
					}
				}
			}

			// on prend 500 actionsCombo s'il y en a trop
			var goodActionsComboCount = count(goodActionsCombo);
			if (goodActionsComboCount > 500) {
				goodActionsCombo = arrayFilter(goodActionsCombo, function(value) {
					return rand() < (500 / goodActionsComboCount);
				})
				debug("filtering goodActionsCombo :" + (getOperations() - oepjfcs) + " count : " + count(goodActionsCombo))
			}

			for (var goodActionCombo in goodActionsCombo) {
				goodActionCombo = arraySort(goodActionCombo, function(action1, action2) {
					var cellToUse1 = action1.cellToUse;
					var cellToUseId1 = -1;
					if (cellToUse1 != null)
						cellToUseId1 = cellToUse1.id;
					var cellToUse2 = action2.cellToUse;
					var cellToUseId2 = -1;
					if (cellToUse2 != null)
						cellToUseId2 = cellToUse2.id;

					var itemToTeleport1 = action1.itemToTeleport;
					var itemToTeleport2 = action2.itemToTeleport;

					var score1 = getActionOrderScore(action1);
					var score2 = getActionOrderScore(action2);

					if (score1 <= score2 and itemToTeleport2 != null and itemToTeleport1 == null) {
						/*action1.itemToTeleport = itemToTeleport2;
						action2.itemToTeleport = null;*/
						return -1;
					} else if (score2 <= score1 and itemToTeleport1 != null and itemToTeleport2 == null) {
						/*action2.itemToTeleport = itemToTeleport1;
						action1.itemToTeleport = null;*/
						return 1;
					} else if (score2 == score1) {
						if (itemToTeleport1 != null)
							return -1;
						else if (itemToTeleport2 != null)
							return 1;
						else 
							return 0
					} else if (score1 < score2)
						return -1;
					return 1;
				});
				
				var itemsToTeleport = []
				for (var action in goodActionCombo) {
					if (action.itemToTeleport != null)
						push(itemsToTeleport, action.itemToTeleport);
				}
				
				var beforeEffectInvertPos = [];
				var casterCell = caster.cell;
				var casterMP = caster.stats.mp;
				for (var action in goodActionCombo) {
					var item = action.item;
					var cellTarget = action.cellTarget;
					var cellToUse = action.cellToUse;
					var itemToTeleport = shift(itemsToTeleport);

					if (itemToTeleport == null) {
						var cellsAccessible = Map.getCellsAccessible(casterCell, casterMP);
						
						if (cellsAccessible[cellToUse.id] != null) {
							casterCell = cellsAccessible[cellToUse.id].cell;
							casterMP -= cellsAccessible[cellToUse.id].mp;
						} else {
							casterCell = null;	
						}
					} else {
						var cellsAccessibleWithTPFromThere = Map.getCellsAccessibleWithTeleportation(casterCell, casterMP, itemToTeleport);
						
						if (cellsAccessibleWithTPFromThere[cellToUse.id] != null) {
							casterCell = cellsAccessibleWithTPFromThere[cellToUse.id].cell;
							casterMP -= cellsAccessibleWithTPFromThere[cellToUse.id].mp;
						} else {
							casterCell = null;	
						}
					}
					
					if (casterCell == null) break;
					
					if (item.hasEffectType(EFFECT_INVERT)) {
						if (cellTarget.content != null) {
							//push(beforeEffectInvertPos, {caster: caster, target: cellTarget.content});
							//Entity.invert(cellTarget.content, caster);
						
							var currentActionPassed = false;
							for (var action2 in goodActionCombo) {
								if (action.id == action2.id) {
									currentActionPassed = true;
									continue;
								}
								if (!currentActionPassed) continue;

								if (action2.cellTarget.id == cellTarget.id) {
									action2.cellToUse = cellTarget;
									action2.cellTarget = cellToUse;
								}
							}
							casterCell = cellTarget;
						}
					}
				}
				if (casterCell != null) {
					push(othersGoodActionCombo, {actionCombo: goodActionCombo, endCell: casterCell, endMP: casterMP, lowestScore: 9999999});
				}
				
				/*var el = null
				while((el = pop(beforeEffectInvertPos)) != null) {
					debug(el)
					Entity.invert(el.target, el.caster);
				}*/
			}
			
			Debug.log("goodActionsCombo :" + count(othersGoodActionCombo))
		}
		
		if (othersGoodActionCombo == []) {
			otherActions = arraySort(otherActions, function(action1, action2) {
				var cellToUse1 = action1.cellToUse;
				var cellToUseId1 = -1;
				if (cellToUse1 != null)
					cellToUseId1 = cellToUse1.id;
				var cellToUse2 = action2.cellToUse;
				var cellToUseId2 = -1;
				if (cellToUse2 != null)
					cellToUseId2 = cellToUse2.id;

				if (cellToUseId1 == cellToUseId2) {
					var itemToTeleport1 = action1.itemToTeleport;
					var itemToTeleport2 = action2.itemToTeleport;

					var score1 = getActionOrderScore(action1);
					var score2 = getActionOrderScore(action2);

					if (score1 <= score2 and itemToTeleport2 != null and itemToTeleport1 == null) {
						action1.itemToTeleport = itemToTeleport2;
						action2.itemToTeleport = null;
						return -1;
					} else if (score2 <= score1 and itemToTeleport1 != null and itemToTeleport2 == null) {
						action2.itemToTeleport = itemToTeleport1;
						action1.itemToTeleport = null;
						return 1;
					} else if (score2 == score1) {
						if (itemToTeleport1 != null)
							return -1;
						else if (itemToTeleport2 != null)
							return 1;
						else 
							return 0
					} else if (score1 < score2) 
						return -1;
					return 1;
				}
				if (action1.id < action2.id) 
					return -1;
				return 1;
			});
			
			this.orderedActions = selfCastActions + otherActions;
		} else {
			this.orderedActions = selfCastActions;
			
			arrayIter(othersGoodActionCombo, function(actionComboObj) {
				var cellsAccessible = Map.getCellsAccessible(actionComboObj.endCell, actionComboObj.endMP);
				for (var cAcc in cellsAccessible) {
					var c = cAcc.cell;
					if (actionComboObj.lowestScore > endTurnScores[c.id])
						actionComboObj.lowestScore = endTurnScores[c.id];
				}
			})
				
			othersGoodActionCombo = arraySort(othersGoodActionCombo, function(actionComboObj1, actionComboObj2) {
				var lowestScore1 = actionComboObj1.lowestScore;
				var lowestScore2 = actionComboObj2.lowestScore;
				if (lowestScore1 == lowestScore2) return 0;
				return lowestScore1 - lowestScore2;
			})
			
			for (var actionComboObj in othersGoodActionCombo) {		
				var itemsToTeleport = []
				for (var action in actionComboObj.actionCombo) {
					if (action.itemToTeleport != null)
						push(itemsToTeleport, action.itemToTeleport);
				}
				
				for (var action in actionComboObj.actionCombo) {
					action.itemToTeleport = shift(itemsToTeleport);
					debug(action)
					this.orderedActions += [action];
				}
				break;	
			}
		}
	}

	private getSelfActionOrderScore(action) {
		var score = 0;
		for (var effect in action.item.effects) {
			 if (effect.type == EFFECT_DEBUFF) {
				score += 0;
			 } else if(effect.type == EFFECT_BUFF_AGILITY or effect.type == EFFECT_RAW_BUFF_AGILITY) {
				score += 1;
			} else if(ItemEffect.buffEffects[effect.type] or ItemEffect.rawBuffEffects[effect.type]) {
				score += 2;
			} else if(ItemEffect.maxLifeEffects[effect.type]) {
				score += 4;
			} else if(ItemEffect.healEffects[effect.type] or ItemEffect.shieldEffects[effect.type] or ItemEffect.dmgReturnEffects[effect.type]) {
				score += 5;
			} else if(effect.type == EFFECT_ANTIDOTE or effect.type == EFFECT_REMOVE_SHACKLES) {
				score += 6;
			} else if(effect.type == EFFECT_SUMMON) {
				score += 8;
			} else {
				score += 7;
			}
		}
		
		return score / count(action.item.effects);
	}

	private getActionOrderScore(action) {
		var score = 0;
		if (action.item == null)
			debug(action)
		for (var effect in action.item.effects) {
			if (effect.type == EFFECT_DEBUFF) {
				score += 0;
			} else if (ItemEffect.buffEffects[effect.type]) {
				score += 1;	
			} else if (ItemEffect.vulnerabilityEffects[effect.type]) {
				score += 2;
			} else if(effect.type == EFFECT_NOVA_DAMAGE) {
				score += 5;
			} else { 
				score += 4;
			}
		}
		
		return score / count(action.item.effects);
	}
}