include("Debug");
include("CellContent/EntitiesGroup");
include("CellContent/Team");
include("CellContent/Leek");
include("Item/Chip");
include("Item/Weapon");
include("Effect/EffectScoreMultiplier");
include("Map/Map");

class Game {
	public myTeam;
	public otherTeams = [];
	public teams = [];
	public entities;
	public me;
	public map;

	constructor() {
		// game initialisation
		Debug.startOpCount();
		this.map = new Map();
		Cell.initCells(); 
		Map.initObstacles();
		Map.initNeighbors();
		Map.initInaccessibleCells();
		Map.initBlockableCells();
		Map.initEnclosedCells();
		
		var entitiesId = getAllies() + getEnemies();
		Leek.initLeeks(entitiesId);
		Bulb.initBulbs(entitiesId);
		Turret.initTurrets([getAlliedTurret()] + [getEnemyTurret()]);
		Debug.stopOpCount("infos : ");

		this.entities = Team.get(-1);
		
		for (var entityId in getEnemies()) {
			var entity = Entity.get(entityId);
			var team = Team.get(entity.teamId);
			team.add(entity);
			entities.add(entity);
			otherTeams[team.id] = team;
			teams[team.id] = team;
		}
		
		var entityType = getType(getEntity());
		if (entityType == ENTITY_LEEK) {
			this.me = Leek.get(getEntity());
		} else if (entityType == ENTITY_BULB) {
			this.me = Bulb.get(getEntity());
		} else if (entityType == ENTITY_TURRET) {
			this.me = Turret.get(getEntity());
		}
		// pour dire qu'on est le joueur actif
		this.me.contentType = -1;
		myTeam = Team.get(this.me.teamId);
		myTeam.add(this.me);
		teams[myTeam.id] = myTeam;
		entities.add(this.me);
		
		EffectScoreMultiplier.init(this.me.level);
		EntityStatsDiviser.init(myTeam.leeks);
	}

	public startSimulationTurn() {
		var entitiesId = getAllies() + getEnemies();
		// seul les bulbs peuvent apparaitre au cours d'un combat
		Bulb.initBulbs(entitiesId);
		Item.initOnTeamItems();
		
		this.updateEntitiesStats();
		
		var entityType = getType(getEntity());
		if (entityType == ENTITY_LEEK) {
			this.me = Leek.get(getEntity());
		} else if (entityType == ENTITY_BULB) {
			this.me = Bulb.get(getEntity());
		} else if (entityType == ENTITY_TURRET) {
			this.me = Turret.get(getEntity());
		}
		// pour dire qu'on est le joueur actif
		this.me.contentType = -1;
		
		for (var entityId in entitiesId) {
			var entity = Entity.get(entityId);
			var team = Team.get(entity.teamId);
			team.add(entity);
			this.entities.add(entity);
		}
		
		this.updateLeeksOrder();
		
		for (var team in this.teams) {
			team.update();
			team.initScoreVals();
			team.initItemsEffects();
		}
		this.entities.update();
		
		this.map.resetEntitiesPosition();
		this.map.setEntitiesPosition(this.entities);
		
		Map.resetCellsCanUseItemMemo();
		Map.resetCellsCanUseItemIgnoreMemo();
		Map.resetCellsAccessibleMemo();
	}
	
	public startTurn() {
		var entitiesId = getAllies() + getEnemies();
		// seul les bulbs peuvent apparaitre au cours d'un combat
		Bulb.initBulbs(entitiesId);
		Item.initOnTeamItems();
		
		this.updateEntitiesStats();
		
		var entityType = getType(getEntity());
		if (entityType == ENTITY_LEEK) {
			this.me = Leek.get(getEntity());
		} else if (entityType == ENTITY_BULB) {
			this.me = Bulb.get(getEntity());
		} else if (entityType == ENTITY_TURRET) {
			this.me = Turret.get(getEntity());
		}
		// pour dire qu'on est le joueur actif
		this.me.contentType = -1;
		
		for (var entityId in entitiesId) {
			var entity = Entity.get(entityId);
			var team = Team.get(entity.teamId);
			team.add(entity);
			this.entities.add(entity);
		}
		
		this.updateLeeksOrder();
		
		for (var team in this.teams) {
			team.update();
		}
		this.entities.update();
		
		this.map.resetEntitiesPosition();
		this.map.setEntitiesPosition(this.entities);
		
		Map.resetCellsCanUseItemMemo();
		Map.resetCellsCanUseItemIgnoreMemo();
		Map.resetCellsAccessibleMemo();
	}

	public endTurn() {
		// on est plus le joueur actif
		this.me.contentType = CELL_ENTITY;
	}

	public updateEntitiesStats() {
		Leek.updateLeeksStats();
		Bulb.updateBulbsStats();
		Turret.updateTurretsStats();
	}

	public updateEntities() {
		this.updateLeeksOrder();
		
		for (var team in this.teams) {
			team.update();
		}
		
		this.map.resetEntitiesPosition();
		this.map.setEntitiesPosition(this.entities);
	}
	
	public applyItem(item, cellTarget, cellFrom) {
		var targets = [];
		if (cellTarget != null)
			targets = item.getItemTargets(cellTarget, cellFrom, this.me);
		
		this.me.simulateItemUse(item);
		
		for (var target in targets) {
			target.applyItem(item, this.me, cellTarget, Cell.getDistance(target.cell, cellTarget));
		}
	}
	
	/**
	 * Met à jour l'ordre de jeu des entités par rapport à l'entité actuelle 
	 **/
	public updateLeeksOrder() {
		var leeksOrder = [];
		for(var e in this.entities.alive) {
			leeksOrder[e.turnOrder] = e;
		}
		leeksOrder = arraySort(leeksOrder, function(id1, e1, id2, e2) {
			if(id1 < id2) {
				if(id1 < 0 and id2 < 0)
					return -1;
				else if(id1 < 0)
					return 1;
				else
					return -1;
			} else if(id1 > id2) {
				if(id1 < 0 and id2 < 0)
					return 1;
				else if(id2 < 0)
					return -1;
				else
					return 1;
			}
		}) 
		
		var i = 0;
		for(var entity in leeksOrder) {
			entity.turnOrder = i;
			i++;
		}
	}
}