	public static getPriorityDangerItem(caster, target) {
		var items = [];
		for (var item in caster.items) {
			var priorityScore = 0;
			
			for (var effect in item.effects) {
				var mult = 1;
				if (effect.type == EFFECT_DAMAGE)
					mult = EffectScoreMultiplier.damage * target.scores.damage;
				else if (effect.type == EFFECT_LIFE_DAMAGE)
					mult = EffectScoreMultiplier.lifeDamage * caster.stats.life / 500 * target.scores.damage;
				else if (effect.type == EFFECT_NOVA_DAMAGE)
					mult = EffectScoreMultiplier.novaDamage * caster.stats.scienceMult * target.scores.novaDamage;
				else if (effect.type == EFFECT_POISON)
					mult = EffectScoreMultiplier.poison * caster.stats.magicMult * target.scores.poison;
				else if (effect.type == EFFECT_VULNERABILITY)
					mult = EffectScoreMultiplier.relVulnerability * 2 * target.scores.relVulnerability;
				else if (effect.type == EFFECT_ABSOLUTE_VULNERABILITY)
					mult = EffectScoreMultiplier.absoVulnerability * 2 * target.scores.absoVulnerability;
				
				if (effect.canTarget(target, caster) and (ItemEffect.damageEffects[effect.type] or ItemEffect.vulnerabilityEffects[effect.type])) {
					priorityScore += effect.meanValue * (effect.turns != 0 ? effect.turns : 1) / item.cost * mult;
					priorityScore += (item.maxRange - item.minRange) * 5;
				}
			}

			if (priorityScore != 0)
				items[item.id] = {item: item, priorityScore: priorityScore};
		}
		items = arraySort(items, function(itemPriorityScore1, itemPriorityScore2) {
			return itemPriorityScore2.priorityScore - itemPriorityScore1.priorityScore;
		})
		
		return items;
	}
	
	public static getItemEffectiveArea(item, cell, from) {
		return Item.effectiveAreaMemo.apply(item, cell, from);
	}

	private static effectiveAreaMemo = new Memoize3(function(item, cell, from) {
			var cells = [];
			if (item.areaType == AREA_POINT) {
				cells[cell.id] = cell;
				return cells;
			} else if (item.areaType == AREA_FIRST_INLINE) {
				return Map.getAreaFirstInLine(cells, item.maxRange - item.minRange, cell, from);
			} else if (item.areaType == AREA_LASER_LINE) {
				return 	Map.getAreaLaserLine(cells, item.minRange, item.maxRange, cell, from);
			} else if (item.areaType == AREA_CIRCLE_1) {
				return 	Map.getAreaCircle1(cells, cell);
			} else if (item.areaType == AREA_CIRCLE_2) {
				return 	Map.getAreaCircle2(cells, cell);
			} else if (item.areaType == AREA_CIRCLE_3) {
				return 	Map.getAreaCircle3(cells, cell);
			} else if (item.areaType == AREA_PLUS_1) {
				return 	Map.getAreaPlus1(cells, cell);
			} else if (item.areaType == AREA_PLUS_2) {
				return 	Map.getAreaPlus2(cells, cell);
			} else if (item.areaType == AREA_PLUS_3) {
				return 	Map.getAreaPlus3(cells, cell);
			} else if (item.areaType == AREA_SQUARE_1) {
				return 	Map.getAreaSquare1(cells, cell);
			} else if (item.areaType == AREA_SQUARE_2) {
				return 	Map.getAreaSquare2(cells, cell);
			} else if (item.areaType == AREA_X_1) {
				return 	Map.getAreaCross1(cells, cell);
			} else if (item.areaType == AREA_X_2) {
				return 	Map.getAreaCross2(cells, cell);
			} else if (item.areaType == AREA_X_3) {
				return 	Map.getAreaCross3(cells, cell);
			}
		}, function(item, cell, from) {
			return (from ? from.id : 614) << 18 | cell.id << 8 | item.areaType;
	});
	
