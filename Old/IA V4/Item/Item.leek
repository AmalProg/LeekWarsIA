	public id;
	public name;
	public areaType;
	public cost;
	public baseCooldown;
	public minRange;
	public maxRange;
	public launchType;
	public needLos;
	public effects = [];
	public effectsDamage = [];
	public effectsTypeList = [];
	
	constructor(id) {
		this.id = id;
	}
	
	public getEffectiveArea(cell, from) {
		return Item.effectiveAreaMemo.apply(this, cell, from);
	}
	
	public getItemTargets(cell, from, caster) {
		var targets = [];
		
		for (var cId : var c in getEffectiveArea(cell, from)) {
			if (c.hasEntity and c.content.alive() and this.canTarget(c.content, caster)) {
				targets[c.content.id] = c.content;
			};
		}
		return targets;
	}

	public canTarget(target, caster) {
		for (var effect in this.effects) {
			if (effect.canTarget(target, caster))
				return true;
		}
		return false;
	}
	
	public hasEffectType(effectType) {
		return this.effectsTypeList[effectType];
	}
	
	public getAoeMult(dist) {
		var areaType = this.areaType;
		if (areaType == AREA_LASER_LINE or areaType == AREA_FIRST_INLINE or areaType == AREA_POINT) {
			return 1;
		} else {
			return 1 - dist * 0.2;	
		}
	}
	
	public getAreaSize() {
		if (this.areaType == AREA_CIRCLE_1) { 
			return 1;
		} else if (this.areaType == AREA_CIRCLE_2) {
			return 2;
		} else if (this.areaType == AREA_CIRCLE_3) {
			return 3;
		} else if (this.areaType == AREA_PLUS_1) {
			return 1;
		} else if (this.areaType == AREA_PLUS_2) {
			return 2;
		} else if (this.areaType == AREA_PLUS_3) {
			return 3;
		} else if (this.areaType == AREA_SQUARE_1) {
			return 2;
		} else if (this.areaType == AREA_SQUARE_2) {
			return 4;
		} else if (this.areaType == AREA_X_1) {
			return 2;
		} else if (this.areaType == AREA_X_2) {
			return 4;
		} else if (this.areaType == AREA_X_3) {
			return 6;
		} else if (this.areaType == AREA_POINT) {
			return 0;
		} else if (this.areaType == AREA_FIRST_INLINE) {
			return 0;
		} else if (this.areaType == AREA_LASER_LINE) {
			return 0;
		}
	}
	
	public use(cell) {}

	public apply(cell) {}
	
	public getDangerScore(target, caster, aoeDist, mpNotUsedPercent) {
		var dangerScoreValue = 0;
		var aoeMult = this.getAoeMult(aoeDist);
		if (this.areaType == AREA_LASER_LINE) 
			aoeMult = 1;
		
		for(var effect in this.effects) {
			if (!effect.canTarget(target, caster)) continue;
			
			var effectValue = effect.getAppliedValue(target, caster, target.cell, aoeMult);
			
			if(effect.type == EFFECT_DAMAGE) {
				dangerScoreValue += effectValue * target.scores.damage * EffectScoreMultiplier.damage;
			} else if(effect.type == EFFECT_POISON) {
				dangerScoreValue += effectValue * (1 + effect.turns / 6) * target.scores.poison * EffectScoreMultiplier.poison;
			} else if(effect.type == EFFECT_LIFE_DAMAGE) {
				dangerScoreValue += effectValue * target.scores.lifeDamage * EffectScoreMultiplier.lifeDamage;
			} else if(effect.type == EFFECT_NOVA_DAMAGE) {
				dangerScoreValue += effectValue * target.scores.novaDamage * EffectScoreMultiplier.novaDamage;
			} else if(effect.type == EFFECT_HEAL) {

			} else if(effect.type == EFFECT_RAW_HEAL) {

			} else if(effect.type == EFFECT_NOVA_VITALITY) {

			} else if(effect.type == EFFECT_BOOST_MAX_LIFE) {

			} else if(effect.type == EFFECT_BUFF_AGILITY) {

			} else if(effect.type == EFFECT_BUFF_RESISTANCE) {

			} else if(effect.type == EFFECT_BUFF_WISDOM) {

			} else if(effect.type == EFFECT_BUFF_MP) {

			} else if(effect.type == EFFECT_BUFF_TP) {

			} else if(effect.type == EFFECT_BUFF_STRENGTH) {

			} else if(effect.type == EFFECT_RAW_BUFF_AGILITY) {

			} else if(effect.type == EFFECT_RAW_BUFF_RESISTANCE) {

			} else if(effect.type == EFFECT_RAW_BUFF_WISDOM) {

			} else if(effect.type == EFFECT_RAW_BUFF_MP) {

			} else if(effect.type == EFFECT_RAW_BUFF_TP) {

			} else if(effect.type == EFFECT_RAW_BUFF_STRENGTH) {

			} else if(effect.type == EFFECT_RAW_BUFF_MAGIC) {

			} else if(effect.type == EFFECT_SHACKLE_AGILITY) {

			} else if(effect.type == EFFECT_SHACKLE_WISDOM) {

			} else if(effect.type == EFFECT_SHACKLE_MP) {

			} else if(effect.type == EFFECT_SHACKLE_TP) {

			} else if(effect.type == EFFECT_SHACKLE_STRENGTH) {

			} else if(effect.type == EFFECT_SHACKLE_MAGIC) {

			} else if(effect.type == EFFECT_ABSOLUTE_SHIELD) {

			} else if(effect.type == EFFECT_RELATIVE_SHIELD) {

			} else if(effect.type == EFFECT_ABSOLUTE_VULNERABILITY) {
				dangerScoreValue += effectValue * target.scores.absoVulnerability * EffectScoreMultiplier.absoVulnerability;
			} else if(effect.type == EFFECT_VULNERABILITY) {
				dangerScoreValue += effectValue * target.scores.relVulnerability * EffectScoreMultiplier.relVulnerability;
			} else if(effect.type == EFFECT_STEAL_ABSOLUTE_SHIELD) {
				dangerScoreValue += effectValue * target.scores.stealAbso * EffectScoreMultiplier.stealAbso;
			} else if(effect.type == EFFECT_DAMAGE_RETURN) {

			} else if(effect.type == EFFECT_AFTEREFFECT) {

			} else if(effect.type == EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD) {

			} else if(effect.type == EFFECT_DAMAGE_TO_STRENGTH) {

			} else if(effect.type == EFFECT_POISON_TO_SCIENCE) {

			} else if(effect.type == EFFECT_NOVA_DAMAGE_TO_MAGIC) {

			} else if(effect.type == EFFECT_PROPAGATION) {

			} else if(effect.type == EFFECT_MOVED_TO_MP) {
				
			} else if(effect.type == EFFECT_DEBUFF) {
				dangerScoreValue += target.scores.debuff;
			} else if(effect.type == EFFECT_PUSH) {
				dangerScoreValue += target.scores._push;
			} else if(effect.type == EFFECT_ATTRACT) {
				dangerScoreValue += target.scores.attract;
			}
		}
		
		return dangerScoreValue * (mpNotUsedPercent < 0.5 ? 1 + (0.5 - mpNotUsedPercent) * 0.5 : 1) * floor(caster.stats.tp / this.cost);
	}

	string() {
		return " { name : " + this.name + " } ";	
	}
}