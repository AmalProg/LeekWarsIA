include("Item");
include("../Entities/Entity");
include("../Actions/ActionsManager");

class Combo {
	private Array<Item> _orderedItems; public Array<Item> getOrderedItems() { return this._orderedItems; }
	private integer _cost; public integer getCost() { return this._cost; }
	private boolean _hasWeapon;
	
	constructor() {
		this._cost = 0;
		this._hasWeapon = false;
		this._orderedItems = [];
	}
	constructor(Set<Item> items) {
		this._cost = 0;
		this._hasWeapon = false;
		this._orderedItems = [];
		for (Item item in items)
			this.addItem(item);
	}
	private Combo clone() {
		Combo newCombo = new Combo();
		newCombo._cost = this._cost;
		newCombo._hasWeapon = this._hasWeapon;
		newCombo._orderedItems = clone(this._orderedItems) as Array<Item>;
		
		return newCombo;
	}
	
	public void updateCost(AbstractEntity caster) {
		this._cost = 0;
		integer? curWeaponId = null;
		if (caster instanceof Leek) {
			curWeaponId = (caster as Leek).getEquippedWeaponId();	
		}
		for (Item item in this._orderedItems) {
			this._cost += item.getCost();
			if (item instanceof Weapon) {
				// s'il y a déjà une arme dans ce combo et que ce n'est pas la même
				if (curWeaponId != item.getId()) {
					this._cost++;
					curWeaponId = item.getId();
				}
			}
		}
	}
	
	public boolean canAddItem(Item item, integer tpMax) {
		return this._cost + item.getCost() <= tpMax;
	}
	public void addItem(Item item) {
		this._cost += item.getCost();
		if (item instanceof Weapon) {
			// s'il y a déjà une arme dans ce combo et que ce n'est pas la même
			if (this._hasWeapon && !inArray(this._orderedItems, item))
				this._cost++;
			else
				this._hasWeapon	= true;
		}
		
		push(this._orderedItems, item);
		this._orderedItems = arraySort(this._orderedItems, function(Item i1, Item i2) => integer {
			return ActionsManager.compareItemOrder(i1, i2);
		}) as Array<Item>;
	}
	
	public boolean canKill(AbstractEntity target, AbstractEntity caster, Map<Item, integer> aoePerItem = [:]) {
		EntityStats clonedStats = new EntityStats();
		clonedStats.copy(target.getStats());
		for (Item item in this._orderedItems) {
			for (Effect eff in item.getEffects()) {
				if (eff.getType() == EFFECT_INVERT) continue;
				
				eff.applyTo(null, null, target, caster, clonedStats, caster.getStats(), mapGet(aoePerItem, item, 0) as integer, false);
				if (clonedStats.getLife() <= 0)
					return true;
			}
		}

		return false;
	}
	
	public static Set<Combo> generateCombos(Set<Item> items, integer tpMax) {	
		Set<Combo> allCombos = <>;
		Combo.recursiveGenerateCombos(allCombos, new Combo(<>), clone(items) as Set<Item>, tpMax);
		return allCombos;
	}
	private static Set<Combo> recursiveGenerateCombos(Set<Combo> allCombos, Combo combo, Set<Item> itemsCanUse, integer tpMax) {
		Set<Item> itemsToTest = clone(itemsCanUse) as Set<Item>;
		for (Item item in itemsCanUse) {
			if (combo.canAddItem(item, tpMax)) {
				Combo newCombo = combo.clone();
				newCombo.addItem(item);
				setPut(allCombos, newCombo);
				
				Set<Item> newItemsCanUse = clone(itemsToTest) as Set<Item>;
				if (item.getBaseCooldown() != 0)
					setRemove(newItemsCanUse, item);
				Combo.recursiveGenerateCombos(allCombos, newCombo, newItemsCanUse, tpMax);
				
				setRemove(itemsToTest, item);
			}
			
		}
	}
}