include("Item");

class Weapon extends Item {
	/** weapon pool **/
	private static Map<integer, Weapon> weapons = [:];
	public static Weapon get(integer id) {
		if (Weapon.weapons[id] != null)
			return Weapon.weapons[id]!;
		
		Weapon weapon = new Weapon(id);
		Weapon.weapons[id] = weapon;
		Item.items[id] = weapon;
		return weapon;
	}
	/** fin weapon pool **/
	
	constructor(integer id) {
		super(id);
		
		initStats();
	}

	public initStats() {
		this.name = getWeaponName(this.id);
		this.areaType = getWeaponArea(this.id)!;
		this.cost = getWeaponCost(this.id);
		this.baseCooldown = 0;
		this.minRange = getWeaponMinRange(this.id);
		this.maxRange = getWeaponMaxRange(this.id);
		this.launchType = getWeaponLaunchType(this.id)!;
		this.needLos = weaponNeedLos(this.id);
		for (Array<any> effectArray in getWeaponEffects(this.id)!) {
			Effect? eff = Effect.createEffect(effectArray, this);
			if (eff != null) {
				push(this._effects, eff!);
				setPut(this._effectsTypeList, eff!.getType());
			}
		}
		
		this.initTeamTargetsBool();
	}
	
	protected Set<Cell> getItemEffectiveArea(Cell cell, Cell? from) {
		Set<Cell> cells = <>;
		integer? fromId = null;
		if (from != null) fromId = from!.id;
		for (integer cId in getWeaponEffectiveArea(this.id, cell.id, fromId)!) {
			setPut(cells, CellMap.getCell(cId));
		}
		return cells;
	}
	
	public boolean canUseItemOnCell(Cell cell) {
		return canUseWeaponOnCell(this.id, cell.id);
	}

	public integer use(Cell cell) {
		if (getWeapon() != this.id) {
			setWeapon(this.id);
		}		
		return useWeaponOnCell(cell.id);
	}
}