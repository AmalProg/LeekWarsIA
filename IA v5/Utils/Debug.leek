global integer COLOR_BLACK = getColor(255, 255, 255);

class Debug {
	public static boolean enabledLog = false;
	public static boolean enabledWarning = true;
	public static boolean enabledInfo = false;
	public static boolean enabledError = true;
	public static boolean enabledOp = false;
	private static integer op;

	private constructor() {}
	
	public static void log(any object, integer color = COLOR_BLACK) {
		if (enabledLog) {
			debugC(object, color);
		}
	}

	public static void error(any object) {
		if (enabledError) {
			debugE(object);
		}
	}
	
	public static void info(any object) {
		if (enabledInfo) {
			debugC(object, getColor(219, 81, 212));
		}
	}

	public static void warning(any object) {
		if (enabledWarning) {
			debugW(object);
		}
	}
	
	public static void startOpCount() {
		Debug.op = getOperations();
	}
	
	public static void stopOpCount(string preText = "") {
		if (enabledOp) {
			debugC(preText + (getOperations() - Debug.op), getColor(235, 65, 25));
		}
	}
}