include("Effect");

class PushEffect extends Effect {
	private constructor(Array<any> effectArray, Item item) {
		setPut(_triggerableEffects, EFFECT_MOVED_TO_MP);
		
		super(effectArray, item);
	}
	
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, EntityStats casterStats, Cell? cellTarget) {
		affectedEntity.pushTo(cellTarget!);
		
		this.tryTriggerPassive(affectedEntity, caster, affectedEntityStats, casterStats, 1);
	}
	
}