include("PassiveEffect");

class DamageToAbsoluteShieldEffect extends PassiveEffect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, boolean isSelfCast, Cell cellTarget) {
		integer finalValue = round(value * this._triggerValue / 100);
		affectedEntityStats.addEffect(EntityStats.addAbsoStatic, EFFECT_RAW_ABSOLUTE_SHIELD, finalValue, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	
	}
	
		protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
				
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value * this._triggerValue / 100);
		return targetScores.getAbsoScore(finalValue, targetStats.getAbso()) * targetAllyMult;
	}
}