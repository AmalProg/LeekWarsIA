include("Effect");

class DamageEffect extends Effect {
	private constructor(Array<any> effectArray, Item item) {
		setPut(this._triggerableEffects, EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD);
		setPut(this._triggerableEffects, EFFECT_DAMAGE_TO_STRENGTH);
		
		super(effectArray, item);
	}
	
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		real baseDmg = value * casterStats.getStrengthMult() * casterStats.getPowerMult();
		integer dmgReturn = round(baseDmg * affectedEntityStats.getDmgReturn() / 100);
		integer dmg = round(baseDmg * (1 - affectedEntityStats.getRel() / 100) - affectedEntityStats.getAbso());

		if (dmg > 0) {
			affectedEntityStats.removeLife(dmg, EFFECT_DAMAGE);
			affectedEntity.updateAliveState(caster);

			this.tryTriggerPassive(affectedEntity, caster, dmg);
		}
		if (caster != affectedEntity) {
			if (dmg > 0)
				casterStats.addLife(round(dmg * casterStats.getWisdom() / 1000));
			
			if (dmgReturn > 0) {
				casterStats.removeLife(dmgReturn, EFFECT_DAMAGE);
				caster.updateAliveState(caster);
				
				this.tryTriggerPassive(affectedEntity, caster, dmgReturn);
			}
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		EntityScores casterScores = caster.getScores();
		
		real baseDmg = value * casterStats.getStrengthMult() * casterStats.getPowerMult();
		integer dmgReturn = round(baseDmg * targetStats.getDmgReturn() / 100);
		integer dmg = round(baseDmg * (1 - targetStats.getRel() / 100) - targetStats.getAbso());

		integer casterAllyDmgMult = caster.isAnAlly() ? -1 : 1;
		integer casterAllyOtherMult = caster.isAnAlly() ? 1 : -1;
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;

		real score = 0.0;
		if (dmg > 0) {
			integer overDmg = 0;
			
			if (dmg > targetStats.getLife()) {
				// On ne gère l'over dmg que pour un ennemi
				if (!target.isAnAlly())
					overDmg = dmg - targetStats.getLife(); 
				dmg = targetStats.getLife();
				
				score += targetScores.getKillScore() * targetAllyMult;
				score += targetScores.getPowerScore(target.getPowerOnDeath()) * casterAllyOtherMult;
				
				//Debug.log("I can kill ! " + target);   
			}
			score += targetScores.getDmgScore(dmg, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().directDmg;
			//if (overDmg > 0)
				//score -= 0.25 * targetScores.getDmgScore(overDmg, targetStats.getLife()) * targetAllyMult;

			score += this.getPassiveScore(target, caster, targetStats, casterStats, dmg);
		}
		
		if (caster != target) {
			if (dmg > 0) {
				integer lifeSteal = round(dmg * casterStats.getWisdom() / 1000);
				if (casterStats.getLife() + lifeSteal > casterStats.getMaxLife())
					lifeSteal = casterStats.getMaxLife() - casterStats.getLife();
				score += casterScores.getHealScore(lifeSteal, casterStats.getLife()) * casterAllyOtherMult;
			}
			
			if (dmgReturn > 0) {
				score += casterScores.getDmgScore(dmgReturn) * casterAllyDmgMult;
				if (dmgReturn > casterStats.getLife()) {
					score += casterScores.getKillScore() * casterAllyDmgMult;
					
					Debug.log("I will kill myself ! " + caster);   
				}
					
				score += this.getPassiveScore(target, caster, targetStats, casterStats, dmgReturn);
			}
		}
		return score;
		
		// TODO: add score for erosion
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		if (this._item.getId() == 143) return 0;
			// TODO : gérer plasma
		
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		real baseDmg = baseValue * casterStats.getStrengthMult() * casterStats.getPowerMult();
		return max(0, round(baseDmg * (1 - targetStats.getRel() / 100) - targetStats.getAbso()));
	}
}