	protected static Map<integer, Function<integer, AbstractEntity, AbstractEntity, EntityStats, EntityStats, Cell? => real>> finalEffectScoreFnctPerId = [:];
	public static initFinalEffectScoreFnctPerId() {
		Effect.finalEffectScoreFnctPerId[EFFECT_BUFF_AGILITY] = BuffAgilityEffect.getFinalEffectScoreStatic;
		Effect.finalEffectScoreFnctPerId[EFFECT_BUFF_RESISTANCE] = BuffResistanceEffect.getFinalEffectScoreStatic;
		Effect.finalEffectScoreFnctPerId[EFFECT_BUFF_STRENGTH] = BuffStrengthEffect.getFinalEffectScoreStatic;
