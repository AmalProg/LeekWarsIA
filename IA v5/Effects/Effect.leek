		Effect.effectClassPerId[EFFECT_RAW_BUFF_AGILITY] = RawBuffAgilityEffect;
		Effect.effectClassPerId[EFFECT_RAW_BUFF_MAGIC] = RawBuffMagicEffect;
		Effect.effectClassPerId[EFFECT_RAW_BUFF_POWER] = RawBuffPowerEffect;
		Effect.effectClassPerId[EFFECT_RAW_BUFF_RESISTANCE] = RawBuffResistanceEffect;
		Effect.effectClassPerId[EFFECT_RAW_BUFF_SCIENCE] = RawBuffScienceEffect;
		Effect.effectClassPerId[EFFECT_RAW_BUFF_STRENGTH] = RawBuffStrengthEffect;
