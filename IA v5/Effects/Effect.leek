		Effect.finalEffectScoreFnctPerId[EFFECT_RAW_ABSOLUTE_SHIELD] = RawAbsoluteShieldEffect.getFinalEffectScoreStatic;
		Effect.finalEffectScoreFnctPerId[EFFECT_RAW_RELATIVE_SHIELD] = RawRelativeShieldEffect.getFinalEffectScoreStatic;

