include("Effect");

class RawBuffMagicEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, EntityStats casterStats, Cell? cellTarget) {
		affectedEntityStats.addEffect(EntityStats.addMagicStatic, this._type, round(value), caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		return targetScores.getMagicScore(round(value), targetStats.getMagic()) * targetAllyMult * targetScores.getAdjuster().buffDamage;
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		return targetScores.getMagicScore(finalValue, targetStats.getMagic()) * targetAllyMult * targetScores.getAdjuster().buffDamage;
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return round(baseValue);
	}
}