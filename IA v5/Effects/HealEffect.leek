include("Effect");

class HealEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, EntityStats casterStats, Cell? cellTarget) {
		integer finalValue = round(value * casterStats.getWisdomMult());
		if (this._turns == 0) {
			affectedEntityStats.addLife(finalValue);
		} else {
			affectedEntityStats.addEffect(EntityStats.addLifeStatic, this._type, finalValue, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
	
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value * casterStats.getWisdomMult());
		if (this._turns == 0) {
			integer overHeal = 0;
			if (finalValue > targetStats.getMaxLife() - targetStats.getLife()) {
				// On ne gère l'over heal que pour un allié
				if (target.isAnAlly())
					overHeal = (targetStats.getLife() + finalValue) - targetStats.getMaxLife(); 
				finalValue = targetStats.getMaxLife() - targetStats.getLife();
			}
			real score = targetScores.getHealScore(finalValue, targetStats.getLife()) * targetScores.getAdjuster().heal;
			if (overHeal > 0) {
				integer itemCD = this._item.getBaseCooldown();
				if (itemCD == -1)
					itemCD = 15;
				score -= (0.5 * itemCD / (itemCD + 1)) * targetScores.getHealScore(overHeal, targetStats.getLife());
			}
			return score * targetAllyMult;
			
		} else {
			return targetScores.getHealScore(finalValue, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().healOverTime;
		}
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		// TODO: not quite sure how to manage debuff here
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		return targetScores.getHealScore(finalValue, targetStats.getLife()) * targetScores.getAdjuster().heal;
	}
}