include("Effect");

class NovaDamageEffect extends Effect {
	private constructor(Array<any> effectArray, Item item) {
		setPut(this._triggerableEffects, EFFECT_NOVA_DAMAGE_TO_MAGIC);
		
		super(effectArray, item);
	}
	
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, EntityStats casterStats, Cell? cellTarget) {
		integer dmg = round(value * casterStats.getScienceMult() * casterStats.getPowerMult());

		if (dmg > affectedEntityStats.getMaxLife() - affectedEntityStats.getLife()) {
			dmg = affectedEntityStats.getMaxLife() - affectedEntityStats.getLife();
		}

		if (dmg > 0) {
			affectedEntityStats.removeMaxLife(dmg);
			
			this.tryTriggerPassive(affectedEntity, caster, dmg);
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		EntityScores casterScores = caster.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;

		integer novaDmg = round(value * casterStats.getScienceMult() * casterStats.getPowerMult());
		integer maxNovaDmg = targetStats.getMaxLife() - targetStats.getLife();
		integer overNovaDmg = 0;
		
		real score = 0.0;
		if (novaDmg > 0) {
			if (novaDmg > maxNovaDmg) {
				novaDmg = maxNovaDmg;

				overNovaDmg = novaDmg - maxNovaDmg;
			}
			
			score += targetScores.getMaxLifeScore(novaDmg, targetStats.getMaxLife()) * targetAllyMult * targetScores.getAdjuster().novaDamage;
			if (overNovaDmg > 0)
				score -= 0.25 * targetScores.getMaxLifeScore(overNovaDmg, targetStats.getMaxLife()) * targetAllyMult;
			
			score += this.getPassiveScore(target, caster, targetStats, casterStats, novaDmg);
		}
		return score;
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {	
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		integer novaDmg = round(baseValue * casterStats.getScienceMult() * casterStats.getPowerMult());
		integer maxNovaDmg = targetStats.getMaxLife() - targetStats.getLife();
		if (novaDmg > 0) {
			if (novaDmg > maxNovaDmg) {
				novaDmg = maxNovaDmg;
			}
		}
		return novaDmg;
	}
}