include("Effect");

class AfterEffectEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer dmg = round(value * casterStats.getScienceMult());
		if (dmg > 0) {
			affectedEntityStats.removeLife(dmg, EFFECT_AFTEREFFECT);

			affectedEntityStats.addEffect(EntityStats.removeLifeStatic, this._type, dmg, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	

			affectedEntity.updateAliveState(caster);
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		integer dmg = round(value * casterStats.getScienceMult());
			
		integer casterAllyOtherMult = caster.isAnAlly() ? 1 : -1;
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;

		real score = 0.0;
		if (dmg > 0) {
			integer overDmg = 0;
			if (dmg > targetStats.getLife()) {
				// On ne gère l'over dmg que pour un ennemi
				if (!target.isAnAlly())
					overDmg = dmg - targetStats.getLife(); 
				dmg = targetStats.getLife();
				
				score += targetScores.getKillScore() * targetAllyMult;
				score += targetScores.getPowerScore(target.getPowerOnDeath()) * casterAllyOtherMult;

				Debug.log("I can kill !");
			}
			
			score += (this._turns / 1.5) * targetScores.getDmgScore(dmg, targetStats.getLife()) * targetAllyMult;
			if (overDmg > 0)
				score -= 0.25 * targetScores.getDmgScore(overDmg, targetStats.getLife());
			
			return score;
		}
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;
		return targetScores.getDmgScore(finalValue, targetStats.getLife()) * targetAllyMult;
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return round(baseValue * casterStats.getScienceMult());
	}
}