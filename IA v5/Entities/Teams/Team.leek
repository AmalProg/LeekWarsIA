include("../Entity");
include("../Turret");
include("TeamScores");
include("TeamMapInfos");

class Team {
	/** teams pool **/ 
	private static final Set<Team> teams = <>;
	public static Set<Team> getTeams() { return Team.teams; }
	/** fin teams pool **/
	
	private Set<AbstractEntity> _entities; public Set<AbstractEntity> getEntities() { return this._entities; }
	private Set<Leek> _leeks; public Set<Leek> getLeeks() { return this._leeks; }
	private Set<Bulb> _bulbs; public Set<Bulb> getBulbs() { return this._bulbs; }
	private Set<Boss> _bosses; public Set<Boss> getBosses() { return this._bosses; }
	private Set<AbstractEntity> _alive; public Set<AbstractEntity> getAlive() { return this._alive; }
	private Set<Leek> _aliveLeeks; public Set<Leek> getAliveLeeks() { return this._aliveLeeks; }
	private Set<Leek> _deadLeeks; public Set<Leek> getDeadLeeks() { return this._deadLeeks; }
	private Turret? _turret; public Turret? getTurret() { return this._turret; }
		
	public itemsEffects = [];
	private TeamScores _scores; public TeamScores getScores() { return this._scores; }
	private TeamMapInfos _mapInfos; public TeamMapInfos getMapInfos() { return this._mapInfos; }
	
	constructor(Set<AbstractEntity> entities) {
		this._entities = <>;
		this._leeks = <>;
		this._bulbs = <>;
		this._bosses = <>;
		this._alive = <>;
		this._aliveLeeks = <>;
		this._deadLeeks = <>;
		
		for (AbstractEntity entity in entities) {		
			this.add(entity);
		}
		
		this._scores = new TeamScores(this);
		this._mapInfos = new TeamMapInfos(this);
		
		setPut(Team.teams, this);
	}
	
	public void add(AbstractEntity entity, boolean isUpdating = false) {
		if (!isUpdating && entity.getTeam() != null) {
			Debug.error(entity.getId() + "(" + entity.getName() + ") already has a Team");
			return;
		}
		entity.setTeam(this);
		
		if (!setContains(this._entities, entity.getId())) {
			if (entity instanceof Bulb) {
				if (entity.isEntityAlive()) {
					setPut(this._alive, entity);
					setPut(this._bulbs, entity);
				}
			} else if (entity instanceof Boss) {
				if (entity.isEntityAlive()) {
					setPut(this._alive, entity);
					setPut(this._bosses, entity);
				}
			} else if (entity instanceof Turret) {
				this._turret = entity as Turret;
			} else if (entity instanceof Leek) {
				setPut(this._leeks, entity);
				if (entity.isEntityAlive()) {
					setPut(this._alive, entity);
					setPut(this._aliveLeeks, entity);
				} else {
					setPut(this._deadLeeks, entity);
				}
			}
			
			setPut(this._entities, entity);
		}
	}
	
	public void update() {
		Set<AbstractEntity> tmpEntities = clone(this._entities) as Set<AbstractEntity>;
		setClear(this._entities);
		setClear(this._alive);
		setClear(this._aliveLeeks);
		setClear(this._deadLeeks);
		setClear(this._bulbs);
		this._turret = null;
		
		for (AbstractEntity entity in tmpEntities) {
			this.add(entity, true);
		}
	}
	public void updateMapInfos() {
		this._mapInfos.update();
	}
	public void updateScores() {
		this._scores.update();
	}
	
	public string string() {
		return "{" +
		 "entities : " + this._entities + "\n" +
		 "alive : " + this.getAlive() + "\n" +
		 "leeks : " + this.getLeeks() + "\n" +
		 "deadLeeks : " + this.getDeadLeeks() + "\n" +
		 "aliveLeeks : " + this.getAliveLeeks() + "\n" +
		 "bulbs : " + this.getBulbs() + "\n" +
		 "turret : " + this.getTurret() + "\n" +
		"}"
	}
}