include("Team");

class TeamScores {
	public real directDamageDanger;
	public real poisonDamageDanger;
	public real augmentMaxLifeScore;
	public real needShield;

	private Team _team;
	
	private constructor() {}
	constructor(Team team) {
		this._team = team;
	}
	
	private void reset() {
		this.directDamageDanger = 0.0;
		this.poisonDamageDanger = 0.0;
		this.augmentMaxLifeScore = 0.0;
	}
	
	public void update() {
		this.reset();
		
		integer entitiesAliveCount = setSize(this._team.getAlive());
		for (AbstractEntity entity in this._team.getAlive()) {
			EntityStats eStats = entity.getStats();
			this.directDamageDanger += eStats.getStrength() / (EntityStatsDiviser.strength * 1.5) * entity.getScores().getAdjuster().entityType;
			this.poisonDamageDanger += eStats.getMagic() / (EntityStatsDiviser.magic * 1.5) * entity.getScores().getAdjuster().entityType;
			
			
			/** Shield **/
			this.needShield = 1.0;
			/* * */
			
			for (Item item in entity.getItems()) {
				for (Effect eff in item.getEffects()) {
					if (setContains(Effect.augmentMaxLifeEffects, eff.getType()) && item.getBaseCooldown() != -1) {
						this.augmentMaxLifeScore += eff.getAppliedValue(null, null, entity, eStats, eStats, 0, true);
					}
				}
			}
		}		
		this.augmentMaxLifeScore /= EntityStatsDiviser.maxLife;
	}
}