include("Team");

class TeamScores {
	public real directDamageDanger;
	public real poisonDamageDanger;

	private Team _team;
	
	private constructor() {}
	constructor(Team team) {
		this._team = team;
	}
	
	private void reset() {
		this.directDamageDanger = 0.0;
		this.poisonDamageDanger = 0.0;
	}
	
	public void update() {
		this.reset();
		
		integer entitiesAliveCount = setSize(this._team.getAlive());
		for (AbstractEntity entity in this._team.getAlive()) {
			EntityStats eStats = entity.getStats();
			this.directDamageDanger += eStats.getStrength() / (EntityStatsDiviser.strength * 1.5);
			this.poisonDamageDanger += eStats.getMagic() / (EntityStatsDiviser.magic * 1.5);
		}
	}
}