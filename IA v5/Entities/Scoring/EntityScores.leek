include("EntityScoresAdjuster");

class EntityScores {
	public static final real ALLY_DIST_SCORE_MULT = -1.0;
	public static final real ENEMY_DIST_SCORE_MULT = 1.0;
	
	public real maxLife;
	public real life;
	public real strength;
	public real power;
	public real science;
	public real wisdom;
	public real resistance;
	public real magic;
	public real agility;
	public real abso;
	public real rel;
	public real dmgReturn;
	public real poison;
	public real mp;
	public real tp;
	
	private EntityScoresAdjuster _scoresAdjuster; EntityScoresAdjuster getAdjuster() { return this._scoresAdjuster; }
	private AbstractEntity _entity;
	
	private constructor() {}
	public constructor(AbstractEntity entity, EntityScoresAdjuster scoresAdjuster) {
		this._entity = entity;
		
		this.maxLife = 0.0;
		this.life = 0.0;
		this.strength = 0.0;
		this.power = 0.0;
		this.science = 0.0;
		this.wisdom = 0.0;
		this.resistance = 0.0;
		this.magic = 0.0;
		this.agility = 0.0;
		this.abso = 0.0;
		this.rel = 0.0;
		this.dmgReturn = 0.0;
		this.poison = 0.0;
		this.mp = 0.0;
		this.tp = 0.0;
		
		this._scoresAdjuster = scoresAdjuster;
	}
		
	public void updateScoreAdjuster() {		
		this._scoresAdjuster.update();
	}
	
	public real getKillScore() {
		return this._scoresAdjuster.kill;	
	}
	
	public real getMaxLifeScore(integer maxLifeAdded, integer maxLife = this._entity.getStats().getLife()) {
		// 10\left(1-\min\left(0.8,\frac{a}{2.1\cdot2000}\right)\right)x
		return 8 * (1 - min(0.8, maxLife / (18 * EntityStatsDiviser.maxLife))) * maxLifeAdded * EntityScoresAdjuster.maxLife;
	}
	
	public real getDmgScore(integer dmg, integer life = this._entity.getStats().getLife()) {
		// 2.5\left(1-\min\left(0.6,\frac{a}{8\cdot2000}\right)\right)x+0.0005x^{2}
		return (2.5 * (1 - min(0.6, life / (8 * EntityStatsDiviser.maxLife))) * dmg + 0.0005 * dmg * dmg) * EntityScoresAdjuster.dmg;
	}
	
	public real getHealScore(integer heal, integer life = this._entity.getStats().getLife()) {	
		// 5\left(1-\min\left(0.6,\frac{a}{4\cdot2000}\right)\right)x
		return 5 * (1 - min(0.6, life / (4 * EntityStatsDiviser.maxLife))) * heal * EntityScoresAdjuster.dmg;	
	}
	
	public real getStrengthScore(integer strAdded, integer str = this._entity.getStats().getStrength()) {
		if (strAdded > 0) {
			// 2x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
			return 4 * (EntityStatsDiviser.strength - (str - EntityStatsDiviser.strength * 1.5) * (str - EntityStatsDiviser.strength * 1.5) / (EntityStatsDiviser.strength * 2.25)) / EntityStatsDiviser.strength * strAdded * EntityScoresAdjuster.strength;
		} else {
			// -2x\cdot\frac{\left(z-\frac{\left(-g-z\cdot1.5\right)^{2}}{z\cdot2.25}\right)}{z}
			return -2 * (EntityStatsDiviser.strength - (-str - EntityStatsDiviser.strength * 1.5) * (str - EntityStatsDiviser.strength * 1.5) / (EntityStatsDiviser.strength * 2.25)) / EntityStatsDiviser.strength * strAdded * EntityScoresAdjuster.strength;
		}
	}
	
	public real getPowerScore(integer powerAdded, integer power = this._entity.getStats().getPower()) {
		// 1000-\left(0.31x-31\right)^{2}
		return 1000 - (0.31 * powerAdded - 31) * (0.31 * powerAdded - 31) * EntityScoresAdjuster.power;
	}
	
	public real getMagicScore(integer magicAdded, integer magic = this._entity.getStats().getMagic()) {
		if (magicAdded > 0) {
			// 4x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
			return 4 * (EntityStatsDiviser.magic - (magic - EntityStatsDiviser.magic * 1.5) * (magic - EntityStatsDiviser.magic * 1.5) / (EntityStatsDiviser.magic * 2.25)) / EntityStatsDiviser.magic * magicAdded * EntityScoresAdjuster.magic;
		} else {
			// -2x\cdot\frac{\left(z-\frac{\left(-g-z\cdot1.5\right)^{2}}{z\cdot2.25}\right)}{z}
			return -2 * (EntityStatsDiviser.magic - (-magic - EntityStatsDiviser.magic * 1.5) * (magic - EntityStatsDiviser.magic * 1.5) / (EntityStatsDiviser.magic * 2.25)) / EntityStatsDiviser.magic * magicAdded * EntityScoresAdjuster.magic;
		}
	}
	
	public real getWisdomScore(integer wisdomAdded, integer wisdom = this._entity.getStats().getWisdom()) {
		// 2x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
		return 4 * (EntityStatsDiviser.wisdom - (wisdom - EntityStatsDiviser.wisdom * 1.5) * (wisdom - EntityStatsDiviser.wisdom * 1.5) / (EntityStatsDiviser.wisdom * 2.25)) / EntityStatsDiviser.wisdom * wisdomAdded * EntityScoresAdjuster.wisdom;
	}
	
	public real getResistanceScore(integer resAdded, integer res = this._entity.getStats().getResistance()) {
		// 4x\cdot\frac{\left(z-\frac{\left(g-z\cdot1.5\right)^{2}}{z\cdot2.25}\right)}{z}
		return 4 * (EntityStatsDiviser.resistance - (res - EntityStatsDiviser.resistance * 1.5) * (res - EntityStatsDiviser.resistance * 1.5) / (EntityStatsDiviser.resistance * 2.25)) / EntityStatsDiviser.resistance * resAdded * EntityScoresAdjuster.resistance;
	}
	
	public real getAgilityScore(integer agilityAdded, integer agility = this._entity.getStats().getAgility()) {
		// 4x\cdot\frac{\left(z-\frac{\left(g-z\cdot1.5\right)^{2}}{z\cdot2.25}\right)}{z}
		return 3 * (EntityStatsDiviser.agility - (agility - EntityStatsDiviser.agility * 1.5) * (agility - EntityStatsDiviser.agility * 1.5) / (EntityStatsDiviser.agility * 2.25)) / EntityStatsDiviser.agility * agilityAdded * EntityScoresAdjuster.agility;
	}
	
	public real getScienceScore(integer scienceAdded, integer science = this._entity.getStats().getScience()) {
		// 3.5x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
		return 3.5 * (EntityStatsDiviser.science - (science - EntityStatsDiviser.science * 1.5) * (science - EntityStatsDiviser.science * 1.5) / (EntityStatsDiviser.science * 2.25)) / EntityStatsDiviser.science * scienceAdded * EntityScoresAdjuster.science;
	}
	
	public real getAbsoScore(integer absoAdded, integer abso = this._entity.getStats().getAbso(), integer rel = this._entity.getStats().getRel()) {
		if (abso >= 0) {
			// \frac{h-0.3d}{h}\left(7x-\frac{3f}{F}x\right)
			return (EntityStatsDiviser.rel - 0.3 * rel) / EntityStatsDiviser.rel * (7 * absoAdded - (3 * abso / EntityStatsDiviser.abso) * absoAdded) * EntityScoresAdjuster.abso;
		} else {
			return 7 * absoAdded - (3 * abso / EntityStatsDiviser.abso) * absoAdded * EntityScoresAdjuster.abso;
		}
	}
	
	public real getRelScore(integer relAdded, integer rel = this._entity.getStats().getRel()) {
		// \left(40-10\cdot\frac{d}{h}\right)x-\frac{\left(d\right)}{3h}x^{2}
		return 	((40 - 10 * rel / EntityStatsDiviser.rel) * relAdded - rel / (3 * EntityStatsDiviser.rel) * relAdded * relAdded) * EntityScoresAdjuster.rel;
	}
	
	public real getDmgReturnScore(integer dmgReturnAdded, integer dmgReturn = this._entity.getStats().getDmgReturn(), integer abso = this._entity.getStats().getAbso(), integer rel = this._entity.getStats().getRel()) {
		// \frac{J-0.4d-0.05f}{J}\left(10x-\frac{i}{J}x\right)
		return 	(EntityStatsDiviser.dmgReturn - 0.15 * rel - 0.025 * abso) / EntityStatsDiviser.dmgReturn * (10 * dmgReturnAdded - dmgReturn / EntityStatsDiviser.dmgReturn) * EntityScoresAdjuster.dmgReturn;
	}
	
	public real getPoisonScore(integer poison, integer life = this._entity.getStats().getLife()) {
		// 4.5\left(1-\min\left(0.6,\frac{a}{8\cdot2000}\right)\right)x+0.0005x^{2}
		return (4.5 * (1 - min(0.6, life / (8 * EntityStatsDiviser.maxLife))) * poison + 0.0005 * poison * poison) * EntityScoresAdjuster.poison;
	}
	
	public real getMPScore(integer addedMp, integer mp = this._entity.getStats().getMP()) {
		if (addedMp <= 0 && mp <= 0) return 0.0;
		
		// 200x\cdot\frac{\left(w-\frac{\left(k-w\cdot1.5\right)^{2}}{w\cdot2.25}\right)}{w}
		return 200 * (EntityStatsDiviser.mp - (mp - EntityStatsDiviser.mp * 1.5) * (mp - EntityStatsDiviser.mp * 1.5) / (EntityStatsDiviser.mp * 2.25)) / EntityStatsDiviser.mp * addedMp * EntityScoresAdjuster.mp;	
	}
		
	public real getTPScore(integer addedTp, integer tp = this._entity.getStats().getTP()) {
		if (addedTp <= 0 && tp <= 0) return 0.0;
		
		// 200x\cdot\frac{\left(w-\frac{\left(k-w\cdot1.5\right)^{2}}{w\cdot2.25}\right)}{w}
		return 200 * (EntityStatsDiviser.tp - (tp - EntityStatsDiviser.tp * 1.5) * (tp - EntityStatsDiviser.tp * 1.5) / (EntityStatsDiviser.tp * 2.25)) / EntityStatsDiviser.tp * addedTp * EntityScoresAdjuster.tp;	
	}	
	
 
	public string() {
		return " { " + "life : " + this.life +
			"\n strength : " + this.strength +
			"\n science : " + this.science +
			"\n wisdom : " + this.wisdom +
			"\n resistance : " + this.resistance +
			"\n magic : " + this.magic +
			"\n agility : " + this.agility +
			" }\n";
	}
}