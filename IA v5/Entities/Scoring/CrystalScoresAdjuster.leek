include("EntityScoresAdjuster");

class CrystalScoresAdjuster extends EntityScoresAdjuster {	

	public constructor(AbstractEntity entity) {
		super(entity);
	}
	
	public void update() {
		/* Kill */
		this.kill = -10000.0;
		/* * */
		
		/* Damage */
		this.directDmg = -3.0;
		/* * */
		
		this.poison = -3.0;
		this.novaDamage = -1.0
		
		this.vulneAbso = 0.0;
		this.vulneRel = 0.0;
	}
}