include("../Utils/Debug")
include("Leek");

class EntityStats {
	private integer _maxLife; 
	public integer getMaxLife() { return this._maxLife; }
	public void setMaxLife(integer maxLife) { this._maxLife = maxLife; }
	private integer _life;
	public integer getLife() { return this._life; }
	public void setLife(integer life) { this._life = life; }
	private integer _strength; public integer getStrength() { return this._strength; }
	private integer _wisdom; public integer getWisdom() { return this._wisdom; }
	private integer _agility; public integer getAgility() { return this._agility; }
	private integer _resistance; public integer getResistance() { return this._resistance; }
	private integer _science; public integer getScience() { return this._science; }
	private integer _magic; public integer getMagic() { return this._magic; }
	private integer _power; public integer getPower() { return this._power; }
	private integer _frequency; public integer getFrequency() { return this._frequency; }
	private integer _tp; public integer getTP() { return this._tp; }
	private integer _mp; public integer getMP() { return this._mp; }
	private integer _abso; public integer getAbso() { return this._abso; }
	private integer _rel; public integer getRel() { return this._rel; }
	private integer _dmgReturn; public integer getDmgReturn() { return this._dmgReturn; }
	private integer _poison; public integer getPoison() { return this._poison; }

	private real _strengthMult; public real getStrengthMult() { return this._strengthMult; }
	private real _wisdomMult; public real getWisdomMult() { return this._wisdomMult; }
	private real _agilityMult; public real getAgilityMult() { return this._agilityMult; }
	private real _resistanceMult; public real getResistanceMult() { return this._resistanceMult; }
	private real _scienceMult; public real getScienceMult() { return this._scienceMult; }
	private real _magicMult; public real getMagicMult() { return this._magicMult; }
	private real _powerMult; public real getPowerMult() { return this._powerMult; }
	
	private Set<EntityEffect> _effects; public Set<EntityEffect> getEffects() { return this._effects; }	
	
	private AbstractEntity _entity;
	
	constructor(AbstractEntity entity) {
		this.initStats(entity.getId());
		this._entity = entity;
	}
	
	public copy(EntityStats stats) {
		this._maxLife = stats._maxLife;
		this._life = stats._life;
		this._strength = stats._strength;
		this._wisdom = stats._wisdom;
		this._agility = stats._agility;
		this._resistance = stats._resistance;
		this._science = stats._science;
		this._magic = stats._magic;
		this._power = stats._power;
		this._frequency = stats._frequency;
		this._tp = stats._tp;
		this._mp = stats._mp;
		this._abso = stats._abso;
		this._rel = stats._rel;
		this._dmgReturn = stats._dmgReturn;
		this._poison = stats._poison;
		
		this._strengthMult = stats._strengthMult;
		this._wisdomMult = stats._wisdomMult;
		this._agilityMult = stats._agilityMult;
		this._resistanceMult = stats._resistanceMult;
		this._scienceMult = stats._scienceMult;
		this._magicMult = stats._magicMult;
		this._powerMult = stats._powerMult;
		
		this._effects = clone(stats._effects) as Set<EntityEffect>;
		
		this._entity = stats._entity;
	}
	
	public initStats(integer entityId) {
		this._maxLife = getTotalLife(entityId)!;
		this._life = getLife(entityId)!;
		this._strength = getStrength(entityId)!;
		this._wisdom = getWisdom(entityId)!;
		this._agility = getAgility(entityId)!;
		this._resistance = getResistance(entityId)!;
		this._science = getScience(entityId)!;
		this._magic = getMagic(entityId)!;
		this._power = getPower(entityId)!;
		this._frequency = getFrequency(entityId)!;
		this._tp = getTP(entityId)!;
		if (this._tp < 0)
			this._tp = 0;
		this._mp = getMP(entityId)!;
		if (this._mp < 0)
			this._mp = 0;
		this._abso = getAbsoluteShield(entityId)!;
		this._rel = getRelativeShield(entityId)!;
		this._dmgReturn = getDamageReturn(entityId)!;
		
		this._effects = <>;
		for (Array<boolean|integer> effect in getEffects(entityId)!) {
			setPut(this._effects, EntityEffect(effect));
		}
		
		for (EntityEffect eff in this.getPoisonEffects()) {
			this._poison += eff.getValue();
		}
		
		this.updateMults();
	}
	
	public updateMults() {
		this._strengthMult = (1 + (this._strength >= -100 ? this._strength : -1) / 100);
		this._wisdomMult = (1 + (this._wisdom >= -100 ? this._wisdom : -1) / 100);
		this._agilityMult = (1 + (this._agility >= -100 ? this._agility : -1) / 100);
		this._resistanceMult = (1 + (this._resistance >= -100 ? this._resistance : -1) / 100);
		this._scienceMult = (1 + (this._science >= -100 ? this._science : -1) / 100);
		this._magicMult = (1 + (this._magic >= -100 ? this._magic : -1) / 100);
		this._powerMult = (1 + (this._power >= -100 ? this._power : -1) / 100);	
	}
	
	public addEffect(Function<EntityStats, integer => void>? statsFct, integer type, integer value, AbstractEntity caster, integer turns, boolean critical, integer itemId, AbstractEntity target, integer modifiers) {
		if (turns != 0) {
			EntityEffect effect = new EntityEffect(statsFct, type, value, caster, turns, critical, itemId, target, modifiers);
			//Debug.info("adding effect " + effect + " to " + this._entity.getName())
			setPut(this._effects, effect);
			effect.apply(this);
		}
	}
	
	public void addEffects(Set<EntityEffect> effects) {
		for (EntityEffect effect in effects) {
			if (effect.getTurns() != 0) {
				//Debug.info("adding effect " + effect + " to " + this._entity.getName());
				setPut(this._effects, effect);
				effect.apply(this);
			}
		}
	}
	
	public void removeEffect(EntityEffect effect) {
		//Debug.info("removing effect " + effect + " to " + this._entity.getName());
		setRemove(this._effects, effect);
		effect.remove(this);
	}
	public void removeEffects(Set<EntityEffect> effects) {
		Set<EntityEffect> effectsToRemove = <>;
		for (EntityEffect effect in effects) {
			//Debug.info("removing effect " + effect + " from " + this._entity.getName());
			setPut(effectsToRemove, effect);
			effect.remove(this);
		}
		for (EntityEffect effect in effectsToRemove) {
			setRemove(this._effects, effect);
		}
	}
	public void clearEffects() {
		for (EntityEffect effect in this._effects) {
			//Debug.info("clearing effect " + effect + " from " + this._entity.getName());
			effect.remove(this);
		}
		setClear(this._effects);
	}
	
	/**
	 * Test si l'effet affecte l'entité, corespondant au type et à l'item de l'effet donné
	 * 
	 * @param eff : l'effet recherché
	 * 
	 * @return true si l'entité est affecté par l'effet
	 * 
	 **/
	public boolean hasEffectOn(Effect eff) {
		for (EntityEffect effect in this._effects) {
		if (effect.getType() == eff.getType() && effect.getItemId() == eff.getItem().getId())
				return true;
		}
		return false;
	}
	
	public boolean hasEffectType(integer effType) {
		for (EntityEffect effect in this._effects) {
			if (effect.getType() == effType)
				return true;
		}
		return false;
	}
	
	/**
	 * Récupère l'effet qui affecte l'entité, corespondant au type et à l'item de l'effet donné
	 * 
	 * @param eff : l'effet recherché
	 * 
	 * @return la liste des effets correspondant à 'eff'
	 **/
	public Set<EntityEffect> getEffectsOn(Effect eff) {
		Set<EntityEffect> effectsMatching = <>;
		for (EntityEffect effect in this._effects) {
			if (effect.getType() == eff.getType() && effect.getItemId() == eff.getItem().getId())
				setPut(effectsMatching, effect);
		}
		return effectsMatching;
	}
	
		
	/**
	 * Récupère les effets qui affecteront encore l'entité dans x tour
	 * 
	 * @param turns : le nombre de tours
	 * 
	 * @return la liste des effets
	 **/
	public Set<EntityEffect> getEffectsInTurns(integer turns) {
		Set<EntityEffect> effectsInTurns = <>;
		for (EntityEffect effect in this._effects) {
			if (effect.getTurns() == -1 || effect.getTurns() > turns || (effect.getTurns() == turns && effect.getCaster().getTurnOrder() > this._entity.getTurnOrder()))
				setPut(effectsInTurns, effect);
		}
		return effectsInTurns;
	}
	
	public void removeShackles() {
		Set<EntityEffect> effectsToRemove = <>;
		for (EntityEffect eff in this._effects) {
			if (setContains(Effect.shackleEffects, eff.getType())) {
				eff.getCaster().removeLaunchedEffect(eff);
				setPut(effectsToRemove, eff);
			}
		}
		this.removeEffects(effectsToRemove);
	}
	public Array<EntityEffect> getShacklesEffects() {
		Array<EntityEffect> effects = [];
		for (EntityEffect eff in this._effects) {
			if (setContains(Effect.shackleEffects, eff.getType())) {
				push(effects, eff);
			}
		}
		return effects;
	}
	
	public void removePoisons() {
		Set<EntityEffect> effectsToRemove = <>;
		for (EntityEffect eff in this._effects) {
			if (eff.getType() == EFFECT_POISON) {
				eff.getCaster().removeLaunchedEffect(eff);
				setPut(effectsToRemove, eff);
			}
		}
		this.removeEffects(effectsToRemove);
	}
	public Array<EntityEffect> getPoisonEffects() {
		Array<EntityEffect> effects = [];
		for (EntityEffect eff in this._effects) {
			if (setContains(Effect.poisonEffects, eff.getType())) {
				push(effects, eff);
			}
		}
		return effects;
	}
	
	public void debuff(real|integer value) {
		Set<EntityEffect> effectsToRemove = <>;
		Set<EntityEffect> newEffects = <>;
		for (EntityEffect eff in this._effects) {
			if (eff.isIrreductible()) continue;
			
			setPut(effectsToRemove, eff);
			
			integer newValue = round(eff.getValue() * (1 - (value / 100)));
			if (newValue > 0) {
				setPut(newEffects, new EntityEffect(eff.getStatsFct(), eff.getType(), newValue, eff.getCaster(), eff.getTurns(), eff.isCritical(), eff.getItemId(), eff.getTarget(), eff.getModifiers()));
			}
		}
		this.removeEffects(effectsToRemove);
		this.addEffects(newEffects);
	}
	
	public void addMaxLife(integer value) {	
		this._maxLife += value;
		//Debug.info("adding max life " + value + " life to " + this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}
	
	public void removeMaxLife(integer value) {
		this._maxLife -= value;
		//Debug.info("removing " + value + " max life from " + this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}
	
	public void addLife(integer value) {
		this._life += value;
		if (this._life > this._maxLife)
			this._life = this._maxLife;
		//Debug.info("healing " + value + " life to " +  this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}	
	public static void addLifeStatic(EntityStats stats, integer value) {
		stats.addLife(value);
	}
	
	public void removeLife(integer value, integer type) {
		this._life -= value;

		real erosionMult = type == EFFECT_POISON ? 0.10 : 0.05;
		integer erosionValue = round(value * erosionMult);
		this.removeMaxLife(erosionValue);
		
		//Debug.info("removing " + value + " life from " +  this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}
	public static void removeLifeStatic(EntityStats stats, integer value) {
		stats.removeLife(value, EFFECT_AFTEREFFECT);
	}
	
