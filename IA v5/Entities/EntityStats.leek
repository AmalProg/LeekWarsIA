	public string string() {
		return
			"\n { maxLife : " + this._maxLife +
			"\n life : " + this._life +
			"\n strength : " + this._strength +
			"\n wisdom : " + this._wisdom +
			"\n agility : " + this._agility +
			"\n resistance : " + this._resistance +
			"\n science : " + this._science +
			"\n magic : " + this._magic +
			"\n power : " + this._power +
			"\n tp : " + this._tp +
			"\n mp : " + this._mp +
			"\n abso : " + this._abso +
			"\n rel : " + this._rel +
			"\n dmgReturn : " + this._dmgReturn + " }";
	}
