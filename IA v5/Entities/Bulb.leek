include("../Utils/Debug");
include("Entity");

class Bulb extends AbstractEntity { 
	/** Bulbs pool **/
	private static final Map<integer, Bulb> bulbs = [:];
	public static void initBulbs(Array<integer> entitiesId) {
		Set<Bulb> deadBulbs = <>;
		for (Bulb bulb in Bulb.bulbs) {
			if (mapGet(AbstractEntity.entities, bulb._id, null) == null) {
				// le bulb est mort
				setPut(deadBulbs, bulb);
			}
		}
		for (Bulb deadBulb in deadBulbs) {
			mapRemove(Bulb.bulbs, deadBulb._id);
			// TODO : might need to remove from the summoner
		}

		for (integer bulbId in entitiesId) {
			if (getType(bulbId) == ENTITY_BULB) {
				if (Bulb.get(bulbId) != null) continue;
			
				Bulb newBulb = new Bulb(bulbId);
				Leek? summoner = Leek.get(getSummoner(newBulb._id)!);
				if (summoner != null) {
					summoner!.addSummon(newBulb);
					newBulb.setBulbSummoner(summoner!);
				}
				
				Bulb.bulbs[bulbId] = newBulb;
				AbstractEntity.entities[bulbId] = newBulb;
			}
		}
	}
	
	public static Bulb? get(integer id) {
		return Bulb.bulbs[id];
	}
	/** fin bulbs pool **/
	
	private Leek _summoner; 
	public Leek getBulbSummoner() { return this._summoner; }
	public void setBulbSummoner(Leek summoner) { 
		this._summoner = summoner;
		if (this._summoner.getTeam() != null)
			this._summoner.getTeam()!.add(this);
	}

	private boolean _isSupport; public boolean isSupport() { return this._isSupport; }
	private boolean _isDamage; public boolean isDamage() { return this._isDamage; }
	
	constructor(integer id) {
		this._name = getName(id)!;
		
		if (setContains(supportBulbChips, Bulb.bulbsNameChip[this._name]))
			this._isSupport = true;
		else
			this._isSupport = false;
		if (setContains(damageBulbChips, Bulb.bulbsNameChip[this._name]))
			this._isDamage = true;
		else
			this._isDamage = false;
				

		super(id);
	}
	
	protected void updateStats() {
		super.updateStats();

		if (GAME.isBR)
			this._powerOnDeath = round(2 + 0.5 * this._stats.getPower());
	}
	
	public static Set<integer> supportBulbChips = <CHIP_PUNY_BULB, CHIP_HEALER_BULB, CHIP_METALLIC_BULB, CHIP_TACTICIAN_BULB, CHIP_SAVANT_BULB>;
	public static Set<integer> damageBulbChips = <CHIP_ROCKY_BULB, CHIP_ICED_BULB, CHIP_FIRE_BULB, CHIP_LIGHTNING_BULB, CHIP_WIZARD_BULB>;
	
	public static Map<string, integer> bulbsNameChip = [
		"puny_bulb" : CHIP_PUNY_BULB, 
		"rocky_bulb" : CHIP_ROCKY_BULB, 
		"iced_bulb" : CHIP_ICED_BULB, 
		"healer_bulb" : CHIP_HEALER_BULB, 
		"metallic_bulb" : CHIP_METALLIC_BULB, 
		"fire_bulb" : CHIP_FIRE_BULB, 
		"lightning_bulb" : CHIP_LIGHTNING_BULB, 
		"wizard_bulb" : CHIP_WIZARD_BULB,
		"tactician_bulb" : CHIP_TACTICIAN_BULB, 
		"savant_bulb" : CHIP_SAVANT_BULB
	];
}