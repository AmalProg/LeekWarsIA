include("../../Boss");

class Graal extends Boss {
	public static final real ENTITY_TYPE_MULT = 0.0;
	
	/** Crystals pool **/
	private static Graal graal;
	public static Graal? get() { return Graal.graal; }
	public static init(Array<integer> entitiesId) {
		for (var entityId in entitiesId) {
			if (getType(entityId) == 5 && contains(getName(entityId)!, "graal")) {
				Graal.graal = new Graal(entityId);
				Boss.bosses[entityId] = Graal.graal;
				AbstractEntity.entities[entityId] = Graal.graal;
			}
		}
	}
	public static Graal? get(integer id) {
		return Graal.graal;
	}
	/** fin pool **/

	constructor(integer id) {
		super(id);
	}
}