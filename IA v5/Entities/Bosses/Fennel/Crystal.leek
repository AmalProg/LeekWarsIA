include("../../Boss");
include("../../Scoring/CrystalScoresAdjuster");
include("../../Scoring/MapInfos/CrystalMapInfos");

class Crystal extends Boss {
	public static final real ENTITY_TYPE_MULT = 0.0;
	
	/** Crystals pool **/
	private static final Map<integer, Crystal> crystals = [:];
	public static init(Array<integer> entitiesId) {
		for (integer crystalId in entitiesId) {
			if (getType(crystalId) == 5 && contains(getName(crystalId)!, "crystal")) {
				Crystal.crystals[crystalId] = new Crystal(crystalId);
				Boss.bosses[crystalId] = Crystal.crystals[crystalId];
				AbstractEntity.entities[crystalId] = Crystal.crystals[crystalId];
			}
		}
	}
	public static Crystal? get(integer id) {
		return Crystal.crystals[id];
	}
	/** fin pool **/

	public static final integer RED = 0;
	public static final integer YELLOW = 1;
	public static final integer BLUE = 2;
	public static final integer GREEN = 3;
	private integer _color; public integer getColor() { return this._color; }
	
	constructor(integer id) {
		super(id);
		
		if (contains(this._name, "red"))
			this._color = Crystal.RED;
		else if (contains(this._name, "yellow"))
			this._color = Crystal.YELLOW;
		else if (contains(this._name, "blue"))
			this._color = Crystal.BLUE;
		else if (contains(this._name, "green"))
			this._color = Crystal.GREEN;
	}
	
	protected initScores() {
		this._scores = new EntityScores(this, new CrystalScoresAdjuster(this));
		this._mapInfos = new CrystalMapInfos(this);
	}
}