include("../../Boss");

class Scribe extends Boss {
	public static final real ENTITY_TYPE_MULT = 0.0;
	
	/** Scribes pool **/
	private static final Map<integer, Scribe> scribes = [:];
	public static init(Array<integer> entitiesId) {
		for (integer entityId in entitiesId) {
			if (getType(entityId) == 5 && contains(getName(entityId)!, "fennel_scribe")) {
				Scribe.scribes[entityId] = new Scribe(entityId);
				Boss.bosses[entityId] = Scribe.scribes[entityId];
				AbstractEntity.entities[entityId] = Scribe.scribes[entityId];
			}
		}
	}
	public static Scribe? get(integer id) {
		return Scribe.scribes[id];
	}
	/** fin pool **/

	constructor(integer id) {
		super(id);
	}
}