include("../../Boss");

class King extends Boss {
	public static final real ENTITY_TYPE_MULT = 0.0;
	
	/** Crystals pool **/
	private static King king;
	public static init(Array<integer> entitiesId) {
		for (var entityId in entitiesId) {
			if (getType(entityId) == 5 && contains(getName(entityId)!, "fennel_king")) {
				King.king = new King(entityId);
				Boss.bosses[entityId] = King.king;
				AbstractEntity.entities[entityId] = King.king;
			}
		}
	}
	public static King? get(integer id) {
		return King.king;
	}
	/** fin pool **/

	constructor(integer id) {
		super(id);
	}
}