function getAreaTest(Cell startCell, integer distMin, integer distMax) {
	Set<Cell> cells = <>;
	for (integer i = distMin; i <= distMax; i++) {
		for (string dir in mapGet(circleDir, i, <>)) {
			Cell? c = startCell;
			for (string d in split(dir, ".")) {
				c = c[d]
				if (c == null)
					break;
			}
			if (c != null)
				setPut(cells, c);
		}
	}
	return cells;
}

function getAreaTest2(Cell startCell, integer distMin, integer distMax) {
	Set<Cell> cells = <>;
	for (integer i = distMin; i <= distMax; i++) {
		Cell? baseCell = startCell;
		integer j = 1;
		for (string dir in mapGet(circleDir2, i, [])) {
			Cell? c = baseCell;
			for (string d in split(dir, ".")) {
				c = c[d]
				if (c == null)
					break;
			}
			if (c != null)
				setPut(cells, c);
		
			if (j % i == 1) {
				baseCell = c;
			} else if (j % i == 0) {
				baseCell = startCell;
			}
			j++;
		}
	}
	return cells;
}

circleDir2[1] = ["N"];
circleDir2[2] = ["NW", "NE"];
circleDir2[3] = ["N.NW", "NE", "SW"];
circleDir2[4] = ["NW.NW", "NE", "NE.NE", "SW"];
circleDir2[5] = ["N.NW.NW", "NE", "NE.NE", "SW", "SW.SW"];

global Array<string> mainDirs = ["N", "E", "S", "W"];
global Map<string, Array<string>> dirs = new Map();
dirs["N"] = ["NW", "NE", "SW"];
dirs["E"] = ["NE", "SE", "NW"];
dirs["S"] = ["SE", "SW", "NE"];
dirs["W"] = ["SW", "NW", "SE"];

//(?:\[Saphyre\])* *([1-9]*[1-9]) : (.*?)\n
//circleDir2[$1] = $2;\n

global Map<integer, Array<string>> circlePattern = new Map();
createCircleDirSets(14);
for (integer size : Array<string> strings in circlePattern) {
	debug(size + " : " + strings);
}
function createCircleDirSets(integer maxSize) {
	for (integer i = 2; i <= maxSize; i++) {
		circlePattern[i] = new Array();
		
		for (string mainDir in mainDirs) {
			if (i % 2 == 0) {
				string directions = "";
				for (integer a = 0; a < i / 2; a++) {
					if (a > 0)
						directions += ".";
					directions += dirs[mainDir][0];
				}
				push(circlePattern[i], directions);
				
				directions = "";
				for (integer a = 0; a < i / 2; a++) {
					if (a > 0)
						directions += ".";
					directions += dirs[mainDir][1];
					push(circlePattern[i], directions);
				}
				
				directions = "";
				for (integer a = 0; a < i / 2 - 1; a++) {
					if (a > 0)
						directions += ".";
					directions += dirs[mainDir][2];
					push(circlePattern[i], directions);
				}
			} else {
				string directions = mainDir;
				for (integer a = 0; a < i / 2 - 1; a++) {
					directions += ".";
					directions += dirs[mainDir][0];
				}
				push(circlePattern[i], directions);
				
				directions = "";
				for (integer a = 0; a < i / 2 - 1; a++) {
					if (a > 0)
						directions += ".";
					directions += dirs[mainDir][1];
					push(circlePattern[i], directions);
				}
				
				directions = "";
				for (integer a = 0; a < i / 2 - 1; a++) {
					if (a > 0)
						directions += ".";
					directions += dirs[mainDir][2];
					push(circlePattern[i], directions);
				}
			}
		}
	}
}