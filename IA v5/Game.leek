include("Utils/Debug");
include("Map/CellMap");
include("Entities/EntitiesImports");
include("AI");
include("Utils/Register");
include("Items/Combo");

global Game GAME = Game.getInstance();

class Game {
	public static final integer FIGHT_TYPE_BOSS_NASU = 0;
	public static final integer FIGHT_TYPE_BOSS_FENNEL = 1;
	public static final integer FIGHT_TYPE_BOSS_PUMPKIN = 2;
	
	public final AbstractEntity me;
	public final Timeline timeline;
	private Set<Team> _teams;
	private Set<AbstractEntity> _allEntities; public Set<AbstractEntity> getAllEntities() { return _allEntities; }
	private AI _ai;
	public final integer fightType;
	public final integer bossFightType;
	public final integer leeksPerTeamCount;
	public final integer allEntitiesCount;
	
	private static Game? instance;
	
	public static Game getInstance() {
		if (Game.instance == null) {
			Game.instance = new Game();
		}
		return Game.instance!;
	};
	
	private constructor() {
		this._allEntities = <>;
		
		Debug.enabledLog = true;
		Debug.enabledOp = true;
		Debug.enabledInfo = false;

		Debug.startOpCount();
		CellMap.initCellMap();
		Debug.stopOpCount("init CellMap : ");

		Debug.startOpCount();
		Effect.initOnTeamEffects();
		Effect.initEffectClassPerId();
		Effect.initFinalEffectScoreFnctPerId();
		Effect.initGetAppliedValueFnctPerId();
		EntityEffect.initStatsFctPerType();
		Debug.stopOpCount("init statics : ");

		this.fightType = getFightType();
		
		if (this.fightType == FIGHT_TYPE_BOSS) {
			this.bossFightType = 0;
			if (getMapType() == 8)
				this.bossFightType = Game.FIGHT_TYPE_BOSS_NASU;
			else if (getMapType() == 9)
				this.bossFightType = Game.FIGHT_TYPE_BOSS_FENNEL;
			else if (getMapType() == 10)
				this.bossFightType = Game.FIGHT_TYPE_BOSS_PUMPKIN;
		}
		
		Debug.startOpCount();
		this._teams = <>;
		if (this.fightType == FIGHT_TYPE_BOSS) {
			if (this.bossFightType == Game.FIGHT_TYPE_BOSS_FENNEL) {
				initBossFennelFight();	
			} else {
				
			}
		} else if (this.fightType == FIGHT_TYPE_BATTLE_ROYALE) {
			initBRTeams();
		} else {
			initTeams()
		}
		Debug.stopOpCount("init Leeks and Teams : ");

		AbstractEntity? me = AbstractEntity.get(getEntity());
		if (me != null) {
			this.me = me!;

			Debug.log(me);
			
			this._ai = new AI(this.me, this._teams, this.fightType, this.bossFightType);
		} else {
			Debug.error("me is null");
		}
		
		this.timeline = new Timeline(this._allEntities, this.me);
		  
		this.leeksPerTeamCount = setSize(this.me.getTeam()!.getLeeks());
	}
	
	/**
	 * Initialise le combat contre le Boss Fenouil
	 **/
	private void initBossFennelFight() {
		Array<integer> allies = [];
		Array<integer> enemies = [];
		for (integer entityId in getAllies()) {
			push(allies, entityId);
		}
		for (integer entityId in getEnemies()) {
			if (contains(getName(entityId)!, "crystal"))
				push(allies, entityId);
			else
				push(enemies, entityId);
		}
		Crystal.init(getEnemies());
		initMyTeam(allies);
		
		
		King.init(getEnemies());
		Knight.init(getEnemies());
		Scribe.init(getEnemies());
		Squire.init(getEnemies());
		Graal.init(getEnemies());
		initEnemyTeam(enemies);
	}
	
	private void initBRTeams() {
		initMyTeam(getAllies());
		
		Leek.init(getEnemies());
		Bulb.init(getEnemies());
		Chest.init(getEnemies());
		for (Leek leek in Leek.getAll()) {
			setPut(this._teams, new Team(<leek>));
			setPut(this._allEntities, leek);
		}
		for (Bulb bulb in Bulb.getAll()) {
			bulb.getBulbSummoner().getTeam()!.add(bulb);
			setPut(this._allEntities, bulb);
		}
		for (Chest chest in Chest.getAll()) {
			setPut(this._teams, new Team(<chest>));
			setPut(this._allEntities, chest);
		}
	}
	private void initTeams() {
		initMyTeam(getAllies());
		initEnemyTeam(getEnemies());
	}
	
	private void initEnemyTeam(Array<integer> entities) {
		Leek.init(entities);
		Bulb.init(entities);
		Chest.init(entities);
		Turret.init(entities);
		Set<AbstractEntity> ennemies = <>;
		for (integer entityId in entities) {
			AbstractEntity? entity = AbstractEntity.get(entityId);
			if (entity != null) {
				if (entity instanceof Chest) {
					// Chests are in their own Team
					setPut(this._teams, new Team(<entity!>));
				} else {
					setPut(ennemies, entity);
				}
			}
			
			setPut(this._allEntities, AbstractEntity.get(entityId));
		}
		setPut(this._teams, new Team(ennemies));	
	}
	
	private void initMyTeam(Array<integer> entities) {
		Leek.init(entities);
		Bulb.init(entities);
		Turret.init(entities);
		Set<AbstractEntity> allies = <>;
		for (integer entityId in entities) {
			AbstractEntity? entity = AbstractEntity.get(entityId);
			if (entity != null) {
				setPut(allies, entity);
				setPut(this._allEntities, entity);
			} else {
				Debug.error("Entity was null " + entityId);			
			}
		}
		setPut(this._teams, new Team(allies));
	}
	
	public void updateAllStats() {
		AbstractEntity.updateEntitiesStats();
	}
	
	public void startTurn() {		
		// Les bulbes peuvent apparaitre à n'importe quel tour, pas seulement au début
		Bulb.init(getEnemies());
		Bulb.init(getAllies());
		this.updateAllStats();
		this.me.clearAccessibleCellsWithItem();

		for (Team team in this._teams) { team.update(); }
		for (Team team in this._teams) { team.updateMapInfos();	}
		for (Team team in this._teams) { team.updateScores(); }
		AbstractEntity.updateEntitiesScores();
		AbstractEntity.updateSimulationStats();
		
		
		Debug.startOpCount();
		// Need to be done after removing the current entity from the CellMap
		AbstractEntity.updateEntitiesPathLength();
		Debug.stopOpCount("updateEntitiesPathLength : ");
		
		this._allEntities = <>;
		for (Team team in this._teams) {
			for (AbstractEntity entity in team.getEntities()) {
				setPut(this._allEntities, entity);
			}
		}
		this.timeline.update(this._allEntities);

		for (AbstractEntity entity in this._allEntities) {
			Debug.log(entity.getName());
			Debug.log(entity.getScores().getAdjuster());	
		}
				
		this._ai.determineActions();
		
		this.updateAllStats();
		
		this._ai.executeActions();
		this._ai.goToEndOfTurnCell();
		this._ai.selectBestWeapon();
	}
	
	
	public void triggerEntityDisplacedEvent(AbstractEntity entity) {
		this._ai.resetEveryActions();
		//this._ai.addDisplacingAction();
	}
	public void triggerEntityDiedEvent() {
		this._ai.resetEveryActions();
	}
}