include("Cell");
include("MoveCell");
include("ScoreMap");
include("AccessibleCells");

class CellMap {
	public static final integer xMin = -17;
	public static final integer yMin = -17;
	public static final integer xMax = 17;
	public static final integer yMax = 17;
		
	private static final Map<integer, Cell> _cells = [:]; public static Map<integer, Cell> getCells() { return CellMap._cells; }
	private static final Set<Cell> _occupiedCells = <>; public static Set<Cell> getOccupiedCells() { return CellMap._occupiedCells; }
	private static string _occupiedCellsHash; public static string getOccupiedCellsHash() { return CellMap._occupiedCellsHash; }

	private constructor() {}
	public static initCellMap() {
		for (integer x = CellMap.xMin; x <= CellMap.xMax; x++) {
			integer absX = abs(x);
			for (integer y = CellMap.yMin; y <= CellMap.yMax; y++) {
				if (absX + abs(y) <= CellMap.yMax) {
					integer cellId = getCellFromXY(x, y)!;
					integer cellType = getCellContent(cellId);
					CellMap._cells[cellId] = new Cell(cellId, cellType);
				}
			}
		}
			
		CellMap.initNeighboursCells();
	}
	
	public static Cell? getCell(integer id) {
		return CellMap._cells[id];
	}
	
	public static void triggerCellTypeChangedEvent(Cell cell, integer newType) {
		boolean isModified = false;
		if (newType == CELL_ENTITY) {
			isModified = setPut(CellMap._occupiedCells, cell);
		} else {
			isModified = setRemove(CellMap._occupiedCells, cell);
		}
		
		if (isModified) {
			Array<Cell> orderedOccupiedCells = arraySort(setToArray(CellMap._occupiedCells), function(Cell c1, Cell c2) => integer {
				return c1.id - c2.id;
			}) as Array<Cell>;
			CellMap._occupiedCellsHash = "";
			for (Cell c in orderedOccupiedCells) {
				CellMap._occupiedCellsHash += c.id + "|";
			} 
		}
	}
	
	private static void initNeighboursCells() {
		for (integer x = CellMap.xMin; x <= CellMap.xMax; x++) {
			integer absX = abs(x);
			for (integer y = CellMap.yMin; y <= CellMap.yMax; y++) {
				if (absX + abs(y) <= CellMap.yMax) {
					integer? id = getCellFromXY(x, y);
					if (id == null) continue;
					
					Cell? cell = CellMap.getCell(id!);
					if (cell == null) continue;

					integer? n = getCellFromXY(x, y + 1);
					if(n != null)
						cell!.N = CellMap.getCell(n!);

					integer? ne = getCellFromXY(x - 1, y + 1);
					if(ne != null)
						cell!.NE = CellMap.getCell(ne!);

					integer? e = getCellFromXY(x - 1, y);
					if(e != null)
						cell!.E = CellMap.getCell(e!);

					integer? se = getCellFromXY(x - 1, y - 1);
					if(se != null)
						cell!.SE = CellMap.getCell(se!);

					integer? s = getCellFromXY(x, y - 1);
					if(s != null)
						cell!.S = CellMap.getCell(s!);

					integer? sw = getCellFromXY(x + 1, y - 1);
					if(sw != null)
						cell!.SW = CellMap.getCell(sw!);

					integer? w = getCellFromXY(x + 1, y)
					if(w != null)
						cell!.W = CellMap.getCell(w!);

					integer? nw = getCellFromXY(x + 1, y + 1)
					if(nw != null)
						cell!.NW = CellMap.getCell(nw!);
				}
			}
		}
	}
	
	public static AccessibleCells getAccessibleCells(Cell startCell, integer mp) {
		return CellMap.accessibleCellsMemo.apply(startCell, mp) as AccessibleCells;
	}
	private static Memoize2 accessibleCellsMemo = new Memoize2(function (Cell startCell, integer mp) => AccessibleCells {
		AccessibleCells accessibleCells = new AccessibleCells();
		accessibleCells.addMoveCell(new MoveCell(startCell, 0, max(0, mp)));
		Set<Cell> pastMpTravelledCells = <>;
		setPut(pastMpTravelledCells, startCell);

		for (integer i = 1; i <= mp; i++) {
			Set<Cell> clonedTravelledCells = clone(pastMpTravelledCells) as Set<Cell>;
			setClear(pastMpTravelledCells);
			for (Cell c in clonedTravelledCells) {
				Cell? tmpC = c.N;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
				tmpC = c.E;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
				tmpC = c.S;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
				tmpC = c.W;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
			}
		}
		return accessibleCells;
	}, function(Cell startCell, integer mp) {
		return CellMap.getOccupiedCellsHash() + "," + startCell.id + "," + max(0, mp);
	});
	public static void resetAccessibleCellsMemo() {
		CellMap.accessibleCellsMemo.reset();
	}

