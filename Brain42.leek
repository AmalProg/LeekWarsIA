/** IA v5/Entities/Turret **/




class Turret extends AbstractEntity {
	/** Turrets pool **/
	private static final Map<integer, Turret> turrets = [:];
	public static initTurrets(Array<integer> entitiesId) {
		for (integer turretId in entitiesId) {
			if (getType(turretId) == ENTITY_TURRET) {
				turrets[turretId] = new Turret(turretId);
				AbstractEntity.entities[turretId] = turrets[turretId];
			}
		}
	}
	public static get(integer id) {
		return Turret.turrets[id];
	}
	/** fin turrets pool **/

	constructor(integer id) {
		super(id);
	}
	
	public static updateTurretsStats() {
		for (var turret in Turret.turrets) {
			turret.updateStats();
		}
	}
	protected void updateStats() {
		super.updateStats();
		// can't move
		this._stats.useMP(this._stats.getMP());
	}
}
/** IA v5/Entities/Teams/TeamScores **/



class TeamScores {
	public real directDamageDanger;
	public real poisonDamageDanger;

	private Team _team;
	
	private constructor() {}
	constructor(Team team) {
		this._team = team;
	}
	
	private void reset() {
		this.directDamageDanger = 0.0;
		this.poisonDamageDanger = 0.0;
	}
	
	public void update() {
		this.reset();
		
		integer entitiesAliveCount = setSize(this._team.getAlive());
		for (AbstractEntity entity in this._team.getAlive()) {
			EntityStats eStats = entity.getStats();
			this.directDamageDanger += eStats.getStrength() / (EntityStatsDiviser.strength * 1.5);
			this.poisonDamageDanger += eStats.getMagic() / (EntityStatsDiviser.magic * 1.5);
		}
	}
}
/** IA v5/Entities/Teams/TeamMapInfos **/



class TeamMapInfos {
	private static final integer POSSIBLE_TARGET_DIST = 14;
	private static final integer ALLIES_NEEDED_GOOD_TARGET = 2;
	
	public Set<AbstractEntity> goodTargets;
	public Set<AbstractEntity> possibleTargets;
	
	private Team _team;
	
	private constructor() {}
	constructor(Team team) {
		this._team = team;
	}
	
	private void reset() {
		this.goodTargets = <>;
		this.possibleTargets = <>;
	}
	
	public void update() {
		this.reset();
		
		Set<Cell> alliesCells = <>;
		for (AbstractEntity entity in this._team.getAlive()) {
			setPut(alliesCells, entity.getCell());
		}
		Cell alliesBarycenterCell = Cell.getBarycenterCell(alliesCells);
		
		for (AbstractEntity enemy in GAME.getAllEntities()) {		
			if (enemy.getTeam() == this._team || !enemy.isEntityAlive() || enemy instanceof Bulb) continue;
			
			Cell enemyCell = enemy.getCell()!;
			integer enemyRel = enemy.getStats().getRel();
			integer enemyAbso = enemy.getStats().getAbso();
			
			integer goodTargetCount = 0;
			if (enemyRel < EntityStatsDiviser.rel / 3 && enemyAbso < EntityStatsDiviser.abso / 2) {
				for (AbstractEntity entity in this._team.getAlive()) {
					integer dist = Cell.getDistance(enemyCell, entity.getCell()!);
					integer entityMP = entity.getStats().getMP();
					if (dist <= entityMP * 1.4) {
						goodTargetCount++;
					}
				}
			}
			// Si l'ennemi a peu de shield et qu'il est proche d'au moins 2 alliés
			if (goodTargetCount >= TeamMapInfos.ALLIES_NEEDED_GOOD_TARGET) {
				setPut(this.goodTargets, enemy);
			}
			
			integer distToBarycenter = Cell.getDistance(enemyCell, alliesBarycenterCell);
			if (distToBarycenter < TeamMapInfos.POSSIBLE_TARGET_DIST) {
				setPut(this.possibleTargets, enemy);
			}
		}
		
		debug("goodTargets : " + this.goodTargets);
		debug("possibleTargets : " + this.possibleTargets);
	}
}

class Team {
	/** teams pool **/ 
	private static final Set<Team> teams = <>;
	public static Set<Team> getTeams() { return Team.teams; }
	/** fin teams pool **/
	
	private Set<AbstractEntity> _entities; public Set<AbstractEntity> getEntities() { return this._entities; }
	private Set<Leek> _leeks; public Set<Leek> getLeeks() { return this._leeks; }
	private Set<Bulb> _bulbs; public Set<Bulb> getBulbs() { return this._bulbs; }
	private Set<AbstractEntity> _alive; public Set<AbstractEntity> getAlive() { return this._alive; }
	private Set<Leek> _aliveLeeks; public Set<Leek> getAliveLeeks() { return this._aliveLeeks; }
	private Set<Leek> _deadLeeks; public Set<Leek> getDeadLeeks() { return this._deadLeeks; }
	private Turret? _turret; public Turret? getTurret() { return this._turret; }
		
	public itemsEffects = [];
	private TeamScores _scores; public TeamScores getScores() { return this._scores; }
	private TeamMapInfos _mapInfos; public TeamMapInfos getMapInfos() { return this._mapInfos; }
	
	constructor(Set<AbstractEntity> entities) {
		this._entities = <>;
		this._leeks = <>;
		this._bulbs = <>;
		this._alive = <>;
		this._aliveLeeks = <>;
		this._deadLeeks = <>;
		
		for (AbstractEntity entity in entities) {		
			this.add(entity);
		}
		
		this._scores = new TeamScores(this);
		this._mapInfos = new TeamMapInfos(this);
		
		setPut(Team.teams, this);
	}
	
	public void add(AbstractEntity entity, boolean isUpdating = false) {
		if (!isUpdating && entity.getTeam() != null) {
			Debug.error(entity.getId() + "(" + entity.getName() + ") already has a Team");
			return;
		}
		entity.setTeam(this);
		
		if (!setContains(this._entities, entity.getId())) {
			if (entity instanceof Bulb) {
				if (entity.isEntityAlive()) {
					setPut(this._alive, entity);
					setPut(this._bulbs, entity);
				}
			} else if (entity instanceof Turret) {
				this._turret = entity as Turret;
			} else if (entity instanceof Leek) {
				setPut(this._leeks, entity);
				if (entity.isEntityAlive()) {
					setPut(this._alive, entity);
					setPut(this._aliveLeeks, entity);
				} else {
					setPut(this._deadLeeks, entity);
				}
			}
			
			setPut(this._entities, entity);
		}
	}
	
	public void update() {
		Set<AbstractEntity> tmpEntities = clone(this._entities) as Set<AbstractEntity>;
		setClear(this._entities);
		setClear(this._alive);
		setClear(this._aliveLeeks);
		setClear(this._deadLeeks);
		setClear(this._bulbs);
		this._turret = null;
		
		for (AbstractEntity entity in tmpEntities) {
			this.add(entity, true);
		}
	}
	public void updateMapInfos() {
		this._mapInfos.update();
	}
	public void updateScores() {
		this._scores.update();
	}
	
	public string string() {
		return "{" +
		 "entities : " + this._entities + "\n" +
		 "alive : " + this.getAlive() + "\n" +
		 "leeks : " + this.getLeeks() + "\n" +
		 "deadLeeks : " + this.getDeadLeeks() + "\n" +
		 "aliveLeeks : " + this.getAliveLeeks() + "\n" +
		 "bulbs : " + this.getBulbs() + "\n" +
		 "turret : " + this.getTurret() + "\n" +
		"}"
	}
}



class AbstractEntity {
	public static final integer ACCESSIBLE_CELLS_SIZE = 40; 
	
	/** entities pool **/
	protected static final Map<integer, AbstractEntity> entities = [:];
	public static AbstractEntity? get(integer id) {
		return AbstractEntity.entities[id];
	}
	/** fin entities pool **/
	
	protected final integer _id; public integer getId() { return this._id; }
	protected final string _farmerName; public string getFarmerName() { return this._farmerName; }
	protected final string _name; public string getName() { return this._name; }
	protected final integer _level; public integer getLevel() { return this._level; }
	protected Team _team;
	public Team? getTeam() { return this._team; }
	public void setTeam(Team team) { this._team = team; }
	protected final boolean _isAlly; public boolean isAnAlly() { return this._isAlly; }
	protected final boolean _isSummon; public boolean isSummon() { return this._isSummon; }
	protected final boolean _isStatic; public boolean isStatic() { return this._isStatic; }
	protected integer _powerOnDeath; public integer getPowerOnDeath() { return this._powerOnDeath; }
	protected boolean _isAlive; public boolean isEntityAlive() { return this._isAlive; }

	protected Cell? _cell;
	public Cell? getCell() { return this._cell; }
	protected integer _turnOrder; public integer getTurnOrder() { return this._turnOrder; }
	protected Set<Item> _items; public Set<Item> getItems() { return this._items; }
	protected Array<Item> _movementItems; public Array<Item> getMovementItems() { return this._movementItems; }
	protected Map<Item, integer> _cooldowns; public Map<Item, integer> getCooldowns() { return this._cooldowns; }

	protected SimulationEntity _simulationEntity;  public SimulationEntity getSimulationEntity() { return this._simulationEntity; }
	protected AccessibleCells _pathLengthCells; public AccessibleCells getPathLengthCells() { return this._pathLengthCells; }
	protected AccessibleCells _initialAccessibleCells; public AccessibleCells getInitialAccessibleCells() { return this._initialAccessibleCells; }
	protected Map<integer, AccessibleCells> _accessibleCellsWithItem;
	protected EntityStats _baseStats; public EntityStats getBaseStats() { return this._baseStats; }
	protected EntityStats _stats; public EntityStats getStats() { return this._stats; }
	protected EntityScores _scores;	public EntityScores getScores() { return this._scores; }
	
	protected Array<EntityEffect> _launchedEffects;
	protected Array<Bulb> _summons;
 
	private constructor() {}
	constructor(integer id) {
		this._id = id;
		this._items = <>;
		this._movementItems = [];
		this._cooldowns = [:];
		this._launchedEffects = [];
		this._summons = [];
		
		this._farmerName = getFarmerName(this._id)!;
		this._name = getName(this._id)!;
		this._level = getLevel(this._id)!;
		this._isAlly = isAlly(this._id);
		this._isSummon = isSummon(this._id)!;
		this._isStatic = isStatic(this._id);
		
		this._accessibleCellsWithItem = [:];
		
		this.initStats();
		this._simulationEntity = new SimulationEntity(this);
	}
	
	private void initStats() {
		this._powerOnDeath = 0;
			
		this._isAlive = isAlive(this._id);

		if (this._isAlive) {
			this._cell = CellMap.getCell(getCell(this._id)!);
			this._turnOrder = getEntityTurnOrder(this._id) - getEntityTurnOrder();
		} else {
			this._cell = null;
			this._turnOrder = -99;
		}

		for(var chipId in getChips(this._id)!) {
			var item = Chip.get(chipId);
			setPut(this._items, item);
			this._cooldowns[item] = getCooldown(chipId, this._id);
			
			if (item.hasEffectTypeIn(Effect.teleportEffects)) {
				push(this._movementItems, item);
			}
			
			// Ordonne les item de téléport du plus petit coût au plus grand
			this._movementItems = arraySort(this._movementItems, function(Item i1, Item i2) => integer {
				return i1.getCost() - i2.getCost();
			}) as Array<Item>;
		}


		this._baseStats = new EntityStats(this);	
		// les poireaux n'ont pas d'effet de base
		this._baseStats.removeEffects(this._baseStats.getEffects());
		this._scores = new EntityScores(this);
	}

	public void updateStats() {
		this._isAlive = isAlive(this._id);
		
		if (this._isAlive) {
			// Change the cell to it's new location and update the CellMap
			this.setCell(CellMap.getCell(getCell(this._id)!))
		} else {
			// L'entité est morte donc elle n'est plus sur la map
			this.setCell(null);
		}

		this._launchedEffects = [];
		for (Array<boolean|integer> effect in getLaunchedEffects(this._id)!) {
			push(this._launchedEffects, new EntityEffect(effect));
		}
		
		this._summons = [];
		for (integer summonId in getSummons(this._id)) {
			push(this._summons, AbstractEntity.get(summonId));
		}
		
		if (this._isAlive) {
			this._turnOrder = getEntityTurnOrder(this._id)! - getEntityTurnOrder();
		} else {
			this._turnOrder = -99;
		}
		
		for (Item item in this._items) {
			this._cooldowns[item] = getCooldown(item.getId(), this._id);
		}
		
		this._stats = new EntityStats(this);
	}

	public static updateEntitiesScores() {
		for (AbstractEntity entity in AbstractEntity.entities) {
			entity.updateScores();
		}
	}
	public void updateScores() {
		this._scores.updateScoreAdjuster();
	}

	public static updateSimulationStats() {
		for (AbstractEntity entity in AbstractEntity.entities) {
			entity.getSimulationEntity().updateStats();
		}
	}

	public static updatePositions() {
		for (AbstractEntity entity in AbstractEntity.entities) {
			entity.updatePosition();
		}
	}
	public void updatePosition() {
		integer? cellId = getCell(this._id);
		if (cellId != null)
			this.setCell(CellMap.getCell(cellId!));
		else
			this.setCell(null);
	}

	public static updateEntitiesPathLength() {
		for (AbstractEntity entity in AbstractEntity.entities) {
			entity.updatePathLength();
		}
	}
	public void updatePathLength() {
		if (this._isAlive) {
			this._initialAccessibleCells = CellMap.getAccessibleCells(this._simulationEntity.getCell()!, this._stats.getMP());
			this._pathLengthCells = CellMap.getAccessibleCells(this._simulationEntity.getCell()!, AbstractEntity.ACCESSIBLE_CELLS_SIZE);
			
			//if (this._id == getEntity()) {
				//clearMarks()
				//CellMap.markAccessibleCells(CellMap.getAccessibleCellsWithTeleport(this._simulationEntity.getCell()!, this._stats.getMP(), Item.get(CHIP_JUMP)!));
				//pause();
			//}
		}
	}
	private AccessibleCells? createAccessibleCellsWithItem(Item item, integer dist) {
		AccessibleCells? accCells = null;
		if (item.hasEffectType(EFFECT_TELEPORT)) {
			accCells = CellMap.getAccessibleCellsWithTeleport(this._simulationEntity.getCell()!, this._simulationEntity.getMP(), item);
			
		} else if (item.hasEffectTypeIn(<EFFECT_RAW_BUFF_MP, EFFECT_BUFF_MP>)) {
			integer mp = this._simulationEntity.getMP();
			for (Effect eff in item.getEffectsOfTypes(<EFFECT_RAW_BUFF_MP, EFFECT_BUFF_MP>))
				mp += eff.getAppliedValue(null, null, this, this._stats, this._stats, dist, true);
			accCells = CellMap.getAccessibleCells(this._simulationEntity.getCell()!, mp);
	
		}
		return accCells;
	}
	public AccessibleCells? getAccessibleCellsWithItem(Item item, integer dist = 0) {
		integer key = item.getId() << 10 | this._simulationEntity.getMP();
		
		if (mapContainsKey(this._accessibleCellsWithItem, key))
			return this._accessibleCellsWithItem[key];
		else 
			return this._accessibleCellsWithItem[key] = createAccessibleCellsWithItem(item, dist);
	}
	public void clearAccessibleCellsWithItem() {
		mapClear(this._accessibleCellsWithItem);
	}
 	public AccessibleCells getPathCalcAccessibleCells() {
		return CellMap.getAccessibleCells(this._simulationEntity.getCell()!, this._simulationEntity.getMP());
	}
	
	public void updateAliveState(AbstractEntity caster) {
		if (this._stats.getLife() <= 0) {
			if (this._isAlive) 
				this.kill(caster);
		}
	}

	public integer getItemCooldown(Item item) {
		return mapGet(this._cooldowns, item, -1) as integer;
	}

	public Array<Item> getOffCooldownMovementItemsOrderedByCost() {
		Array<Item> offCooldownItems = [];
		for (Item item in this._movementItems) {
			if (this._cooldowns[item] == 0)
				push(offCooldownItems, item);
		}
		return offCooldownItems;
	}

	public Set<Item> getOffCooldownItems() {
		Set<Item> offCooldownItems = <>;
		for (Item item in this._items) {
			if (this._cooldowns[item] == 0)
				setPut(offCooldownItems, item);
		}
		return offCooldownItems;
	}

	public Set<Item> getOffCooldownsItemsInTurns(integer turns) {
		Set<Item> offCooldownItems = <>;
		for (Item item in this._items) {
			if (this._cooldowns[item] <= turns)
				setPut(offCooldownItems, item);
		}
		return offCooldownItems;
	}

	public EntityStats getStatsInTurns(integer turns) {
		EntityStats statsInTurns = new EntityStats();

		statsInTurns.copy(this._stats);
		statsInTurns.clearEffects();
		statsInTurns.addEffects(this._stats.getEffectsInTurns(turns));
		
		return statsInTurns;
	}

	public void simulateItemUse(Item item) {			
		this.useTP(item.getCost());
		this._cooldowns[item] = item.getBaseCooldown();
	}

	public void unsimulateItemUse(Item item) {			
		this.useTP(-item.getCost());
		this._cooldowns[item] = 0;
	}	
	
	public void kill(AbstractEntity caster) {
		if (!this._isAlive) return;
		
		this._isAlive = false;
		this.setCell(null);
		
		if (caster instanceof Leek) {
			PassiveEffect? eff = (caster as Leek).getPassiveItemEffects()[EFFECT_KILL_TO_TP];
			if (eff != null) {
				eff!.applyPassiveTo(caster, caster, 0, 1);
			}
		}

		for (EntityEffect eff in this._stats.getEffects()) {
			eff.getCaster().removeLaunchedEffect(eff);
		}
		this._stats.copy(this._baseStats);
		for (EntityEffect eff in this._launchedEffects) {
			eff.getTarget()!.getStats().removeEffect(eff);
		}
		this._launchedEffects = [];
		for (AbstractEntity summon in this._summons) {
			summon.kill(this);
		}
		this._summons = [];
		this._turnOrder = -1;
		
		this._team.update();
		GAME.triggerEntityDiedEvent();
	}
	
	public void resurrection(Cell cell) {
		this._stats.setMaxLife(max(10, round(this._stats.getMaxLife() * 0.5)));
		this._stats.setLife(this._stats.getMaxLife());
		this._isAlive = true;
		this.setCell(cell);
		
		GAME.triggerEntityDisplacedEvent();
	}
	
	public void removeLaunchedEffect(EntityEffect effect) {
		removeElement(this._launchedEffects, effect);
	}

	private void setCell(Cell? cell) {
		if(getTurn() >= 11) {
			debug(this + " " + this._cell + " "	+ cell);
		}
		// On vérifie que c'est bien nous sur la cellule et qu'il n'y a pas eu l'update d'une autre entité avant
		if (this._cell != null && this._cell!.getCellEntity() == this)
			this._cell!.setType(CELL_EMPTY);

		if (cell == null) {
			this._cell = null;
		} else {
			this._cell = cell;
			this._cell!.setType(CELL_ENTITY, this);
		}
	}
	
	/**
	 * Simule l'inversion de 2 entités
	 * 
	 * @param otherEntity : entité
	 **/
	public void invert(AbstractEntity otherEntity, Cell cellFrom) {
		var tmpE1Cell = cellFrom;
		this.setCell(otherEntity.getCell());
		otherEntity.setCell(tmpE1Cell);
		
		if (this._id != getEntity())
			this.updatePathLength();
		
		GAME.triggerEntityDisplacedEvent();
	}
	
	/**
	 * Simule le déplacement
	 * 
	 * @param cell : cellule d'arrivée
	 * @param mp  : mp utilisés 
	 **/
	public void move(Cell cell, integer mp) {
		this.setCell(cell);
		this.useMP(mp);
	}
	
	/**
	 * Simule la téléportation
	 * 
	 * @param cell : cellule d'arrivée
	 **/
	public teleport(Cell? cell) {
		if (cell == null) {
			Debug.error("Teleportation vers une cell null impossible");
			return;
		}

		this.setCell(cell);

		if (this._id != getEntity())
			this.updatePathLength();
	}
	
	/**
	 * Simule l'attraction
	 * 
	 * @param cell : cellule d'arrivée
	 **/
	public void attract(Cell cell) {
		this.setCell(cell);
		
		if (this._id != getEntity())
			this.updatePathLength();
		
		GAME.triggerEntityDisplacedEvent();
	}
	
	/**
	 * Simule la poussée
	 * 
	 * @param cell : cellule d'arrivée
	 **/
	public void pushTo(Cell cell) {			
		this.setCell(cell);
		
		if (this._id != getEntity())
			this.updatePathLength();
		
		GAME.triggerEntityDisplacedEvent();
	}

	public void useTP(integer tp) {
		this._stats.useTP(tp);
	}

	public void useMP(integer mp) {
		this._stats.useMP(mp);
	}

	public static string getTargetsHash(Set<AbstractEntity> targets, Cell cellTarget, boolean isAreaLaserLine = false) {
		Array<AbstractEntity> orderedTargets = setToArray(targets) as Array<AbstractEntity>;
		orderedTargets = arraySort(orderedTargets, function(AbstractEntity a1, AbstractEntity a2) => integer {
			return a1.getId() - a2.getId();
		}) as Array<AbstractEntity>;

		string targetsHash = "";
		for (AbstractEntity entity in orderedTargets) {
			integer dist = 0;
			if (!isAreaLaserLine) {
				dist = Cell.getDistance(cellTarget, entity.getCell()!);
			}
			targetsHash += entity.getId() + "|" + dist + ",";		
		}

		return targetsHash;
	}
	
	public printDebug() {
		return "{name: " + this._name +
			"\n id: " + this._id +
			"\n isAlly: " + this._isAlly +
			"\n isSummon: " + this._isSummon +
			"\n isStatic: " + this._isStatic +
			"\n isAlive: " + this._isAlive +
			"\n items: " + this._items +
			"\n movementItems: " + this._movementItems +
			"\n cooldowns: " + this._cooldowns +
			"\n baseStats: " + this._baseStats +
			"\n stats: " + this._stats +
			"\n launchedEffects: " + this._launchedEffects +
			"\n summons: " + this._summons +
			"\n cell: " + this._cell + "}\n";
	}

	public string() {
		return "{name: " + this._name +
			", cell: " + this._cell +
			", isAlly: " + this._isAlly + "}\n";
	}
}

class Cell {
	public final integer id;
	public final integer x;
	public final integer y;
	
	public Cell? N;
	public Cell? NE;
	public Cell? E;
	public Cell? SE;
	public Cell? S;
	public Cell? SW;
	public Cell? W;
	public Cell? NW;
	
	private AbstractEntity? _entity; public AbstractEntity? getCellEntity() { return _entity!; }
	private integer _type = CELL_EMPTY; public integer getType() { return _type; }
	public boolean _isWalkable; public boolean isWalkable() { return _isWalkable; }
	public boolean _isObstacle; public boolean isObstacle() { return _isObstacle; }
	public boolean _hasEntity; public boolean hasEntity() { return _hasEntity; }
	private boolean _hasPlayer; public boolean hasPlayer() { return _hasPlayer; }
	
	
	constructor(integer id, integer type) {
		this.id = id;
		this.x = getCellX(this.id)!;
		this.y = getCellY(this.id)!;
		 
		this.setType(type);
	}
	
	constructor(integer x, integer y, integer type) {
		this.id = getCellFromXY(x, y)!;
		this.x = x;
		this.y = y;
		
		this.setType(type);
	}
	
	public void setType(integer type, AbstractEntity? entity = null) {
		this._type = type;
		if (this._type == CELL_EMPTY) {
			this._entity = entity;
			this._isWalkable = true;
			this._isObstacle = false;
			this._hasEntity = false;
			this._hasPlayer = false;
		} else if (this._type == CELL_OBSTACLE) {
			this._entity = entity;
			this._isWalkable = false;
			this._isObstacle = true;
			this._hasEntity = false;
			this._hasPlayer = false;
		}  else if (this._type == CELL_ENTITY) {
			// On ne veut pas l'entity jouant sur la CellMap
			if (entity != null && entity!.getId() != getEntity()) {
				this._isWalkable = false;
				this._isObstacle = false;
				this._hasEntity = true;
				this._entity = AbstractEntity.get(entity!.getId());
				
			} else if (entity != null && entity!.getId() == getEntity()) {
				this._hasPlayer = true;
				type = CELL_EMPTY;
			}
		}
		
		CellMap.triggerCellTypeChangedEvent(this, type);
	}
	
	public static integer getIdFromXY(integer x, integer y) {
		return 306 + 18 * x + 17 * y;
	}
	
	/**
	 * @params c1 : cellule
	 * @params c2 : cellule
	 * 
	 * @return la distance entre les deux cellules à vole d'oiseau
	 **/
	public static integer getDistance(Cell c1, Cell c2) {
		integer distX = c1.x - c2.x;
		integer distY = c1.y - c2.y;
		return (distX >= 0 ? distX : -distX) + (distY >= 0 ? distY : -distY);
	}
	
	/**
	 * @params c1 : cellule
	 * @params c2 : cellule
	 * 
	 * @return la distance entre les deux cellules à vole d'oiseau
	 **/
	public static Cell getBarycenterCell(Set<Cell> cells) {
		integer sumX = 0;
		integer sumY = 0;
		for (Cell cell in cells) {
			sumX += cell.x;
			sumY += cell.y;
		}
		integer cellsCount = setSize(cells);
		
		return CellMap.getCell(Cell.getIdFromXY(round(sumX / cellsCount), round(sumY / cellsCount)))!;
	}
	
	/**
	 * @params Cell c1
	 * @params Cell c2
	 * 
	 * @return true si les cellules sont sur la même ligne
	 **/
	public static boolean isOnSameLine(Cell c1, Cell c2) {
		if (c1.x == c2.x) return true;
		return c1.y == c2.y;
	}
	
	/**
	 * @params Cell cellTarget
	 * @params Cell c1
	 * @params Cell c2
	 * 
	 * @return true si les cellules c1 et c2 sont du même coté par rapport à cellTarget
	 **/
	public static boolean isOnSameDirection(Cell cellTarget, Cell c1, Cell c2) {
		return signum(cellTarget.x - c1.x as real) == signum(cellTarget.x - c2.x as real) && signum(cellTarget.y - c1.y as real) == signum(cellTarget.y - c2.y as real);
	}
	
	/** For debug purposes **/
	public string string() {
		return "{id : " + this.id + "}";
	}
}
/** IA v5/Map/MoveCell **/



class MoveCell {
	public final Cell cell;
	public final integer mpUsed;
	public final integer mpRemain;
	public final Item? itemTeleport;
	public final Cell? cellFromTeleport;
	public final Cell? cellToTeleport;
	
	public constructor(Cell cell, integer mpUsed, integer mpRemain, Item? item = null, Cell? cellFrom = null, Cell? cellTo = null) {
		this.cell = cell;
		this.mpUsed = mpUsed;
		this.mpRemain = mpRemain;
		this.itemTeleport = item;
		this.cellFromTeleport = cellFrom;
		this.cellToTeleport = cellTo;
	}
	
	public static Set<Cell> getCellsSet(Set<MoveCell> moveCells) {
		Set<Cell> cells;
		for (MoveCell moveCell in moveCells)
			setPut(cells, moveCell.cell);
		
		return cells;
	}
	
	public static Map<Cell, MoveCell> getCellsMap(Set<MoveCell> moveCells) {
		Map<Cell, MoveCell> cells;
		for (MoveCell moveCell in moveCells)
			cells[moveCell.cell] = moveCell;
		
		return cells;
	}
	
	public string string() {
		string r = "{cell : " + this.cell + ", mpUsed : " + this.mpUsed + ", mpRemain : " + this.mpRemain;
		if (this.cellFromTeleport != null) {
			r += ", moveItem : " + this.itemTeleport + ", cellFromTP : " + this.cellFromTeleport + ", cellToTP : " + this.cellToTeleport;
		}
		r += "}";
		return r;
	}
}
/** IA v5/Map/ScoreMap **/



class ScoreMap {
	private final Map<Cell, real> _scoreCells; public Map<Cell, real> getScoreCells() { return this._scoreCells; }
	private final real _baseValue;
	
	private constructor() {}
	constructor(Set<Cell> cells, real baseValue) {
		this._scoreCells = [:];
		this._baseValue = baseValue;
		
		for (Cell cell in cells) {
			this._scoreCells[cell] = this._baseValue;
		}
	}
	
	public real getMaxScore() {
		return mapMax(this._scoreCells) as real;
	}
	public real getMinScore() {
		return mapMin(this._scoreCells) as real;
	}
	
	public real getScore(Cell cell) {
		return mapGet(this._scoreCells, cell, this._baseValue) as real;
	}
	
	public void resetScore() {
		for (Cell cell : real score in this._scoreCells) {
			this._scoreCells[cell] = this._baseValue;
		}
	}
	
	public void setScores(Set<Cell> cells, real score) {
		for (Cell cell in cells) {
			this._scoreCells[cell] = score;
		}
	}
	public void setScore(Cell cell, real score) {
		this._scoreCells[cell] = score;
	}
	
	public void setHighestScores(Set<Cell> cells, real score) {
		for (Cell cell in cells) {
			if (!mapContainsKey(this._scoreCells, cell) || score > this._scoreCells[cell])
				this._scoreCells[cell] = score;
		}
	}
	public void setHighestScore(Cell cell, real score) {
		if (!mapContainsKey(this._scoreCells, cell) || score > this._scoreCells[cell])
			this._scoreCells[cell] = score;
	}
	
	public void setLowestScores(Set<Cell> cells, real score) {
		for (Cell cell in cells) {
			if (!mapContainsKey(this._scoreCells, cell) || score < this._scoreCells[cell])
				this._scoreCells[cell] = score;
		}
	}
	public void setLowestScore(Cell cell, real score) {
		if (!mapContainsKey(this._scoreCells, cell) || score < this._scoreCells[cell])
			this._scoreCells[cell] = score;
	}
	
	public void addScores(Set<Cell> cells, real score) {
		for (Cell cell in cells) {
			if (!mapContainsKey(this._scoreCells, cell))
				this._scoreCells[cell] = score;
			else
				this._scoreCells[cell] += score;
		}
	}
	public void addScore(Cell cell, real score) {
		if (!mapContainsKey(this._scoreCells, cell))
			this._scoreCells[cell] = score;
		else
			this._scoreCells[cell] += score;
	}
	
	public void removeScores(Set<Cell> cells, real score) {
		this.addScores(cells, -score);
	}
	public void removeScore(Cell cell, real score) {
		this.addScore(cell, -score);
	}
	
	public void debugMap() {
		for (Cell cell : real score in this._scoreCells) {
			if (score == this._baseValue)
				markText([cell.id], "-", COLOR_RED);
			else
				markText([cell.id], round(score), COLOR_RED);
		}
	}
}
/** IA v5/Map/AccessibleCells **/



class AccessibleCells {
	private final Set<Cell> cells; public Set<Cell> getCells() { return this.cells; }
	private final Map<Cell, MoveCell> moveCells; public Map<Cell, MoveCell> getMoveCells() { return this.moveCells; }

	constructor() {
		this.cells = <>;
		this.moveCells = [:];
	}
	
	public void addMoveCell(MoveCell moveCell) {
		setPut(this.cells, moveCell.cell);
		mapPut(this.moveCells, moveCell.cell, moveCell);
	}
	public void removeMoveCell(Cell cell) {
		setRemove(this.cells, cell);
		mapRemove(this.moveCells, cell);
	}
	
	public Array<MoveCell> getOrderedPerMpUsedMoveCell(boolean isAsc) {
		if (isAsc) {
			return arraySort(mapValues(this.moveCells), function(MoveCell mc1, MoveCell mc2) => integer {
				return mc1.mpUsed - mc2.mpUsed;
			}) as Array<MoveCell>;
		} else {
			return arraySort(mapValues(this.moveCells), function(MoveCell mc1, MoveCell mc2) => integer {
				return mc2.mpUsed - mc1.mpUsed;
			}) as Array<MoveCell>;
		}
	}
	
	public MoveCell? getMoveCell(Cell cell) {
		return mapGet(this.moveCells, cell, null) as MoveCell;
	}
	public boolean hasCell(Cell cell) {
		return mapContainsKey(this.moveCells, cell);
	}
	
	public integer? getMpUsed(Cell cell) {
		if (mapContainsKey(this.moveCells, cell))
			return this.moveCells[cell]!.mpUsed;	
		return null;
	}
}

class CellMap {
	public static final integer xMin = -17;
	public static final integer yMin = -17;
	public static final integer xMax = 17;
	public static final integer yMax = 17;
		
	private static final Map<integer, Cell> _cells = [:]; public static Map<integer, Cell> getCells() { return CellMap._cells; }
	private static final Set<Cell> _occupiedCells = <>;
	private static string _occupiedCellsHash; public static string getOccupiedCellsHash() { return CellMap._occupiedCellsHash; }

	private constructor() {}
	public static initCellMap() {
		for (integer x = CellMap.xMin; x <= CellMap.xMax; x++) {
			integer absX = abs(x);
			for (integer y = CellMap.yMin; y <= CellMap.yMax; y++) {
				if (absX + abs(y) <= CellMap.yMax) {
					integer cellId = getCellFromXY(x, y)!;
					integer cellType = getCellContent(cellId);
					CellMap._cells[cellId] = new Cell(cellId, cellType);
				}
			}
		}
			
		CellMap.initNeighboursCells();
	}
	
	public static Cell? getCell(integer id) {
		return CellMap._cells[id];
	}
	
	public static void triggerCellTypeChangedEvent(Cell cell, integer newType) {
		boolean isModified = false;
		if (newType == CELL_ENTITY) {
			isModified = setPut(CellMap._occupiedCells, cell);
		} else {
			isModified = setRemove(CellMap._occupiedCells, cell);
		}
		
		if (isModified) {
			Array<Cell> orderedOccupiedCells = arraySort(setToArray(CellMap._occupiedCells), function(Cell c1, Cell c2) => integer {
				return c1.id - c2.id;
			}) as Array<Cell>;
			CellMap._occupiedCellsHash = "";
			for (Cell c in orderedOccupiedCells) {
				CellMap._occupiedCellsHash += c.id + "|";
			} 
		}
	}
	
	private static void initNeighboursCells() {
		for (integer x = CellMap.xMin; x <= CellMap.xMax; x++) {
			integer absX = abs(x);
			for (integer y = CellMap.yMin; y <= CellMap.yMax; y++) {
				if (absX + abs(y) <= CellMap.yMax) {
					integer? id = getCellFromXY(x, y);
					if (id == null) continue;
					
					Cell? cell = CellMap.getCell(id!);
					if (cell == null) continue;

					integer? n = getCellFromXY(x, y + 1);
					if(n != null)
						cell!.N = CellMap.getCell(n!);

					integer? ne = getCellFromXY(x - 1, y + 1);
					if(ne != null)
						cell!.NE = CellMap.getCell(ne!);

					integer? e = getCellFromXY(x - 1, y);
					if(e != null)
						cell!.E = CellMap.getCell(e!);

					integer? se = getCellFromXY(x - 1, y - 1);
					if(se != null)
						cell!.SE = CellMap.getCell(se!);

					integer? s = getCellFromXY(x, y - 1);
					if(s != null)
						cell!.S = CellMap.getCell(s!);

					integer? sw = getCellFromXY(x + 1, y - 1);
					if(sw != null)
						cell!.SW = CellMap.getCell(sw!);

					integer? w = getCellFromXY(x + 1, y)
					if(w != null)
						cell!.W = CellMap.getCell(w!);

					integer? nw = getCellFromXY(x + 1, y + 1)
					if(nw != null)
						cell!.NW = CellMap.getCell(nw!);
				}
			}
		}
	}
	
	public static AccessibleCells getAccessibleCells(Cell startCell, integer mp) {
		return CellMap.accessibleCellsMemo.apply(startCell, mp) as AccessibleCells;
	}
	private static Memoize2 accessibleCellsMemo = new Memoize2(function (Cell startCell, integer mp) => AccessibleCells {
		AccessibleCells accessibleCells = new AccessibleCells();
		accessibleCells.addMoveCell(new MoveCell(startCell, 0, max(0, mp)));
		Set<Cell> pastMpTravelledCells = <>;
		setPut(pastMpTravelledCells, startCell);

		for (integer i = 1; i <= mp; i++) {
			Set<Cell> clonedTravelledCells = clone(pastMpTravelledCells) as Set<Cell>;
			setClear(pastMpTravelledCells);
			for (Cell c in clonedTravelledCells) {
				Cell? tmpC = c.N;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
				tmpC = c.E;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
				tmpC = c.S;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
				tmpC = c.W;
				if (tmpC != null && !accessibleCells.hasCell(tmpC!) && tmpC!.isWalkable()) {
					accessibleCells.addMoveCell(new MoveCell(tmpC!, i, mp - i));
					setPut(pastMpTravelledCells, tmpC);
				}
			}
		}
		return accessibleCells;
	}, function(Cell startCell, integer mp) {
		return CellMap.getOccupiedCellsHash() + "," + startCell.id + "," + max(0, mp);
	});
	public static void resetAccessibleCellsMemo() {
		CellMap.accessibleCellsMemo.reset();
	}

