		Debug.error("Function getAppliedValue from Effect need to be overriden " + this.class);
		return 0;
	}
	public static integer getAppliedValueStatic(Effect effect, Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		return effect.getAppliedValue(cellTarget, cellFrom, caster, targetStats, casterStats, dist, isCasterHit);
	}
	
