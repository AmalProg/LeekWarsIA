/** IA v5/Utils/Memoize **/

class Memoize1 {
	private Map<any, any> mem;
	private Function<any => any> f;
	private Function<any => any> paramF;
	
	constructor(Function<any => any> funct, Function<any => any> paramFunc) {
		this.mem = new Map();
		this.f = funct;
		this.paramF = paramFunc;
	}
	
	public any apply(any p1) {
		any key = paramF(p1);
		any ret = this.mem[key];
		if (ret != null) {
			return ret;
		} else {
			return this.mem[key] = f(p1);
		}
	}
	
	public void reset() {
		this.mem = new Map();	
	}
}

class Memoize2 {
	private Map<any, any> mem;
	private Function<any, any => any> f;
	private Function<any, any => any> paramF;
	
	constructor(Function<any, any => any> funct, Function<any, any => any> paramFunc) {
		this.mem = new Map();
		this.f = funct;
		this.paramF = paramFunc;
	}
	
	public any apply(any p1, any p2) {
		any key = paramF(p1, p2);
		any ret = this.mem[key];
		if (ret != null) {
			return ret;
		} else {
			return this.mem[key] = f(p1, p2);
		}
	}
	
	public void reset() {
		this.mem = new Map();	
	}
}

class Memoize3 {
	private Map<any, any> mem;
	private Function<any, any, any => any> f;
	private Function<any, any, any => any> paramF;
	
	constructor(Function<any, any, any => any> funct, Function<any, any, any => any> paramFunc) {
		this.mem = new Map();	
		this.f = funct;
		this.paramF = paramFunc;
	}
	
	public any apply(any p1, any p2, any p3) {
		any key = paramF(p1, p2, p3);
		any ret = this.mem[key];
		if (ret != null) {
			return ret;
		} else {
			return this.mem[key] = f(p1, p2, p3);
		}
	}
	
	public void reset() {
		this.mem = new Map();	
	}
}


/** IA v5/Utils/CollectionUtils **/

//function mapAddMap(Map map1, Map map2) {
	//for (var k : var v in map2) {
		//map1[k] = v;
	//}
//}

function mapIntersection(Map map1, Map map2) {
	Map newCells = new Map();
	for(var id : var c in map1) {
		if(map2[id] != null) {
			newCells[id] = c;
		}
	}

	return newCells;
}

function arrayToSet(Array array) => Set {
	Set set = <>;
	for (any element in array) {
		setPut(set, element);
	}

	return set;
}

function setPutAll(Set set, Set setToAdd) => Set {
	for (any val in setToAdd) {
		setPut(set, val);
	}
}

function setGetOne(Set set) => any? {
	for (any val in set) {
		return val;
	}
	return null;
}

function arrayIndexOf(Array array, any element) {
	for (integer i : any el in array) {
		if (el == element) return i;
	}
	return -1;
}

/** IA v5/Map/Area **/





global Function<integer, integer, null | Array<integer> | integer => boolean?> | Function<integer, integer => boolean?> currentLoS = lineOfSight;

class Area {
	private static Map<string, integer> incrementPerDirection = ["N": 1, "NE": 2, "E": 1, "SE": 2, "S": 1, "SW": 2, "W": 1, "NW": 2]
	
	
	/**
	 * Récupère la première cellule permettant d'utilier l'item sur la cellule target
	 * 
	 * params
	 * target : la cellule à viser
	 * item : l'item utilisé
	 * 
	 * return
	 *  : la cellule
	 **/
	public static Cell? getFirstCellToHitLaser(Item item, Cell target, string direction) {
		Cell currentCell = target;
		for (integer i = 0; i <= item.getMaxRange() and !currentCell.isObstacle(); i++) {
			if (i >= item.getMinRange())
				return currentCell;
			currentCell = currentCell[direction] as Cell;
		}
		
		return null;
	}
	
	/**
	 * Récupère une ligne
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getLine(Set<Cell> cells, Cell cell, integer distMin, integer distMax, string direction) {
		Cell? currentCell = cell;
		for(integer i = 0; i <= distMax && currentCell != null; i += Area.incrementPerDirection[direction]) {
			if (i >= distMin && !currentCell!.isObstacle()) 
				setPut(cells, currentCell);
			
			currentCell = currentCell![direction] as Cell;
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone en forme de +
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getPlusArea(Cell cell, integer distMin, integer distMax) {	
		return Area.plusAreaMemo.apply(cell, distMin, distMax) as Set<Cell>;
	}
	private static Memoize3 plusAreaMemo = new Memoize3(function(Cell cell, integer distMin, integer distMax) {
			Set<Cell> cells = <>;
			Area.getLine(cells, cell, distMin, distMax, "N");
			Area.getLine(cells, cell, distMin, distMax, "E");
			Area.getLine(cells, cell, distMin, distMax, "S");
			Area.getLine(cells, cell, distMin, distMax, "W");
		
			return cells;
		}, function(Cell cell, integer distMin, integer distMax) {
			return cell.id << 17 | distMin << 5 | distMax;
		}
	);
	
	/**
	 * Récupère une zone en forme de + avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getPlusAreaLos(Cell cell, integer distMin, integer distMax) {	
		Set<Cell> cells = <>;
		
		for (Cell c in Area.getPlusArea(cell, distMin, distMax)) {
			if (currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone en forme de + pour les inversion
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getInvertPlusArea(Cell cell, integer distMin, integer distMax) {
		Set<Cell> cells = <>;
		
		for (Cell c in getPlusArea(cell, distMin, distMax)) {
			if (c.hasEntity())
				setPut(cells, c);
		}
		
		return cells;
	}
	public static Set<Cell> getInvertPlusAreaIgnore(Cell cell, integer distMin, integer distMax, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> cells = <>;
		
		for (Cell c in getPlusArea(cell, distMin, distMax)) {
			if (c.hasEntity() && !setContains(ignoredEntities, c.getCellEntity()))
				setPut(cells, c);
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone en forme de + pour les inversion
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getInvertPlusAreaLos(Cell cell, integer distMin, integer distMax) {
		Set<Cell> cells = <>;
		
		for (Cell c in getPlusArea(cell, distMin, distMax)) {
			if (c.hasEntity() && currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
		
		return cells;
	}
	public static Set<Cell> getInvertPlusAreaLosIgnore(Cell cell, integer distMin, integer distMax, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> cells = <>;
		
		for (Cell c in getPlusArea(cell, distMin, distMax)) {
			if (c.hasEntity() && !setContains(ignoredEntities, c.getCellEntity()) && currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone circulaire
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getArea(Cell cell, integer distMin, integer distMax) {
		return Area.areaMemo.apply(cell, distMin, distMax) as Set<Cell>;
	}
	private static Memoize3 areaMemo = new Memoize3(function(Cell cell, integer distMin, integer distMax) {
			Set<Cell> cells = <>;
			for (integer i = distMin; i <= distMax; i++) {
				for (Cell c in Area.getCircle(cell, i)) {
					if (!c.isObstacle())
						setPut(cells, c);
				}
			}
			return cells;
		}, function(Cell cell, integer distMin, integer distMax) {
			return cell.id << 17 | distMin << 5 | distMax;
		}
	);
	
	public static Set<Cell> getCircle(Cell cell, integer size) {
		return Area.circleMemo.apply(cell, size) as Set<Cell>;
	} 
	
	private static Memoize2 circleMemo = new Memoize2(function(Cell cell, integer size) {
			if (size < 0) return <>;
			if (size == 0) return <cell>;
			
			Set<Cell> cells = <>;
			Set<Cell> precPrecCircleCells = Area.getCircle(cell, size - 2);
			Set<Cell> precCircleCells = Area.getCircle(cell, size - 1);

			for(Cell c in precCircleCells) {
				Cell? ngbC = c.N;
				if (ngbC != null && !setContains(precPrecCircleCells, ngbC)) 
					setPut(cells, ngbC);

				ngbC = c.E;
				if (ngbC != null && !setContains(precPrecCircleCells, ngbC)) 
					setPut(cells, ngbC);

				ngbC = c.S;
				if (ngbC != null && !setContains(precPrecCircleCells, ngbC)) 
					setPut(cells, ngbC);

				ngbC = c.W;
				if (ngbC != null && !setContains(precPrecCircleCells, ngbC)) 
					setPut(cells, ngbC);
			}
				
			return cells;
		}, function(Cell cell, integer size) {
			return cell.id << 12 | size;
		}
	);
	
	/**
	 * Récupère une zone circulaire avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getAreaLos(Cell cell, integer distMin, integer distMax) {		
		Set<Cell> cells = <>;
		
		for (Cell c in getArea(cell, distMin, distMax)) {
			if (currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone circulaire avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getInvertArea(Cell cell, integer distMin, integer distMax) {	
		Set<Cell> cells = <>;
		
		for (Cell c in getArea(cell, distMin, distMax)) {
			if (c.hasEntity())
				setPut(cells, c);
		}
		
		return cells;
	}
	public static Set<Cell> getInvertAreaIgnore(Cell cell, integer distMin, integer distMax, Set<AbstractEntity> ignoredEntities) {		
		Set<Cell> cells = <>;

		for (Cell c in getArea(cell, distMin, distMax)) {
			if (c.hasEntity() && !setContains(ignoredEntities, c.getCellEntity()))
				setPut(cells, c);
		}
		
		return cells;
	}
	
	/**
	 * Récupère une zone circulaire avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getInvertAreaLos(Cell cell, integer distMin, integer distMax) {		
		Set<Cell> cells = <>;

		for (Cell c in getArea(cell, distMin, distMax)) {
			if (c.hasEntity() and currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
		
		return cells;
	}
	public static Set<Cell> getInvertAreaLosIgnore(Cell cell, integer distMin, integer distMax, Set<AbstractEntity> ignoredEntities) {		
		Set<Cell> cells = <>;

		for (Cell c in getArea(cell, distMin, distMax)) {
			if (c.hasEntity() && !setContains(ignoredEntities, c.getCellEntity()) && currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
		
		return cells;
	}

	/**
	 * Récupère une zone diagonale avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getDiagonalArea(Cell cell, integer distMin, integer distMax) {	
		return Area.diagonalAreaMemo.apply(cell, distMin, distMax) as Set<Cell>;
	}
	private static Memoize3 diagonalAreaMemo = new Memoize3(function(Cell cell, integer distMin, integer distMax) {
			Set<Cell> cells = <>;
			Area.getLine(cells, cell, distMin, distMax, "NE");
			Area.getLine(cells, cell, distMin, distMax, "SE");
			Area.getLine(cells, cell, distMin, distMax, "SW");
			Area.getLine(cells, cell, distMin, distMax, "NW");
		
			return cells;
		}, function(Cell cell, integer distMin, integer distMax) {
			return cell.id << 17 | distMin << 5 | distMax;
		}
	);
	
	/**
	 * Récupère une zone diagonale avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getDiagonalAreaLos(Cell cell, integer distMin, integer distMax) {		
		Set<Cell> cells = <>;
				
		for (Cell c in getDiagonalArea(cell, distMin, distMax)) {
			if (currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
		
		return cells;
	}

	/**
	 * Récupère une zone star avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getStarArea(Cell cell, integer distMin, integer distMax) {			
		return Area.starAreaMemo.apply(cell, distMin, distMax) as Set<Cell>;
	}
	private static Memoize3 starAreaMemo = new Memoize3(function(Cell cell, integer distMin, integer distMax) {	
			Set<Cell> cells = Area.getDiagonalArea(cell, distMin, distMax);
			cells = setUnion(cells, Area.getPlusArea(cell, distMin, distMax)) as Set<Cell>;
			return cells;
		}, function(Cell cell, integer distMin, integer distMax) {
			return cell.id << 17 | distMin << 5 | distMax;
		}
	);
	
	/**
	 * Récupère une zone star avec test de los
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getStarAreaLos(Cell cell, integer distMin, integer distMax) {		
		Set<Cell> cells = <>;
		
		for (Cell c in getStarArea(cell, distMin, distMax)) {
			if (currentLoS(cell.id, c.id))
				setPut(cells, c);
		}
						
		return cells;
	}
}
/** IA v5/Effects/Effect **/



/** IA v5/Effects/BuffAgilityEffect **/



class BuffAgilityEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		integer finalValue = round(value * caster.getStats().getScienceMult());
		affectedEntityStats.addEffect(EntityStats.addAgilityStatic, this._type, finalValue, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value * caster.getStats().getScienceMult());
		return targetScores.getAgilityScore(finalValue, targetStats.getAgility()) * targetAllyMult;
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		return targetScores.getAgilityScore(finalValue, targetStats.getAgility()) * targetAllyMult;
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return round(baseValue * casterStats.getScienceMult());
	}
}
/** IA v5/Effects/BuffResistanceEffect **/



class BuffResistanceEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer finalValue = round(value * casterStats.getScienceMult());
		affectedEntityStats.addEffect(EntityStats.addResistanceStatic, this._type, finalValue, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value * casterStats.getScienceMult());
		return targetScores.getResistanceScore(finalValue, targetStats.getResistance()) * targetAllyMult * targetScores.getAdjuster().resBuff;
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		return targetScores.getResistanceScore(finalValue, targetStats.getResistance()) * targetAllyMult * targetScores.getAdjuster().resBuff;
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return round(baseValue * casterStats.getScienceMult());
	}
}
