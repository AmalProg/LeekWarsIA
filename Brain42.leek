class Effect {
	protected integer _type; public integer getType() { return _type; }
	protected real _minValue; public real getMinValue() { return _minValue; }
	protected real _maxValue; public real getMaxValue() { return _maxValue; }
	protected real _meanValue; public real getMeanValue() { return _meanValue; }
	protected real _myValue; public real getMyValue() { return _myValue; }
	protected integer _turns; public integer getTurns() { return _turns; }
	protected integer _targets; public integer getTargets() { return _targets; }
	protected integer _modifiers; public integer getModifiers() { return _modifiers; }
	protected Item _item; public Item getItem() { return _item; }
	protected Set<integer> _triggerableEffects = <>; public Set<integer> getTriggerableEffects() { return _triggerableEffects; }
	
	protected boolean _isNotReplaceable; public boolean isNotReplaceable() { return _isNotReplaceable; }
	protected boolean _isAffectingCaster; public boolean isAffectingCaster() { return _isAffectingCaster; }
	protected boolean _isStackable; public boolean isStackable() { return _isStackable; }
	protected boolean _isMultByTargets; public boolean isMultByTargets() { return _isMultByTargets; }
	protected boolean _isIrreductible; public boolean isIrreductible() { return _isIrreductible; }
	
	protected constructor(Array<any> effectArray, Item item) {
		this._type = effectArray[0] as integer;
		this._minValue = effectArray[1] as real;
		this._maxValue = effectArray[2] as real;
		this._meanValue = this._minValue * 0.5 + this._maxValue * 0.5;
		this._myValue = this._minValue * 0.7 + this._maxValue * 0.3;
		this._turns = effectArray[3] as integer;
		this._targets = effectArray[4] as integer;
		this._modifiers = effectArray[5] as integer;
		this._item = item;
		
		this._isNotReplaceable = (this._modifiers & EFFECT_MODIFIER_NOT_REPLACEABLE) != 0;
		this._isAffectingCaster = (this._modifiers & EFFECT_MODIFIER_ON_CASTER) != 0;
		this._isStackable = (this._modifiers & EFFECT_MODIFIER_STACKABLE) != 0;
		this._isMultByTargets = (this._modifiers & EFFECT_MODIFIER_MULTIPLIED_BY_TARGETS) != 0;
		this._isIrreductible = (this._modifiers & EFFECT_MODIFIER_IRREDUCTIBLE) != 0;
	}
	
	protected void tryTriggerPassive(AbstractEntity target, AbstractEntity caster, integer triggerValue) {
		if (target instanceof Leek) {
			for (integer effectType in this._triggerableEffects) { 
				PassiveEffect? eff = (target as Leek).getPassiveItemEffects()[effectType];
				if (eff != null) {
					eff!.applyPassiveTo(target, caster, 0, triggerValue);
				}
			}
		}
	}
	
	public Set<AbstractEntity> getAffectedTargets(Cell cell, Cell? from, AbstractEntity caster) {
		Set<AbstractEntity> targets = <>;
		
		for (Cell c in this._item.getEffectiveArea(cell, from)) {
			if (c.hasEntity() && c.getCellEntity()!.isEntityAlive() && this.canTarget(c.getCellEntity()!, caster)) {
				setPut(targets, c.getCellEntity());
			};
		}
		return targets;
	}

	public boolean canTarget(AbstractEntity target, AbstractEntity caster) {
		if (!(this._targets & EFFECT_TARGET_ALLIES) && target.getTeam() == caster.getTeam()) return false;
		if (!(this._targets & EFFECT_TARGET_CASTER) && target == caster) return false;
		if (!(this._targets & EFFECT_TARGET_ENEMIES) && target.getTeam() != caster.getTeam()) return false;
		if (!(this._targets & EFFECT_TARGET_NON_SUMMONS) && !target.isSummon()) return false;
		if (!(this._targets & EFFECT_TARGET_SUMMONS) && target.isSummon()) return false;
		return true;
	}
	
	public canApplyTo(AbstractEntity target, AbstractEntity caster) {
		var selfCast = caster == target;
		
		if (this._isAffectingCaster && !selfCast) {
			return false;
		}
		
		if (this._isNotReplaceable) {
			// On ne peut pas remplacer l'effet déjà en place
			if (target.getStats().hasEffectOn(this)) 
				return false;
		}
		
		return true;
	}
	
	public void applyOnCell(Cell cellTarget, Cell? cellFrom, AbstractEntity caster, boolean isCasterHit = false) {
		if (this._isAffectingCaster) {
			this.applyTo(cellTarget, cellFrom, caster, caster, caster.getStats(), caster.getStats(), 0, isCasterHit);
		} else {
			for (AbstractEntity entity in this._item.getSimulationTargets(cellTarget, cellFrom, caster)) {
				if (entity.isEntityAlive()) {
					integer aoeDist = Cell.getDistance(cellTarget, entity.getCell()!);
					this.applyTo(cellTarget, cellFrom, entity, caster, entity.getStats(), caster.getStats(), aoeDist, isCasterHit);
				}
			}
		}
	}
	public void applyTo(Cell? cellTarget, Cell? cellFrom, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		if (!this.canApplyTo(target, caster)) return;
		
		boolean isSelfCast = caster.getId() == target.getId();
		
		if (this._isNotReplaceable) {
			// On ne peut pas remplacer l'effet déjà en place
			if (targetStats.hasEffectOn(this)) return;
		}
		
		if (!this._isStackable) {
			// on retire l'effet qui va être remplacé
			targetStats.removeEffects(targetStats.getEffectsOn(this));
		}
		
		real value = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		this.apply(value, caster, target, targetStats, cellTarget);
		
		if (targetStats.getAgility() > 800 && !(this instanceof PassiveEffect)) {
			if (target instanceof Leek) {
				PassiveEffect? eff = (target as Leek).getPassiveItemEffects()[EFFECT_CRITICAL_TO_HEAL];
				if (eff != null) {
					eff!.applyPassiveTo(target, caster, 0, 1);
				}
			}
		}
			
		targetStats.updateMults();
	}
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		// need to be overriden
	}
	
	public real getPassiveScore(AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer triggerValue) {
		if (target instanceof Leek) {
			for (integer effectType in this._triggerableEffects) { 
				PassiveEffect? eff = (target as Leek).getPassiveItemEffects()[effectType];
				if (eff != null) {
					eff!.getPassiveEffectScore(target, caster, targetStats, casterStats, triggerValue);
				}
			}
		}
	}
	
	public real getScoreOnCell(Cell cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats casterStats, boolean isCasterHit = false, integer statsTurnDelay = 0) {
		real score = 0.0;

		if (this._isAffectingCaster) {
			score = this.getScore(cellTarget, cellFrom, caster, caster, casterStats, casterStats, 0, isCasterHit) * caster.getScores().getAdjuster().entityType;
		} else {
			for (AbstractEntity entity in this.getAffectedTargets(cellTarget, cellFrom, caster)) {
				EntityStats entityStats = entity.getStats();
				if (statsTurnDelay != 0)
					entityStats = entity.getStatsInTurns(statsTurnDelay);
				
				real entityTypeMult = entity.getScores().getAdjuster().entityType;

				integer aoeDist = Cell.getDistance(cellTarget, entity.getCell()!);
				score += this.getScore(cellTarget, cellFrom, entity, caster, entityStats, casterStats, aoeDist, isCasterHit) * entityTypeMult;
			}
		}
		
		return this.scaleScoreOnCdAndDuration(score);
	}
	protected real getScore(Cell? cellTarget, Cell? cellFrom, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		if (!this.canApplyTo(target, caster)) return 0.0;

		if (this._isNotReplaceable) {
			// On ne peut pas remplacer l'effet déjà en place
			if (targetStats.hasEffectOn(this)) return 0.0;
		}
		
		real removedEffectScore = 0.0;
		if (!this._isStackable) {
			EntityStats tmpTargetStats = new EntityStats();
			tmpTargetStats.copy(targetStats);
			targetStats = tmpTargetStats;
			// on retire l'effet qui va être remplacé
			for (EntityEffect entityEff in targetStats.getEffectsOn(this)) {
				targetStats.removeEffect(entityEff);
				
				// récupère la classe de l'effet
				Function<integer, AbstractEntity, AbstractEntity, EntityStats, EntityStats, Cell? => real>? getFinalEffectScorefnct = Effect.finalEffectScoreFnctPerId[entityEff.getType()];
				if (getFinalEffectScorefnct != null) {
					// on multiplie le score par un coeff en fonction du nombre de tours restant pour l'effet
					removedEffectScore += (entityEff.getTurns() / 1.5) * (getFinalEffectScorefnct!)(entityEff.getValue(), target, caster, targetStats, casterStats, cellTarget);
				}
			}
		}
		
		real value = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return (this.getEffectScore(value, target, caster, targetStats, casterStats, cellTarget) - removedEffectScore);
	}
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		Debug.error("Function getEffectScore from Effect need to be overriden " + this.class);
		return 0.0;
	}
	public real getSelfScore(AbstractEntity caster, EntityStats casterStats, integer dist) {
		if (!this.canApplyTo(caster, caster)) return 0.0;
		
		if (this._isNotReplaceable) {
			// On ne peut pas remplacer l'effet déjà en place
			if (casterStats.hasEffectOn(this)) return 0.0;
		}
		
		real removedEffectScore = 0.0;
		if (!this._isStackable) {
			// on retire l'effet qui va être remplacé
			for (EntityEffect entityEff in casterStats.getEffectsOn(this)) {
				// récupère la classe de l'effet
				Function<integer, AbstractEntity, AbstractEntity, EntityStats, EntityStats, Cell? => real>? getFinalEffectScorefnct = Effect.finalEffectScoreFnctPerId[entityEff.getType()];
				if (getFinalEffectScorefnct != null) {
					// on multiplie le score par un coeff en fonction du nombre de tours restant pour l'effet
					removedEffectScore += (entityEff.getTurns() / 5) * (getFinalEffectScorefnct!)(entityEff.getValue(), caster, caster, casterStats, casterStats, null);
				}
			}
		}
		
		real value = this._myValue * this._item.getAoeMult(dist);
		real score = this.getEffectScore(value, caster, caster, casterStats, casterStats, null);
		return this.scaleScoreOnCdAndDuration(score - removedEffectScore);
	}
	protected real scaleScoreOnCdAndDuration(real score) {
		// multiplie le score en fonction du nombre de tours durant lesquels il est appliqué
		if (this._turns != 0)
			score *= 0.5 + (0.5 * (this._turns - 1) / 3);
		
		integer itemCd = this._item.getBaseCooldown();
		if (itemCd == -1) {
			// Si l'item à un cd infini
			score *= 0.5;
		} else if (itemCd != 0) {
			score *= 1 - min(0.5, itemCd / 20);
		}
		
		return score;
	}
	
	protected real getBaseValueToApply(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, integer dist, boolean isCasterHit = false) {
		var aoeMult = this._item.getAoeMult(dist);

		var nbrTargetsMult = 1;
		if (this._isMultByTargets) {
			// l'effet de base est multiplié par le nombre d'entités touchées
			Set<AbstractEntity> targets = this.getAffectedTargets(cellTarget!, cellFrom, caster);
			nbrTargetsMult = setSize(targets) + (isCasterHit ? 1 : 0);
		}
		
		return this._myValue * nbrTargetsMult * aoeMult;
	}
	
	public static Effect? createEffect(Array<any> effectArray, Item item) {
		integer type = effectArray[0] as integer;
		Class? effectClass = Effect.effectClassPerId[type];
		if (effectClass != null) {
			return new (effectClass!)(effectArray, item);
		}
		return null;
	}
	
