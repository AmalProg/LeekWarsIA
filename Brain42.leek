	public static AccessibleCells getAccessibleCellsWithTeleport(Cell startCell, integer mp, Item item) {
		return CellMap.accessibleCellsWithTeleportMemo.apply(startCell, mp, item) as AccessibleCells;
	}
	private static Memoize3 accessibleCellsWithTeleportMemo = new Memoize3(function (Cell startCell, integer mp, Item item) => AccessibleCells {
		AccessibleCells accessibleCells = CellMap.getAccessibleCells(startCell, mp);
		Map<Cell, MoveCell> cellFromToTeleportCells = [:];
		Map<integer, Set<Cell>> cellsPerMpToTeleport = [:];

		for (integer i = 0; i <= mp; i++) {
			cellsPerMpToTeleport[i] = <>;
		}
		
		AccessibleCells accessibleCellsWithTP = new AccessibleCells();
		for (MoveCell moveCell in accessibleCells.getOrderedPerMpUsedMoveCell(true)) {
			Set<Cell> cellsCanHitTeleport = item.getCellsCanHitFrom(moveCell.cell);
			for (Cell cellToHitTP in cellsCanHitTeleport) {
				// Si on n'a pas encore mis de mpUsed sur la cellToHitTP
				if (!mapContainsKey(cellFromToTeleportCells, cellToHitTP)) {
					cellFromToTeleportCells[cellToHitTP] = moveCell;
					setPut(cellsPerMpToTeleport[moveCell.mpUsed]!, cellToHitTP);
				}
			}
		}
		
		for (integer mpUsed : Set<Cell> cells in cellsPerMpToTeleport) {			
			integer curMpUsed = mpUsed + 1;
			for (Cell c in cells) {
				Cell cellFromTeleport;
				Cell cellToTeleport;
				if (!accessibleCellsWithTP.hasCell(c)) {
					cellFromTeleport = cellFromToTeleportCells[c]!.cell;
					cellToTeleport = c;
					accessibleCellsWithTP.addMoveCell(new MoveCell(c, mpUsed, mp - mpUsed, item, cellFromTeleport, cellToTeleport));
				} else {
					cellFromTeleport = accessibleCellsWithTP.getMoveCell(c)!.cellFromTeleport!;
					cellToTeleport = accessibleCellsWithTP.getMoveCell(c)!.cellToTeleport!;
				}
				
				if (mpUsed < mp) {
					Cell? tmpC = c.N;
					if (tmpC != null && tmpC!.isWalkable() && (!mapContainsKey(cellFromToTeleportCells, tmpC) || curMpUsed < cellFromToTeleportCells[tmpC!]!.mpUsed)) {
						accessibleCellsWithTP.addMoveCell(new MoveCell(tmpC!, curMpUsed, mp - curMpUsed, item, cellFromTeleport, cellToTeleport));
						setPut(cellsPerMpToTeleport[curMpUsed]!, tmpC);
					}
					tmpC = c.E;
					if (tmpC != null && tmpC!.isWalkable() && (!mapContainsKey(cellFromToTeleportCells, tmpC) || curMpUsed < cellFromToTeleportCells[tmpC!]!.mpUsed)) {
						accessibleCellsWithTP.addMoveCell(new MoveCell(tmpC!, curMpUsed, mp - curMpUsed, item, cellFromTeleport, cellToTeleport));
						setPut(cellsPerMpToTeleport[curMpUsed]!, tmpC);
					}
					tmpC = c.S;
					if (tmpC != null && tmpC!.isWalkable() && (!mapContainsKey(cellFromToTeleportCells, tmpC) || curMpUsed < cellFromToTeleportCells[tmpC!]!.mpUsed)) {
						accessibleCellsWithTP.addMoveCell(new MoveCell(tmpC!, curMpUsed, mp - curMpUsed, item, cellFromTeleport, cellToTeleport));
						setPut(cellsPerMpToTeleport[curMpUsed]!, tmpC);
					}
					tmpC = c.W;
					if (tmpC != null && tmpC!.isWalkable() && (!mapContainsKey(cellFromToTeleportCells, tmpC) || curMpUsed < cellFromToTeleportCells[tmpC!]!.mpUsed)) {
						accessibleCellsWithTP.addMoveCell(new MoveCell(tmpC!, curMpUsed, mp - curMpUsed, item, cellFromTeleport, cellToTeleport));
						setPut(cellsPerMpToTeleport[curMpUsed]!, tmpC);
					}
				}
			}
		}

		accessibleCellsWithTP.addMoveCell(new MoveCell(startCell, 0, max(0, mp)));

		return accessibleCellsWithTP;
	}, function(Cell startCell, integer mp, Item item) {
		return CellMap.getOccupiedCellsHash() + "," + item.getId() + "," + startCell.id + "," + max(0, mp);
	});
	public static void resetAccessibleCellsWithTeleportMemo() {
		return CellMap.accessibleCellsWithTeleportMemo.reset();
	}
	
	public static Set<Cell> getEdgeCells(Set<Cell> cells) {
		Set<Cell> edgeCells = <>;
		for (Cell cell in cells) {
			if ((cell.N != null && !setContains(cells, cell.N)) || (cell.E != null && !setContains(cells, cell.E)) || (cell.S != null && !setContains(cells, cell.S)) || (cell.W != null && !setContains(cells, cell.W)))
				setPut(edgeCells, cell);
		}
		return edgeCells;
	}
	
	public static void showRandCellNeighbour() {
		integer id = randInt(0, 613);
		Cell? c = CellMap._cells[id];
		if (c == null) return;
		
		mark([c!.id], COLOR_GREEN);
		if (c!.N != null)
			mark([c!.N!.id], COLOR_RED);
		if (c!.NE != null)
			mark([c!.NE!.id], COLOR_RED);
		if (c!.E != null)
			mark([c!.E!.id], COLOR_RED);
		if (c!.SE != null)
			mark([c!.SE!.id], COLOR_RED);
		if (c!.S != null)
			mark([c!.S!.id], COLOR_RED);
		if (c!.SW != null)
			mark([c!.SW!.id], COLOR_RED);
		if (c!.W != null)
			mark([c!.W!.id], COLOR_RED);
		if (c!.NW != null)
			mark([c!.NW!.id], COLOR_RED);
	}
	
	public static void markAccessibleCells(AccessibleCells accessibleCells, integer color = COLOR_GREEN) {
		for (MoveCell moveCell in accessibleCells.getMoveCells()) {
			mark(moveCell.cell.id, getColor(0, 0, 0));
			markText(moveCell.cell.id, moveCell.mpUsed, color);
		}
	}
	
	public static void markCells(Set<Cell> cells, integer color = COLOR_GREEN) {
		mark(arrayMap(setToArray(cells), function(Cell c) => integer { return c.id; }) as Array<integer>, color);
	}

	public static void markMoveCells(Set<MoveCell> cells, integer color = COLOR_GREEN) {
		mark(arrayMap(setToArray(cells), function(MoveCell mc) => integer { return mc.cell.id; }) as Array<integer>, color);
	}

	public static void markCellsFrom(Set<TargetCell> cells, integer color = COLOR_GREEN) {
		mark(arrayMap(setToArray(cells), function(TargetCell tc) => integer { return tc.cellFrom!.id; }) as Array<integer>, color);
	}

	public static void markTargetCells(Set<TargetCell> cells, integer color = COLOR_GREEN) {
		mark(arrayMap(setToArray(cells), function(TargetCell tc) => integer { return tc.cellTarget.id; }) as Array<integer>, color);
	}

}


/** IA v5/Entities/Chest **/



class Chest extends AbstractEntity {
	public static final integer WOOD_CHEST_BASE_LIFE = 2_000;
	public static final integer IRON_CHEST_BASE_LIFE = 5_000;
	public static final integer DIAMOND_CHEST_BASE_LIFE = 20_000;
	
	/** Chests pool **/
	private static final Map<integer, Chest> chests = [:];
	public static initChests(Array<integer> entitiesId) {
		for (var chestId in entitiesId) {
			if (getType(chestId) == ENTITY_CHEST) {
				Chest.chests[chestId] = new Chest(chestId);
				AbstractEntity.entities[chestId] = Chest.chests[chestId];
			}
		}
	}
	public static Chest? get(integer id) {
		return Chest.chests[id];
	}
	/** fin chests pool **/

	constructor(integer id) {
		super(id);
		
		if (this._baseStats.getMaxLife() == WOOD_CHEST_BASE_LIFE) {
			this._powerOnDeath = 10;
		} else if (this._baseStats.getMaxLife() == WOOD_CHEST_BASE_LIFE) {
			this._powerOnDeath = 50;
		} else if (this._baseStats.getMaxLife() == WOOD_CHEST_BASE_LIFE) {
			this._powerOnDeath = 100;
		}
	}
	
	public static updateChestsStats() {
		for (Chest chest in Chest.chests) {
			chest.updateStats();
		}
	}
	protected void updateStats() {
		super.updateStats();
		// can't move
		this._stats.useMP(this._stats.getMP());
	}
}

/** IA v5/Entities/Timeline **/



class Timeline {
	private Array<AbstractEntity> _entitiesTurnOrdered;
	private Map<AbstractEntity, integer> _turnOrderAfterMe;
	private Map<Team, Array<AbstractEntity>> _turnOrderedPerTeam;
	
	private AbstractEntity _playingEntity;
	
	private constructor() {}
	public constructor(Set<AbstractEntity> entities, AbstractEntity entityPlaying) {
		this._turnOrderedPerTeam = [:];
		this._turnOrderAfterMe = [:];
		this._playingEntity = entityPlaying;
		this.update(entities);
	}
	
	public void update(Set<AbstractEntity> entities) {
		this._entitiesTurnOrdered = setToArray(entities) as Array<AbstractEntity>;
		
		this._entitiesTurnOrdered = arraySort(this._entitiesTurnOrdered, function(AbstractEntity a1, AbstractEntity a2) => integer {
			return a1.getTurnOrder() - a2.getTurnOrder();
		}) as Array<AbstractEntity>;

		for (AbstractEntity otherEntity in this._entitiesTurnOrdered) {
			integer turnOrder = otherEntity.getTurnOrder() - this._playingEntity.getTurnOrder();
			if (turnOrder < 0)
				turnOrder += count(this._entitiesTurnOrdered);
			this._turnOrderAfterMe[otherEntity] = turnOrder;
			
			// les entités ordonnées par ordre de tour pour chaque team
			if (!mapContainsKey(this._turnOrderedPerTeam, otherEntity.getTeam()))
				this._turnOrderedPerTeam[otherEntity.getTeam()!] = [];
			push(this._turnOrderedPerTeam[otherEntity.getTeam()!]!, otherEntity);
		}
	}
	
	public integer getTurnOrderAfterMe(AbstractEntity entity) {
		return mapGet(this._turnOrderAfterMe, entity, -1) as integer;
	}

	public AbstractEntity? getNextEntityInTeam(AbstractEntity entity) {
		AbstractEntity? firstEntity = null;
		integer entityTurnOrder = entity.getTurnOrder();
		for (AbstractEntity otherEntity in mapGet(this._turnOrderedPerTeam, entity.getTeam(), []) as Array<AbstractEntity>)  {
			if (firstEntity == null)
				firstEntity = otherEntity;
			
			if (otherEntity.getTurnOrder() > entityTurnOrder)
				return otherEntity
		}
		return firstEntity;
	}

	public AbstractEntity? getPrevEntity(AbstractEntity entity, boolean takeAlly = false, boolean takeEnemies = false, boolean takeBulbs = false, takeTurrets = false) {
		AbstractEntity? prevEntity = null;
		for (AbstractEntity otherEntity in this._entitiesTurnOrdered) {
			boolean isSameTeam = otherEntity.getTeam() != entity.getTeam();
			if (otherEntity instanceof Bulb && !takeBulbs) continue;
			if (otherEntity instanceof Turret && !takeTurrets) continue;
			if (isSameTeam && !takeAlly) continue;
			if (!isSameTeam && !takeEnemies) continue;
			
			if (entity == otherEntity) break;
			prevEntity = otherEntity;
		}
		if (prevEntity == null) {
			for (integer i = count(this._entitiesTurnOrdered) - 1; i > 0; i--) {
				AbstractEntity otherEntity = this._entitiesTurnOrdered[i];
				boolean isSameTeam = otherEntity.getTeam() != entity.getTeam();
				if (otherEntity instanceof Bulb && !takeBulbs) continue;
				if (otherEntity instanceof Turret && !takeTurrets) continue;
				if (isSameTeam && !takeAlly) continue;
				if (!isSameTeam && !takeEnemies) continue;

				return otherEntity;
			}
			return this._entitiesTurnOrdered[-1];
		}
		return prevEntity;
	}

	public AbstractEntity? getNextEntity(AbstractEntity entity, boolean takeAlly = false, boolean takeEnemies = false, boolean takeBulbs = false, takeTurrets = false) {
		boolean foundEntity = false;
		for (AbstractEntity otherEntity in this._entitiesTurnOrdered) {
			boolean isSameTeam = otherEntity.getTeam() != entity.getTeam();
			if (otherEntity instanceof Bulb && !takeBulbs) continue;
			if (otherEntity instanceof Turret && !takeTurrets) continue;
			if (isSameTeam && !takeAlly) continue;
			if (!isSameTeam && !takeEnemies) continue;
			
			
			if (foundEntity)
				return otherEntity;
			if (entity == otherEntity) 
				foundEntity = true;
		}
		for (AbstractEntity otherEntity in this._entitiesTurnOrdered) {
			boolean isSameTeam = otherEntity.getTeam() != entity.getTeam();
			if (otherEntity instanceof Bulb && !takeBulbs) continue;
			if (otherEntity instanceof Turret && !takeTurrets) continue;
			if (isSameTeam && !takeAlly) continue;
			if (!isSameTeam && !takeEnemies) continue;

			return otherEntity;
		}
		return null;
	}
	
	/**
	 * @param AbstractEntity firstEntity
	 * @param AbstractEntity secondEntity
	 * @param boolean isCountAllies
	 * @param boolean isCountEnemies
	 * @param boolean isCountBulbs
	 * @param boolean isCountTurrets
	 */
	public integer getEntitiesPlayingBetweenEntitiesCount(AbstractEntity firstEntity, AbstractEntity secondEntity, boolean isCountAllies = false, boolean isCountEnemies = false, boolean isCountBulbs = false, isCountTurrets = false) {
		boolean firstEntityFound = false;
		boolean secondEntityFound = false;
		integer count = 0;
		Team firstEntityTeam = firstEntity.getTeam()!;
		for (AbstractEntity entity in this._entitiesTurnOrdered) {
			if (entity == firstEntity) {
				firstEntityFound = true;
				
				if (!secondEntityFound && firstEntity != secondEntity) {
					count = 0;
				}
			} else {
				if (entity == secondEntity) {
					secondEntityFound = true;
					
					if (firstEntityFound) break;
				}

				if (((!secondEntityFound && !firstEntityFound) || firstEntityFound) && (isCountAllies && entity.getTeam() == firstEntityTeam) || (isCountEnemies && entity.getTeam() != firstEntityTeam) || (isCountBulbs && entity instanceof Bulb) || (isCountTurrets && entity instanceof Turret)) {
					count++;
				}
			}
		}
		return count;
	}

	/**
	 * @params AbstractEntity firstEntity
	 * @params boolean isCountAllies
	 * @params boolean isCountEnemies
	 * @params boolean isCountBulbs
	 * @params boolean isCountTurrets
	 **/
	public Array<AbstractEntity> getEntitiesPlayingAfter(AbstractEntity firstEntity, boolean isCountAllies = false, boolean isCountEnemies = false, boolean isCountBulbs = false, isCountTurrets = false) {
		boolean firstEntityFound = false;
		Array<AbstractEntity> beforeFoundEntities = [];
		Array<AbstractEntity> entities = [];
		Team firstEntityTeam = firstEntity.getTeam()!;
		for (AbstractEntity entity in this._entitiesTurnOrdered) {
			if (entity == firstEntity) {
				firstEntityFound = true;
			}
			
			if ((isCountAllies && entity.getTeam() == firstEntityTeam) || (isCountEnemies && entity.getTeam() != firstEntityTeam) || (isCountBulbs && entity instanceof Bulb) || (isCountTurrets && entity instanceof Turret)) {
				if (firstEntityFound){
					push(entities, entity);
				} else {
					push(beforeFoundEntities, entity);
				}
			}
		}
		
		for (AbstractEntity entity in beforeFoundEntities)
			push(entities, entity);
		
		return entities;
	}
}
/** IA v5/AI **/



/** IA v5/Actions/Action **/

/** IA v5/Map/TargetCell **/



class TargetCell {
	public Cell cellTarget;
	public Cell? cellFrom;
	public Cell? cellFocused;
	
	public constructor(Cell target, Cell? from = null, Cell? focused = null) {
		this.cellTarget = target;
		this.cellFrom = from;
		this.cellFocused = focused;
	}
	
	public string string() {
		return "{cellTarget : " + this.cellTarget + ", cellFrom : " + this.cellFrom + ", cellFocused : " + this.cellFocused + "}";
	}
}


class Action {
	public static final integer SIMULATING_DEBUG_COLOR = getColor(50, 168, 90);
	
	private static integer idCounter = 0;
	
	private integer _id;
	public integer getUniqueId() { return this._id; }
	
	private Item _item; 
	public void setItem(Item item) { this._item = item; }
	public Item getItem() { return this._item; }
	
	private Set<TargetCell> _targetCells;
	public void setTargetCells(Set<TargetCell> cells) { this._targetCells = cells; }
	public Set<TargetCell> getTargetCells() { return this._targetCells; }
	
	private string _targetsHash;
	public void setTargetsHash(string targetsHash) { this._targetsHash = targetsHash; }
	public string getTargetsHash() { return this._targetsHash; }
	
	private Set<AbstractEntity> _targets;
	publci void addTarget(AbstractEntity target) { setPut(this._targets, target); }
	public void setTargets(Set<AbstractEntity> targets) { this._targets = targets; }
	public Set<AbstractEntity> getTargets() { return this._targets; }
	
	private Set<MoveCell> _cellsFrom;
	public void setCellsFrom(Set<MoveCell> cells) { this._cellsFrom = cells; }
	public Set<MoveCell> getCellsFrom() { return this._cellsFrom; }
	public void clearCellsFrom() { setClear(this._cellsFrom); }
	public void removeCellsFrom(Set<MoveCell> cells) {
		for (MoveCell moveCellToRemove in cells) {
			if (setContains(this._cellsFrom, moveCellToRemove))
				setRemove(this._cellsFrom, moveCellToRemove);
		}
	}
	
	private integer _hitCasterDist;
	public void setHitCasterDist(integer dist) { this._hitCasterDist = dist; }
	public integer getHitCasterDist() { return this._hitCasterDist; }
	
	private Item? _teleportItem;
	public void setTeleportItem(Item? teleportItem) { this._teleportItem = teleportItem; }
	public Item? getTeleportItem() { return this._teleportItem; }
	
	private real _score;
	public void setScore(real score) { this._score = score; }
	public real getScore() { return this._score; }
	
	
	private integer _useCount;
	public void addUse() { this._useCount++; }
	public integer getUseCount() { return this._useCount; }
	
	constructor() {	
		this._id = Action.idCounter++;
		this._targetCells = <>;
		this._targetsHash = "";
		this._targets = <>;
		this._cellsFrom = <>;
		this._hitCasterDist = -1;
		this._teleportItem = null;
		this._score = 0.0;
		this._useCount = 0;
	}
	constructor(Action action) {	
		this._id = action._id;
		this._item = action._item;
		this._targetCells = clone(action._targetCells) as Set<TargetCell>;
		this._targetsHash = action._targetsHash;
		this._targets = clone(action._targets) as Set<AbstractEntity>;
		this._cellsFrom = clone(action._cellsFrom) as Set<MoveCell>;
		this._hitCasterDist = action._hitCasterDist;
		this._teleportItem = action._teleportItem;
		this._score = action._score;
		this._useCount = action._useCount;
	}
	public Action clone() {
		return new Action(this);
	}
	
	public void simulate(ActionsManager manager, AbstractEntity caster) {
		integer useCount = this._useCount;
		while (useCount-- > 0) {
			if (!setIsEmpty(this._targetCells)) {
				MoveCell moveCell = setGetOne(this._cellsFrom) as MoveCell;
				// On ne se téléporte que à la première réalisation de l'action
				if (this._teleportItem != null && !manager.isUsedMovementItem(this._teleportItem!)) {
					manager.addUsedMovementItem(this._teleportItem!);

					moveCell.itemTeleport!.applyOnCell(moveCell.cellToTeleport!, moveCell.cellFromTeleport, caster, 0);
					caster.simulateItemUse(moveCell.itemTeleport!);

					Debug.log("Simulating teleport with " + moveCell.itemTeleport + " on " + moveCell.cellToTeleport + " from " + moveCell.cellFromTeleport, Action.SIMULATING_DEBUG_COLOR);
					Debug.log("I have " + caster.getStats().getTP() + " tp left");
				}

				TargetCell targetCell = setGetOne(this._targetCells) as TargetCell;
				Debug.log("Simulating " + this._item + " on " + targetCell + " from " + targetCell.cellFrom + " with caster at dist " + this._hitCasterDist + " for a score of " + this._score, Action.SIMULATING_DEBUG_COLOR);
				Debug.log("cellsFrom : " + this._cellsFrom, Action.SIMULATING_DEBUG_COLOR);
				Debug.log("targetCells : " + this._targetCells, Action.SIMULATING_DEBUG_COLOR);
				this._item.applyOnCell(targetCell.cellTarget, targetCell.cellFrom, caster, this._hitCasterDist);
			} else {
				Debug.log("Simulating " + this + " on self ", Action.SIMULATING_DEBUG_COLOR);
				this._item.applyTo(caster, caster, this._hitCasterDist, true);
			}

			caster.simulateItemUse(this._item);
			Debug.log("I have " + caster.getStats().getTP() + " tp left");
		}
	}
	
	public void execute(ActionsManager manager, Array<Action> notExecutedSelfActions = [], MoveCell? moveCell = null) {
		while (this._useCount-- > 0) {
			if (moveCell != null) {
				string log = "Moving to " + moveCell!.cell.id;

				// Si on doit utiliser un item de TP
				if (this._teleportItem != null && !manager.isUsedMovementItem(this._teleportItem!)) {
					manager.addUsedMovementItem(this._teleportItem!);
					
					log += " using tp item " + moveCell!.itemTeleport + " from " + moveCell!.cellFromTeleport + " to " + moveCell!.cellToTeleport;
					
					do {
						manager.tryExecuteSelfActions(notExecutedSelfActions);	
					} while(moveTowardCell(moveCell!.cellFromTeleport!.id, 1));
					
					moveCell!.itemTeleport!.use(moveCell!.cellToTeleport!);
					// On retire l'item de téléportation pour les prochaines réalisations de l'action
					this._teleportItem = null;
				}

				Debug.log(log);
				do {
					manager.tryExecuteSelfActions(notExecutedSelfActions);	
				} while(moveTowardCell(moveCell!.cell.id, 1));
			}

			Cell myCell = CellMap.getCell(getCell()!)!;

			integer useResult = -99;
			for (TargetCell targetCell in this._targetCells) {							
				Debug.log("Using " + this._item.getName() + " on " + targetCell.cellTarget + " from " + myCell);
				if (this._item.getAreaType() == AREA_LASER_LINE || this._item.getAreaType() == AREA_FIRST_INLINE) {
					if (Cell.isOnSameDirection(targetCell.cellTarget, targetCell.cellFrom!, myCell) && this._item.canUseItemOnCell(targetCell.cellTarget)) {
						string targetsHash = AbstractEntity.getTargetsHash(this._item.getSimulationTargets(targetCell.cellTarget, targetCell.cellFrom, GAME.me), targetCell.cellTarget, true);
						Debug.log(targetsHash + " / " + this._targetsHash)

						useResult = this._item.use(targetCell.cellTarget);
					}
				} else {
					if (this._item.canUseItemOnCell(targetCell.cellTarget)) {
						string targetsHash = AbstractEntity.getTargetsHash(this._item.getSimulationTargets(targetCell.cellTarget, null, GAME.me), targetCell.cellTarget);
						if (this._hitCasterDist != -1) {
							integer dist = Cell.getDistance(myCell, targetCell.cellTarget);
							targetsHash += GAME.me.getId() + "|" + dist + ",";
						}

						Debug.log(targetsHash + " / " + this._targetsHash)

						if (targetsHash == this._targetsHash) {
							useResult = this._item.use(targetCell.cellTarget);
						} else {
							// On test en retirant les entité mortes du targetsHash
							string newTargetsHash = "";
							for (string targetsDist in split(this._targetsHash, ",")) {
								string targetId = split(targetsDist, "|")[0];
								if (isAlive(number(targetId) as integer))
									newTargetsHash += targetsDist + ",";
							}

							string newCurrentTargetsHash = "";
							for (string targetsDist in split(targetsHash, ",")) {
								string targetId = split(targetsDist, "|")[0];
								if (isAlive(number(targetId) as integer))
									newCurrentTargetsHash += targetsDist + ",";
							}

							Debug.log(newCurrentTargetsHash + " / " + newTargetsHash)

							if (newCurrentTargetsHash == newTargetsHash)
								useResult = this._item.use(targetCell.cellTarget);
						}
					}
				}


				if (useResult != -99) {
					if (useResult <= 0) {
						Debug.log("Target cells : " + this._targetCells);
						Debug.log("Cells from : " + this._cellsFrom);
						Debug.log("Use result : " + useResult);
					}

					if (useResult == USE_FAILED)
						Debug.error("The item use as failed");
					else if (useResult == USE_INVALID_COOLDOWN)
						Debug.error("The item use as failed cause the item is on cooldown");
					else if (useResult == USE_INVALID_POSITION)
						Debug.error("The item use as failed cause the positions aren't good");
					else if (useResult == USE_INVALID_TARGET)
						Debug.error("The item use as failed cause the target isn't valid");
					else if (useResult == USE_NOT_ENOUGH_TP)
						Debug.error("The item use as failed cause you don't have enough TP");
					else if (useResult == USE_RESURRECT_INVALID_ENTITY)
						Debug.error("The item use as failed cause the entity can't be ressurected");
					else if (useResult == USE_TOO_MANY_SUMMONS)
						Debug.error("The item use as failed cause you already have too many summons on the field");

					break;
				}
			}

			if (useResult == -99) {
				Debug.error("Action couldn't be made");
			}
		}
	}
	
	public string string() {
		string ret = "{id : " + this._id
			+ ", item : " + this._item
			//+ "cellsTo : " + this._targetCells + "\n"
			+ ", score : " + this._score
			+ ", useCount : " + this._useCount;
		
		if (this._teleportItem != null) {
			ret += ", teleportItem : " + this._teleportItem;
		}
		if (this._hitCasterDist != -1) {
			ret += ", distHitTarget : " + this._hitCasterDist;
		}
		//if (!setIsEmpty(this._targetCells)) {
			//ret += ", one target cell : " + setGetOne(this._targetCells);
		//}
		
		ret += "}";
		
		return ret;
	}
}


/** IA v5/Actions/ActionsManager **/


/** IA v5/Map/ScoreCell **/



class ScoreCell {
	public final Cell cell;
	public real score;
	
	constructor(Cell cell, real score) {
		this.cell = cell;
		this.score = score;
	}
	
	public string string() {
		return "{cell : " + this.cell + ", score : " + this.score + "}";
	}
}

class ActionsManager {
	private Map<integer, Action> _choosenActions;
	public boolean hasChoosenAction(integer id) { return mapContainsKey(this._choosenActions, id); }
	public Action? getChoosenAction(integer id) { return mapGet(this._choosenActions, id, null) as Action?; }
	
	private Array<Action> _selfActions;
	private Array<Action> _summonActions;
	private Array<Action> _orderedOtherActions; 
	public Array<Action> getOrderedOtherActions() { return this._orderedOtherActions; }
	public void clearOrderedOtherAction() { arrayClear(this._orderedOtherActions); }
	
	private Set<Action> _delayingActions;
	private Array<Action> _delayedSelfActions;
	
	private Map<Action, Action> _linkedPrevActions;
	private Map<Action, Set<Action>> _sameCellsFromLinkedActions;
	
	private Array<Item> _useableMovementItems;
	public void addUseableMovementItem(Item item) { push(this._useableMovementItems, item); }
	public void addUseableMovementItems(Set<Item> items) { for (Item item in items) push(this._useableMovementItems, item); }
	public void clearUseableMovementItems() { arrayClear(this._useableMovementItems); }
	public Array<Item> getUseableMovementItems() { return this._useableMovementItems; }
	private Set<Item> _usedMovementItems;
	public void addUsedMovementItem(Item item) { setPut(this._usedMovementItems, item);}
	public void removeUsedMovementItem(Item item) { setRemove(this._usedMovementItems, item); }
	public void clearUsedMovementItems() { setClear(this._usedMovementItems); }
	public boolean isUsedMovementItem(Item item) { return setContains(this._usedMovementItems, item); }

	private boolean _isDelayedSelfActions;
	
	constructor() {
		this.reset();
	}
	
	public void reset() {
		this._choosenActions = [:];
		this._selfActions = [];
		this._summonActions = [];
		this._orderedOtherActions = [];
		this._delayingActions = <>;
		this._delayedSelfActions = [];
		this._linkedPrevActions = [:];
		this._sameCellsFromLinkedActions = [:];
		this._useableMovementItems = [];
		this._usedMovementItems = <>;
		
		for (Action action in this._orderedOtherActions) {
			if (action.getTeleportItem() != null) {
				this.addUseableMovementItem(action.getTeleportItem()!);
			}
		}
		
		this._isDelayedSelfActions = false;
	}
												 
	public void simulate(AbstractEntity caster) {
		this.clearUsedMovementItems();
		
		this.orderSelfActions();
		this.orderDelayedSelfActions();
		
		this.simulateSelfAction(caster);
		
		Set<Action> delayingActions = clone(this._delayingActions) as Set<Action>;
		boolean isDelayedSelfActions = true;
		for (Action action in this._orderedOtherActions) {
			action.simulate(this, caster);
			
			// Si l'élément obligeait de delayer les self action, on le retire de _delayingActions
			setRemove(delayingActions, action);
			if (setIsEmpty(delayingActions)) {
				isDelayedSelfActions = false;
			}

			// On essaye d'exécuter les self action restantes sur cette cell
			if (!isDelayedSelfActions)
				this.simulateDelayedSelfAction(caster);
		}
		
		if (isDelayedSelfActions)
			this.simulateDelayedSelfAction(caster);
	}
	private void simulateSelfAction(AbstractEntity caster) {
		for (Action action in this._selfActions) {
			action.simulate(this,caster);
		}
	}
	private void simulateDelayedSelfAction(AbstractEntity caster) {
		for (Action action in this._delayedSelfActions) {
			action.simulate(this,caster);
		}
	}
	
	public void addSelfAction(Action action) {
		this._choosenActions[action.getUniqueId()] = action;
		
		if (this._isDelayedSelfActions)
			push(this._delayedSelfActions, action);
		else {
			EntityStats myStats = GAME.me.getStats();
			boolean isDelayedAction = false;
			for (Effect eff in action.getItem().getEffects()) {
				if (!eff.isStackable() && myStats.hasEffectOn(eff)) {
					Function<Effect, Cell?, Cell?, AbstractEntity, EntityStats, EntityStats, integer, boolean => integer> getAppliedValueFnct = Effect.getAppliedValueFnctPerId[eff.getType()]!;
					integer originalValue = (setGetOne(myStats.getEffectsOn(eff)) as EntityEffect).getValue();
					integer afterEffectValue = getAppliedValueFnct(eff, null, null, GAME.me, myStats, myStats, action.getHitCasterDist(), true);
					// Si la stats original est meilleur que la stats qu'on va ajouter
					if (originalValue - afterEffectValue > 0)
						isDelayedAction = true;
				}
			}

			if (isDelayedAction)
				push(this._delayedSelfActions, action);
			else
				push(this._selfActions, action);
		}
	}
												 
	/**
	 * @params actions : toutes les actions (pas sur soi) ordonnées
	 * @params isEndOfActions : si c'est la fin de l'algo et qu'on renvoi juste les bonnes actions à réaliser
	 **/
	public void setOrderedOtherAction(Array<Action> actions, boolean isEndOfActions = false) {
		this._orderedOtherActions = actions;

		if (isEndOfActions) return;
		
		for (Action action in actions) {
			this._choosenActions[action.getUniqueId()] = action;
			
			// Si l'item donne des TP
			if (action.getItem().hasEffectType(EFFECT_BUFF_TP) || action.getItem().hasEffectType(EFFECT_RAW_BUFF_TP)) {
				boolean isHitingCaster = false;
				// Et que l'effet affecte le caster
				for (Effect eff in action.getItem().getEffectsOfTypes(<EFFECT_BUFF_TP, EFFECT_RAW_BUFF_TP>)) {
					if (eff.isAffectingCaster())
						isHitingCaster = true;
				}
				
				// Ou qu'on est dans l'area
				if (setContains(action.getTargets(), GAME.me))
					isHitingCaster = true;
				
				if (isHitingCaster) {
					// On va mettre un delai sur les self actions
					this._isDelayedSelfActions = true;
					setPut(this._delayingActions, action);
				}
			}
		}
	}
	
	/**
	 * Retourne le coût de l'utilisation des actions, dans l'ordre donné, par caster
	 **/
	public integer getOrderedActionsCost(Array<Action> actions, SimulationEntity caster) {
		integer cost = 0;
		for (Action action in actions) {
			Item item = action.getItem();
			
			if (item instanceof Weapon && item.getId() != caster.getEquippedWeaponId()) {
				cost++;
				caster.setEquippedWeaponId(item.getId());
			}
			cost += item.getCost();
		}
		
		caster.resetEquippedWeaponId();
		
		return cost;
	}
	
	/**
	 * @params ScoreMap dangerMap : les scores les plus bas seront considéré comme les meilleures cells
	 **/
	public void executeChoosenActions(ScoreMap dangerMap) {
		this.clearUsedMovementItems();
		
		this.orderSelfActions();
		this.orderDelayedSelfActions();
		
		Debug.log("Delaying self actions : " + this._isDelayedSelfActions);
		Array<Action> notExecutedSelfActions = clone(this._selfActions) as Array<Action>;
		this.tryExecuteSelfActions(notExecutedSelfActions);
		
		// Gérer toutes les autres actions
		for (integer i : Action action in this._orderedOtherActions) {
			AbstractEntity.updatePositions();
			Cell myCell = GAME.me.getCell()!;
			AccessibleCells myCellsAcc;
			if (action.getTeleportItem() != null) {
				myCellsAcc = CellMap.getAccessibleCellsWithTeleport(myCell, getMP(), action.getTeleportItem()!);
			} else {
				myCellsAcc = CellMap.getAccessibleCells(myCell, getMP());
			}

			Map<Cell, MoveCell> moveCellPerCell = [:];
			Array<ScoreCell> scoredCellsFrom = [];
			for (MoveCell moveCell in action.getCellsFrom()) {
				if (!myCellsAcc.hasCell(moveCell.cell)) continue;
				
				// On récupère la moveCell des AccessibleCells de myCell pour être sûr de ne pas utiliser une moveCell simulée d'une autre manière
				moveCellPerCell[moveCell.cell] = myCellsAcc.getMoveCell(moveCell.cell);
				
				// Récupère le plus petit score de danger accessible via cette moveCell
				real lowestDangerScore = 999999.0;
				for (Cell accCell in CellMap.getAccessibleCells(moveCell.cell, moveCell.mpRemain).getCells()) {
					if (dangerMap.getScore(accCell) < lowestDangerScore)
						lowestDangerScore = dangerMap.getScore(accCell);
				}
				push(scoredCellsFrom, new ScoreCell(moveCell.cell, lowestDangerScore));
			}

			// Ordonne les cell en fonction du score de danger, puis en fonction du path length avec notre cell actuelle
			scoredCellsFrom = arraySort(scoredCellsFrom, function(ScoreCell sc1, ScoreCell sc2) => real {
				if (sc1.score == sc2.score) {
					return myCellsAcc.getMpUsed(sc1.cell) - myCellsAcc.getMpUsed(sc2.cell) as real;
				}
				return sc1.score - sc2.score;
			}) as Array<ScoreCell>;
			
			if (isEmpty(scoredCellsFrom)) {
				Debug.error("Couldn't find any accessible cells to realise " + action);
				Debug.log("Target cells : " + action.getTargetCells());
				Debug.log("Move cells : " + action.getCellsFrom());
			} else {
				Cell bestCellFrom = this.getBestCellFromToExecuteAction(action, scoredCellsFrom, moveCellPerCell, myCellsAcc, i==0);

				action.execute(this, notExecutedSelfActions, moveCellPerCell[bestCellFrom]);
				// Si l'élément obligeait de delayer les self action, on le retire de _delayingActions
				setRemove(this._delayingActions, action);
				if (setIsEmpty(this._delayingActions)) {
					if (this._isDelayedSelfActions)
						Debug.log("End of delaying, we can use self actions");
					this._isDelayedSelfActions = false;
				}

				// On essaye d'exécuter les self action restantes sur cette cell	
				this.tryExecuteSelfActions(notExecutedSelfActions, bestCellFrom);	
				if (!this._isDelayedSelfActions)
					this.tryExecuteSelfActions(this._delayedSelfActions, bestCellFrom);
			}
		}
	
		// S'il reste des actions delayée, ont les réalisent
		this.tryExecuteSelfActions(this._delayedSelfActions);
	}

	private Cell getBestCellFromToExecuteAction(Action action, Array<ScoreCell> scoredCellsFrom, Map<Cell, MoveCell> moveCellPerCell, AccessibleCells myCellsAcc, boolean isFirstAction) {

		Cell bestCellFrom = (arrayGet(scoredCellsFrom, 0) as ScoreCell).cell;
		// Si ce n'est pas la première action et que elle a un item pour se téléporter
		if (!isFirstAction && action.getTeleportItem() != null) {
			Cell myCell = CellMap.getCell(getCell()!)!;
			for (ScoreCell scoreCell in scoredCellsFrom) {
				MoveCell moveCell = moveCellPerCell[scoreCell.cell]!;
				// Si je peux aller sur la cell pour me teleport
				if (myCellsAcc.hasCell(moveCell.cellFromTeleport!)) {
					integer mpLeft = myCellsAcc.getMoveCell(moveCell.cellFromTeleport!)!.mpRemain;
					// Et que je peux aller sur la cell avec les mp restants
					if (setContains(CellMap.getAccessibleCells(moveCell.cellToTeleport!, mpLeft).getCells(), moveCell.cell)) {
						// Cette cell est bien accessible via la cell actuelle
						bestCellFrom = scoreCell.cell;
						break;
					}
				}
			}
		}
		
		return bestCellFrom;
	}

	private void tryExecuteSelfActions(Array<Action> actions, Cell cellFrom = CellMap.getCell(getCell()!)!) {
		// Gérer les actions sur soi même
		for (Action action in clone(actions) as Array<Action>) {
			// On n'essaye que les actions pas déjà exécutés
			if (this.tryExecuteSelfAction(action, cellFrom)) {
				removeElement(actions, action);
			} else {
				Debug.warning("Someone in the self cast aoe : " + action.getItem().getSimulationTargets(cellFrom, null, GAME.me) + " for " + action);
			}
		}
	}

	private boolean tryExecuteSelfAction(Action action, Cell cellFrom) {
		integer distWanted = action.getHitCasterDist();
		if (action.getHitCasterDist() == 0) {
			if (setSize(action.getItem().getSimulationTargets(cellFrom, null, GAME.me)) == 0) {
				// Si on est la seule entité affecté par l'item
				action.setTargetCells(<new TargetCell(cellFrom, null)>);		  
				action.execute(this);
			} else {
				return false;
			}
		} else {
			boolean isActionExecuted = false;
			for (Cell cell in action.getItem().getEffectiveArea(cellFrom, null)) {
				if (Cell.getDistance(cellFrom, cell) == distWanted && setSize(action.getItem().getSimulationTargets(cell, null, GAME.me)) == 0) {
					// If there is no targets, it means we will only hit ourself
					action.setTargetCells(<new TargetCell(cell, null)>);
					action.execute(this);
					isActionExecuted = true;
					break;
				}
			}
			
			if (!isActionExecuted)
				return false;
		}
		
		return true;
	}

	public Array<Action> orderSelfActions() {
		this._selfActions = arraySort(this._selfActions, function(Action a1, Action a2) => integer {
			return this.compareSelfActionOrder(a1, a2) as integer;
		}) as Array<Action>;
	}
	public Array<Action> orderDelayedSelfActions() {
		this._delayedSelfActions = arraySort(this._delayedSelfActions, function(Action a1, Action a2) => integer {
			return this.compareSelfActionOrder(a1, a2) as integer;
		}) as Array<Action>;
	}

	public Array<Action> orderOtherActions(Array<Action> actions) {
		return arraySort(actions, function(Action a1, Action a2) => integer {
			Set<AbstractEntity> sameTargets = setIntersection(a1.getTargets(), a2.getTargets()) as Set<AbstractEntity>;
			if (setContains(sameTargets, GAME.me))
				return this.compareSelfActionOrder(a1, a2) as integer;
			if (!setIsEmpty(sameTargets))
				return this.compareActionOrder(a1, a2);
			return 0;
		}) as Array<Action>;
	}

	/*
	 * @returns -1 if a1 need to be done first, 0 if they can be done in any order, 1 if a2 need to be done first
	 */
	public real compareSelfActionOrder(Action a1, Action a2) {
		return getSelfActionOrderScore(a1) - getSelfActionOrderScore(a2);
	}
	public real getSelfActionOrderScore(Action action) {
		integer score = 0;
		for (Effect effect in action.getItem().getEffects()) {
			integer effType = effect.getType();
			 if (effType == EFFECT_DEBUFF) {
				score += 0;
			 } else if(effType == EFFECT_BUFF_AGILITY or effType == EFFECT_RAW_BUFF_AGILITY) {
				score += 1;
			} else if(effType == EFFECT_BUFF_TP or effType == EFFECT_RAW_BUFF_TP) {
				score += 2;
			} else if(setContains(Effect.buffEffects, effType) or setContains(Effect.rawBuffEffects, effType)) {
				score += 3;
			} else if(setContains(Effect.maxLifeEffects, effType)) {
				score += 5;
			} else if(setContains(Effect.healEffects, effType) or setContains(Effect.shieldEffects, effType) or setContains(Effect.dmgReturnEffects, effType)) {
				score += 7;
			} else if(effType == EFFECT_ANTIDOTE or effType == EFFECT_REMOVE_SHACKLES) {
				score += 11;
			} else if(effType == EFFECT_SUMMON) {
				score += 20;
			} else {
				score += 9;
			}
		}
		
		return score / count(action.getItem().getEffects());
	}

	/*
	 * @returns -1 if a1 need to be done first, 0 if they can be done in any order, 1 if a2 need to be done first
	 */
	public integer compareActionOrder(Action a1, Action a2) {
		boolean a1HasEffectDebuff = a1.getItem().hasEffectType(EFFECT_DEBUFF);
		boolean a2HasEffectDebuff = a2.getItem().hasEffectType(EFFECT_DEBUFF);
		if (a1HasEffectDebuff && !a2HasEffectDebuff)
			return -1;
		if (!a1HasEffectDebuff && a2HasEffectDebuff)
			return 1;
		
		
		boolean a1HasEffectNovaVitality = a1.getItem().hasEffectType(EFFECT_NOVA_VITALITY);
		boolean a2HasEffectNovaVitality = a2.getItem().hasEffectType(EFFECT_NOVA_VITALITY);
		boolean a1HasEffectHeal = a1.getItem().hasEffectTypeIn(Effect.healEffects);
		boolean a2HasEffectHeal = a2.getItem().hasEffectTypeIn(Effect.healEffects);
		if (a1HasEffectNovaVitality && !a2HasEffectNovaVitality)
			if (a2HasEffectHeal)
				return -1;
		if (!a1HasEffectNovaVitality && a2HasEffectNovaVitality)
			if (a1HasEffectHeal)
				return 1;
		
		
		boolean a1HasEffectVulnerability = a1.getItem().hasEffectTypeIn(Effect.vulnerabilityEffects);
		boolean a2HasEffectVulnerability = a2.getItem().hasEffectTypeIn(Effect.vulnerabilityEffects);
		boolean a1HasEffectDamage = a1.getItem().hasEffectTypeIn(Effect.directDamageEffects);
		boolean a2HasEffectDamage = a2.getItem().hasEffectTypeIn(Effect.directDamageEffects);
		if ((a1HasEffectVulnerability && !a2HasEffectVulnerability) || (a1HasEffectHeal && !a2HasEffectHeal))
			if (a2HasEffectDamage)
				return -1;
		if ((!a1HasEffectVulnerability && a2HasEffectVulnerability) || (!a1HasEffectHeal && a2HasEffectHeal))
			if (a1HasEffectDamage)
				return 1;
		
		
		boolean a1HasEffectNoveDamage = a1.getItem().hasEffectType(EFFECT_NOVA_DAMAGE);
		boolean a2HasEffectNoveDamage = a2.getItem().hasEffectType(EFFECT_NOVA_DAMAGE);
		if (a1HasEffectDamage && !a2HasEffectDamage)
			if (a2HasEffectNoveDamage)
				return -1;
		if (!a1HasEffectDamage && a2HasEffectDamage)
			if (a1HasEffectNoveDamage)
				return 1;
		
		return 0;
	}

	public Action getLinkedPrevActions(Action action) {
		return mapGet(this._linkedPrevActions, action, null) as Action;	
	}
	public void linkPrevActions(Action action, Action prevAction) {
		this._linkedPrevActions[action] = prevAction;
	}

	public Set<Action> getSameCellsFromLinkedActions(Action action) {
		return mapGet(this._sameCellsFromLinkedActions, action, <>) as Set<Action>;	
	}
	public void linkSameCellsFromActions(Action a1, Action a2) {
		if (!mapContainsKey(this._sameCellsFromLinkedActions, a1)) {
			this._sameCellsFromLinkedActions[a1] = <>;
		}
		setPut(this._sameCellsFromLinkedActions[a1]!, a2);
		
		if (!mapContainsKey(this._sameCellsFromLinkedActions, a2)) {
			this._sameCellsFromLinkedActions[a2] = <>;
		}
		setPut(this._sameCellsFromLinkedActions[a2]!, a1);

		// Pour toutes les actions déjà lié à a1 on les lie avec a2
		for (Action linkedAction in clone(mapGet(this._sameCellsFromLinkedActions, a1, <>)) as Set<Action>) {
			setPut(this._sameCellsFromLinkedActions[linkedAction]!, a2);
			setPut(this._sameCellsFromLinkedActions[a2]!, linkedAction);
		}
		for (Action linkedAction in clone(mapGet(this._sameCellsFromLinkedActions, a2, <>)) as Set<Action>) {
			setPut(this._sameCellsFromLinkedActions[linkedAction]!, a1);
			setPut(this._sameCellsFromLinkedActions[a1]!, linkedAction);
		}
	}
	public void unlinkEveryActions() {
		mapClear(this._sameCellsFromLinkedActions);
	}
}
/** IA v5/Utils/RegistersManager **/

/** IA v5/Utils/Register **/



class Register {
	private string key;
	private JsonElement data;
	
	constructor(string key) {
		this.key = key;
		string? strData = getRegister(key);
		if (strData != null && strData != "") {
			any decodedData = jsonDecode(strData!);
			if (decodedData instanceof Object)
				this.data = new JsonObject(decodedData as Object);
			else if (decodedData instanceof Array)
				this.data = new JsonArray(decodedData as Array);
			else {
				Debug.error("Register data isn't either an Object or an Array " + strData + " / " + decodedData);
				this.data = new JsonObject();
			}
		}
		else
			this.data = new JsonObject();
	}
	
	public JsonElement get() {
		return this.data;
	}
	
	public void save() {
		setRegister(this.key, jsonEncode(this.data.encode()));
	}
	
	public void write(JsonElement jsonEl) {
		Object|Array encodedJson = jsonEl.encode();
		setRegister(this.key, jsonEncode(encodedJson));
		this.data = jsonEl;
	}
	
	public void clear() {
		deleteRegister(this.key);
		this.data = new JsonObject();
	}
}

class RegistersManager {
	public static final string ITEMS_SET_REGISTER_NAME = "ItemsSet";
	public static final string ITEMS_USE_COUNT_REGISTER_NAME = "ItemsUseCount";
	public static final string ITEMS_SCORES_REGISTER_NAME = "ItemsScores";
	public static final string STATS_REGISTER_NAME = "Stats";
	
	private static RegistersManager? instance;
	public static RegistersManager getInstance() {
		if (RegistersManager.instance == null)
			RegistersManager.instance = new RegistersManager();
		return RegistersManager.instance!;
	}
	
	private Map<string, Register> _registers;

	private constructor() {
		this._registers = [:];
		
		for (string name : string data in getRegisters()) {
			this._registers[name] = new Register(name);
		}
	}
	
	public Register get(string name) {
		if (mapContainsKey(this._registers, name))
			return this._registers[name]!;
		return this._registers[name] = new Register(name);
	}
}
/** IA v5/Utils/Json **/



class JsonElement {
	
	public void decode(Object|Array element) {}

	public Object|Array encode() {}
}

class JsonObject extends JsonElement {
	private Object _object;
	private Set<string> _propsName; public Set<string> getPropsName() { return this._propsName; }
	
	constructor() {
		this._object = {};
		this._propsName = <>;
	}
	constructor(Object object) {
		this.decode(object);
	}
	
	public void addProp(string name, any prop) {
		this._object[name] = prop;
		setPut(this._propsName, name);
	}
	
	public any? getProp(string name) {
		if (this.hasProp(name)) {
			return this._object[name];
		}
	}
	
	public void removeProp(string name) {
		if (this.hasProp(name)) {
			this._object[name] = null;
			setRemove(this._propsName, name);
		}
	}
	
	public boolean hasProp(string name) {
		return setContains(this._propsName, name);
	}
	
	public void decode(Object|Array object) {
		this._object = object as Object;
		this._propsName = arrayToSet(this._object.keys()) as Set<string>;
		
		for (string prop in this._propsName) {
			if (this._object[prop] instanceof Object) {
				this._object[prop] = new JsonObject(this._object[prop] as Object);
			} else if (this._object[prop] instanceof Array) {
				this._object[prop] = new JsonArray(this._object[prop] as Array);
			}
		}
	}
	
	public Object|Array encode() {
		Object object = clone(this._object) as Object;
		for (string prop in this._propsName) {
			if (object[prop] instanceof JsonObject) {
				object[prop] = (object[prop] as JsonObject).encode();
			} else if (object[prop] instanceof Array) {
				object[prop] = (object[prop] as JsonArray).encode();
			}
		}
		
		return object;
	}
}

class JsonArray extends JsonElement {
	private Array<any> _array;
	
	constructor() {
		this._array = [];
	}
	constructor(Array<any> array) {
		this.decode(array);
	}
	
	public any get(integer index) {
		if (index < count(this._array))
			return this._array[index];		
		return null;
	}
	
	public void decode(Object|Array array) {
		this._array = array as Array;
		
		for (integer i : any element in this._array) {
			if (element instanceof Object) {
				this._array[i] = new JsonObject(this._array[i] as Object);
			} else if (element instanceof Array) {
				this._array[i] = new JsonArray(this._array[i] as Array);
			}
		}
	}
	
	public Object|Array encode() {
		Array array = clone(this._array) as Array;
		for (integer i : any element in this._array) {
			if (element instanceof Object) {
				array[i] = (array[i] as JsonObject).encode();
			} else if (element instanceof Array) {
				array[i] = (array[i] as JsonArray).encode();
			}
		}
		
		return array;
	}
}

class AI {
	public static final integer MAX_DANGER_ITEMS_TESTED_COUNT = 14;
	public static final integer MIN_SCORE_USEFUL_ACTION = 45;
	
	private AbstractEntity _me;
	private Set<Team> _teams;
	private Map<AbstractEntity, Map<Item, Set<Cell>>> _cellsPerDangerItemPerEntity;
	private ScoreMap _dangerMap;
	private Array<Action> _everyActions; public void resetEveryActions() { arrayClear(this._everyActions); }
	private Array<Action> _actions;
	private real _highestActionScore;
	private ActionsManager _actionsManager;
	private Item? _movementEscapeItem;
	private JsonObject _itemsScoreStats;
	private real _highHighMeanScore;
	
	constructor(AbstractEntity me, Set<Team> teams) {
		this._me = me;
		this._teams = teams;
		this._dangerMap = new ScoreMap(<>, 0.0);
		this._cellsPerDangerItemPerEntity = [:];
		this._everyActions = [];
		this._actions = [];
		this._highestActionScore = 0.0;
		this._actionsManager = new ActionsManager();
		this._movementEscapeItem = null;
		
		if (this._me instanceof Leek) {
			this.registerItemsSet();
			this.registerStats();
			this.initItemsScoresRegister();
		}
	}
	
	/**
	 * Détermine toutes les action choisies du tour
	 **/
	public void determineActions() {
		if (!this._me.isStatic) {
			Debug.startOpCount();
			this.initDangerItemMap();
			Debug.stopOpCount("initDangerItemMap : ");
		}
		
		this._movementEscapeItem = null;
		this.resetEveryActions();
		this._actionsManager.reset();
		
		Action? prevChoosenAction = null;

		boolean canDoAction = true;
		while (canDoAction && this._me.isEntityAlive()) {			
			arrayClear(this._actions);

			if (!this._me.isStatic && prevChoosenAction == null || this.needToRecalculateDangerMap(prevChoosenAction)) {
				// recalcule la danger map en fonction des nouvelles stats des entités
				Debug.startOpCount();
				this.calculateDangerMap();
				Debug.stopOpCount("calculateDangerMap : ");
			}
			
			// update tout les multiplicateurs qui ont pu être modifiés par la simulation d'un effet
			//for (Team team in this._teams) {
				//for (AbstractEntity entity in team.getEntities()) {
					//entity.getStats().updateMults();
				//}
			//}
			
			// On vérifie que l'on a toujours besoin de fuir en utilisant un item
			if (this._movementEscapeItem != null) {
				real lowestDangerScoreAccessible = this.getLowestDangerScoreAccessible(this._me.getPathCalcAccessibleCells());
				if (this._highestActionScore > lowestDangerScoreAccessible) {
					// Si après les action déjà simulée, on est finalement plus en danger, on n'utilise plus de teleport escape
					this._me.unsimulateItemUse(this._movementEscapeItem!);
					Debug.log("Cancel escape with item : " + this._movementEscapeItem);
					this._movementEscapeItem = null;
				}
			}
			
			if (isEmpty(this._everyActions)) {
				Debug.startOpCount();
				this.generateActions();
				Debug.stopOpCount("generateActions : ");
			} else {
				Debug.startOpCount();
				this.filterUseableActions();
				Debug.stopOpCount("filterUseableActions : ");
			}

			Debug.startOpCount();
			this.filterToFarActions();
			Debug.stopOpCount("filterToFarActions : ");
			
			Debug.startOpCount();
			this.calculateActionsScore();
			Debug.stopOpCount("calculateActionsScore : ");
			
			Debug.startOpCount();
			this.orderActionsByScore();
			Debug.stopOpCount("orderActionsByScore : ");
			
			if (this._me instanceof Leek) {
				this.registerItemsScores();
			}
			
			Debug.log("Actions possible found : " + count(this._actions));
			integer i = 0;
			for (Action action in this._actions) {
				Debug.log(action, getColor(175, 175, 175));
				
				i++;
				if (i > 30) break;
			}
			
			boolean useDangerMap = this.doNeedDangerMap();
			
			Debug.startOpCount();
			Action? bestDoableAction = this.filterBestDoableAction(useDangerMap);
			Debug.stopOpCount("filterBestDoableAction : ");
			
			if (bestDoableAction == null) {
				canDoAction = false;
			} else {
				if (bestDoableAction!.getScore() < this._highestActionScore)
					this._highestActionScore = bestDoableAction!.getScore();
				
				Debug.startOpCount();
				GAME.updateAllStats();
				for (AbstractEntity entity in GAME.getAllEntities()) {
					// On reset les stats de simulation pour enlever les cellules modifiés lors de la simu
					entity.getSimulationEntity().resetStats();
				}
				if (this._movementEscapeItem != null)
					this._me.simulateItemUse(this._movementEscapeItem!);
				this._actionsManager.simulate(this._me);
				Debug.stopOpCount("Simulate all actions : ");
				
				if (this._me instanceof Leek) {
					this.registerChoosenItem(bestDoableAction!);
				}
			}
			
			if (bestDoableAction == null)
				Debug.log("Pas d'action réalisable trouvée");
		}
	}
	
	private boolean needToRecalculateDangerMap(Action? prevChoosenAction) {
		if (prevChoosenAction == null) return false;
		
		Item item = prevChoosenAction!.getItem();
		// Si on fait des dégats à une entité, on recalcule
		if (item.hasEffectTypeIn(Effect.directDamageEffects))
			return true;
		
		// Si on se shield / heal soi même
		if (item.hasEffectTypeIn(Effect.shieldEffects) || item.hasEffectTypeIn(Effect.rawShieldEffects) || item.hasEffectTypeIn(Effect.healEffects)) {
			if (prevChoosenAction!.getHitCasterDist() != -1)
				return true;
			
			for (Effect eff in item.getEffects()) {
				integer effType = eff.getType();
				if ((setContains(Effect.shieldEffects, effType) || setContains(Effect.rawShieldEffects, effType) || setContains(Effect.healEffects, effType)) && eff.isAffectingCaster()) {
					return true;
				}
			}
			return true;
		}
		return false;
	}
	
	private real getLowestDangerScoreAccessible(AccessibleCells accCells) {
		real lowestDangerScoreAccessible = 999999.0;
		for (Cell cell in accCells.getCells()) {
			if (this._dangerMap.getScore(cell) < lowestDangerScoreAccessible)
				lowestDangerScoreAccessible = this._dangerMap.getScore(cell);
		}
		return lowestDangerScoreAccessible;
	}
	
	/**
	 * 
	 **/
	private boolean doNeedDangerMap() {
		// Si le score de la meilleur action est <= au plus petit score de la map de danger, alors on ne va pas prendre en compte la map de danger
		real lowestDangerScoreAccessible = this.getLowestDangerScoreAccessible(this._me.getPathCalcAccessibleCells());
		if (!isEmpty(this._actions) && this._actions[0].getScore() <= lowestDangerScoreAccessible && this._highestActionScore <= lowestDangerScoreAccessible) {
			if (this._movementEscapeItem != null) return true;
			
			// On test si on peut aller sur une cell safe avec un item de téléport
			for (Item moveItem in this._me.getOffCooldownMovementItemsOrderedByCost()) {
				if (moveItem.getCost() > this._me.getStats().getTP()) continue;
				
				real lowestDangerScoreAccessibleWithTp = this.getLowestDangerScoreAccessible(this._me.getAccessibleCellsWithItem(moveItem)!);

				if (this._actions[0].getScore() > lowestDangerScoreAccessibleWithTp) {
					// On peut utiliser cette item pour aller sur une cell safe
					this._movementEscapeItem = moveItem;
					this._me.simulateItemUse(this._movementEscapeItem!);
					Debug.log("Will escape with teleport item : " + this._movementEscapeItem);
					break;
				}
			}

			if (this._movementEscapeItem == null) {
				// Même avec des item de téléport on ne peut pas accéder à une cell safe
				Debug.log("Not using danger map", getColor(127, 3, 252));
				return false;
			}
		} else if (this._movementEscapeItem != null && !isEmpty(this._actions)) {
			// Si après les action déjà simulée, on est finalement plus en danger, on n'utilise plus de teleport escape
			this._me.unsimulateItemUse(this._movementEscapeItem!);
			Debug.log("Cancel escape with teleport item : " + this._movementEscapeItem);
			this._movementEscapeItem = null;
		}
		
		return true;
	}
	
	/*
	 * Enregistre les stats utilisées pour les différents type de combat
	 */
	private void registerStats() {
		Register statsSetReg = RegistersManager.getInstance().get(RegistersManager.STATS_REGISTER_NAME);
		string fightTypeStr = string(getFightType());
		
		EntityStats baseStats = this._me.getBaseStats();
		string statsHash = "";
		statsHash += baseStats.getStrength() + "|";
		statsHash += baseStats.getWisdom() + "|";
		statsHash += baseStats.getAgility() + "|";
		statsHash += baseStats.getResistance() + "|";
		statsHash += baseStats.getScience() + "|";
		statsHash += baseStats.getMagic() + "|";
		statsHash += baseStats.getMP() + "|";
		statsHash += baseStats.getTP() + "|";
		
		JsonObject statsPerFightType = statsSetReg.get() as JsonObject;
		if (statsPerFightType.hasProp(fightTypeStr)) {
			string saveStatsHash = statsPerFightType.getProp(fightTypeStr) as string;
			if (saveStatsHash != statsHash) {
				Debug.warning("Reseting ITEMS_SCORES / ITEMS_USE_COUNT registers cause stats have changed");
				Debug.log(saveStatsHash + " / " + statsHash);

				// Si les items ont changés, on reset le registre des utilisations d'item
				Register? statsUseCountReg = RegistersManager.getInstance().get(RegistersManager.ITEMS_SCORES_REGISTER_NAME + fightTypeStr);
				if (statsUseCountReg != null) {
					JsonObject statsUseCount = statsUseCountReg!.get() as JsonObject;
					if (statsUseCount.hasProp(fightTypeStr))
						statsUseCount.addProp(fightTypeStr, new JsonObject());
					statsUseCountReg!.save();
				}
				
				Register? itemsUseCountReg = RegistersManager.getInstance().get(RegistersManager.ITEMS_USE_COUNT_REGISTER_NAME);
				if (itemsUseCountReg != null) {
					JsonObject itemsUseCount = itemsUseCountReg!.get() as JsonObject;
					if (itemsUseCount.hasProp(fightTypeStr))
						itemsUseCount.addProp(fightTypeStr, new JsonObject());
					itemsUseCountReg!.save();
				}
			}
		}
		
		statsPerFightType.addProp(fightTypeStr, statsHash);
		statsSetReg.save();
	}
	
	/*
	 * Enregistre les items utilisés pour les différents type de combat
	 */
	private void registerItemsSet() {
		Register itemsSetReg = RegistersManager.getInstance().get(RegistersManager.ITEMS_SET_REGISTER_NAME);
		string fightTypeStr = string(getFightType());
		
		Array<Item> itemsOrderedById = arraySort(setToArray(this._me.getItems()), function(Item i1, Item i2) => integer {
			return i1.getId() - i2.getId();
		}) as Array<Item>;
		
		string itemsHash = "";
		for (Item item in itemsOrderedById) {
			itemsHash += item.getId() + "|"	
		}
		
		JsonObject itemsSetPerFightType = itemsSetReg.get() as JsonObject;
		if (itemsSetPerFightType.hasProp(fightTypeStr)) {
			string saveItemsHash = itemsSetPerFightType.getProp(fightTypeStr) as string;
			if (saveItemsHash != itemsHash) {
				Debug.warning("Reseting ITEMS_USE_COUNT register cause items have changed");
				Debug.log(saveItemsHash + " / " + itemsHash);

				// Si les items ont changés, on reset le registre des utilisations d'item
				Register? itemsUseCountReg = RegistersManager.getInstance().get(RegistersManager.ITEMS_USE_COUNT_REGISTER_NAME);
				if (itemsUseCountReg != null) {
					JsonObject itemsUseCount = itemsUseCountReg!.get() as JsonObject;
					if (itemsUseCount.hasProp(fightTypeStr))
						itemsUseCount.addProp(fightTypeStr, new JsonObject());
					itemsUseCountReg!.save();
				}
			}
		}
		
		itemsSetPerFightType.addProp(fightTypeStr, itemsHash);
		itemsSetReg.save();
	}
	
	/*
	 * Enregistre le nombre d'utilisation des items pour les différents type de combat
	 */
	private void registerChoosenItem(Action action) {
		Register itemsUseCountReg = RegistersManager.getInstance().get(RegistersManager.ITEMS_USE_COUNT_REGISTER_NAME);
		string fightTypeStr = string(getFightType());

		JsonObject itemsUseCountPerFightType = itemsUseCountReg.get() as JsonObject;
		if (!itemsUseCountPerFightType.hasProp(fightTypeStr)) {
			itemsUseCountPerFightType.addProp(fightTypeStr, new JsonObject());
		}
		
		string itemName = action.getItem().getName();
		JsonObject itemsUseCount = itemsUseCountPerFightType.getProp(fightTypeStr) as JsonObject;
		if (!itemsUseCount.hasProp(itemName)) {
			itemsUseCount.addProp(itemName, 0);
		}
		itemsUseCount.addProp(itemName, (itemsUseCount.getProp(itemName) as integer) + 1);
		itemsUseCountReg.save();
	}
	
	/*
	 * Enregistre la moyenne des scores des items pour les différents type de combat
	 */	
	private void initItemsScoresRegister() {		
		string fightTypeStr = string(getFightType());
		Register scoresReg = RegistersManager.getInstance().get(RegistersManager.ITEMS_SCORES_REGISTER_NAME + fightTypeStr); 
		
		this._itemsScoreStats = scoresReg.get() as JsonObject;

		this._highHighMeanScore = 0.0;
		for (string propName in this._itemsScoreStats.getPropsName()) {
			JsonObject itemScoreStats = this._itemsScoreStats.getProp(propName) as JsonObject;
			this._highHighMeanScore += itemScoreStats.getProp("meanHighHigh") as integer;
		}
		this._highHighMeanScore /= setSize(this._itemsScoreStats.getPropsName());
	}
	private void registerItemsScores() {
		Map<Item, real> cumulatedScorePerItem = [:];
		Map<Item, integer> scoresCountPerItem = [:];
		for (Action action in this._actions) {
			Item item = action.getItem();
			real score = action.getScore();
			
			if (!mapContainsKey(scoresCountPerItem, item))
				scoresCountPerItem[item] = 0;
			// On ne prend que le meilleur score
			if (scoresCountPerItem[item] > 0) continue;
			scoresCountPerItem[item]++;
			
			if (!mapContainsKey(cumulatedScorePerItem, item))
				cumulatedScorePerItem[item] = 0.0;
			cumulatedScorePerItem[item] += score;
		}
		
		for (Item item : real cumulatedScore in cumulatedScorePerItem) {
			integer score = round(cumulatedScore / scoresCountPerItem[item]!);
			
			JsonObject itemScoreObj = new JsonObject();
			string itemName = item.getName();
			if (this._itemsScoreStats.hasProp(itemName))
				itemScoreObj = this._itemsScoreStats.getProp(itemName) as JsonObject;

			integer meanCount = 1;
			if (!itemScoreObj.hasProp("meanCount")) {
				itemScoreObj.addProp("meanCount", 1);
			} else {
				meanCount = itemScoreObj.getProp("meanCount") as integer;
				itemScoreObj.addProp("meanCount", meanCount + 1);
			}
			if (!itemScoreObj.hasProp("mean")) {
				itemScoreObj.addProp("mean", score);
				itemScoreObj.addProp("meanHigh", score);
				itemScoreObj.addProp("meanHighHigh", score);
			} else {
				itemScoreObj.addProp("mean", round((itemScoreObj.getProp("mean") * meanCount + score) / (meanCount + 1)));
			}

			if (score > itemScoreObj.getProp("mean")) {
				if (!itemScoreObj.hasProp("meanHighCount")) {
					itemScoreObj.addProp("meanHigh", score);
					itemScoreObj.addProp("meanHighCount", 1);
				} else {
					integer meanHighCount = itemScoreObj.getProp("meanHighCount") as integer;
					itemScoreObj.addProp("meanHigh", round((itemScoreObj.getProp("meanHigh") * meanHighCount + score) / (meanHighCount + 1)));
					itemScoreObj.addProp("meanHighCount", meanHighCount + 1);
					
					// On set la meanHighHigh à la valeur de la meanHigh si elle n'existe pas encore
					if (itemScoreObj.getProp("meanHighHighCount") < itemScoreObj.getProp("meanHigh"))
						itemScoreObj.addProp("meanHighHigh", itemScoreObj.getProp("meanHigh"));

				}
			}
			
			if (score > itemScoreObj.getProp("meanHigh")) {
				if (!itemScoreObj.hasProp("meanHighHighCount")) {
					itemScoreObj.addProp("meanHighHigh", score);
					itemScoreObj.addProp("meanHighHighCount", 1);
				} else {
					integer meanHighHighCount = itemScoreObj.getProp("meanHighHighCount") as integer;
					itemScoreObj.addProp("meanHighHigh", round((itemScoreObj.getProp("meanHighHigh") * meanHighHighCount + score) / (meanHighHighCount + 1)));
					itemScoreObj.addProp("meanHighHighCount", meanHighHighCount + 1);
				}
			}

			this._itemsScoreStats.addProp(itemName, itemScoreObj);
		}
		
		string fightTypeStr = string(getFightType());
		Register scoresReg = RegistersManager.getInstance().get(RegistersManager.ITEMS_SCORES_REGISTER_NAME + fightTypeStr); 
		
		scoresReg.write(this._itemsScoreStats); 
		scoresReg.save(); 
	}
	
	/**
	 * Execute toutes les actions choisies
	 **/
	public void executeActions() {
		Debug.startOpCount();
		this._actionsManager.executeChoosenActions(this._dangerMap);
		Debug.stopOpCount("executeChoosenActions : ");
	}
	
	/**
	 * Déplace l'entité sur la meilleur cell possible en fonction de la map de danger
	 **/
	public void goToEndOfTurnCell() {
		if (this._me.isStatic) return;
		
		this._me.updateStats();
		
		//clearMarks();
		//this._dangerMap.debugMap();
		//pause();
		
		AccessibleCells accCellsToUse;
		if (this._movementEscapeItem != null) {
			if (this._movementEscapeItem!.hasEffectType(EFFECT_TELEPORT)) {
				accCellsToUse = CellMap.getAccessibleCellsWithTeleport(this._me.getCell()!, this._me.getStats().getMP(), this._movementEscapeItem!);
			} else if (this._movementEscapeItem!.hasEffectType(EFFECT_TELEPORT)) {
				
			}
			
			Debug.log("Using item to escape " + this._movementEscapeItem);
		} else {
			accCellsToUse = CellMap.getAccessibleCells(this._me.getCell()!, this._me.getStats().getMP());	
		}
		
		Array<ScoreCell> sortedCells = [];
		for (MoveCell moveCell in accCellsToUse.getMoveCells()) {
			push(sortedCells, new ScoreCell(moveCell.cell, this._dangerMap.getScore(moveCell.cell)));
		}
		sortedCells = arraySort(sortedCells, function(ScoreCell cs1, ScoreCell cs2) => real {
			return cs1.score - cs2.score;
		}) as Array<ScoreCell>;

		ScoreCell bestScoreCell = (arrayGet(sortedCells, 0) as ScoreCell);
		if (this._movementEscapeItem != null) {
			MoveCell? moveCell = accCellsToUse.getMoveCells()[bestScoreCell.cell];
			if (moveCell != null && moveCell!.cellFromTeleport != null) {
				Debug.log("Moving to " + moveCell!.cellFromTeleport + " to tp");
				moveTowardCell(moveCell!.cellFromTeleport!.id);
				Debug.log("Teleporting to " + moveCell!.cellToTeleport + " with " + moveCell!.itemTeleport);
				moveCell!.itemTeleport!.use(moveCell!.cellToTeleport!);
				Debug.log("Moving to end on " + moveCell!.cell);
				moveTowardCell(moveCell!.cell.id);
			} else if (moveCell!.cellFromTeleport == null) {
				Debug.log("Don't need to escape with teleport to " + moveCell);
			} else {
				Debug.error("Can't escape with teleport to " + moveCell);
			}
		} else {
			Debug.log("Moving to end on " + bestScoreCell.cell.id);
			moveTowardCell(bestScoreCell.cell.id);
		}
	}
	
	/**
	 * Sélectionne la meilleur arme probable pour le prochain tour
	 **/
	public void selectBestWeapon() {
		if (this._me.getStats().getTP() >= 1) {
			AbstractEntity? nearestEnemy = null;
			integer nearestEnemyDist = 999999;
			for (Team team in this._teams) {
				if (team == this._me.getTeam()) continue;
				
				for (AbstractEntity entity in team.getAliveLeeks()) {
					integer? dist = entity.getPathLengthCells().getMpUsed(this._me.getCell()!);
					if (dist != null) {
						if (dist < nearestEnemyDist) {
							nearestEnemyDist = dist!;
							nearestEnemy = entity;
						}
					}
				}
			}
			
			Array<Weapon> weaponsArray = [];
			if (this._me instanceof Leek)
				weaponsArray = setToArray((this._me as Leek).getLeekWeapons()) as Array<Weapon>;
			Array<Weapon> orderedWeapons = arrayFilter(weaponsArray, function(Weapon weapon) => boolean {
				boolean result = false;
				for (Effect eff in weapon.getEffects()) {
					integer effType = eff.getType();
					if (effType == EFFECT_DAMAGE)
						if (this._me.getStats().getStrength() > EntityStatsDiviser.strength * 0.8)
							result = true;
					else if (effType == EFFECT_NOVA_DAMAGE)
						if (this._me.getStats().getScience() > EntityStatsDiviser.science * 0.8)
							result = true;
					else if (effType == EFFECT_POISON)
						if (this._me.getStats().getMagic() > EntityStatsDiviser.magic * 0.8)
							result = true;
				}
				return result;
			}) as Array<Weapon>;

			orderedWeapons = arraySort(orderedWeapons, function(Weapon w1, Weapon w2) => integer {			
				return (abs(w1.getMinRange() - nearestEnemyDist) + abs(w1.getMaxRange() - nearestEnemyDist)) - (abs(w2.getMinRange() - nearestEnemyDist) + abs(w2.getMaxRange() - nearestEnemyDist));
			}) as Array<Weapon>;
			
			for (var weapon in orderedWeapons) {
				setWeapon(weapon.getId());
				break;
			}
		}
	}
	
	/**
	 * Filtre les actions qu'il est possible d'effectuer
	 **/
	private Action? filterBestDoableAction(boolean useDangerMap) {	
		Array<Action> doableOtherActions = [];
		for (Action action in this._actionsManager.getOrderedOtherActions())
			push(doableOtherActions, action.clone());
		
		Cell myCell = this._me.getCell()!;
		Set<Item> alreadyUsedMovementItem = <>;
		for (Action action in this._actionsManager.getOrderedOtherActions()) {
			if (action.getTeleportItem() != null)
				setPut(alreadyUsedMovementItem, action.getTeleportItem());
		}
				
		for (Action action in this._actions) {			
			if (action.getScore() <= AI.MIN_SCORE_USEFUL_ACTION) continue;
			
			// Si l'action a déjà été choisie précédement
			if (this._actionsManager.hasChoosenAction(action.getUniqueId())) {
				this._actionsManager.getChoosenAction(action.getUniqueId())!.addUse();
				return action;
			}
			
			// Si ce n'est pas un self cast
			if (!setIsEmpty(action.getTargetCells())) {
				this._actionsManager.clearUseableMovementItems();
				this._actionsManager.addUseableMovementItems(alreadyUsedMovementItem);
				for (AbstractEntity entity in GAME.getAllEntities()) {
					// On reset les stats de simulation pour le prochain test de pathing
					entity.getSimulationEntity().resetStats();
				}
				
				if (!this._me.isStatic()) {
					for (Item moveItem in this._me.getOffCooldownMovementItemsOrderedByCost()) {
						// Si j'ai assez de TP pour faire l'action et utiliser l'item de movement
						// Et que l'action est réalisable en utilisant l'item de movement
						integer switchWeaponCost = action.getItem() instanceof Weapon && (this._me as Leek).getEquippedWeaponId() != action.getItem().getId() ? 1 : 0;
						if (moveItem.getCost() + action.getItem().getCost() + switchWeaponCost > this._me.getStats().getTP()) continue;
						
						if (this.isActionWorthTeleporting(action, moveItem)) {
							this._actionsManager.addUseableMovementItem(moveItem);
						}
					}
				}
				
				if (this.canDoAction(action, doableOtherActions, useDangerMap)) {
					action.addUse();
					return action;
				}
			} else {
				// Si c'est un self cast
				action.addUse();
				this._actionsManager.addSelfAction(action);
				return action;
			}
		}
		
		// Aucune nouvelle action ne peut être ajouté donc on remet les actions déjà choisie avec les bonnes cellsFrom
		this._actionsManager.setOrderedOtherAction(doableOtherActions, true);

		return null;
	}

	/**
	 * Détermine si utilise un item de mouvement pour l'action, vaut le coût
	 **/
	private boolean isActionWorthTeleporting(Action action, Item moveItem) {
		Item item = action.getItem();
		real costMult = (moveItem.getCost() / 2 - 3) / 20;
		real cdMult = (moveItem.getBaseCooldown() / 2.5 - 3) / 8;
		real scoreMult = costMult + cdMult;
		
		// Si le score est < à la moyenne des très haute moyenne de chaque item, alors la tp ne vaut pas le coup
		if (action.getScore() < this._highHighMeanScore * (1 + scoreMult)) return false;

		string itemName = item.getName();
		JsonObject itemScoreStatsObj;
		if (this._itemsScoreStats.hasProp(itemName)) {
			itemScoreStatsObj = this._itemsScoreStats.getProp(itemName) as JsonObject;
		
			if (itemScoreStatsObj.hasProp("meanHigh")) {
				integer meanHighHigh = itemScoreStatsObj.getProp("meanHighHigh") as integer;
				// Ecrat entre la moyenne et la moyenne haute
				integer diff = (meanHighHigh - itemScoreStatsObj.getProp("meanHigh")) as integer;
				real scoreNeeded = meanHighHigh - 2 * diff * costMult;

				// Si le score est > à la moyenne haute des scores de l'item, alors le téléport vaut le coup
				if (action.getScore() > scoreNeeded)
					return true;
			}
		}
				
		return false;
	}

	/**
	 * 
	 **/
	private Set<MoveCell> getCellsAccessibleToHit(Action action) {
		Set<Cell> cellsCanMoveToHit = this.getActionCellsCanMoveToHit(action);
		AccessibleCells accessibleCells = this._me.getPathCalcAccessibleCells();
		
		// Cells accessibles qui permettent d'utiliser l'item sur une des targetCell
		Set<MoveCell> cellsAccessibleToHit = <>;
		for (MoveCell moveCell in accessibleCells.getMoveCells()) {
			if (setContains(cellsCanMoveToHit, moveCell.cell))
				setPut(cellsAccessibleToHit, moveCell);
		}
		
		// Si on ne peut pas aller sur une des cell pour utiliser l'item
		if (setIsEmpty(cellsAccessibleToHit)) {
			// On essaye avec les items de movement disponibles
			for (Item moveItem in this._actionsManager.getUseableMovementItems()) {
				accessibleCells = this._me.getAccessibleCellsWithItem(moveItem)!;
				for (MoveCell moveCell in accessibleCells.getMoveCells()) {
					if (setContains(cellsCanMoveToHit, moveCell.cell))
						setPut(cellsAccessibleToHit, moveCell);
				}
								
				// On a trouvé des cell avec cette item de movement
				if (!setIsEmpty(cellsAccessibleToHit)) {
					// S'il n'y a pas encore d'action non self cast
					if (!this._actionsManager.isUsedMovementItem(moveItem)) {
						action.setTeleportItem(moveItem);
						this._actionsManager.addUsedMovementItem(moveItem);
					}
					break;
				}
			}
		}
		
		return cellsAccessibleToHit;
	}

	/**
	 * Détermine si on peu réaliser l'action en même temps que toutes les autres déjà choisies
	 **/
	private boolean canDoAction(Action action, Array<Action> otherActions, boolean useDangerMap) {			
		// S'il n'y a pas encore d'action non self cast
		if (isEmpty(otherActions)) {
			this._actionsManager.clearUsedMovementItems();

			// Cells accessibles qui permettent d'utiliser l'item sur une des targetCell
			Set<MoveCell> cellsAccessibleToHit = this.getCellsAccessibleToHit(action);
			
			// S'il n'y a pas de cellules accessibles permettant d'utiliser l'item
			if (setIsEmpty(cellsAccessibleToHit))
				return false;
			
			// Pour toutes les cells ou on peut utiliser l'item on regarde si le score de la map de danger est suffisament faible pour le score de l'action
			Set<MoveCell> cellsWithSafeEscape = <>;
			for (MoveCell moveCell in cellsAccessibleToHit) {
				if (!useDangerMap || this.doesCellHaveSafeEscape(action, moveCell)) {
					setPut(cellsWithSafeEscape, moveCell);
				}
			}
			
			// Si on a trouvé des cell avec une escape safe
			if (!setIsEmpty(cellsWithSafeEscape)) {
				action.setCellsFrom(cellsWithSafeEscape);
				this._actionsManager.setOrderedOtherAction([action]);
				return true;
			}

		} else {
			Array<Action> newOtherActions = [];
			Action? invertAction = null;
			for (Action otherAction in otherActions) {
				push(newOtherActions, otherAction.clone());
				
				if (otherAction.getItem().hasEffectType(EFFECT_INVERT)) {
					invertAction = otherAction;
				}
			}
			push(newOtherActions, action);
			
			if (invertAction == null) {
				// On ordonne les actions dans le sens le plus logique
				newOtherActions = this._actionsManager.orderOtherActions(newOtherActions);
			} else {
				// Dans le cas d'une inversion, on vérifie qu'il soit possible de réaliser les autres actions même si inversion est fait avant
				boolean canInvertBeforeOtherActions = true;
				AbstractEntity invertionTarget = setGetOne(invertAction!.getTargets()) as AbstractEntity;
				for (Action otherAction in newOtherActions) {
					if (otherAction == invertAction) continue;
					
					// Si otherAction ne vise pas l'entité inversée où qu'elle le fait mais que c'est l'unique entité visée
					if (setSize(otherAction.getTargets()) > 1 && setContains(otherAction.getTargets(), invertionTarget)) {
						canInvertBeforeOtherActions = false;
					}
				}
				
				if (canInvertBeforeOtherActions) {
					// On ordonne les actions dans le sens le plus logique
					newOtherActions = this._actionsManager.orderOtherActions(newOtherActions);
				}
			}
			
						
			Set<integer> alreadyReversed = <>;
			boolean isTestingPossibilities = false;
			do {
				//Debug.log("Trying new path " + newOtherActions, COLOR_BLUE);

				// Si l'ordre des items fait que la suite d'action coûte plus que nos TP, alors on ne peut pas faire l'action
				if (this._actionsManager.getOrderedActionsCost(newOtherActions, this._me.getSimulationEntity()) > this._me.getSimulationEntity().getTP()) return false;
				
				// On clear les items de mouvement déjà utilisés
				this._actionsManager.clearUsedMovementItems();
				for (Action newOtherAction in newOtherActions) {
					newOtherAction.setTeleportItem(null);	
					// On reset tous les paths
					newOtherAction.clearCellsFrom();
				}
				for (AbstractEntity entity in GAME.getAllEntities()) {
					// On reset les stats de simulation pour le prochain test de pathing
					entity.getSimulationEntity().resetStats();
				}
				
				isTestingPossibilities = false;
				boolean isActionDoable = true;
				integer curUsedTP = 0;
				
				Action firstAction = newOtherActions[0];
				if (this.findCellsFromForFirstAction(firstAction, useDangerMap)) {
					this.simulateActionForPathing(firstAction);

					if (firstAction.getItem().hasEffectType(EFFECT_INVERT))
						this.invertActionCells(firstAction, newOtherActions, 0);
				}

				// Pour toutes les actions choisie + cette action, ordonnée
				for (integer i = 0; i < count(newOtherActions) - 1; i++) {						
					curUsedTP += newOtherActions[i+1].getItem().getCost();
					
					Action choosenAction = newOtherActions[i];
					Action nextChoosenAction = newOtherActions[i+1]
					
					// Si on a actuellement assez de TP pour faire l'action et qu'on trouve un path
					if (curUsedTP <= this._me.getSimulationEntity().getTP() && this.findPathsBetweenChoosenActions(choosenAction, nextChoosenAction, useDangerMap)) {
						this.simulateActionForPathing(nextChoosenAction);

						if (nextChoosenAction.getItem().hasEffectType(EFFECT_INVERT))
							this.invertActionCells(nextChoosenAction, newOtherActions, i+1);
						
						continue;
					}

					boolean canBeReversed = true;
					Set<AbstractEntity> sameTargets = setIntersection(newOtherActions[i].getTargets(), newOtherActions[i+1].getTargets()) as Set<AbstractEntity>;
					if (setContains(sameTargets, this._me) && this._actionsManager.compareSelfActionOrder(newOtherActions[i], newOtherActions[i+1]) != 0) {
						// Si on est affecté par les deux actions et que les deux actions n'ont pas le même score de priorité
						canBeReversed = false;
					} else if (!setIsEmpty(sameTargets) && this._actionsManager.compareActionOrder(newOtherActions[i], newOtherActions[i+1]) != 0) {
						// Si au moins une entité est affecté par les deux actions et que les deux actions n'ont pas le même score de priorité
						canBeReversed = false;
					}

					// On vérifit qu'on a pas déjà inversé les deux actions
					if (canBeReversed && !setContains(alreadyReversed, i)) {
						// Intervertit
						Action tmpAction = newOtherActions[i];
						newOtherActions[i] = newOtherActions[i+1];
						newOtherActions[i+1] = tmpAction;
						
						// On supprime les paths pour ces 2 actions
						newOtherActions[i].clearCellsFrom();
						newOtherActions[i].setTeleportItem(null);
						newOtherActions[i+1].clearCellsFrom();
						newOtherActions[i+1].setTeleportItem(null);
						this._actionsManager.unlinkEveryActions();
						
						setPut(alreadyReversed, i);
						isTestingPossibilities = true;
						isActionDoable = false;
						break;
					} else {
						// La nextChoosenAction n'est pas réalisable après choosenAction, donc on continue de tester avec la prochaine action
						this._actionsManager.unlinkEveryActions();
						isActionDoable = false;
						break;
					}
				}

				if (isActionDoable) {
					this._actionsManager.setOrderedOtherAction(newOtherActions);
					return true;
				}
			} while (isTestingPossibilities);
		}

		return false;
	}

	/**
	 * Cherche les cells pour réaliser la première action
	 * 
	 * @return true si des cellules ont été trouvées
	 **/
	private boolean findCellsFromForFirstAction(Action choosenAction, boolean useDangerMap) {
		if (setIsEmpty(choosenAction.getCellsFrom())) {
			Set<MoveCell> cellsAccessibleToHit = this.getCellsAccessibleToHit(choosenAction);
			Set<MoveCell> cellsWithSafeEscape = <>;
			for (MoveCell moveCell in cellsAccessibleToHit) {
				if (!useDangerMap || this.doesCellHaveSafeEscape(choosenAction, moveCell)) {
					setPut(cellsWithSafeEscape, moveCell);
				}
			}

			// Si on a trouvé des cell avec une escape safe
			if (!setIsEmpty(cellsWithSafeEscape)) {
				choosenAction.setCellsFrom(cellsWithSafeEscape);
				
				return true;
			}
		}
		
		return false;
	}

	/**
	 * Cherche un path réalisable entre les deux actions
	 * 
	 * @return true si un path à été trouvé
	 **/
	private boolean findPathsBetweenChoosenActions(Action choosenAction, Action nextChoosenAction, boolean useDangerMap) {
		
		Set<Cell> cellsCanMoveToHitNextChoosenAction = this.getActionCellsCanMoveToHit(nextChoosenAction);
		Set<MoveCell> cellsAccessibleToHitLikeChoosenAction = <>;
		
		Set<MoveCell> choosenActionCellsFrom = <>;
		if (choosenAction.getItem().hasEffectType(EFFECT_INVERT)) {
			// Si choosenAction est une inversion, il faut prendre en compte qu'on est téléporté sur la targetCell, et donc c'est la cell à partir de laquelle on doit calculer le path avec le nextChoosenAction
			TargetCell targetCell = setGetOne(choosenAction.getTargetCells()) as TargetCell;
			
			for (MoveCell moveCell in choosenAction.getCellsFrom()) {
				setPut(choosenActionCellsFrom, new MoveCell(targetCell.cellTarget, moveCell.mpUsed, moveCell.mpRemain, choosenAction.getItem(), moveCell.cell, targetCell.cellTarget));
			}
			
		} else {
			choosenActionCellsFrom = choosenAction.getCellsFrom();
			
			// On ne teste pas si les deux actions ont les même celle si l'action d'avant était une inversion
			for (MoveCell moveCell in choosenActionCellsFrom) {
				if (setContains(cellsCanMoveToHitNextChoosenAction, moveCell.cell))
					setPut(cellsAccessibleToHitLikeChoosenAction, moveCell);
			}
		}
		
		// Si au moins une des cellCanMoveToHit de cette action est déjà présente dans les cellsFrom permettant de réaliser choosenAction
		if (!setIsEmpty(cellsAccessibleToHitLikeChoosenAction)) {
			choosenAction.setCellsFrom(cellsAccessibleToHitLikeChoosenAction);
			nextChoosenAction.setCellsFrom(cellsAccessibleToHitLikeChoosenAction);
			
			this._actionsManager.linkSameCellsFromActions(nextChoosenAction, choosenAction);
			// Pour toutes les actions liés on met également ces cells
			for (Action linkedAction in this._actionsManager.getSameCellsFromLinkedActions(choosenAction)) {
				linkedAction.setCellsFrom(cellsAccessibleToHitLikeChoosenAction);
			}
			
			Debug.log(choosenAction + " into " + nextChoosenAction);
			Debug.log("Same cells linked actions " + this._actionsManager.getSameCellsFromLinkedActions(choosenAction));
			Debug.log("Common cells for actions " + cellsAccessibleToHitLikeChoosenAction);

			/** La nextChoosenAction est réalisable après choosenAction, donc on continue de tester avec la prochaine action **/
			return true;
		}

		// Si a partir des cellFrom de choosenAction je ne peux pas atteindre une des cellules pour réaliser nextChoosentAction
		if (!this.hasCellsAccessibleToHitWithSafeEscape(choosenAction, choosenActionCellsFrom, nextChoosenAction, cellsCanMoveToHitNextChoosenAction, null, useDangerMap)) {
			// On test la même chose mais en utilisant les items de movement disponible
			for (Item moveItem in this._actionsManager.getUseableMovementItems()) {
				if (this._actionsManager.isUsedMovementItem(moveItem)) continue;
				// Si l'item de movement n'a pas déjà été utilisé
				if (this.hasCellsAccessibleToHitWithSafeEscape(choosenAction, choosenActionCellsFrom, nextChoosenAction, cellsCanMoveToHitNextChoosenAction, moveItem, useDangerMap)) {
					nextChoosenAction.setTeleportItem(moveItem);
					this._actionsManager.addUsedMovementItem(moveItem);
					
					return true;
				}
			}
			
			return false;
		}
		
		Debug.log("Found to do" + nextChoosenAction + " after " + choosenAction);
		return true;
	}

	/**
	 * If we invert two entities, we need to modify the subsequents action, so that we target the right cell
	 **/
	private void invertActionCells(Action invertAction, Array<Action> newOtherActions, integer invertActionIndex) {
		AbstractEntity inversionTarget = setGetOne(invertAction.getTargets()) as AbstractEntity;
		
		integer inversionTargetId = inversionTarget.getId();
		integer inversionTargetHitDist = 0;
		
		for (integer i = invertActionIndex+1; i < count(newOtherActions); i++) {
			Action action = newOtherActions[i];
			Item item = action.getItem();
			integer areaType = item.getAreaType();
			
			// Si l'action ne vise pas l'entité inversée, on ne fait rien
			if (setSize(action.getTargets()) > 1 || !setContains(action.getTargets(), inversionTarget)) continue;

			// On génère les nouvelles TargetCell en fonction de la cell de l'entité visée après l'inversion
			Set<TargetCell> newTargetCells = <>;
			Cell entityCell = inversionTarget.getSimulationEntity().getCell()!;
			if (areaType == AREA_LASER_LINE || areaType == AREA_FIRST_INLINE) {
				for (Cell cellFrom in item.getCellsCanMoveToHit(entityCell)) {
					setPut(newTargetCells, new TargetCell(Item.getCellToHitLaser(item, entityCell, cellFrom)!, cellFrom, entityCell));
				}
				
				clearMarks()
				CellMap.markCellsFrom(action.getTargetCells());
				pause();
				clearMarks()
				CellMap.markCellsFrom(newTargetCells);
				pause();

			} else {
				// On récupère la dist à laquelle l'entité doit être visée
				for (string targetsDist in split(action.getTargetsHash(), ",")) {
					Array<string> targetsDistTab = split(targetsDist, "|");
					string targetId = targetsDistTab[0];
					if (number(targetId) == inversionTargetId) {
						inversionTargetHitDist = number(targetsDistTab[1]) as integer;
						break;
					}
				}

				for (Cell cell in item.getEffectiveArea(entityCell, null)) {		
					if (Cell.getDistance(cell, entityCell) == inversionTargetHitDist)
						setPut(newTargetCells, new TargetCell(cell));
				}
			}
			
			action.setTargetCells(newTargetCells);
		}
	}

	private void simulateActionForPathing(Action action) {
		if (setContains(action.getTargets(), this._me) || action.getItem().hasEffectType(EFFECT_INVERT))  {
			this._me.getSimulationEntity().simulateAction(action);
		}
	}

	/**
	 * 
	 **/
	private boolean hasCellsAccessibleToHitWithSafeEscape(Action choosenAction, Set<MoveCell> choosenActionCellsFrom, Action nextChoosenAction, Set<Cell> cellsAccessibleToHitNextChoosenAction, Item? moveItem, boolean useDangerMap) {
		Set<MoveCell> cellsAccessibleToHitWithSafeEscape = <>;
		Set<MoveCell> cellsFromOfChoosenActionWithoutPath = <>;
		// Si l'action n'a pas de cell en commun avec les cellsFrom de choosenAction
		// Pour toutes les cells accessibles depuis cellFrom avec les mp qu'il nous reste
		for (MoveCell moveCell in choosenActionCellsFrom) {			
			boolean cellAccFound = false;
			
			AccessibleCells cellsAccessibleAfterChoosenAction;
			if (moveItem == null)
				cellsAccessibleAfterChoosenAction = CellMap.getAccessibleCells(moveCell.cell, moveCell.mpRemain);	
			else
				cellsAccessibleAfterChoosenAction = CellMap.getAccessibleCellsWithTeleport(moveCell.cell, moveCell.mpRemain, moveItem!);
			
			for (MoveCell cellAcc in cellsAccessibleAfterChoosenAction.getMoveCells()) {
				// Si la cell d'action est accessible via cellAcc de choosenAction
				if (setContains(cellsAccessibleToHitNextChoosenAction, cellAcc.cell)) {
					if (!useDangerMap || this.doesCellHaveSafeEscape(nextChoosenAction, cellAcc)) {
						setPut(cellsAccessibleToHitWithSafeEscape, cellAcc);
						cellAccFound = true;
					}
				}
			}

			if (!cellAccFound) {
				// Cette moveCell de choosenAction ne permet pas d'aller vers une cell pour réaliser nextChoosenAction
				setPut(cellsFromOfChoosenActionWithoutPath, moveCell);
			}
		}

		/** Des cells avec une bonne escape et un path avec la choosenAction d'avant on été trouvées**/
		if (!setIsEmpty(cellsAccessibleToHitWithSafeEscape)) {
			nextChoosenAction.setCellsFrom(cellsAccessibleToHitWithSafeEscape);
			choosenAction.removeCellsFrom(cellsFromOfChoosenActionWithoutPath);
			// Si on a vider toutes les cellsFrom d'une des actions antérieur c'est qu'il n'y a ps de path
			if (!this.removeCellsFromForLinkedAction(choosenAction))
				return false;
			// Pour toutes les actions liés on retire également ces cells
			for (Action linkedAction in this._actionsManager.getSameCellsFromLinkedActions(choosenAction)) {
				linkedAction.removeCellsFrom(cellsFromOfChoosenActionWithoutPath);
			}
			
			this._actionsManager.linkPrevActions(nextChoosenAction, choosenAction);
			
			Debug.log(choosenAction + " into " + nextChoosenAction);
			Debug.log("Same cells linked actions " + this._actionsManager.getSameCellsFromLinkedActions(choosenAction));
			Debug.log("Remove cells from prev action " + cellsFromOfChoosenActionWithoutPath);
			Debug.log("Cells from for prev action " + choosenAction.getCellsFrom());
			Debug.log("Cells from for next action " + cellsAccessibleToHitWithSafeEscape);
			
			/** La nextChoosenAction est réalisable après choosenAction, donc on continue de tester avec la prochaine action **/
			return true;
		}
		
		return false;
	}

	/**
	 * Retire les paths qui ne sont plus réalisable à cause des actions antérieure
	 * 
	 * @return false si on retire toutes les cellFrom d'une action antérieure
	 **/
	private boolean removeCellsFromForLinkedAction(Action action) {
		Action? linkedPrevAction = this._actionsManager.getLinkedPrevActions(action);
		if (linkedPrevAction == null) 
			return true;
		
		Map<Cell, MoveCell> cellsFromPerCellForAction = MoveCell.getCellsMap(action.getCellsFrom());
		
		Set<MoveCell> cellsToRemoveFromPrevAction = <>;
		for (MoveCell moveCell in linkedPrevAction!.getCellsFrom()) {
			Item? moveItem = linkedPrevAction!.getTeleportItem();
			AccessibleCells accessibleCells;
			if (moveItem == null)
				accessibleCells = CellMap.getAccessibleCells(moveCell.cell, moveCell.mpRemain);
			else if (moveItem!.hasEffectType(EFFECT_TELEPORT))
				accessibleCells = CellMap.getAccessibleCellsWithTeleport(moveCell.cell, moveCell.mpRemain, moveItem!);
			
			boolean canPathFromMoveCell = false;
			for (MoveCell cellAcc in accessibleCells.getMoveCells()) {
				// Si on peut atteindre un cellFrom de action
				if (mapContainsKey(cellsFromPerCellForAction, cellAcc.cell) && cellsFromPerCellForAction[cellAcc.cell]!.mpRemain == cellAcc.mpRemain) {
					// C'est que le path de moveCell est toujours bon
					canPathFromMoveCell = true;
					break;
				}
			}
			
			if (!canPathFromMoveCell)
				setPut(cellsToRemoveFromPrevAction, moveCell);
		}

		Debug.log("Remove cells from prev action " + cellsToRemoveFromPrevAction);

		linkedPrevAction!.removeCellsFrom(cellsToRemoveFromPrevAction);
		// On a retiré toutes les cellFrom de l'action antérieure, donc il n'y a pas de path
		if (setIsEmpty(linkedPrevAction!.getCellsFrom()))
			return false;
		
		// On continue de retirer les path impossible dans les actions précédentes
		Action? linkedPrevPrevAction = this._actionsManager.getLinkedPrevActions(linkedPrevAction!);
		if (linkedPrevPrevAction != null)
			return this.removeCellsFromForLinkedAction(linkedPrevPrevAction!);
		
		return true;
	}

	/**
	 * Récupère le cellsToHit pour l'action
	 **/
	private Set<Cell> getActionCellsCanMoveToHit(Action action) {
		Set<Cell> cellsCanMoveToHit = <>;
		Item item = action.getItem();

		// Récupère les cell qui permettent de viser targetCell
		for (TargetCell targetCell in action.getTargetCells()) {
			if (item.getAreaType() == AREA_LASER_LINE || item.getAreaType() == AREA_FIRST_INLINE) {
				Cell? cellCanMoveToHit = Item.getCellToHitLaser(item, targetCell.cellFrom!, targetCell.cellTarget);
				if (cellCanMoveToHit != null) {
					// Si on est sur la même ligne et du même coté que la cellFrom d'origine
					if (Cell.isOnSameDirection(targetCell.cellTarget, cellCanMoveToHit!, targetCell.cellFrom!)) {
						setPut(cellsCanMoveToHit, cellCanMoveToHit!);
					}
				}
				
			} else if (item.hasEffectType(EFFECT_INVERT)) {
				setPut(cellsCanMoveToHit, targetCell.cellFrom);
			} else {
				integer distWanted = action.getHitCasterDist();
				Set<Cell> allCellsCanMoveToHitTarget = item.getCellsCanMoveToHit(targetCell.cellTarget);
				if (distWanted != -1) {
					for (Cell areaCell in item.getEffectiveArea(targetCell.cellTarget, null)) {
						// Si la cell permet d'utiliser l'item sur targetCell et qu'on est à la distance voulue
						if (setContains(allCellsCanMoveToHitTarget, areaCell) && Cell.getDistance(areaCell, targetCell.cellTarget) == distWanted) {
							setPut(cellsCanMoveToHit, areaCell);
						}
					}
				} else {
					for (Cell areaCell in item.getEffectiveArea(targetCell.cellTarget, null)) {
						// Si on est en dehors de l'area
						if (!setContains(allCellsCanMoveToHitTarget, areaCell))
							setPutAll(cellsCanMoveToHit, allCellsCanMoveToHitTarget);
					}
				}
			}
		}
		
		return cellsCanMoveToHit;
	}

	/**
	 * Détermine à partir de la cellFrom il est possible de terminer sur un cell safe, de la dangerMap, par rapport au score de l'action
	 **/
	private boolean doesCellHaveSafeEscape(Action action, MoveCell moveCell) {
		AccessibleCells accCellsToEscape;
		Cell cellFrom = moveCell.cell;
		// Si c'est une inversion, on prend en compte le fait qu'on sera sur la cellule visée après l'utilisation
		if (action.getItem().hasEffectType(EFFECT_INVERT))
			cellFrom = (setGetOne(action.getTargetCells()) as TargetCell).cellTarget;
		
		if (this._movementEscapeItem != null) {
			accCellsToEscape = CellMap.getAccessibleCellsWithTeleport(cellFrom, moveCell.mpRemain, this._movementEscapeItem!);
		} else {
			accCellsToEscape = CellMap.getAccessibleCells(cellFrom, moveCell.mpRemain);	
		}
		
		for (MoveCell moveCellEscape in accCellsToEscape.getMoveCells()) {
			// Si une cell a un score assez faible Alors l'action est faisable
			if (this._dangerMap.getScore(moveCellEscape.cell) <= action.getScore()) {
				return true;
			}
		}
		return false;
	}
	
	/**
	 * Ordonne les actions dans l'ordre décroissant de leur score
	 **/
	private void orderActionsByScore() {
		this._actions = arraySort(this._actions, function(Action a, Action b) => real {
			return b.getScore() - a.getScore();
		}) as Array<Action>;
	}
	
	/**
	 * Filtre les actions qui sont trop loin pour être réalisée
	 **/
	private void filterToFarActions() {
		//Debug.log("Actions before filtering to far : " + count(this._actions));
		
		Item? mostDistMovementItem = null;
		for (Item item in this._me.getOffCooldownMovementItemsOrderedByCost()) {
			if (mostDistMovementItem == null)
				mostDistMovementItem = item;
			else if (mostDistMovementItem!.hasEffectType(EFFECT_TELEPORT) && item.getMaxRange() > mostDistMovementItem!.getMaxRange()) {
				mostDistMovementItem = item;
			}
		}
		
		Cell myCell = this._me.getCell()!;
		integer myMP = this._me.getStats().getMP();
		integer maxDistFromItem = mostDistMovementItem != null ? mostDistMovementItem!.getMaxRange() : 0;
		integer maxDistMoved = myMP + maxDistFromItem;
		this._actions = arrayFilter(this._actions, function(Action action) => boolean {
			// Une self action est toujours réalisable
			if (setIsEmpty(action.getTargetCells())) return true;
			
			integer minDistForAction = 999999;
			for (TargetCell targetCell in action.getTargetCells()) {
				integer cellDist = Cell.getDistance(targetCell.cellTarget, myCell);
				if (cellDist < minDistForAction)
					minDistForAction = cellDist;
			}
			
			return minDistForAction <= maxDistMoved + action.getItem().getMaxRange();
		}) as Array<Action>;

		//Debug.log("Actions after filtering to far : " + count(this._actions));
	}
	
	/**
	 * Calcule les scores pour toutes les actions
	 **/
	private void calculateActionsScore() {
		for (Action action in this._actions) {
			Item item = action.getItem();
			TargetCell? targetCell = setGetOne(action.getTargetCells()) as TargetCell;
			boolean isCasterHit = action.getHitCasterDist() != -1;
			
			real score = 0.0;
			for (Effect eff in item.getEffects()) {
				if (targetCell != null) {
					integer effType = eff.getType();
					if (effType == EFFECT_ATTRACT || effType == EFFECT_PUSH || effType == EFFECT_INVERT || effType == EFFECT_TELEPORT) {
						// c'est différent
					} else {
						score += eff.getScoreOnCell(targetCell!.cellTarget, targetCell!.cellFrom, this._me, this._me.getStats(), isCasterHit);

						// On ajoute le score sur le caster
						if (isCasterHit) {
							score += eff.getSelfScore(this._me, this._me.getStats(), action.getHitCasterDist());
						}
					}
					
				} else {
					// C'est une self action : on ne calcule que le score sur le caster
					score += eff.getSelfScore(this._me, this._me.getStats(), action.getHitCasterDist());
				}
			}
			
			action.setScore(item.scaleScoreOnCost(score));
		}
	}
	
	/**
	 * Génère toutes les actions possibles
	 **/
	private void generateActions() {
		for (Item item in this._me.getOffCooldownItems()) {
			// On passe l'item si c'est un item pour ce téléporter ou pour summoner
			if (setContains(item.getEffectsTypeList(), EFFECT_TELEPORT) || setContains(item.getEffectsTypeList(), EFFECT_SUMMON)) continue;
			
			var cost = item.getCost();
			// si ce n'est pas l'arme qu'on a actuellement ça coûte 1 de plus
			if (item instanceof Weapon && (this._me as Leek).getEquippedWeaponId() != item.getId()) {
				cost++;
			}
			
			// si je n'ai plus assez de TP, on passe l'item
			if (cost > this._me.getStats().getTP()) continue;
			
			this.generateItemActions(item);
		}
		
		if (isEmpty(this._everyActions))
			this._everyActions = this._actions;
		
		// TODO : for item that has an effect which affect the caster, try to hit in the void
	}
		
	private void filterUseableActions() {
		Array<Action> actions = [];
		Set<Item> offCooldownItems = this._me.getOffCooldownItems();
		for (Action action in this._everyActions) {
			Item item = action.getItem();
			if (!setContains(offCooldownItems, item)) continue;
			if (setContains(item.getEffectsTypeList(), EFFECT_TELEPORT) || setContains(item.getEffectsTypeList(), EFFECT_SUMMON)) continue;
			
			var cost = item.getCost();
			// Si ce n'est pas l'arme qu'on a actuellement ça coûte 1 de plus
			if (item instanceof Weapon && (this._me as Leek).getEquippedWeaponId() != item.getId()) {
				cost++;
			}
			// Si je n'ai plus assez de TP, on passe l'item
			if (cost > this._me.getStats().getTP()) continue;
			
			push(actions, action);
		}
		
		this._actions = actions;
	}

	/**
	 * Génère les actions possibles avec un item
	 * 
	 * @params Item item
	 **/
	private void generateItemActions(Item item) {
		Set<TargetCell> cellsToCalcScore = <>;
		Set<Cell> alreadyTargetedCells = <>
		integer areaType = item.getAreaType();
		
		for (Team team in this._teams) {
			for (AbstractEntity entity in team.getAlive()) {
				// Si l'entité n'est pas vivante
				// ou que je me vise sans pouvoir me toucher
				// ou que je vise un allié mais que l'item n'est pas fait pour ça
				// ou que je vise un ennemi mais que l'item n'est pas fait pour ça
				// Alors on passe l'item
				if (!entity.isEntityAlive() || entity == this._me || (entity.isAnAlly() && !item.canTargetAlly()) || (!entity.isAnAlly() && !item.canTargetEnemy())) continue;

				if (areaType == AREA_LASER_LINE || areaType == AREA_FIRST_INLINE) {
					Cell entityCell = entity.getCell()!;
					for (Cell cellFrom in item.getCellsCanMoveToHit(entityCell)) {
						setPut(cellsToCalcScore, new TargetCell(Item.getCellToHitLaser(item, entityCell, cellFrom)!, cellFrom, entityCell));
					}
					
				} else if (item.hasEffectType(EFFECT_INVERT)) {
					Cell entityCell = entity.getCell()!;
					for (Cell cellFrom in item.getCellsCanMoveToHit(entityCell)) {
						setPut(cellsToCalcScore, new TargetCell(Item.getCellToHitLaser(item, entityCell, cellFrom)!, cellFrom, entityCell));
					}
					
				} else {
					for (Cell cell in item.getEffectiveArea(entity.getCell()!, null)) {		
						if (!setContains(alreadyTargetedCells, cell)) {
							setPut(cellsToCalcScore, new TargetCell(cell));
							setPut(alreadyTargetedCells, cell);
						}
					}
				}
			}
		}
		
		Map<TargetCell, string> targetsPerCell = this.getTargetsPerCell(item, cellsToCalcScore);
		Map<string, Set<TargetCell>> cellsPerTarget = this.getCellsPerTargets(item, targetsPerCell);
		this.createActions(item, cellsPerTarget);
	}

	/**
	 * Retourne une map avec pour chaque TargetCell un score unique selon les entités présente dans l'area touchée
	 **/
	private Map<TargetCell, string> getTargetsPerCell(Item item, Set<TargetCell> cellsToCalcScore) {
		boolean isAreaLaserLine = item.getAreaType() == AREA_LASER_LINE;
		// Calcule une valeur unique en fonction des targets et de leur position par rapport à la cellule visée
		Map<TargetCell, string> targetsPerCell = [:];
		for (TargetCell targetCell in cellsToCalcScore) {
			Set<AbstractEntity> targets = item.getSimulationTargets(targetCell.cellTarget, targetCell.cellFrom, this._me);
			targetsPerCell[targetCell] = AbstractEntity.getTargetsHash(targets, targetCell.cellTarget, isAreaLaserLine);
		}
		
		return targetsPerCell;
	}

	/**
	 * Groupe les TargetCell en fonction de leur score unique des entités touchées
	 **/
	private Map<string, Set<TargetCell>> getCellsPerTargets(Item item, Map<TargetCell, string> targetsPerCell) {
		// Tri les cellules qui ont exactement les mêmes targets dans les même conditions
		Map<string, Set<TargetCell>> cellsPerTargets = [:];
		for (TargetCell targetCell : string targetsHash in targetsPerCell) {
			if (!mapContainsKey(cellsPerTargets, targetsHash))
				cellsPerTargets[targetsHash] = <targetCell>;
			else
				setPut(cellsPerTargets[targetsHash]!, targetCell);
		}
		return cellsPerTargets;
	}

	/**
	 * Créé les objets Action
	 **/
	private void createActions(Item item, Map<string, Set<TargetCell>> cellsPerTargets) {
		boolean canHitSelf = item.getAreaType() != AREA_LASER_LINE  && item.getAreaType() != AREA_FIRST_INLINE && item.getAreaSize() >= item.getMinRange() && item.canTarget(this._me, this._me) ;
		boolean isObligatedToHitSelf = item.getAreaType() != AREA_LASER_LINE  && item.getAreaType() != AREA_FIRST_INLINE && item.getAreaSize() >= item.getMaxRange() && item.canTarget(this._me, this._me);

		for (string targetsHash : Set<TargetCell> cells in cellsPerTargets) {
			Set<AbstractEntity> targets = <>;
			for (string targetsDist in split(targetsHash, ",")) {
				string targetId = split(targetsDist, "|")[0];
				setPut(targets, AbstractEntity.get(number(targetId) as integer));
			}
			
			if (!isObligatedToHitSelf) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					for (TargetCell targetCell in cells) {
						Action newAction = new Action();
						newAction.setItem(item);
						newAction.setTargetCells(<targetCell>);
						newAction.setTargetsHash(targetsHash);
						newAction.setTargets(targets);
						push(this._actions, newAction);
					}
				} else {
					Action newAction = new Action();
					newAction.setItem(item);
					newAction.setTargetCells(cells);
					newAction.setTargetsHash(targetsHash);
					newAction.setTargets(targets);
					push(this._actions, newAction);
				}
			}
			
			if (canHitSelf) {
				// On peut se faire toucher sur toutes les distances de l'area, sauf si la range max est < à la distance max d'area
				for (integer dist = item.getMinRange(); dist <= min(item.getAreaSize(), item.getMaxRange()); dist++) {
					if (dist == 0) {
						// Vérifie qu'il n'y a pas déjà une entité présente sur la cell visée
						// Si ce n'est pas nous alors on ne crée pas d'action
						AbstractEntity? entity = (setGetOne(cells) as TargetCell).cellTarget.getCellEntity();
						if (entity != null && entity != this._me) continue;
					}
					
					Action newSelfAction = new Action();
					newSelfAction.setItem(item);
					newSelfAction.setTargetCells(cells);
					newSelfAction.setTargetsHash(targetsHash + this._me.getId() + "|"  + dist + ",");
					newSelfAction.setTargets(targets);
					newSelfAction.addTarget(this._me);
					newSelfAction.setHitCasterDist(dist);
					push(this._actions, newSelfAction);
				}
			}
		}
		
		// Ajoute les actions quand on hit que soit même
		if (canHitSelf) {
			Cell myCell = this._me.getCell()!;
			for (integer dist = item.getMinRange(); dist <= item.getAreaSize(); dist++) {
				Action newSelfAction = new Action();
				newSelfAction.setItem(item);
				newSelfAction.setTargetsHash(this._me.getId() + "|" + dist + ",");					
				newSelfAction.setTargets(<this._me>);
				newSelfAction.setHitCasterDist(dist);
				push(this._actions, newSelfAction);
			}
		}
	}

	/**
	 * Initialise la map de danger
	 **/
	private Map<Cell, Set<Item>> initDangerItemMap() {
		mapClear(this._cellsPerDangerItemPerEntity);
		
		integer enemiesLeeksCount = 0;
		for (Team team in this._teams) {
			if (team != this._me.getTeam())
				enemiesLeeksCount += setSize(team.getAliveLeeks());
		}
		
		for (Team team in this._teams) {
			if (team == this._me.getTeam()) continue;
			
			Debug.log("Testing danger on " + AI.MAX_DANGER_ITEMS_TESTED_COUNT / enemiesLeeksCount + " items");
			for (AbstractEntity entity in team.getAlive()) {
				AccessibleCells entityAccessibleCells = entity.getInitialAccessibleCells();
				this._cellsPerDangerItemPerEntity[entity] = [:];
				
				integer dangerItemsTestedCount = 0;
				// get the items which will be off cooldown when this entity will play
				Array<Item> orderedDangerItems = this.orderAndFilterDangerItems(entity, entity.getOffCooldownsItemsInTurns(1));
				boolean isAlreadyTestedMeleeItem = false;
				//Debug.log("OrderedDangerItems : " + orderedDangerItems);

				for (Item item in orderedDangerItems) {
					if (item.getMaxRange() == 1) {
						if (isAlreadyTestedMeleeItem) continue;
						isAlreadyTestedMeleeItem = true;
					}
					
					//Debug.startOpCount();
					Set<Cell> cellsCanUseItem = item.getCellsCanHitFromCellsIgnore(entityAccessibleCells.getCells(), <entity>);
					this._cellsPerDangerItemPerEntity[entity]![item] = cellsCanUseItem;

					dangerItemsTestedCount++;
					if (dangerItemsTestedCount > AI.MAX_DANGER_ITEMS_TESTED_COUNT / enemiesLeeksCount)
						break;
					//Debug.log(entity.getName() + " with " + item.getName())										
					//Debug.stopOpCount("getCellsCanUseFromCellsIgnore : ");		
					//CellMap.markCells(cellsCanUseItem, COLOR_RED);
					//pause();
					//clearMarks();
				}
			}
		}
	}
	
	/**
	 * Calcul le score de danger pour chaque cell de la map
	 **/
	private void calculateDangerMap() {
		this._dangerMap.resetScore();
		
		Map<AbstractEntity, ScoreMap> damageMapPerEntity;
		for (AbstractEntity entity : Map<Item, Set<Cell>> cellsPerItem in this._cellsPerDangerItemPerEntity) {
			if (!entity.isEntityAlive()) continue;
			
			ScoreMap damageMap = new ScoreMap(<>, 0.0);

			// On prend les stats de l'entité lors de son prochain tour (pas à l'instant actuel)
			EntityStats entityStatsHisTurn = entity.getStatsInTurns(1);

			// Calcul les dangerScore pour tous les items dangereux de l'entité et les cellules qu'il peut toucher avec
			for (Item item : Set<Cell> cells in cellsPerItem) {		
				if (item.getId() == 143) continue;
				// TODO : gérer plasma

				Map<integer, real> itemDangerScore = [:];
				// On calcule le score pour toutes les distance d'area possible pour l'item
				for (integer i = 0; i <= item.getAreaSize(); i++) {
					itemDangerScore[i] = item.scaleScoreOnCost(item.getScore(this._me, entity, this._me.getStats(), entityStatsHisTurn, i));
				}

				// TODO: calculer les combos de danger, pour calculer plus précisément les dégats potentiels sur une cell
				//if (item.getBaseCooldown() == 0) {
					//for (integer hitDist : real dangerScore in itemDangerScore) {
						//itemDangerScore[hitDist] = dangerScore;
					//}
				//}
		
				damageMap.setHighestScores(cells, -(itemDangerScore[0]!));

				// Ajoute les area of effect
				if (item.getAreaType() != AREA_LASER_LINE && item.getAreaType() != AREA_FIRST_INLINE) {
					for (Cell cell in CellMap.getEdgeCells(cells)) {
						for (Cell effCell in item.getEffectiveArea(cell, null)) {
							integer dist = Cell.getDistance(effCell, cell);
							if (!setContains(cells, effCell)) {
								damageMap.setHighestScore(effCell, -itemDangerScore[dist]!);
							}
						}
					}
				}
			}
			
			damageMapPerEntity[entity] = damageMap;
		}
		
		// Pour toutes les cellules on calcule des scores en fonction des distances avec les alliés, les ennemis ...
		
		integer alliesTotalLife = 0;
		integer alliesAliveLeeksCount = setSize(this._me.getTeam()!.getAliveLeeks());
		for (AbstractEntity ally in this._me.getTeam()!.getAlive()) {
			alliesTotalLife += ally.getStats().getLife();
		}
		
		this.calculateEnemyTeamDangerMap(damageMapPerEntity, alliesTotalLife, alliesAliveLeeksCount);
		this.calculateAllyTeamDangerMap(alliesTotalLife, alliesAliveLeeksCount);
	}

	private void calculateEnemyTeamDangerMap(Map<AbstractEntity, ScoreMap> damageMapPerEntity, integer alliesTotalLife, integer alliesAliveLeeksCount) {
		Cell myCell = this._me.getCell()!;
		
		real SCORE_PER_DIST = this._highHighMeanScore / 30;
		
		for (Team team in this._teams) {
			integer teamTotalLife = 0;
			integer teamAlivesLeeksCount = setSize(team.getAliveLeeks());
			for (AbstractEntity entity in team.getAlive()) {
				teamTotalLife += round(entity.getStats().getLife() * entity.getScores().getAdjuster().entityType);
			}
			
			real lifeAdvantageScore = max(0.2, 1 + (alliesTotalLife - teamTotalLife) / (2 * EntityStatsDiviser.maxLife));
			real countAdvantageScore = 1.0 + (alliesAliveLeeksCount - teamAlivesLeeksCount) / GAME.leeksPerTeamCount;
			real advantageScore = lifeAdvantageScore * countAdvantageScore;
			Debug.log("advantageScore enemy : " + advantageScore);
			for (AbstractEntity entity in team.getAlive()) {
				if (entity == this._me) continue;
				
				AccessibleCells entityPathLength = entity.getPathLengthCells();
				boolean entityIsBulb = entity instanceof Bulb;
				real entityTypeMult = entity.getScores().getAdjuster().entityType;
				Cell entityCell = entity.getCell()!;
				integer entityMP = entity.getStats().getMP();
				
				integer distWantedFromEntity = round(entityMP * 2 / advantageScore);
				real scorePerDistFromEntity = SCORE_PER_DIST * advantageScore * entityTypeMult / GAME.leeksPerTeamCount;
				real distWantedScore = (1 - distWantedFromEntity / 24) * scorePerDistFromEntity;

				ScoreMap? entityDamageMap = mapGet(damageMapPerEntity, entity, null) as ScoreMap;
				
				integer alliesBeforeEntityCount = GAME.timeline.getEntitiesPlayingBetweenEntitiesCount(this._me, entity, true);
				integer alliesBeforeEntityCountDiviser = 1 + alliesBeforeEntityCount;
				for (Cell cell in CellMap.getCells()) {
					if (cell._isObstacle) continue;
					
					// Ajoute damage map pour l'entité
					if (entityDamageMap != null) {
						real score = entityDamageMap!.getScore(cell);
						score /= advantageScore;
						score /= alliesBeforeEntityCountDiviser;
						this._dangerMap.addScore(cell, score);
					}
					
					// TODO: Quickfix si on n'est pas présent dans le pathLength de l'entité (car le chemin est bloqué par exemple)
					real distToEntity = 0.0;
					real meanWeight = 1.5;
					if (entityPathLength.hasCell(cell)) {
						distToEntity += entityPathLength.getMpUsed(cell)!;
						meanWeight += 1.0;
					}
					distToEntity += Cell.getDistance(entityCell, cell) * 1.5;
					distToEntity /= meanWeight;
					
					real distScore =  max(0.0, abs(distWantedFromEntity - distToEntity) - 2) * scorePerDistFromEntity;
					this._dangerMap.addScore(cell, distScore);
				}
			}
		}
	}

	private void calculateAllyTeamDangerMap(integer alliesTotalLife, integer alliesAliveLeeksCount) {
		Cell myCell = this._me.getCell()!;
		
		real SCORE_PER_DIST = this._highHighMeanScore / 3;

		// Pour voir si les enemis ont beaucoup d'items dangereux en AOE
		real areaSizeWeightedMean = 0.0;
		integer areaSizeWeightValue = 0;
		integer enemyTeamsTotalLife = 0;
		integer enemyTeamAlivesLeeksCount = 0;
		for (Team team in this._teams) {
			if (team == this._me.getTeam()) continue;
			
			enemyTeamAlivesLeeksCount += setSize(team.getAliveLeeks());
			
			for (AbstractEntity entity in team.getAlive()) {
				enemyTeamsTotalLife += round(entity.getStats().getLife() * entity.getScores().getAdjuster().entityType);
				
				Array<Item> dangerItems = orderAndFilterDangerItems(entity, entity.getOffCooldownsItemsInTurns(1));
				areaSizeWeightValue += count(dangerItems);
				for (integer i : Item item in dangerItems) {
					if (item.getAreaType() != AREA_LASER_LINE && item.getAreaType() != AREA_FIRST_INLINE) {
						areaSizeWeightedMean += item.getAreaSize();
					}
				}
			}
		}
		areaSizeWeightedMean /= areaSizeWeightValue;
		debug("areaSizeWeightedMean : " + areaSizeWeightedMean);
		integer distAwayWantedFromEntity = ceil(areaSizeWeightedMean);

		
		real lifeAdvantageScore = max(0.2, 1.0 + (alliesTotalLife - enemyTeamsTotalLife) / (2 * EntityStatsDiviser.maxLife));
		real countAdvantageScore = 1.0 + (alliesAliveLeeksCount - enemyTeamAlivesLeeksCount) / GAME.leeksPerTeamCount;
		real advantageScore = lifeAdvantageScore * countAdvantageScore;
		Debug.log("advantageScore ally : " + advantageScore);
		for (AbstractEntity entity in this._me.getTeam()!.getAlive()) {
			if (entity == this._me) continue;

			AccessibleCells entityPathLength = entity.getPathLengthCells();
			boolean entityIsBulb = entity instanceof Bulb;
			real entityTypeMult = entity.getScores().getAdjuster().entityType;
			Cell entityCell = entity.getCell()!;
			integer entityMP = entity.getStats().getMP();

			integer distWantedFromEntity = round(entityMP * 0.5 * advantageScore);
			real scorePerDistFromEntity = SCORE_PER_DIST * entityTypeMult / advantageScore / GAME.leeksPerTeamCount;
			real distWantedScore = (4 - distWantedFromEntity / 12) * scorePerDistFromEntity;

			integer alliesBeforeEntityCount = GAME.timeline.getEntitiesPlayingBetweenEntitiesCount(this._me, entity, true);
			integer alliesBeforeEntityCountDiviser = 1 + alliesBeforeEntityCount;
			for (Cell cell in CellMap.getCells()) {
				if (cell._isObstacle) continue;

				real distToEntity = 0.0;
				real meanWeight = 2.5;
				if (entityPathLength.hasCell(cell)) {
					distToEntity += entityPathLength.getMpUsed(cell)!;
					meanWeight += 1.0;
				}
				distToEntity += Cell.getDistance(entityCell, cell) * 2.5;
				distToEntity /= meanWeight;	

				// Si on retire du score de danger
				if (distToEntity <= distWantedFromEntity) {
					// On retire un score constant pour toutes les cells à moins de la distance demandée
					this._dangerMap.removeScore(cell, distWantedScore);
				} else {
					// On retire de moins en moins de score plus les cells s'éloignes
					real distScore = distWantedScore - abs(distWantedFromEntity - distToEntity) * scorePerDistFromEntity;
					this._dangerMap.removeScore(cell, max(-SCORE_PER_DIST * 10.0, distScore));
				}
				
				if (distToEntity <= distAwayWantedFromEntity) {
					real distScore = (1 + distToEntity - distAwayWantedFromEntity) * scorePerDistFromEntity * 2;
					//distScore *= 
					this._dangerMap.addScore(cell, distScore);
				}
			}
		}
	}

	private Array<Item> orderAndFilterDangerItems(AbstractEntity entity, Set<Item> items) {
		EntityStats entityStats = entity.getStatsInTurns(1);

		Map<Item, real> dangerScorePerItem = [:];
		for (Item item in items) {
			real score = 0.0;

			for (Effect eff in item.getEffects()) {
				if (setContains(Effect.dangerEffects, eff.getType())) {
					if (eff.getType() == EFFECT_INVERT || eff.getType() == EFFECT_ATTRACT || eff.getType() == EFFECT_PUSH) {

					} else {
						if (item.getId() == 143) continue;
						// TODO : gérer plasma
						
						score += eff.getScore(null, null, this._me, entity, this._me.getStats(), entityStats, 0);
					}
				}
			}
			
			dangerScorePerItem[item] = item.scaleScoreOnCost(score);
		}
		
		Array<Item> orderedItems = setToArray(items) as Array<Item>;
		orderedItems = arrayFilter(orderedItems, function(Item i1) => boolean {
			return dangerScorePerItem[i1] != 0;
		}) as Array<Item>;
		orderedItems = arraySort(orderedItems, function(Item i1, Item i2) => real {
			return dangerScorePerItem[i1]! - dangerScorePerItem[i2]!;
		}) as Array<Item>;

		return orderedItems;
	}
}


global Game GAME = Game.getInstance();

class Game {
	public final AbstractEntity me;
	public final Timeline timeline;
	private Set<Team> _teams;
	private Set<AbstractEntity> _allEntities; public Set<AbstractEntity> getAllEntities() { return _allEntities; }
	private AI _ai;
	public final boolean isBR;
	public final integer leeksPerTeamCount;
	public final integer allEntitiesCount;
	
	private static Game? instance;
	
	public static Game getInstance() {
		if (Game.instance == null) {
			Game.instance = new Game();
		}
		return Game.instance!;
	};
	
	private constructor() {
		this._allEntities = <>;
		
		Debug.enabledLog = true;
		Debug.enabledOp = false;
		Debug.enabledInfo = false;

		Debug.startOpCount();
		CellMap.initCellMap();
		Debug.stopOpCount("init CellMap : ");

		Debug.startOpCount();
		Effect.initOnTeamEffects();
		Effect.initEffectClassPerId();
		Effect.initFinalEffectScoreFnctPerId();
		Effect.initGetAppliedValueFnctPerId();
		EntityEffect.initStatsFctPerType();
		Debug.stopOpCount("init statics : ");

		this.isBR = getFightType() == FIGHT_TYPE_BATTLE_ROYALE;

		Debug.startOpCount();
		this._teams = <>;
		if (this.isBR) {
			initBRTeams();
		} else {
			initTeams()
		}
		Debug.stopOpCount("init Leeks and Teams : ");

		AbstractEntity? me = AbstractEntity.get(getEntity());
		if (me != null) {
			this.me = me!;
			
			Debug.log(me);
			
			this._ai = new AI(this.me, this._teams);
		} else {
			Debug.error("me is null");
		}
		
		this.timeline = new Timeline(this._allEntities, this.me);
		
		this.leeksPerTeamCount = setSize(this.me.getTeam()!.getLeeks());
	}
	private void initBRTeams() {
		for (integer entityId in getEnemies()) {
			Leek.initLeeks([entityId]);
			Bulb.initBulbs([entityId]);
			Chest.initChests([entityId]);

			AbstractEntity? entity = AbstractEntity.get(entityId);
			if (entity != null) {
				setPut(this._teams, new Team(<entity!>));
			}
			
			setPut(this._allEntities, AbstractEntity.get(entityId));
		}

		Leek.initLeeks([getEntity()]);
		Leek? me = Leek.get(getEntity());
		if (me != null) {
			setPut(this._teams, new Team(<me!>));
				   
			setPut(this._allEntities, me);
		}
	}
	private void initTeams() {
		Leek.initLeeks(getAllies());
		Bulb.initBulbs(getAllies());
		Turret.initTurrets(getAllies());
		Set<AbstractEntity> allies = <>;
		for (integer entityId in getAllies()) {
			setPut(allies, AbstractEntity.get(entityId));
			
			setPut(this._allEntities, AbstractEntity.get(entityId));
		}
		setPut(this._teams, new Team(allies));

		Leek.initLeeks(getEnemies());
		Bulb.initBulbs(getEnemies());
		Chest.initChests(getEnemies());
		Turret.initTurrets(getEnemies());
		Set<AbstractEntity> ennemies = <>;
		for (integer entityId in getEnemies()) {
			AbstractEntity? entity = AbstractEntity.get(entityId);
			if (entity != null) {
				if (!(entity instanceof Chest)) {
					setPut(ennemies, entity);
				} else {
					// Chests are in their own Team
					setPut(this._teams, new Team(<entity!>));
				}
			}
			
			setPut(this._allEntities, AbstractEntity.get(entityId));
		}
		setPut(this._teams, new Team(ennemies));
	}
	
	public void updateAllStats() {
		Bulb.updateBulbsStats();
		Leek.updateLeeksStats();
		Chest.updateChestsStats();
		Turret.updateTurretsStats();
	}
	
	public void startTurn() {		
		// Les bulbes peuvent apparaitre à n'importe quel tour, pas seulement au début
		Bulb.initBulbs(getEnemies());
		Bulb.initBulbs(getAllies());
		this.updateAllStats();
		this.me.clearAccessibleCellsWithItem();

		for (Team team in this._teams) { team.update(); }
		for (Team team in this._teams) { team.updateMapInfos();	}
		for (Team team in this._teams) { team.updateScores(); }
		AbstractEntity.updateEntitiesScores();
		AbstractEntity.updateSimulationStats();
		
		
		Debug.startOpCount();
		// Need to be done after removing the current entity from the CellMap
		AbstractEntity.updateEntitiesPathLength();
		Debug.stopOpCount("updateEntitiesPathLength : ");
		
		this._allEntities = <>;
		for (Team team in this._teams) {
			for (AbstractEntity entity in team.getEntities()) {
				setPut(this._allEntities, entity);
			}
		}
		this.timeline.update(this._allEntities);

		for (AbstractEntity entity in this._allEntities) {
			Debug.log(entity.getScores().getAdjuster());	
		}
		
		this._ai.determineActions();
		
		this.updateAllStats();
		
		this._ai.executeActions();
		this._ai.goToEndOfTurnCell();
		this._ai.selectBestWeapon();
	}
	
	
	public void triggerEntityDisplacedEvent() {
		this._ai.resetEveryActions();
	}
	public void triggerEntityDiedEvent() {
		this._ai.resetEveryActions();
	}
}


if (getFarmerName(getNearestEnemy()) == "Amal" && getFightType() == FIGHT_TYPE_SOLO)
	return;

GAME.startTurn();

Debug.log(getUsedRAM() + " / " + getMaxRAM());
Debug.log("Operations this turn : " + getOperations());