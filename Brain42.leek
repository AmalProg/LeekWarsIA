class Chip extends Item {
	/** chips pool **/
	private static Map<integer, Chip> chips = [:];
	public static Chip get(integer id) {
		if (Chip.chips[id] != null)
			return Chip.chips[id]!;
		
		Chip chip = new Chip(id);
		Chip.chips[id] = chip;
		Item.items[id] = chip;
		return Chip.chips[id]!;
	}
	/** fin chips pool **/
	
	constructor(integer id) {
		super(id);
		initStats();
	}

	private void initStats() {
		this.name = getChipName(this.id);
		this.areaType = getChipArea(this.id)!;
		this.cost = getChipCost(this.id)!;
		this.baseCooldown = getChipCooldown(this.id);
		this.minRange = getChipMinRange(this.id)!;
		this.maxRange = getChipMaxRange(this.id)!;
		this.launchType = getChipLaunchType(this.id)!;
		this.needLos = chipNeedLos(this.id);
		for (Array<any> effectArray in getChipEffects(this.id)!) {
			Effect? eff = Effect.createEffect(effectArray, this);
			if (eff != null) {
				push(this._effects, eff!);
				setPut(this._effectsTypeList, eff!.getType());
			}
		}
		
		this.initTeamTargetsBool();
	}
	
	protected Set<Cell> getItemEffectiveArea(Cell cell, Cell? from) {
		Set<Cell> cells = <>;
		integer? fromId = null;
		if (from != null) fromId = from!.id;
		for (integer cId in getChipEffectiveArea(this.id, cell.id, fromId)!) {
			setPut(cells, CellMap.getCell(cId));
		}
		return cells;
	}
	
	public boolean canUseItemOnCell(Cell cell) {
		return canUseChipOnCell(this.id, cell.id);
	}
	
	public integer use(Cell cell) {
		return useChipOnCell(this.id, cell.id);
	}
}
/** IA v5/Entities/EntityEffect **/



class EntityEffect {
	private Function<EntityStats, integer => void>? _statsFct; public Function<EntityStats, integer => void>? getStatsFct() { return _statsFct; }
	private integer _type; public integer getType() { return _type; }
	private integer _value; public integer getValue() { return _value; }
	private AbstractEntity _caster; public AbstractEntity getCaster() { return _caster; }
	private integer _turns;  public integer getTurns() { return _turns; }
	private boolean _critical; public boolean isCritical() { return _critical; }
	private integer _itemId; public integer getItemId() { return _itemId; }
	private AbstractEntity|null _target; public AbstractEntity|null getTarget() { return _target; }
	private integer _modifiers; public integer getModifiers() { return _modifiers; }
	private boolean _isIrreductible; public boolean isIrreductible() { return _isIrreductible; }
	
	constructor(Array<boolean|integer> effectArray) {
		this._type = effectArray[0] as integer;
		this._statsFct = EntityEffect._statsFctPerType[this._type];
		this._value = effectArray[1] as integer;
		this._caster = AbstractEntity.get(round(effectArray[2] as integer))!;
		this._turns = effectArray[3] as integer;
		this._critical = effectArray[4] == 1;
		this._itemId = effectArray[5] as integer;
		this._target = AbstractEntity.get(effectArray[6] as integer);
		this._modifiers = effectArray[7] as integer;

		this._isIrreductible = (this._modifiers & EFFECT_MODIFIER_IRREDUCTIBLE) != 0;
	}
	constructor(Function<EntityStats, integer => void>? statsFct, integer type, integer value, AbstractEntity caster, integer turns, boolean critical, integer itemId, AbstractEntity? target, integer modifiers) {
		this._statsFct = statsFct;
		this._type = type;
		this._value = value;
		this._caster = caster;
		this._turns = turns;
		this._critical = critical;
		this._itemId = itemId;
		this._target = target;	
		this._modifiers = modifiers;	
		
		this._isIrreductible = (this._modifiers & EFFECT_MODIFIER_IRREDUCTIBLE) != 0;
	}
	
	public void apply(EntityStats stats) {
		if (this._statsFct != null)
			(this._statsFct!)(stats, this._value);
	}
	public void remove(EntityStats stats) {
		if (this._statsFct != null)
			(this._statsFct!)(stats, -this._value);
	}
	
	private static Map<integer, Function<EntityStats, integer => void>> _statsFctPerType;
	public static Function<EntityStats, integer => void>? getstatsFctPerType(integer type) {
		return _statsFctPerType[type];
	}
	public static initStatsFctPerType() {
		EntityEffect._statsFctPerType = [:];
		EntityEffect._statsFctPerType[EFFECT_HEAL] = EntityStats.addLifeStatic;
		 
		EntityEffect._statsFctPerType[EFFECT_BUFF_AGILITY] = EntityStats.addAgilityStatic;
		EntityEffect._statsFctPerType[EFFECT_BUFF_RESISTANCE] = EntityStats.addResistanceStatic;
		EntityEffect._statsFctPerType[EFFECT_BUFF_STRENGTH] = EntityStats.addStrengthStatic;
		EntityEffect._statsFctPerType[EFFECT_BUFF_WISDOM] = EntityStats.addWisdomStatic;
		EntityEffect._statsFctPerType[EFFECT_BUFF_MP] = EntityStats.addMPStatic;
		EntityEffect._statsFctPerType[EFFECT_BUFF_TP] = EntityStats.addTPStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_AGILITY] = EntityStats.addAgilityStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_MAGIC] = EntityStats.addMagicStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_POWER] = EntityStats.addPowerStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_RESISTANCE] = EntityStats.addResistanceStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_SCIENCE] = EntityStats.addScienceStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_STRENGTH] = EntityStats.addStrengthStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_WISDOM] = EntityStats.addWisdomStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_MP] = EntityStats.addMPStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_BUFF_TP] = EntityStats.addTPStatic;
		EntityEffect._statsFctPerType[EFFECT_ABSOLUTE_SHIELD] = EntityStats.addAbsoStatic;
		EntityEffect._statsFctPerType[EFFECT_RELATIVE_SHIELD] = EntityStats.addRelStatic;
		EntityEffect._statsFctPerType[EFFECT_STEAL_ABSOLUTE_SHIELD] = EntityStats.addAbsoStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_ABSOLUTE_SHIELD] = EntityStats.addAbsoStatic;
		EntityEffect._statsFctPerType[EFFECT_RAW_RELATIVE_SHIELD] = EntityStats.addRelStatic;
		EntityEffect._statsFctPerType[EFFECT_DAMAGE_RETURN] = EntityStats.addDmgReturnStatic;
		EntityEffect._statsFctPerType[EFFECT_SHACKLE_AGILITY] = EntityStats.removeAgilityStatic;
		EntityEffect._statsFctPerType[EFFECT_SHACKLE_MAGIC] = EntityStats.removeMagicStatic;
		EntityEffect._statsFctPerType[EFFECT_SHACKLE_MP] = EntityStats.removeMPStatic;
		EntityEffect._statsFctPerType[EFFECT_SHACKLE_TP] = EntityStats.removeTPStatic;
		EntityEffect._statsFctPerType[EFFECT_SHACKLE_STRENGTH] = EntityStats.removeStrengthStatic;
		EntityEffect._statsFctPerType[EFFECT_SHACKLE_WISDOM] = EntityStats.removeWisdomStatic;
		EntityEffect._statsFctPerType[EFFECT_VULNERABILITY] = EntityStats.removeRelStatic;
		EntityEffect._statsFctPerType[EFFECT_ABSOLUTE_VULNERABILITY] = EntityStats.removeAbsoStatic;
		
		EntityEffect._statsFctPerType[EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD] = EntityStats.addAbsoStatic;
		EntityEffect._statsFctPerType[EFFECT_DAMAGE_TO_STRENGTH] = EntityStats.addStrengthStatic;
		EntityEffect._statsFctPerType[EFFECT_POISON_TO_SCIENCE] = EntityStats.addScienceStatic;
		EntityEffect._statsFctPerType[EFFECT_NOVA_DAMAGE_TO_MAGIC] = EntityStats.addMagicStatic;
		EntityEffect._statsFctPerType[EFFECT_MOVED_TO_MP] = EntityStats.addMPStatic;
		EntityEffect._statsFctPerType[EFFECT_ALLY_KILLED_TO_AGILITY] = EntityStats.addAgilityStatic;
		EntityEffect._statsFctPerType[EFFECT_KILL_TO_TP] = EntityStats.addTPStatic;
	}
	
	public string string() {
		return 	"{ type: " + Effect.effectNamePerType[this._type] +
				", value: " + this._value +
				", caster: " + this._caster.getName() +
				", turns: " + this._turns +
				", critical: " + this._critical +
				", itemId: " + this._itemId +
				", target: " + (this._target != null ? this._target!.getName() : "null") +
				", modifiers: " + this._modifiers +
				", isIrreductible: " + this._isIrreductible +
			" }\n";
	}
}
/** IA v5/Entities/Scoring/EntityStatsDiviser **/

class EntityStatsDiviser {
	public static integer maxLife = 2150;
	public static integer abso = 180;
	public static integer rel = 70;
	public static integer dmgReturn = 40;
	public static integer strength = 400;
	public static integer power = 50;
	public static integer magic = 400;
	public static integer wisdom = 335;
	public static integer resistance = 335;
	public static integer agility = 335;
	public static integer science = 400;
	public static integer poison = 750;
	public static integer mp = 4;
	public static integer tp = 12;
	
	public static reset() {
		EntityStatsDiviser.maxLife = 0;
		EntityStatsDiviser.abso = 0;
		EntityStatsDiviser.rel = 0;
		EntityStatsDiviser.dmgReturn = 0;
		EntityStatsDiviser.strength = 0;
		EntityStatsDiviser.power = 0;
		EntityStatsDiviser.magic = 0;
		EntityStatsDiviser.wisdom = 0;
		EntityStatsDiviser.resistance = 0;
		EntityStatsDiviser.agility = 0;
		EntityStatsDiviser.science = 0;
		EntityStatsDiviser.poison = 0;
		EntityStatsDiviser.mp = 0;
		EntityStatsDiviser.tp = 0;
	}
	
	public static init(Set<AbstractEntity> alliesLeeks) {
		EntityStatsDiviser.reset();
		
		real meanLevel = 0.0;
		for (AbstractEntity entity in alliesLeeks) {
			meanLevel = entity.getLevel() as real;
		}
		meanLevel /= setSize(alliesLeeks);
		
		var capital = 50 + meanLevel * 5;
		if (meanLevel > 99) capital += 45;
		if (meanLevel > 199) capital += 45;
		if (meanLevel > 299) capital += 45;
		if (meanLevel > 300) capital += 95;
			
		var lifeCapital = capital / 7.12;
		var value = 0;
		if (lifeCapital > 250) {
			lifeCapital -= 250;
			value += 1000;
			if (lifeCapital > 333) {
				lifeCapital -= 333;
				value += 1000;
				if (lifeCapital > 500) {
					lifeCapital -= 500;
					value += 1000;
				} else {
					value += lifeCapital * 2;
				}
			} else {
				value += lifeCapital * 3;
			}
		} else {
			value += lifeCapital * 4;
		}
		EntityStatsDiviser.maxLife = 100 + ((meanLevel - 1) * 3) + value;
		
		var attackCapital = capital / 4.45;
		EntityStatsDiviser.strength = getStatValue(attackCapital);
		EntityStatsDiviser.magic = EntityStatsDiviser.strength;
		
		var wisdomCapital = capital / 7.12;
		EntityStatsDiviser.wisdom = getStatValue(wisdomCapital);
		
		var resistanceCapital = capital / 7.12;
		EntityStatsDiviser.resistance = getStatValue(resistanceCapital);
		
		var agilityCapital = capital / 1.78;
		EntityStatsDiviser.agility = getStatValue(agilityCapital);
		
		var scienceCapital = capital / 7.12;
		EntityStatsDiviser.science = getStatValue(scienceCapital);
		
		var mpCapital = capital / 14.8;
		EntityStatsDiviser.mp = 3;
		if (mpCapital >= 20) EntityStatsDiviser.mp = 4;
		if (mpCapital >= 60) EntityStatsDiviser.mp = 5;
		if (mpCapital >= 120) EntityStatsDiviser.mp = 6;
		if (mpCapital >= 200) EntityStatsDiviser.mp = 7;
		if (mpCapital >= 300) EntityStatsDiviser.mp = 8;
		
		var tpCapital = capital / 2.94;
		EntityStatsDiviser.tp = 10;
		if (tpCapital >= 30) EntityStatsDiviser.tp = 11;
		if (tpCapital >= 65) EntityStatsDiviser.tp = 12;
		if (tpCapital >= 105) EntityStatsDiviser.tp = 13;
		if (tpCapital >= 150) EntityStatsDiviser.tp = 14;
		if (tpCapital >= 200) EntityStatsDiviser.tp = 15;
		if (tpCapital >= 255) EntityStatsDiviser.tp = 16;
		if (tpCapital >= 315) EntityStatsDiviser.tp = 17;
		if (tpCapital >= 380) EntityStatsDiviser.tp = 18;
		if (tpCapital >= 450) EntityStatsDiviser.tp = 19;
		if (tpCapital >= 525) EntityStatsDiviser.tp = 20;
		if (tpCapital >= 605) EntityStatsDiviser.tp = 21;
		if (tpCapital >= 690) EntityStatsDiviser.tp = 22;
		
		EntityStatsDiviser.abso = 14 * max(1, meanLevel / 30);
		EntityStatsDiviser.rel = 20 * max(1, meanLevel / 100);
		EntityStatsDiviser.dmgReturn = 15 * max(1, meanLevel / 100);
		
		/*debug(EntityStatsDiviser.maxLife);
		debug(EntityStatsDiviser.abso);
		debug(EntityStatsDiviser.rel);
		debug(EntityStatsDiviser.dmgReturn);
		debug(EntityStatsDiviser.strength);
		debug(EntityStatsDiviser.magic);
		debug(EntityStatsDiviser.wisdom);
		debug(EntityStatsDiviser.resistance);
		debug(EntityStatsDiviser.agility);
		debug(EntityStatsDiviser.science);
		debug(EntityStatsDiviser.mp);
		debug(EntityStatsDiviser.tp);*/
	}
	
	private static getStatValue(capital) {
		var value = 0;
		if (capital > 100) {
			capital -= 100;
			value += 200;
			if (capital > 100) {
				capital -= 100;
				value += 100;
				if (capital > 100) {
					capital -= 100;
					value += 100;
					if (capital > 400) {
						value += 200;
					}
				} else {
					value += capital / 2;
				}
			} else {
				value += capital;
			}
		} else {
			value += capital * 2;
		}
		
		return value;
	}
}
/** IA v5/Entities/Scoring/EntityScores **/

/** IA v5/Entities/Scoring/EntityScoresAdjuster **/

class EntityScoresAdjuster {
	public static real maxLife = 1.2;
	public static real dmg = 0.8;
	public static real heal = 1.2;
	public static real abso = 1.7;
	public static real rel = 1.3;
	public static real dmgReturn = 1.0;
	public static real strength = 1.6;
	public static real power = 1.0;
	public static real magic = 1.0;
	public static real wisdom = 1.0;
	public static real resistance = 0.5;
	public static real agility = 1.2;
	public static real science = 1.0;
	public static real poison = 1.0;
	public static real mp = 1.2;
	public static real tp = 1.4;
	
	public real kill;
	public real entityType;
	public real turnOrderNear;
	public real turnOrderFar;
	public real isolation;
	public real debuffOther;
	public real debuffShield;
	public real debuffBuffDamage;
	public real debuffBuffMP;
	public real debuffBuffTP;
	public real debuffBuffOtherStats;
	public real debuffDmgReturn;
	public real debuffShackles;
	public real buffDamage;
	public real antidote;
	public real healOverTime;
	public real heal;
	public real shield;
	public real resBuff;
	public real directDmg;
	public real poison;
	public real novaDamage;
	public real vulneAbso;
	public real vulneRel;
	public real dmgReturn;
	
	private AbstractEntity _entity;
	
	private constructor() {}
	constructor(AbstractEntity entity) {
		this._entity = entity;
		
		if (this._entity instanceof Bulb) {
			Bulb bulb = this._entity as Bulb;

			if (bulb.isSupport())
				this.entityType = 0.15;
			else if (bulb.isDamage())
				this.entityType = 0.5;
		} else {
			this.entityType = 1.0;
		}
	}
	
	public void update() {
		Cell entityCell = this._entity.getCell()!;
		EntityStats entityStats = this._entity.getStats();
		EntityStats entityStatsIn1Turn = this._entity.getStatsInTurns(1);
		integer entityMP = entityStatsIn1Turn.getMP();
		
		if (!this._entity.isEntityAlive()) {
			/* Resurection */
			/* * */
			return;
		}
		
		/* Turn order */
		// Si c'est un allié on préfère viser les entités qui jouent après
		this.turnOrderNear = 1.1 - (0.2 * GAME.timeline.getTurnOrderAfterMe(this._entity) / setSize(GAME.getAllEntities()));
		// Si c'est un enemy on préfère viser les entités qui jouent dans longtemps
		this.turnOrderFar = 0.9 + (0.2 * GAME.timeline.getTurnOrderAfterMe(this._entity) / setSize(GAME.getAllEntities()));
		/* * */
		
		/* Kill */
		this.kill = 4000.0 * this.entityType * this.turnOrderNear;
		/* * */
		
		integer aliveTeamsCount = 0;
		for (Team team in Team.getTeams()) {
			if (setSize(team.getAlive()) != 0)
				aliveTeamsCount++;
		}

		
		/* Isolation */
		real isolatedFromAlliesScore = 1.0;
		real inDangerScore = 1.0;
		this.isolation = 1.0;
		if (GAME.leeksPerTeamCount != 1 && this._entity.isEntityAlive()) {
			integer alliesNearCount = 0;
			integer ennemiesNearCount = 0;
			for (Team team in Team.getTeams()) {
				boolean isOnMyTeam = team == this._entity.getTeam();

				for (AbstractEntity entity in team.getAliveLeeks()) {
					if (entity == this._entity) continue;
					
					if (Cell.getDistance(entity.getCell()!, entityCell) < entityMP * 1.5) {
						if (isOnMyTeam && entity != this._entity)
							alliesNearCount++;
						else
							ennemiesNearCount++;
					}
				}
			}
			
			
			isolatedFromAlliesScore = 1.0 + (GAME.leeksPerTeamCount / (1 + alliesNearCount) - 1) / (12.0 * aliveTeamsCount / 2);
			inDangerScore = 1.0 + (ennemiesNearCount / (1 + alliesNearCount) - 1) / (12.0 * aliveTeamsCount / 2);
			this.isolation = isolatedFromAlliesScore * inDangerScore;
		}
		/* * */
		
		/* Debuff */
		this.debuffOther = 0.2;
		this.debuffBuffDamage = 0.7 * this.turnOrderNear;
		this.debuffBuffMP = 0.3;
		this.debuffBuffTP = 0.4;
		this.debuffBuffOtherStats = 0.1;
		this.debuffDmgReturn = 1.0;
		this.debuffShackles = 1.0;
		
		Set<AbstractEntity> goodTargets = GAME.me.getTeam()!.getMapInfos().goodTargets;
		boolean isGoodTarget = setContains(goodTargets, this._entity);
				
		real dmgPotentialWithDebuffs = 0.0;
		real dmgPotential = 0.0;
		if (setSize(goodTargets) == 0 || isGoodTarget) {
			EntityStats debuffedStats = new EntityStats();
			debuffedStats.copy(entityStats);
			debuffedStats.debuff(60);
			
			EntityStats stats = new EntityStats();
			stats.copy(entityStats);
			
			for (AbstractEntity otherEntity in GAME.timeline.getEntitiesPlayingAfter(GAME.me, true, true, true, true)) {
				if (!otherEntity.isEntityAlive()) continue;

				EntityStats otherEntityStatsIn1Turn = otherEntity.getStatsInTurns(1);

				if (otherEntity.getTeam() == this._entity.getTeam()) {
					integer otherEntityMP = otherEntityStatsIn1Turn.getMP();

					// Si c'est une entité de mon équipe on ajout les shields disponibles
					for (Item item in otherEntity.getOffCooldownsItemsInTurns(1)) {
						// Si la distance entre les deux entité est < à la range d'application de l'effet + les mp du caster 
						if (Cell.getDistance(otherEntity.getCell()!, entityCell) < otherEntityMP + item.getAreaSize() + item.getMaxRange()) {
							for (Effect eff in item.getEffects()) {
								integer effType = eff.getType();
								if (setContains(Effect.shieldEffects, effType) && eff.canTarget(this._entity, otherEntity) && eff.canApplyTo(this._entity, otherEntity)) {
									eff.applyTo(null, null, this._entity, otherEntity, debuffedStats, otherEntityStatsIn1Turn, 0);
									eff.applyTo(null, null, this._entity, otherEntity, stats, otherEntityStatsIn1Turn, 0);
								}
							}
						}
					}

				} else if (otherEntity.getTeam() == GAME.me.getTeam()) {

					integer otherEntityMP = otherEntityStatsIn1Turn.getMP();
					real bestDamageWithDebuffsPerTp = 0.0;
					real bestDamagePerTp = 0.0;
					for (Item item in otherEntity.getOffCooldownItems()) {
						if (!item.hasEffectTypeIn(Effect.directDamageEffects) && !item.hasEffectType(EFFECT_DEBUFF)) continue;

						if (Cell.getDistance(otherEntity.getCell()!, entityCell) < otherEntityMP / 2 + item.getAreaSize() + item.getMaxRange()) {
							
							if (item.hasEffectType(EFFECT_DEBUFF) && otherEntity != GAME.me) {
								debuffedStats.debuff(60);
							} else if (item.hasEffectTypeIn(Effect.directDamageEffects)) {
								real dmgWithDebuffsPerTp = 0.0;
								real dmgPerTp = 0.0;
								for (Effect eff in item.getEffects()) {
									integer effType = eff.getType();
									if (setContains(Effect.directDamageEffects, effType) && eff.canTarget(this._entity, otherEntity) && eff.canApplyTo(this._entity, otherEntity)) {
										dmgWithDebuffsPerTp += eff.getAppliedValue(null, null, this._entity, debuffedStats, otherEntityStatsIn1Turn, 0) / item.getCost();
										
										dmgPerTp += eff.getAppliedValue(null, null, this._entity, stats, otherEntityStatsIn1Turn, 0) / item.getCost();
									}
								}

								if (dmgWithDebuffsPerTp > bestDamageWithDebuffsPerTp)
									bestDamageWithDebuffsPerTp = dmgWithDebuffsPerTp;
								
								if (dmgPerTp > bestDamagePerTp)
									bestDamagePerTp = dmgPerTp;
							}
						}
					}
					dmgPotentialWithDebuffs += bestDamageWithDebuffsPerTp * otherEntity.getStats().getTP();
					dmgPotential += bestDamagePerTp * otherEntity.getStats().getTP();
				}
			}
		}
		this.debuffShield = dmgPotentialWithDebuffs / EntityStatsDiviser.maxLife / 3 * this.isolation * this.turnOrderFar;
		/* * */
		
		
		/* Antidote */
		integer otherAntidoteCount = 0;
		for (AbstractEntity otherEntity in GAME.timeline.getEntitiesPlayingAfter(GAME.me, true, false, true, true)) {
			if (!otherEntity.isEntityAlive()) continue;
			if (otherEntity == this._entity) continue;
			
			integer otherEntityMP = otherEntity.getStats().getMP();
			
			for (Item item in otherEntity.getOffCooldownsItemsInTurns(1)) {
				if (item.hasEffectType(EFFECT_ANTIDOTE) && Cell.getDistance(entityCell, otherEntity.getCell()!) < otherEntityMP *  1.3) {
					otherAntidoteCount++;
				}
			}
		}

		this.antidote = 0.5 * this.isolation;
		if (otherAntidoteCount == 0)
			this.antidote *= 1.2 * (this.turnOrderNear * this.turnOrderNear);
		else
			this.antidote /= 2;
		/* * */
		
		
		/* Shield */
		Set<AbstractEntity> possibleTargets = GAME.me.getTeam()!.getMapInfos().possibleTargets;

		real directDamageDanger = 0.0;
		real poisonDamageDanger = 0.0;
		for (Team team in Team.getTeams()) {
			if (team != this._entity.getTeam())
				directDamageDanger += team.getScores().directDamageDanger;
				poisonDamageDanger += team.getScores().poisonDamageDanger;
			
		}
		this.shield = max(0.0, min(1.6, directDamageDanger)) * (isGoodTarget ? 1.15 : 1) * (1 + dmgPotential / EntityStatsDiviser.maxLife / 12) * this.isolation * this.turnOrderNear;
		// Si il n'y a personne à proximité, on a moins besoin de shield
		if (setSize(possibleTargets) == 0)
			this.shield /= 2;
		/* * */
		
		
		/* HealOverTime */
		integer enemiesLeekCount = GAME.timeline.getEntitiesPlayingBetweenEntitiesCount(this._entity, this._entity, false, true);
		this.healOverTime = 1 / (1 + 0.05 * enemiesLeekCount) * max(1.0, min(1.6, poisonDamageDanger));
		/* * */
		
		
		/* Res buff */
		integer shieldItemsOffCooldownCount = 0;
		for (Item item in this._entity.getItems()) {
			if (this._entity.getItemCooldown(item) <= 1) {
				if (item.hasEffectTypeIn(Effect.shieldEffects)) {
					shieldItemsOffCooldownCount++;
				}
			}
		}
		this.resBuff = shieldItemsOffCooldownCount / 2.0 * this.shield // * teamNeedShields;
		/* * */
		
		
		/* Dmg return */
		this.dmgReturn = max(0.0, min(1.6, directDamageDanger)) * this.isolation;
		/* * */
		
		
		/* Heal */
		AbstractEntity nextEnemy = GAME.timeline.getNextEntity(GAME.me, false, true)!;
		integer entityAfterNovaDmgItemsOffCooldownCount = 0;
		for (Item item in nextEnemy.getItems()) {
			if (nextEnemy.getItemCooldown(item) <= 1) {
				for (Effect eff in item.getEffectsOfTypes(Effect.novaDamageEffects)) {
					entityAfterNovaDmgItemsOffCooldownCount++;
				}
			}
		}
		this.heal = max(1.3, 1.0 + 0.1 * entityAfterNovaDmgItemsOffCooldownCount) * (isGoodTarget ? 1.15 : 1) * (1 + dmgPotential / EntityStatsDiviser.maxLife / 12) * this.isolation * this.turnOrderNear;
		/* * */
		
		
		/* Buffs */
		this.buffDamage = 1.0 * this.turnOrderNear;
		if (setSize(possibleTargets) == 0)
			this.buffDamage /= 2;
		/* * */
		
		/* Damage */
		this.directDmg = 1.0 * max(1.0, min(1.2, directDamageDanger)) * (isGoodTarget ? 1.15 : 1) * (1 + dmgPotential / EntityStatsDiviser.maxLife / 12) * this.isolation * this.turnOrderFar;
		/* * */
		
		this.poison = 1.0 * this.isolation * this.turnOrderNear;
		this.novaDamage = 1.0 * this.isolation * this.turnOrderFar;
		
		
		this.vulneAbso = 1.5  * (1 + dmgPotentialWithDebuffs / EntityStatsDiviser.maxLife / 12) * this.isolation * this.turnOrderFar;
		this.vulneRel = 1.5  * (1 + dmgPotentialWithDebuffs / EntityStatsDiviser.maxLife / 12) * this.isolation * this.turnOrderFar;
	}
}

class EntityScores {
	public static final real ALLY_DIST_SCORE_MULT = -1.0;
	public static final real ENEMY_DIST_SCORE_MULT = 1.0;
	
	public real maxLife;
	public real life;
	public real strength;
	public real power;
	public real science;
	public real wisdom;
	public real resistance;
	public real magic;
	public real agility;
	public real abso;
	public real rel;
	public real dmgReturn;
	public real poison;
	public real mp;
	public real tp;
	
	private EntityScoresAdjuster _scoresAdjuster; EntityScoresAdjuster getAdjuster() { return this._scoresAdjuster; }
	private AbstractEntity _entity;
	
	private constructor() {}
	public constructor(AbstractEntity entity) {
		this._entity = entity;
		
		this.maxLife = 0.0;
		this.life = 0.0;
		this.strength = 0.0;
		this.power = 0.0;
		this.science = 0.0;
		this.wisdom = 0.0;
		this.resistance = 0.0;
		this.magic = 0.0;
		this.agility = 0.0;
		this.abso = 0.0;
		this.rel = 0.0;
		this.dmgReturn = 0.0;
		this.poison = 0.0;
		this.mp = 0.0;
		this.tp = 0.0;
		
		this._scoresAdjuster = new EntityScoresAdjuster(entity);
	}
		
	public void updateScoreAdjuster() {		
		this._scoresAdjuster.update();
	}
	
	public real getKillScore() {
		return this._scoresAdjuster.kill;	
	}
	
	public real getMaxLifeScore(integer maxLifeAdded, integer maxLife = this._entity.getStats().getLife()) {
		// 10\left(1-\min\left(0.8,\frac{a}{2.1\cdot2000}\right)\right)x
		return 10 * (1 - min(0.8, maxLife / (2.1 * EntityStatsDiviser.maxLife))) * maxLifeAdded * EntityScoresAdjuster.maxLife;
	}
	
	public real getDmgScore(integer dmg, integer life = this._entity.getStats().getLife()) {
		// 2.5\left(1-\min\left(0.6,\frac{a}{2\cdot2000}\right)\right)x
		return (2.5 * (1 - min(0.6, life / (8 * EntityStatsDiviser.maxLife))) * dmg + 0.0005 * dmg * dmg) * EntityScoresAdjuster.dmg;	
	}
	
	public real getHealScore(integer heal, integer life = this._entity.getStats().getLife()) {	
		// 4\left(1-\min\left(0.6,\frac{a}{4\cdot2000}\right)\right)x
		return 4 * (1 - min(0.6, life / (4 * EntityStatsDiviser.maxLife))) * heal * EntityScoresAdjuster.dmg;	
	}
	
	public real getStrengthScore(integer strAdded, integer str = this._entity.getStats().getStrength()) {
		// 2x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
		return 4 * (EntityStatsDiviser.strength - (str - EntityStatsDiviser.strength * 1.5) * (str - EntityStatsDiviser.strength * 1.5) / (EntityStatsDiviser.strength * 2.25)) / EntityStatsDiviser.strength * strAdded * EntityScoresAdjuster.strength;
	}
	
	public real getPowerScore(integer powerAdded, integer power = this._entity.getStats().getPower()) {
		// 1000-\left(0.31x-31\right)^{2}
		return 1000 - (0.31 * powerAdded - 31) * (0.31 * powerAdded - 31) * EntityScoresAdjuster.power;
	}
	
	public real getMagicScore(integer magicAdded, integer magic = this._entity.getStats().getMagic()) {
		// 4x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
		return 4 * (EntityStatsDiviser.magic - (magic - EntityStatsDiviser.magic * 1.5) * (magic - EntityStatsDiviser.magic * 1.5) / (EntityStatsDiviser.magic * 2.25)) / EntityStatsDiviser.magic * magicAdded * EntityScoresAdjuster.magic;
	}
	
	public real getWisdomScore(integer wisdomAdded, integer wisdom = this._entity.getStats().getWisdom()) {
		// 2x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
		return 4 * (EntityStatsDiviser.wisdom - (wisdom - EntityStatsDiviser.wisdom * 1.5) * (wisdom - EntityStatsDiviser.wisdom * 1.5) / (EntityStatsDiviser.wisdom * 2.25)) / EntityStatsDiviser.wisdom * wisdomAdded * EntityScoresAdjuster.wisdom;
	}
	
	public real getResistanceScore(integer resAdded, integer res = this._entity.getStats().getResistance()) {
		// 4x\cdot\frac{\left(z-\frac{\left(g-z\cdot1.5\right)^{2}}{z\cdot2.25}\right)}{z}
		return 4 * (EntityStatsDiviser.resistance - (res - EntityStatsDiviser.resistance * 1.5) * (res - EntityStatsDiviser.resistance * 1.5) / (EntityStatsDiviser.resistance * 2.25)) / EntityStatsDiviser.resistance * resAdded * EntityScoresAdjuster.resistance;
	}
	
	public real getAgilityScore(integer agilityAdded, integer agility = this._entity.getStats().getAgility()) {
		// 4x\cdot\frac{\left(z-\frac{\left(g-z\cdot1.5\right)^{2}}{z\cdot2.25}\right)}{z}
		return 3 * (EntityStatsDiviser.agility - (agility - EntityStatsDiviser.agility * 1.5) * (agility - EntityStatsDiviser.agility * 1.5) / (EntityStatsDiviser.agility * 2.25)) / EntityStatsDiviser.agility * agilityAdded * EntityScoresAdjuster.agility;
	}
	
	public real getScienceScore(integer scienceAdded, integer science = this._entity.getStats().getScience()) {
		// 3.5x\cdot\frac{\left(500-\frac{\left(g-750\right)^{2}}{1125}\right)}{500}
		return 3.5 * (EntityStatsDiviser.science - (science - EntityStatsDiviser.science * 1.5) * (science - EntityStatsDiviser.science * 1.5) / (EntityStatsDiviser.science * 2.25)) / EntityStatsDiviser.science * scienceAdded * EntityScoresAdjuster.science;
	}
	
	public real getAbsoScore(integer absoAdded, integer abso = this._entity.getStats().getAbso(), integer rel = this._entity.getStats().getRel()) {
		if (abso >= 0) {
			// \frac{h-0.3d}{h}\left(6x-\frac{f}{60}x\right)
			return 	(EntityStatsDiviser.rel - 0.3 * rel) / EntityStatsDiviser.rel * (7 * absoAdded - (3 * abso / EntityStatsDiviser.abso) * absoAdded) * EntityScoresAdjuster.abso;
		} else {
			return 7 * absoAdded - (3 * abso / EntityStatsDiviser.abso) * absoAdded * EntityScoresAdjuster.abso;
		}
	}
	
	public real getRelScore(integer relAdded, integer rel = this._entity.getStats().getRel()) {
		if (rel >= 0) {
			// \left(40-10\cdot\frac{d}{h}\right)x-\frac{\left(d\right)}{3h}x^{2}
			return 	((40 - 10 * rel / EntityStatsDiviser.rel) * relAdded - rel / (3 * EntityStatsDiviser.rel) * relAdded * relAdded) * EntityScoresAdjuster.rel;
		} else {
			// \frac{100+d}{100}\left(30-15\cdot\frac{d}{100}\right)x
			return 	(EntityStatsDiviser.rel + rel) / EntityStatsDiviser.rel * (30 - 15 * (rel / EntityStatsDiviser.rel)) * relAdded * EntityScoresAdjuster.rel;
		}
	}
	
	public real getDmgReturnScore(integer dmgReturnAdded, integer dmgReturn = this._entity.getStats().getDmgReturn(), integer abso = this._entity.getStats().getAbso(), integer rel = this._entity.getStats().getRel()) {
		// \frac{J-0.4d-0.05f}{J}\left(10x-\frac{i}{J}x\right)
		return 	(EntityStatsDiviser.dmgReturn - 0.4 * rel - 0.05 * abso) / EntityStatsDiviser.dmgReturn * (10 * dmgReturnAdded - dmgReturn / EntityStatsDiviser.dmgReturn) * EntityScoresAdjuster.dmgReturn;
	}
	
	public real getPoisonScore(integer poison, integer life = this._entity.getStats().getLife()) {
		// 2.5\left(1-\min\left(0.6,\frac{a}{8\cdot2000}\right)\right)x
		return 2.5 * (1 - min(0.6, life / (8 * EntityStatsDiviser.maxLife))) * poison * EntityScoresAdjuster.poison;
	}
	
	public real getMPScore(integer addedMp, integer mp = this._entity.getStats().getMP()) {
		// 200x\cdot\frac{\left(w-\frac{\left(k-w\cdot1.5\right)^{2}}{w\cdot2.25}\right)}{w}
		return 200 * (EntityStatsDiviser.mp - (mp - EntityStatsDiviser.mp * 1.5) * (mp - EntityStatsDiviser.mp * 1.5) / (EntityStatsDiviser.mp * 2.25)) / EntityStatsDiviser.mp * addedMp * EntityScoresAdjuster.mp;	
	}
		
	public real getTPScore(integer addedTp, integer tp = this._entity.getStats().getTP()) {
		// 200x\cdot\frac{\left(w-\frac{\left(k-w\cdot1.5\right)^{2}}{w\cdot2.25}\right)}{w}
		return 200 * (EntityStatsDiviser.tp - (tp - EntityStatsDiviser.tp * 1.5) * (tp - EntityStatsDiviser.tp * 1.5) / (EntityStatsDiviser.tp * 2.25)) / EntityStatsDiviser.tp * addedTp * EntityScoresAdjuster.tp;	
	}	
	
 
	public string() {
		return " { " + "life : " + this.life +
			"\n strength : " + this.strength +
			"\n science : " + this.science +
			"\n wisdom : " + this.wisdom +
			"\n resistance : " + this.resistance +
			"\n magic : " + this.magic +
			"\n agility : " + this.agility +
			" }\n";
	}
}
/** IA v5/Entities/EntityStats **/


/** IA v5/Entities/Leek **/


/** IA v5/Items/Weapon **/



class Weapon extends Item {
	/** weapon pool **/
	private static Map<integer, Weapon> weapons = [:];
	public static Weapon get(integer id) {
		if (Weapon.weapons[id] != null)
			return Weapon.weapons[id]!;
		
		Weapon weapon = new Weapon(id);
		Weapon.weapons[id] = weapon;
		Item.items[id] = weapon;
		return weapon;
	}
	/** fin weapon pool **/
	
	constructor(integer id) {
		super(id);
		
		initStats();
	}

	public initStats() {
		this.name = getWeaponName(this.id);
		this.areaType = getWeaponArea(this.id)!;
		this.cost = getWeaponCost(this.id);
		this.baseCooldown = 0;
		this.minRange = getWeaponMinRange(this.id);
		this.maxRange = getWeaponMaxRange(this.id);
		this.launchType = getWeaponLaunchType(this.id)!;
		this.needLos = weaponNeedLos(this.id);
		for (Array<any> effectArray in getWeaponEffects(this.id)!) {
			Effect? eff = Effect.createEffect(effectArray, this);
			if (eff != null) {
				push(this._effects, eff!);
				setPut(this._effectsTypeList, eff!.getType());
			}
		}
		
		this.initTeamTargetsBool();
	}
	
	protected Set<Cell> getItemEffectiveArea(Cell cell, Cell? from) {
		Set<Cell> cells = <>;
		integer? fromId = null;
		if (from != null) fromId = from!.id;
		for (integer cId in getWeaponEffectiveArea(this.id, cell.id, fromId)!) {
			setPut(cells, CellMap.getCell(cId));
		}
		return cells;
	}
	
	public boolean canUseItemOnCell(Cell cell) {
		return canUseWeaponOnCell(this.id, cell.id);
	}

	public integer use(Cell cell) {
		if (getWeapon() != this.id) {
			setWeapon(this.id);
		}		
		return useWeaponOnCell(cell.id);
	}
}

class Leek extends AbstractEntity {
	/** leeks pool **/
	private static final Map<integer, Leek> leeks = [:];
	public static void initLeeks(Array<integer> entitiesId) {
		for (integer leekId in entitiesId) {
			if(getType(leekId) == ENTITY_LEEK) {
				Leek.leeks[leekId] = new Leek(leekId);
				AbstractEntity.entities[leekId] = leeks[leekId];
			}
		}
	}
	public static Leek? get(integer id) {
		return Leek.leeks[id];
	}
	public static integer countLeeks() {
		return mapSize(Leek.leeks);
	}
	/** fin leeks pool **/
 
	private Set<Weapon> _weapons; public Set<Weapon> getLeekWeapons() { return this._weapons; }
	private Map<integer, PassiveEffect> _passiveItemEffects; public Map<integer, PassiveEffect> getPassiveItemEffects() { return this._passiveItemEffects; }
	private integer? _equippedWeaponId; public integer? getEquippedWeaponId() { return this._equippedWeaponId; }
	private Set<Bulb> _summons; public Set<Bulb> getSummons() { return _summons; }

	constructor(integer id) {
		super(id);

		this._weapons = <>;
		this._passiveItemEffects = [:];
		
		this._summons = <>;

		initBaseStats();
	}

	public initBaseStats() {
		for(integer wepId in getWeapons(this._id)!) {
			Weapon weapon = Weapon.get(wepId);
			setPut(this._items, weapon);
			for (Array<any> passiveEffect in getWeaponPassiveEffects(wepId)) {
				PassiveEffect? passiveItemEffect = PassiveEffect.createEffect(passiveEffect, weapon);
				if (passiveItemEffect != null)
					this._passiveItemEffects[passiveItemEffect!.getType()] = passiveItemEffect!;
			}
			setPut(this._weapons, weapon);
			this._cooldowns[weapon] = 0;
		}
	}

	public static updateLeeksStats() {
		for (Leek leek in Leek.leeks) {
			leek.updateStats();
		}
	}
	protected void updateStats() {
		this._equippedWeaponId = getWeapon();
		super.updateStats();
		
		if (GAME.isBR)
			this._powerOnDeath = round(10 + 0.5 * this._stats.getPower());
		
	}
	
	public void addSummon(Bulb bulb) {
		setPut(this._summons, bulb);
	}
	public void removeSummon(Bulb bulb) {
		setRemove(this._summons, bulb);
	}
	
	public void simulateItemUse(Item item) {
		if (item instanceof Weapon and this._equippedWeaponId != item.getId()) {
			this._equippedWeaponId = item.getId();
			this.useTP(1);
		}
		super.simulateItemUse(item);
		Debug.info("my tp : " + this._stats.getTP());
	}
}

class EntityStats {
	private integer _maxLife; 
	public integer getMaxLife() { return this._maxLife; }
	public void setMaxLife(integer maxLife) { this._maxLife = maxLife; }
	private integer _life;
	public integer getLife() { return this._life; }
	public void setLife(integer life) { this._life = life; }
	private integer _strength; public integer getStrength() { return this._strength; }
	private integer _wisdom; public integer getWisdom() { return this._wisdom; }
	private integer _agility; public integer getAgility() { return this._agility; }
	private integer _resistance; public integer getResistance() { return this._resistance; }
	private integer _science; public integer getScience() { return this._science; }
	private integer _magic; public integer getMagic() { return this._magic; }
	private integer _power; public integer getPower() { return this._power; }
	private integer _frequency; public integer getFrequency() { return this._frequency; }
	private integer _tp; public integer getTP() { return this._tp; }
	private integer _mp; public integer getMP() { return this._mp; }
	private integer _abso; public integer getAbso() { return this._abso; }
	private integer _rel; public integer getRel() { return this._rel; }
	private integer _dmgReturn; public integer getDmgReturn() { return this._dmgReturn; }
	private integer _poison; public integer getPoison() { return this._poison; }

	private real _strengthMult; public real getStrengthMult() { return this._strengthMult; }
	private real _wisdomMult; public real getWisdomMult() { return this._wisdomMult; }
	private real _agilityMult; public real getAgilityMult() { return this._agilityMult; }
	private real _resistanceMult; public real getResistanceMult() { return this._resistanceMult; }
	private real _scienceMult; public real getScienceMult() { return this._scienceMult; }
	private real _magicMult; public real getMagicMult() { return this._magicMult; }
	private real _powerMult; public real getPowerMult() { return this._powerMult; }
	
	private Set<EntityEffect> _effects; public Set<EntityEffect> getEffects() { return this._effects; }	
	
	private AbstractEntity _entity;
	
	constructor(AbstractEntity entity) {
		this.initStats(entity.getId());
		this._entity = entity;
	}
	
	public copy(EntityStats stats) {
		this._maxLife = stats._maxLife;
		this._life = stats._life;
		this._strength = stats._strength;
		this._wisdom = stats._wisdom;
		this._agility = stats._agility;
		this._resistance = stats._resistance;
		this._science = stats._science;
		this._magic = stats._magic;
		this._power = stats._power;
		this._frequency = stats._frequency;
		this._tp = stats._tp;
		this._mp = stats._mp;
		this._abso = stats._abso;
		this._rel = stats._rel;
		this._dmgReturn = stats._dmgReturn;
		this._poison = stats._poison;
		
		this._strengthMult = stats._strengthMult;
		this._wisdomMult = stats._wisdomMult;
		this._agilityMult = stats._agilityMult;
		this._resistanceMult = stats._resistanceMult;
		this._scienceMult = stats._scienceMult;
		this._magicMult = stats._magicMult;
		this._powerMult = stats._powerMult;
		
		this._effects = clone(stats._effects) as Set<EntityEffect>;
		
		this._entity = stats._entity;
	}
	
	public initStats(integer entityId) {
		this._maxLife = getTotalLife(entityId)!;
		this._life = getLife(entityId)!;
		this._strength = getStrength(entityId)!;
		this._wisdom = getWisdom(entityId)!;
		this._agility = getAgility(entityId)!;
		this._resistance = getResistance(entityId)!;
		this._science = getScience(entityId)!;
		this._magic = getMagic(entityId)!;
		this._power = getPower(entityId)!;
		this._frequency = getFrequency(entityId)!;
		this._tp = getTP(entityId)!;
		if (this._tp < 0)
			this._tp = 0;
		this._mp = getMP(entityId)!;
		if (this._mp < 0)
			this._mp = 0;
		this._abso = getAbsoluteShield(entityId)!;
		this._rel = getRelativeShield(entityId)!;
		this._dmgReturn = getDamageReturn(entityId)!;
		
		this._effects = <>;
		for (Array<boolean|integer> effect in getEffects(entityId)!) {
			setPut(this._effects, EntityEffect(effect));
		}
		
		for (EntityEffect eff in this.getPoisonEffects()) {
			this._poison += eff.getValue();
		}
		
		this.updateMults();
	}
	
	public updateMults() {
		this._strengthMult = (1 + (this._strength >= -100 ? this._strength : -1) / 100);
		this._wisdomMult = (1 + (this._wisdom >= -100 ? this._wisdom : -1) / 100);
		this._agilityMult = (1 + (this._agility >= -100 ? this._agility : -1) / 100);
		this._resistanceMult = (1 + (this._resistance >= -100 ? this._resistance : -1) / 100);
		this._scienceMult = (1 + (this._science >= -100 ? this._science : -1) / 100);
		this._magicMult = (1 + (this._magic >= -100 ? this._magic : -1) / 100);
		this._powerMult = (1 + (this._power >= -100 ? this._power : -1) / 100);	
	}
	
	public addEffect(Function<EntityStats, integer => void>? statsFct, integer type, integer value, AbstractEntity caster, integer turns, boolean critical, integer itemId, AbstractEntity target, integer modifiers) {
		if (turns != 0) {
			EntityEffect effect = new EntityEffect(statsFct, type, value, caster, turns, critical, itemId, target, modifiers);
			//Debug.info("adding effect " + effect + " to " + this._entity.getName())
			setPut(this._effects, effect);
			effect.apply(this);
		}
	}
	
	public void addEffects(Set<EntityEffect> effects) {
		for (EntityEffect effect in effects) {
			if (effect.getTurns() != 0) {
				//Debug.info("adding effect " + effect + " to " + this._entity.getName());
				setPut(this._effects, effect);
				effect.apply(this);
			}
		}
	}
	
	public void removeEffect(EntityEffect effect) {
		//Debug.info("removing effect " + effect + " to " + this._entity.getName());
		setRemove(this._effects, effect);
		effect.remove(this);
	}
	public void removeEffects(Set<EntityEffect> effects) {
		Set<EntityEffect> effectsToRemove = <>;
		for (EntityEffect effect in effects) {
			//Debug.info("removing effect " + effect + " from " + this._entity.getName());
			setPut(effectsToRemove, effect);
			effect.remove(this);
		}
		for (EntityEffect effect in effectsToRemove) {
			setRemove(this._effects, effect);
		}
	}
	public void clearEffects() {
		for (EntityEffect effect in this._effects) {
			//Debug.info("clearing effect " + effect + " from " + this._entity.getName());
			effect.remove(this);
		}
		setClear(this._effects);
	}
	
	/**
	 * Test si l'effet affecte l'entité, corespondant au type et à l'item de l'effet donné
	 * 
	 * @param eff : l'effet recherché
	 * 
	 * @return true si l'entité est affecté par l'effet
	 * 
	 **/
	public boolean hasEffectOn(Effect eff) {
		for (EntityEffect effect in this._effects) {
		if (effect.getType() == eff.getType() && effect.getItemId() == eff.getItem().getId())
				return true;
		}
		return false;
	}
	
	public boolean hasEffectType(integer effType) {
		for (EntityEffect effect in this._effects) {
			if (effect.getType() == effType)
				return true;
		}
		return false;
	}
	
	/**
	 * Récupère l'effet qui affecte l'entité, corespondant au type et à l'item de l'effet donné
	 * 
	 * @param eff : l'effet recherché
	 * 
	 * @return la liste des effets correspondant à 'eff'
	 **/
	public Set<EntityEffect> getEffectsOn(Effect eff) {
		Set<EntityEffect> effectsMatching = <>;
		for (EntityEffect effect in this._effects) {
			if (effect.getType() == eff.getType() && effect.getItemId() == eff.getItem().getId())
				setPut(effectsMatching, effect);
		}
		return effectsMatching;
	}
	
		
	/**
	 * Récupère les effets qui affecteront encore l'entité dans x tour
	 * 
	 * @param turns : le nombre de tours
	 * 
	 * @return la liste des effets
	 **/
	public Set<EntityEffect> getEffectsInTurns(integer turns) {
		Set<EntityEffect> effectsInTurns = <>;
		for (EntityEffect effect in this._effects) {
			if (effect.getTurns() == -1 || effect.getTurns() > turns || (effect.getTurns() == turns && effect.getCaster().getTurnOrder() > this._entity.getTurnOrder()))
				setPut(effectsInTurns, effect);
		}
		return effectsInTurns;
	}
	
	public void removeShackles() {
		Set<EntityEffect> effectsToRemove = <>;
		for (EntityEffect eff in this._effects) {
			if (setContains(Effect.shackleEffects, eff.getType())) {
				eff.getCaster().removeLaunchedEffect(eff);
				setPut(effectsToRemove, eff);
			}
		}
		this.removeEffects(effectsToRemove);
	}
	public Array<EntityEffect> getShacklesEffects() {
		Array<EntityEffect> effects = [];
		for (EntityEffect eff in this._effects) {
			if (setContains(Effect.shackleEffects, eff.getType())) {
				push(effects, eff);
			}
		}
		return effects;
	}
	
	public void removePoisons() {
		Set<EntityEffect> effectsToRemove = <>;
		for (EntityEffect eff in this._effects) {
			if (eff.getType() == EFFECT_POISON) {
				eff.getCaster().removeLaunchedEffect(eff);
				setPut(effectsToRemove, eff);
			}
		}
		this.removeEffects(effectsToRemove);
	}
	public Array<EntityEffect> getPoisonEffects() {
		Array<EntityEffect> effects = [];
		for (EntityEffect eff in this._effects) {
			if (setContains(Effect.poisonEffects, eff.getType())) {
				push(effects, eff);
			}
		}
		return effects;
	}
	
	public void debuff(real|integer value) {
		Set<EntityEffect> effectsToRemove = <>;
		Set<EntityEffect> newEffects = <>;
		for (EntityEffect eff in this._effects) {
			if (eff.isIrreductible()) continue;
			
			setPut(effectsToRemove, eff);
			
			integer newValue = round(eff.getValue() * (1 - (value / 100)));
			if (newValue > 0) {
				setPut(newEffects, new EntityEffect(eff.getStatsFct(), eff.getType(), newValue, eff.getCaster(), eff.getTurns(), eff.isCritical(), eff.getItemId(), eff.getTarget(), eff.getModifiers()));
			}
		}
		this.removeEffects(effectsToRemove);
		this.addEffects(newEffects);
	}
	
	public void addMaxLife(integer value) {	
		this._maxLife += value;
		//Debug.info("adding max life " + value + " life to " + this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}
	
	public void removeMaxLife(integer value) {
		this._maxLife -= value;
		//Debug.info("removing " + value + " max life from " + this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}
	
	public void addLife(integer value) {
		this._life += value;
		if (this._life > this._maxLife)
			this._life = this._maxLife;
		//Debug.info("healing " + value + " life to " +  this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}	
	public static void addLifeStatic(EntityStats stats, integer value) {
		stats.addLife(value);
	}
	
	public void removeLife(integer value, integer type) {
		this._life -= value;

		real erosionMult = type == EFFECT_POISON ? 0.10 : 0.05;
		integer erosionValue = round(value * erosionMult);
		this.removeMaxLife(erosionValue);
		
		//Debug.info("removing " + value + " life from " +  this._entity.getName() + " who has " + this._life + " / " + this._maxLife);
	}
	public static void removeLifeStatic(EntityStats stats, integer value) {
		stats.removeLife(value, EFFECT_AFTEREFFECT);
	}
	
	public void addStrength(integer value) {
		this._strength += value;
		//Debug.info("add " + value + " strength to " +  this._entity.getName());
	}
	public static void addStrengthStatic(EntityStats stats, integer value) {
		stats.addStrength(value);
	}
	
	public void removeStrength(integer value) {
		this._strength -= value;
		//Debug.info("remove " + value + " strength to " +  this._entity.getName());
	}
	public static void removeStrengthStatic(EntityStats stats, integer value) {
		stats.removeStrength(value);
	}
	
	public void addWisdom(integer value) {
		this._wisdom += value;
		//Debug.info("add " + value + " wisdom to " + this._entity.getName());
	}
