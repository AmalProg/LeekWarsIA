	private static Memoize3 cellsCanHitFromWithItemIgnoreMemo = new Memoize3(function(Item item, Cell cellFrom, Set<AbstractEntity> ignoredEntities) {
			Set<Cell> cells = <>;
			
			Array<integer> ignoredEntitiesId = new Array();
