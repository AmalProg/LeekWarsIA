	}
	
	public integer getAppliedValueStatic(Effect effect, Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = effect.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return round(baseValue * caster.getStats().getMagicMult());
	}
}
