/** IA v5/Effects/AfterEffectEffect **/



class AfterEffectEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer dmg = round(value * casterStats.getScienceMult());
		if (dmg > 0) {
			affectedEntityStats.removeLife(dmg, EFFECT_AFTEREFFECT);

			affectedEntityStats.addEffect(EntityStats.removeLifeStatic, this._type, dmg, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	

			affectedEntity.updateAliveState(caster);
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		integer dmg = round(value * casterStats.getScienceMult());
			
		integer casterAllyOtherMult = caster.isAnAlly() ? 1 : -1;
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;

		real score = 0.0;
		if (dmg > 0) {
			integer overDmg = 0;
			if (dmg > targetStats.getLife()) {
				// On ne gère l'over dmg que pour un ennemi
				if (!target.isAnAlly())
					overDmg = dmg - targetStats.getLife(); 
				dmg = targetStats.getLife();
				
				score += targetScores.getKillScore() * targetAllyMult;
				score += targetScores.getPowerScore(target.getPowerOnDeath()) * casterAllyOtherMult;

				Debug.log("I can kill !");
			}
			
			score += (this._turns / 1.5) * targetScores.getDmgScore(dmg, targetStats.getLife()) * targetAllyMult;
			if (overDmg > 0)
				score -= 0.25 * targetScores.getDmgScore(overDmg, targetStats.getLife());
			
			return score;
		}
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;
		return targetScores.getDmgScore(finalValue, targetStats.getLife()) * targetAllyMult;
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return round(baseValue * casterStats.getScienceMult());
	}
}
/** IA v5/Effects/DamageEffect **/



class DamageEffect extends Effect {
	private constructor(Array<any> effectArray, Item item) {
		setPut(this._triggerableEffects, EFFECT_DAMAGE_TO_ABSOLUTE_SHIELD);
		setPut(this._triggerableEffects, EFFECT_DAMAGE_TO_STRENGTH);
		
		super(effectArray, item);
	}
	
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		real baseDmg = value * casterStats.getStrengthMult() * casterStats.getPowerMult();
		integer dmgReturn = round(baseDmg * affectedEntityStats.getDmgReturn() / 100);
		integer dmg = round(baseDmg * (1 - affectedEntityStats.getRel() / 100) - affectedEntityStats.getAbso());

		if (dmg > 0) {
			affectedEntityStats.removeLife(dmg, EFFECT_DAMAGE);
			affectedEntity.updateAliveState(caster);

			this.tryTriggerPassive(affectedEntity, caster, dmg);
		}
		if (caster != affectedEntity) {
			if (dmg > 0)
				casterStats.addLife(round(dmg * casterStats.getWisdom() / 1000));
			
			if (dmgReturn > 0) {
				casterStats.removeLife(dmgReturn, EFFECT_DAMAGE);
				caster.updateAliveState(caster);
				
				this.tryTriggerPassive(affectedEntity, caster, dmgReturn);
			}
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		EntityScores casterScores = caster.getScores();
		
		real baseDmg = value * casterStats.getStrengthMult() * casterStats.getPowerMult();
		integer dmgReturn = round(baseDmg * targetStats.getDmgReturn() / 100);
		integer dmg = round(baseDmg * (1 - targetStats.getRel() / 100) - targetStats.getAbso());

		integer casterAllyDmgMult = caster.isAnAlly() ? -1 : 1;
		integer casterAllyOtherMult = caster.isAnAlly() ? 1 : -1;
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;

		real score = 0.0;
		if (dmg > 0) {
			integer overDmg = 0;
			
			if (dmg > targetStats.getLife()) {
				// On ne gère l'over dmg que pour un ennemi
				if (!target.isAnAlly())
					overDmg = dmg - targetStats.getLife(); 
				dmg = targetStats.getLife();
				
				score += targetScores.getKillScore() * targetAllyMult;
				score += targetScores.getPowerScore(target.getPowerOnDeath()) * casterAllyOtherMult;
				
				//Debug.log("I can kill ! " + target);   
			}
			score += targetScores.getDmgScore(dmg, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().directDmg;
			//if (overDmg > 0)
				//score -= 0.25 * targetScores.getDmgScore(overDmg, targetStats.getLife()) * targetAllyMult;

			score += this.getPassiveScore(target, caster, targetStats, casterStats, dmg);
		}
		
		if (caster != target) {
			if (dmg > 0) {
				integer lifeSteal = round(dmg * casterStats.getWisdom() / 1000);
				if (casterStats.getLife() + lifeSteal > casterStats.getMaxLife())
					lifeSteal = casterStats.getMaxLife() - casterStats.getLife();
				score += casterScores.getHealScore(lifeSteal, casterStats.getLife()) * casterAllyOtherMult;
			}
			
			if (dmgReturn > 0) {
				score += casterScores.getDmgScore(dmgReturn) * casterAllyDmgMult;
				if (dmgReturn > casterStats.getLife()) {
					score += casterScores.getKillScore() * casterAllyDmgMult;
					
					Debug.log("I will kill myself ! " + caster);   
				}
					
				score += this.getPassiveScore(target, caster, targetStats, casterStats, dmgReturn);
			}
		}
		return score;
		
		// TODO: add score for erosion
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		if (this._item.getId() == 143) return 0;
			// TODO : gérer plasma
		
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		real baseDmg = baseValue * casterStats.getStrengthMult() * casterStats.getPowerMult();
		return max(0, round(baseDmg * (1 - targetStats.getRel() / 100) - targetStats.getAbso()));
	}
}
/** IA v5/Effects/LifeDamageEffect **/



class LifeDamageEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		real baseDmg = value / 100 * casterStats.getLife() * casterStats.getPowerMult();
		integer dmgReturn = round(baseDmg * affectedEntityStats.getDmgReturn() / 100);
		integer dmg = round(baseDmg * (1 - affectedEntityStats.getRel() / 100) - affectedEntityStats.getAbso());

		if (dmg > 0) {
			affectedEntityStats.removeLife(dmg, EFFECT_LIFE_DAMAGE);
			affectedEntity.updateAliveState(caster);
		}
		if (!(caster == affectedEntity)) {
			if (dmgReturn > 0) {
				casterStats.removeLife(dmgReturn, EFFECT_DAMAGE);
				caster.updateAliveState(caster);
			}
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		EntityScores casterScores = caster.getScores();
		
		real baseDmg = value / 100 * casterStats.getLife() * casterStats.getPowerMult();
		integer dmgReturn = round(baseDmg * targetStats.getDmgReturn() / 100);
		integer dmg = round(baseDmg * (1 - targetStats.getRel() / 100) - targetStats.getAbso());

		integer casterAllyDmgMult = caster.isAnAlly() ? -1 : 1;
		integer casterAllyOtherMult = caster.isAnAlly() ? 1 : -1;
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;

		real score = 0.0;
		if (dmg > 0) {
			integer overDmg = 0;
			if (dmg > targetStats.getLife()) {
				dmg = targetStats.getLife();

				// On ne gère l'over dmg que pour un ennemi
				if (!target.isAnAlly())
					overDmg = dmg - targetStats.getLife(); 
				
				score += targetScores.getKillScore() * targetAllyMult;
				score += targetScores.getPowerScore(target.getPowerOnDeath()) * casterAllyOtherMult;

				Debug.log("I can kill !");
			}
			score += targetScores.getDmgScore(dmg, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().directDmg;
			if (overDmg > 0)
				score -= 0.25 * targetScores.getDmgScore(overDmg, targetStats.getLife());
		}
		
		if (caster != target) {			
			if (dmgReturn > 0) {
				score += casterScores.getDmgScore(dmgReturn, casterStats.getLife()) * casterAllyDmgMult;
			}
		}
		return score;
		
		// TODO: add score for erosion
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		real baseDmg = baseValue / 100 * casterStats.getLife() * casterStats.getPowerMult();
		return round(baseDmg * (1 - targetStats.getRel() / 100) - targetStats.getAbso());
	}
}
/** IA v5/Effects/PoisonEffect **/


 
class PoisonEffect extends Effect {
	private constructor(Array<any> effectArray, Item item) {
		setPut(_triggerableEffects, EFFECT_POISON_TO_SCIENCE);
		
		super(effectArray, item);
	}
	
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer finalValue = round(value * casterStats.getMagicMult() * casterStats.getPowerMult());
		    			
		affectedEntityStats.addEffect(null, this._type, finalValue, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);
		this.tryTriggerPassive(affectedEntity, caster, finalValue);
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;
		integer finalValue = round(value * casterStats.getMagicMult() * casterStats.getPowerMult());
		return targetScores.getPoisonScore(finalValue, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().poison;
		
		// TODO: add score for erosion
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;
		return targetScores.getPoisonScore(finalValue, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().poison;
	}
}
/** IA v5/Effects/NovaDamageEffect **/



class NovaDamageEffect extends Effect {
	private constructor(Array<any> effectArray, Item item) {
		setPut(this._triggerableEffects, EFFECT_NOVA_DAMAGE_TO_MAGIC);
		
		super(effectArray, item);
	}
	
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer dmg = round(value * casterStats.getScienceMult() * casterStats.getPowerMult());

		if (dmg > affectedEntityStats.getMaxLife() - affectedEntityStats.getLife()) {
			dmg = affectedEntityStats.getMaxLife() - affectedEntityStats.getLife();
		}

		if (dmg > 0) {
			affectedEntityStats.removeMaxLife(dmg);
			
			this.tryTriggerPassive(affectedEntity, caster, dmg);
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		EntityScores casterScores = caster.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? -1 : 1;

		integer novaDmg = round(value * casterStats.getScienceMult() * casterStats.getPowerMult());
		integer maxNovaDmg = targetStats.getMaxLife() - targetStats.getLife();
		integer overNovaDmg = 0;
		
		real score = 0.0;
		if (novaDmg > 0) {
			if (novaDmg > maxNovaDmg) {
				novaDmg = maxNovaDmg;

				overNovaDmg = novaDmg - maxNovaDmg;
			}
			
			score += targetScores.getMaxLifeScore(novaDmg, targetStats.getMaxLife()) * targetAllyMult * targetScores.getAdjuster().novaDamage;
			if (overNovaDmg > 0)
				score -= 0.25 * targetScores.getMaxLifeScore(overNovaDmg, targetStats.getMaxLife()) * targetAllyMult;
			
			score += this.getPassiveScore(target, caster, targetStats, casterStats, novaDmg);
		}
		return score;
	}
}
/** IA v5/Effects/DamageReturnEffect **/



class DamageReturnEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer finalValue = round(value * casterStats.getAgilityMult());
		affectedEntityStats.addEffect(EntityStats.addDmgReturnStatic, this._type, finalValue, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value * casterStats.getAgilityMult());
		return targetScores.getDmgReturnScore(finalValue, targetStats.getDmgReturn(), targetStats.getAbso(), targetStats.getRel()) * targetAllyMult * targetScores.getAdjuster().dmgReturn;
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		return targetScores.getDmgReturnScore(finalValue, targetStats.getDmgReturn(), targetStats.getAbso(), targetStats.getRel()) * targetAllyMult * targetScores.getAdjuster().dmgReturn;
	}
}
/** IA v5/Effects/HealEffect **/



class HealEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer finalValue = round(value * casterStats.getWisdomMult());
		if (this._turns == 0) {
			affectedEntityStats.addLife(finalValue);
		} else {
			affectedEntityStats.addEffect(EntityStats.addLifeStatic, this._type, finalValue, caster, this._turns, false, this._item.getId(), affectedEntity, this._modifiers);	
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
	
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value * casterStats.getWisdomMult());
		if (this._turns == 0) {
			integer overHeal = 0;
			if (finalValue > targetStats.getMaxLife() - targetStats.getLife()) {
				// On ne gère l'over heal que pour un allié
				if (target.isAnAlly())
					overHeal = (targetStats.getLife() + finalValue) - targetStats.getMaxLife(); 
				finalValue = targetStats.getMaxLife() - targetStats.getLife();
			}
			real score = targetScores.getHealScore(finalValue, targetStats.getLife()) * targetScores.getAdjuster().heal;
			if (overHeal > 0) {
				integer itemCD = this._item.getBaseCooldown();
				if (itemCD == -1)
					itemCD = 15;
				score -= (0.5 * itemCD / (itemCD + 1)) * targetScores.getHealScore(overHeal, targetStats.getLife());
			}
			return score * targetAllyMult;
			
		} else {
			return targetScores.getHealScore(finalValue, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().healOverTime;
		}
	}
	
	public static real getFinalEffectScoreStatic(integer finalValue, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		// TODO: not quite sure how to manage debuff here
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		return targetScores.getHealScore(finalValue, targetStats.getLife()) * targetScores.getAdjuster().heal;
	}
}
/** IA v5/Effects/RawHealEffect **/



class RawHealEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		if (this._turns == 0) {
			affectedEntityStats.addLife(round(value));
		}
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value);
		if (this._turns == 0) {
			integer overHeal = 0;
			if (finalValue > targetStats.getMaxLife() - targetStats.getLife()) {
				// On ne gère l'over heal que pour un allié
				if (target.isAnAlly())
					overHeal = (targetStats.getLife() + finalValue) - targetStats.getMaxLife(); 
				finalValue = targetStats.getMaxLife() - targetStats.getLife();
			}
			real score = targetScores.getHealScore(finalValue, targetStats.getLife()) * targetScores.getAdjuster().heal;
			if (this._turns == 0 && overHeal > 0) {
				integer itemCD = this._item.getBaseCooldown();
				if (itemCD == -1)
					itemCD = 15;
				score -= (0.5 * itemCD / (itemCD + 1)) * targetScores.getHealScore(overHeal, targetStats.getLife());
			}
			return score * targetAllyMult;
			
		} else {
			return targetScores.getHealScore(finalValue, targetStats.getLife()) * targetAllyMult * targetScores.getAdjuster().healOverTime;
		}
	}
}
/** IA v5/Effects/BoostMaxLifeEffect **/



class BoostMaxLifeEffect extends Effect {
	protected void apply(real value, AbstractEntity caster, AbstractEntity affectedEntity, EntityStats affectedEntityStats, Cell? cellTarget) {
		EntityStats casterStats = caster.getStats();
		integer finalValue = round(value * casterStats.getWisdomMult());
		affectedEntityStats.addMaxLife(finalValue);
		affectedEntityStats.addLife(finalValue);
	}
	
	protected real getEffectScore(real value, AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, Cell? cellTarget) {
		EntityScores targetScores = target.getScores();
		
		integer targetAllyMult = target.isAnAlly() ? 1 : -1;
		integer finalValue = round(value * casterStats.getWisdomMult());
		real score = targetScores.getMaxLifeScore(finalValue, targetStats.getMaxLife()) * targetAllyMult;
		return score + targetScores.getHealScore(finalValue, targetStats.getLife()) * targetAllyMult;
	}
	
	public integer getAppliedValue(Cell? cellTarget, Cell? cellFrom, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist, boolean isCasterHit = false) {
		real baseValue = this.getBaseValueToApply(cellTarget, cellFrom, caster, dist, isCasterHit);
		return round(baseValue * casterStats.getWisdomMult());
	}
}
