	public string() {
		return 	"{ type: " + this._type +
				" | meanValue: " + this._meanValue +
				" | turns: " + this._turns +
				" | item: " + this._item.getName() + " }";
	}
}


class Item {
	/** items pool **/
	protected static Map<integer, Item> items = [:];
	public static Item? get(integer id) {
		return Item.items[id];
	}
	/** fin items pool **/
	
	protected integer id; public integer getId() { return this.id; }
	protected string name; public string getName() { return this.name; }
	protected integer areaType; public integer getAreaType() { return this.areaType; }
	protected integer cost; public integer getCost() { return this.cost; }
	protected integer baseCooldown; public integer getBaseCooldown() { return this.baseCooldown; }
	protected integer minRange; public integer getMinRange() { return this.minRange; }
	protected integer maxRange; public integer getMaxRange() { return this.maxRange; }
	protected integer launchType; public integer getLaunchType() { return this.launchType; }
	protected boolean needLos; public boolean getNeedLos() { return this.needLos; }
	protected boolean _canTargetAlly; public boolean canTargetAlly() { return this._canTargetAlly; }
	protected boolean _canTargetEnemy; public boolean canTargetEnemy() { return this._canTargetEnemy }
	protected Array<Effect> _effects; public Array<Effect> getEffects() { return this._effects; }
	protected Set<integer> _effectsTypeList; public Set<integer> getEffectsTypeList() { return this._effectsTypeList; }
	
	protected constructor(integer id) {
		this.id = id;
		
		this._canTargetAlly = false;
		this._canTargetEnemy = false;

		this._effects = new Array();
		this._effectsTypeList = <>;
	}
	
	protected void initTeamTargetsBool() {
		for (Effect eff in this._effects) {
			Object? effUseTargets = Effect.getEffectUseTargets(eff.getType());
			if (effUseTargets!.ally || eff.getTargets() & EFFECT_TARGET_ALLIES) {
				this._canTargetAlly = true;
			}
			if (effUseTargets!.enemy || eff.getTargets() & EFFECT_TARGET_ENEMIES) {
				this._canTargetEnemy = true;
			}
		}
	}
	
		
	public Set<Cell> getEffectiveArea(Cell cell, Cell? from) {
		return Item.effectiveAreaMemo.apply(this, cell, from) as Set<Cell>;
	}
	protected Set<Cell> getItemEffectiveArea(Cell cell, Cell? from) {
		// need to be overriden
	}
	private static Memoize3 effectiveAreaMemo = new Memoize3(function(Item item, Cell cell, Cell? from) {
			return item.getItemEffectiveArea(cell, from);
		}, function(Item item, Cell cell, Cell? from) {
			return ((from != null) ? from!.id : 614) << 18 | cell.id << 8 | item.areaType;
	});
	
	public Set<AbstractEntity> getSimulationTargets(Cell cell, Cell? from, AbstractEntity caster) {
		Set<AbstractEntity> targets = <>;
		
		for (Cell c in this.getEffectiveArea(cell, from)) {
			if (c.hasEntity() && this.canTarget(c.getCellEntity()!, caster)) {
				setPut(targets, c.getCellEntity());
			};
		}
		return targets;
	}

	public boolean canTarget(AbstractEntity target, AbstractEntity caster) {
		for (Effect effect in this._effects) {
			if (effect.canTarget(target, caster))
				return true;
		}
		return false;
	}
	
	public Set<Effect> getEffectsOfType(integer effectType) {
		Set<Effect> _effects = <>;
		for (Effect eff in this._effects) {
			if (eff.getType() == effectType)
				setPut(_effects, eff);
		}
		return _effects;
	}
	public Set<Effect> getEffectsOfTypes(Set<integer> effectTypes) {
		Set<Effect> _effects = <>;
		for (Effect eff in this._effects) {
			if (setContains(effectTypes, eff.getType()))
				setPut(_effects, eff);
		}
		return _effects;
	}
	public boolean hasEffectType(integer effectType) {
		return setContains(this._effectsTypeList, effectType);
	}
	public boolean hasEffectTypeIn(Set<integer> effectTypes) {
		for (integer effectType in effectTypes)
			if (setContains(this._effectsTypeList, effectType))
				return true;
		return false;
	}
	
	public real|integer getAoeMult(integer dist) {
		if (this.areaType == AREA_LASER_LINE or this.areaType == AREA_FIRST_INLINE or this.areaType == AREA_POINT) {
			return 1;
		} else {
			return 1 - dist * 0.2;	
		}
	}
	
	public integer getAreaSize() {
		if (this.areaType == AREA_CIRCLE_1) { 
			return 1;
		} else if (this.areaType == AREA_CIRCLE_2) {
			return 2;
		} else if (this.areaType == AREA_CIRCLE_3) {
			return 3;
		} else if (this.areaType == AREA_PLUS_1) {
			return 1;
		} else if (this.areaType == AREA_PLUS_2) {
			return 2;
		} else if (this.areaType == AREA_PLUS_3) {
			return 3;
		} else if (this.areaType == AREA_SQUARE_1) {
			return 2;
		} else if (this.areaType == AREA_SQUARE_2) {
			return 4;
		} else if (this.areaType == AREA_X_1) {
			return 2;
		} else if (this.areaType == AREA_X_2) {
			return 4;
		} else if (this.areaType == AREA_X_3) {
			return 6;
		} else if (this.areaType == AREA_POINT) {
			return 0;
		} else if (this.areaType == AREA_FIRST_INLINE) {
			return 0;
		} else if (this.areaType == AREA_LASER_LINE) {
			return 0;
		}
	}
	
	public real getScore(AbstractEntity target, AbstractEntity caster, EntityStats targetStats, EntityStats casterStats, integer dist) {
		real score = 0.0;
		for (Effect eff in this._effects) {
			if (eff.canTarget(target, caster) && eff.canApplyTo(target, caster)) {
				score += eff.getScore(null, null, target, caster, targetStats, casterStats, dist, true);
			}
		}
		
		return score;
	}
	
	public boolean canUseItemOnCell(Cell cell) {}
	public integer use(Cell cell) {}
	
	public integer applyOnCell(Cell cellTarget, Cell? cellFrom, AbstractEntity caster, integer hitCasterDist) {
		for (Effect eff in this._effects) {
			eff.applyOnCell(cellTarget, cellFrom, caster, hitCasterDist != -1);
			
			if (hitCasterDist != -1) {
				// Apply on caster (caster isn't on the map so it's not applied on by applyOnCell)
				eff.applyTo(cellTarget, cellFrom, caster, caster, caster.getStats(), caster.getStats(), hitCasterDist, true);
			}
		}
	}
	public integer applyTo(AbstractEntity target, AbstractEntity caster, integer dist, boolean isHittingCaster = false) {
		for (Effect eff in this._effects) {
			eff.applyTo(null, null, target, caster, target.getStats(), caster.getStats(), dist, isHittingCaster);
		}
	}

	public real scaleScoreOnCost(real score) {
		return score / (this.cost - (this.cost / 7.5));
	}

	public string string() {
		return "{name: " + this.name + "}";	
	}
	
	/**
	 * Récupère une ligne pour utiliser un laser sur une cell
	 * 
	 * @params cell : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getLineCanMoveToHitWithLaser(Set<Cell> cells, Cell target, integer distMin, integer distMax, string direction) {
		Cell? currentCell = target;
		integer distMinTmp = distMin;
		for(integer i = 0; i <= distMax && currentCell != null && !currentCell!.isObstacle(); i++) {
			
			if(currentCell!.hasEntity()) {
				distMinTmp = i + distMin;
			} else if(i >= distMinTmp) {
				setPut(cells, currentCell);
			}
			
			currentCell = (currentCell!)[direction] as Cell?;
		}
		
		return cells;
	}
	
	public static Set<Cell> getCellsCanMoveToUseLaserOnCell(Cell target, Item item) {
		Set<Cell> cells = <>;
		
		integer minRange = item.getMinRange();
		integer maxRange = item.getMaxRange();
		Item.getLineCanMoveToHitWithLaser(cells, target, minRange, maxRange "N");
		Item.getLineCanMoveToHitWithLaser(cells, target, minRange, maxRange, "E");
		Item.getLineCanMoveToHitWithLaser(cells, target, minRange, maxRange, "S");
		Item.getLineCanMoveToHitWithLaser(cells, target, minRange, maxRange, "W");
		
		return cells;
	}
		
	/**
	 * Récupère une ligne qui peut être toucher par un laser
	 * 
	 * @params cellFrom : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getLineCanHitWithLaser(Set<Cell> cells, Cell cellFrom, integer distMin, integer distMax, string direction) {
		Cell? currentCell = cellFrom;
		for(integer i = 0; i <= distMax && currentCell != null && !currentCell!.isObstacle(); i++) {
			if (i >= distMin) {
				setPut(cells, currentCell);
			} else if(currentCell!.hasEntity()) {
				// Une entité block le tire
				break;
			}
			
			currentCell = (currentCell!)[direction] as Cell?;
		}
		
		return cells;
	}
	public static Set<Cell> getLineCanHitWithLaserIgnore(Set<Cell> cells, Cell cellFrom, integer distMin, integer distMax, string direction, Set<AbstractEntity> ignoredEntities) {
		Cell? currentCell = cellFrom;
		for(integer i = 0; i <= distMax && currentCell != null && !currentCell!.isObstacle(); i++) {
			if (i >= distMin) {
				setPut(cells, currentCell);
			} else if(currentCell!.hasEntity() && !setContains(ignoredEntities, currentCell!.getCellEntity())) {
				// Une entité block le tire
				break;
			}
			
			currentCell = (currentCell!)[direction] as Cell?;
		}
		
		return cells;
	}
		
	public static Set<Cell> getCellsCanHitWithLaser(Cell cellFrom, integer distMin, integer distMax) {
		Set<Cell> cells = <>;

		Item.getLineCanHitWithLaser(cells, cellFrom, distMin, distMax "N");
		Item.getLineCanHitWithLaser(cells, cellFrom, distMin, distMax, "E");
		Item.getLineCanHitWithLaser(cells, cellFrom, distMin, distMax, "S");
		Item.getLineCanHitWithLaser(cells, cellFrom, distMin, distMax, "W");
		
		return cells;	
	}
	public static Set<Cell> getCellsCanHitWithLaserIgnore(Cell cellFrom, integer distMin, integer distMax, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> cells = <>;

		Item.getLineCanHitWithLaserIgnore(cells, cellFrom, distMin, distMax "N", ignoredEntities);
		Item.getLineCanHitWithLaserIgnore(cells, cellFrom, distMin, distMax, "E", ignoredEntities);
		Item.getLineCanHitWithLaserIgnore(cells, cellFrom, distMin, distMax, "S", ignoredEntities);
		Item.getLineCanHitWithLaserIgnore(cells, cellFrom, distMin, distMax, "W", ignoredEntities);
		
		return cells;	
	}
	
	public static Cell? getCellToHitLaser(Item item, Cell cellTarget, Cell cellFrom) {
		integer dx = cellTarget.x - cellFrom.x;
		integer dy = cellTarget.y - cellFrom.y;
		string direction = (dx != 0) ? ((dx > 0) ? "W" : "E") : ((dy > 0) ? "N" : "S");
		
		return Area.getFirstCellToHitLaser(item, cellFrom, direction);
	}
		
		
	/**
	 * Récupère les cellules où on peut pousser une entité
	 * 
	 * @params cellFrom : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getLineCanPush(Set<Cell> cells, Cell cellFrom, integer distMin, integer distMax, string direction) {
		AbstractEntity? firstEntity = null;
		Cell? currentCell = cellFrom;
		for(integer i = 0; i <= distMax && currentCell != null && !currentCell!.isObstacle(); i++) {
			if (currentCell!.hasEntity()) {
				if (firstEntity == null)
					firstEntity = currentCell!.getCellEntity();
				else
					// On ne peut pas pousser à travers une autre entité
					break;
			} else if (i >= distMin && firstEntity != null) {
				setPut(cells, currentCell);
			}
			
			currentCell = (currentCell!)[direction] as Cell?;
		}
			
		return cells;
	}
	public static Set<Cell> getLineCanPushIgnore(Set<Cell> cells, Cell cellFrom, integer distMin, integer distMax, string direction, Set<AbstractEntity> ignoredEntities) {
		AbstractEntity? firstEntity = null;
		Cell? currentCell = cellFrom;
		for(integer i = 0; i <= distMax && currentCell != null && !currentCell!.isObstacle(); i++) {
			if (currentCell!.hasEntity() && !setContains(ignoredEntities, currentCell!.getCellEntity())) {
				if (firstEntity == null)
					firstEntity = currentCell!.getCellEntity();
				else
					// On ne peut pas pousser à travers une autre entité
					break;
			} else if (i >= distMin && firstEntity != null) {
				setPut(cells, currentCell);
			}
			
			currentCell = (currentCell!)[direction] as Cell?;
		}
			
		return cells;
	}
		
	/**
	 * Récupère les cellules sur lesquelles on peut pousser la première entité sur la ligne avec 'item'
	 */
	public static Set<Cell> getCellsCanPush(Cell cellFrom, integer distMin, integer distMax) {
		Set<Cell> cells = <>;

		Item.getLineCanPush(cells, cellFrom, distMin, distMax "N");
		Item.getLineCanPush(cells, cellFrom, distMin, distMax, "E");
		Item.getLineCanPush(cells, cellFrom, distMin, distMax, "S");
		Item.getLineCanPush(cells, cellFrom, distMin, distMax, "W");
		
		return cells;	
	}
	public static Set<Cell> getCellsCanPushIgnore(Cell cellFrom, integer distMin, integer distMax, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> cells = <>;

		Item.getLineCanPushIgnore(cells, cellFrom, distMin, distMax "N", ignoredEntities);
		Item.getLineCanPushIgnore(cells, cellFrom, distMin, distMax, "E", ignoredEntities);
		Item.getLineCanPushIgnore(cells, cellFrom, distMin, distMax, "S", ignoredEntities);
		Item.getLineCanPushIgnore(cells, cellFrom, distMin, distMax, "W", ignoredEntities);
		
		return cells;	
	}
		
	/**
	 * Récupère les cellules où on peut attirer une entité
	 * 
	 * @params cellFrom : la cellule initial
	 * @params distMin : distance minimale de la zone
	 * @params distMax : distance maximale de la zone
	 * @params direction : direction ["N", "NE", "E", "SE", "S", "SW", "W", "NW"]
	 * 
	 * @return cells : tableau des cellules
	 **/
	public static Set<Cell> getLineCanAttract(Set<Cell> cells, Cell cellFrom, integer distMin, integer distMax, string direction) {
		Set<Cell> tmpCells = <>;
		
		boolean foundEntity = false;
		Cell? currentCell = cellFrom;
		for(integer i = 0; i <= distMax && currentCell != null && !currentCell!.isObstacle(); i++) {
			if (currentCell!.hasEntity()) {
				foundEntity = true;
				break;
			} else if (i >= distMin) {
				setPut(tmpCells, currentCell);
			}
			
			currentCell = (currentCell!)[direction] as Cell?;
		}
			
		if (foundEntity)
			setPutAll(cells, tmpCells);
			
		return cells;
	}
	public static Set<Cell> getLineCanAttract(Set<Cell> cells, Cell cellFrom, integer distMin, integer distMax, string direction, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> tmpCells = <>;
		
		boolean foundEntity = false;
		Cell? currentCell = cellFrom;
		for(integer i = 0; i <= distMax && currentCell != null && !currentCell!.isObstacle(); i++) {
			if (currentCell!.hasEntity() && !setContains(ignoredEntities, currentCell!.getCellEntity())) {
				foundEntity = true;
				break;
			} else if (i >= distMin) {
				setPut(tmpCells, currentCell);
			}
			
			currentCell = (currentCell!)[direction] as Cell?;
		}
			
		if (foundEntity)
			setPutAll(cells, tmpCells);
			
		return cells;
	}
		
	/**
	 * Récupère les cellules sur lesquelles on peut pousser la première entité sur la ligne avec 'item'
	 */
	public static Set<Cell> getCellsCanAttract(Cell cellFrom, integer distMin, integer distMax) {
		Set<Cell> cells = <>;

		Item.getLineCanAttract(cells, cellFrom, distMin, distMax "N");
		Item.getLineCanAttract(cells, cellFrom, distMin, distMax, "E");
		Item.getLineCanAttract(cells, cellFrom, distMin, distMax, "S");
		Item.getLineCanAttract(cells, cellFrom, distMin, distMax, "W");
		
		return cells;	
	}
	public static Set<Cell> getCellsCanAttractIgnore(Cell cellFrom, integer distMin, integer distMax, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> cells = <>;

		Item.getLineCanAttract(cells, cellFrom, distMin, distMax "N", ignoredEntities);
		Item.getLineCanAttract(cells, cellFrom, distMin, distMax, "E", ignoredEntities);
		Item.getLineCanAttract(cells, cellFrom, distMin, distMax, "S", ignoredEntities);
		Item.getLineCanAttract(cells, cellFrom, distMin, distMax, "W", ignoredEntities);
		
		return cells;	
	}
	
	
	/**
	 * Récupère les cellules sur lesquelles on peut utiliser 'item' avec des déplacements
	 * 
	 * params
	 * cellsCanGo : les cellules accessibles par la lanceur
	 * item : l'item utilisé
	 * target : la cellule cible
	 * 
	 * return
	 * cells : tableau des cellules
	 **/
	public Set<Cell> getCellsCanMoveToHitFromCells(Set<Cell> cellsFrom) {
		Set<Cell> cells = <>;
		for(Cell c in cellsFrom) {
			setPutAll(cells, this.getCellsCanMoveToHit(c));
		}
		
		return cells;
	}
	public Set<Cell> getCellsCanMoveToHit(Cell c) {
		return Item.cellsCanMoveToHitWithItemMemo.apply(this, c) as Set<Cell>;
	}
	private static Memoize2 cellsCanMoveToHitWithItemMemo = new Memoize2(function(Item item, Cell target) {
		Set<Cell> cells = <>;

		if(item.launchType == LAUNCH_TYPE_LINE) {
			if (item.areaType == AREA_LASER_LINE) {
				cells = Item.getCellsCanMoveToUseLaserOnCell(target, item)
			} else if (item.areaType == AREA_FIRST_INLINE) {
				if (item.hasEffectType(EFFECT_PUSH))
					cells = Area.getPlusArea(target, item.minRange, item.maxRange - 1);
				else if (item.hasEffectType(EFFECT_ATTRACT))
					cells = Area.getPlusArea(target, item.minRange + 1, item.maxRange);
			} else if(item.needLos)
				cells = Area.getPlusAreaLos(target, item.minRange, item.maxRange);
			else
				cells = Area.getPlusArea(target, item.minRange, item.maxRange);
		} else if(item.launchType == LAUNCH_TYPE_CIRCLE) {
			if(item.needLos)
				cells = Area.getAreaLos(target, item.minRange, item.maxRange);
			else 
				cells = Area.getArea(target, item.minRange, item.maxRange);
		} else if(item.launchType == LAUNCH_TYPE_DIAGONAL) {
			if (item.needLos)
				cells = Area.getDiagonalAreaLos(target, item.minRange, item.maxRange);
			else
				cells = Area.getDiagonalArea(target, item.minRange, item.maxRange);
		} else if(item.launchType == LAUNCH_TYPE_STAR) {
			if (item.needLos)
				cells = Area.getStarAreaLos(target, item.minRange, item.maxRange);
			else
				cells = Area.getStarArea(target, item.minRange, item.maxRange);
		}

		// On ne peut pas se déplacer sur une case avec une entité
		Set<Cell> goodCells = <>;
		for (Cell cell in cells) {
			if (!cell.hasEntity())
				setPut(goodCells, cell);
		}

		return goodCells;
	}, function(Item item, Cell target) {
		return CellMap.getOccupiedCellsHash() + "," + target.id + "," + item.getId();
	});
	public static resetCellsCanMoveToHitWithItemMemo() {
		Item.cellsCanMoveToHitWithItemMemo.reset();
	}
	
	/**
	 * Récupère les cellules sur lesquelles on peut utiliser 'item' avec des déplacements
	 * 
	 * params
	 * cellsCanGo : les cellules accessibles par la lanceur
	 * item : l'item utilisé
	 * target : la cellule cible
	 * 
	 * return
	 * cells : tableau des cellules
	 **/
	public Set<Cell> getCellsCanMoveToHitFromCellsIgnore(Set<Cell> cellsFrom, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> cells = <>;
		for(Cell c in cellsFrom) {
			setPutAll(cells, this.getCellsCanMoveToHitIgnore(c, ignoredEntities));
		}
		
		return cells;
	}
	public Set<Cell> getCellsCanMoveToHitIgnore(Cell c, Set<AbstractEntity> ignoredEntities) {	
		return Item.cellsCanMoveToHitWithItemIgnoreMemo.apply(this, c) as Set<Cell>;
	}
	private static Memoize2 cellsCanMoveToHitWithItemIgnoreMemo = new Memoize2(function(Item item, Cell target, Set<AbstractEntity> ignoredEntities) {
		Set<Cell> cells = <>;
		
		Array<integer> ignoredEntitiesId = new Array();
		for (AbstractEntity entity in ignoredEntities) {
			push(ignoredEntitiesId, entity.getId());
		}
		currentLoS = function(integer start, integer end) => boolean? {
			return lineOfSight(start, end, ignoredEntitiesId);
		}

		if(item.launchType == LAUNCH_TYPE_LINE) {
			if (item.hasEffectType(EFFECT_INVERT)) {
				if (item.needLos) {
					cells = Area.getInvertPlusAreaLosIgnore(target, item.minRange, item.maxRange, ignoredEntities);
				} else {
					cells = Area.getInvertPlusAreaIgnore(target, item.minRange, item.maxRange, ignoredEntities);
				}
			} else if (item.areaType == AREA_LASER_LINE) {
				cells = Item.getCellsCanMoveToUseLaserOnCell(target, item)
			} else if (item.areaType == AREA_FIRST_INLINE) {
				if (item.hasEffectType(EFFECT_PUSH))
					cells = Area.getPlusAreaLos(target, item.minRange, item.maxRange - 1);
				else if (item.hasEffectType(EFFECT_ATTRACT))
					cells = Area.getPlusAreaLos(target, item.minRange + 1, item.maxRange);
			} else if(item.needLos)
				cells = Area.getPlusAreaLos(target, item.minRange, item.maxRange);
			else
				cells = Area.getPlusArea(target, item.minRange, item.maxRange);
		} else if(item.launchType == LAUNCH_TYPE_CIRCLE) {
			if (item.hasEffectType(EFFECT_INVERT)) {
				if (item.needLos) {
					cells = Area.getInvertAreaLosIgnore(target, item.getMinRange(), item.maxRange, ignoredEntities);
				} else {
					cells = Area.getInvertAreaIgnore(target, item.getMinRange(), item.maxRange, ignoredEntities);
				}
			} else if(item.needLos)
				cells = Area.getAreaLos(target, item.minRange, item.maxRange);
			else 
				cells = Area.getArea(target, item.minRange, item.maxRange);
		} else if(item.launchType == LAUNCH_TYPE_DIAGONAL) {
			if (item.needLos)
				cells = Area.getDiagonalAreaLos(target, item.minRange, item.maxRange);
			else
				cells = Area.getDiagonalArea(target, item.minRange, item.maxRange);
		} else if(item.launchType == LAUNCH_TYPE_STAR) {
			if (item.needLos)
				cells = Area.getStarAreaLos(target, item.minRange, item.maxRange);
			else
				cells = Area.getStarArea(target, item.minRange, item.maxRange);
		}

		// On ne peut pas se déplacer sur une case avec une entité
		Set<Cell> goodCells = <>;
		for (Cell cell in cells) {
			if (!cell.hasEntity() || setContains(ignoredEntities, cell.getCellEntity()))
				setPut(goodCells, cell);
		}
		cells = goodCells;
		
		currentLoS = lineOfSight;


		return cells;
	}, function(Item item, Cell target, Set<AbstractEntity> ignoredEntities) {
		integer ignoredEntitiesValue = 0;
		Array<AbstractEntity> entitiesArray = setToArray(ignoredEntities) as Array<AbstractEntity>;
		entitiesArray = arraySort(entitiesArray, function(AbstractEntity e1, AbstractEntity e2) => integer {
			return e1.getId() - e2.getId();
		}) as Array<AbstractEntity>;
		for (AbstractEntity entity in entitiesArray) {
			ignoredEntitiesValue += entity.getId() * 10;
		}
		return target.id << 32 | item.id << 22 | ignoredEntitiesValue;
	});
	public static resetCellsCanMoveToHitWithItemIgnoreMemo() {
		Item.cellsCanMoveToHitWithItemIgnoreMemo.reset();
	}
	
	/**
	 * params
	 * cellsCanGo : les cellules accessibles par la lanceur
	 * item : l'item utilisé
	 * target : la cellule cible
	 * 
	 * return
	 * cells : tableau des cellules
	 **/
	public Set<Cell> getAccessibleCellsToHitTarget(Set<Cell> accessibleCells, Cell target) {
		return setIntersection(accessibleCells, this.getCellsCanMoveToHit(target)) as Set<Cell>;
	}
	
	/**
	 * Récupère les cellules sur lesquelles on peut utiliser 'item'
	 * 
	 * params
	 * target : la cellule visée
	 * item : l'item utilisé
	 * 
	 * return
	 * cells : tableau des cellules
	 **/
	public Set<Cell> getCellsCanHitFromCells(Set<Cell> cellsFrom) {
		Set<Cell> cells = <>;
		for(Cell c in cellsFrom) {
			setPutAll(cells, this.getCellsCanHitFrom(c));
		}
		
		return cells;
	}
	public Set<Cell> getCellsCanHitFrom(Cell cellFrom) {
		return Item.cellsCanHitFromWithItemMemo.apply(this, cellFrom) as Set<Cell>;
	}
	private static Memoize2 cellsCanHitFromWithItemMemo = new Memoize2(function(Item item, Cell cellFrom) {
			Set<Cell> cells = <>;
			
			if(item.launchType == LAUNCH_TYPE_LINE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					if (item.needLos) {
						cells = Area.getInvertPlusAreaLos(cellFrom, item.minRange, item.maxRange);
					} else {
						cells = Area.getInvertPlusArea(cellFrom, item.minRange, item.maxRange);
					}
				} else if (item.areaType == AREA_LASER_LINE) {
					cells = Item.getCellsCanHitWithLaser(cellFrom, item.minRange, item.maxRange);
				} else if (item.areaType == AREA_FIRST_INLINE) {
					if (item.hasEffectType(EFFECT_PUSH))
						cells = Item.getCellsCanPush(cellFrom, item.minRange, item.maxRange);
					else if (item.hasEffectType(EFFECT_ATTRACT))
						cells = Item.getCellsCanAttract(cellFrom, item.minRange, item.maxRange);
				} else if(item.needLos)
					cells = Area.getPlusAreaLos(cellFrom, item.minRange, item.maxRange);
				else
					cells = Area.getPlusArea(cellFrom, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_CIRCLE) {
				if (item.hasEffectType(EFFECT_INVERT)) {
					if (item.needLos) {
						cells = Area.getInvertAreaLos(cellFrom, item.getMinRange(), item.maxRange);
					} else {
						cells = Area.getInvertArea(cellFrom, item.getMinRange(), item.maxRange);
					}
				} else if(item.needLos)
					cells = Area.getAreaLos(cellFrom, item.minRange, item.maxRange);
				else 
					cells = Area.getArea(cellFrom, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_DIAGONAL) {
				if (item.needLos)
					cells = Area.getDiagonalAreaLos(cellFrom, item.minRange, item.maxRange);
				else
					cells = Area.getDiagonalArea(cellFrom, item.minRange, item.maxRange);
			} else if(item.launchType == LAUNCH_TYPE_STAR) {
				if (item.needLos)
					cells = Area.getStarAreaLos(cellFrom, item.minRange, item.maxRange);
				else
					cells = Area.getStarArea(cellFrom, item.minRange, item.maxRange);
			}
		
			if (setContains(item.getEffectsTypeList(), EFFECT_TELEPORT) || setContains(item.getEffectsTypeList(), EFFECT_SUMMON)) {
				Set<Cell> goodCells = <>;
				for (Cell cell in cells) {
					if (!cell.hasEntity())
						setPut(goodCells, cell);
				}
				cells = goodCells;
			}

			return cells;
		}, function(Item item, Cell target) {
			return CellMap.getOccupiedCellsHash() + "," + target.id + "," + item.getId();
		}
	);
	public static resetCellsCanHitFromWithItemMemo() {
		Item.cellsCanHitFromWithItemMemo.reset();
	}
	
	/**
	 * Récupère les cellules sur lesquelles on peut utiliser 'item'
	 * 
	 * params
	 * target : la cellule visée
	 * item : l'item utilisé
	 * ignoredEntities : tableau des entités ignorées
	 * 
	 * return
	 * cells : tableau des cellules
